<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Cinema.App"
             Name="Cinema"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <!-- Palette -->
      <Color x:Key="Bg0Color">#0D0E12</Color>
      <Color x:Key="Bg1Color">#14151B</Color>
      <Color x:Key="Bg2Color">#1B1D25</Color>
      <Color x:Key="Bg3Color">#252834</Color>
      <Color x:Key="LineColor">#2A2D3A</Color>
      <Color x:Key="TextColor">#ECEDF3</Color>
      <Color x:Key="TextDimColor">#8C90A4</Color>
      <Color x:Key="AccentColor">#FF9F43</Color>
      <Color x:Key="AccentHoverColor">#FFB66B</Color>
      <Color x:Key="DangerColor">#FF6B6B</Color>

      <SolidColorBrush x:Key="Bg0" Color="{StaticResource Bg0Color}" />
      <SolidColorBrush x:Key="Bg1" Color="{StaticResource Bg1Color}" />
      <SolidColorBrush x:Key="Bg2" Color="{StaticResource Bg2Color}" />
      <SolidColorBrush x:Key="Bg3" Color="{StaticResource Bg3Color}" />
      <SolidColorBrush x:Key="Line" Color="{StaticResource LineColor}" />
      <SolidColorBrush x:Key="Text" Color="{StaticResource TextColor}" />
      <SolidColorBrush x:Key="TextDim" Color="{StaticResource TextDimColor}" />
      <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}" />
      <SolidColorBrush x:Key="AccentSoft" Color="{StaticResource AccentColor}" Opacity="0.14" />
      <SolidColorBrush x:Key="Danger" Color="{StaticResource DangerColor}" />

      <!-- Fluent overrides so built-in controls pick up the accent -->
      <Color x:Key="SystemAccentColor">#FF9F43</Color>
      <Color x:Key="SystemAccentColorLight1">#FFB66B</Color>
      <Color x:Key="SystemAccentColorLight2">#FFC98F</Color>
      <Color x:Key="SystemAccentColorDark1">#E58A32</Color>

      <!-- Icons (Material Design, Apache 2.0) -->
      <StreamGeometry x:Key="IcPlay">M8 5v14l11-7z</StreamGeometry>
      <StreamGeometry x:Key="IcPause">M6 19h4V5H6v14zm8-14v14h4V5h-4z</StreamGeometry>
      <StreamGeometry x:Key="IcFolder">M10 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z</StreamGeometry>
      <StreamGeometry x:Key="IcLibrary">M4 6H2v14c0 1.1.9 2 2 2h14v-2H4V6zm16-4H8c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm-8 12.5v-9l6 4.5-6 4.5z</StreamGeometry>
      <StreamGeometry x:Key="IcAdd">M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z</StreamGeometry>
      <StreamGeometry x:Key="IcRefresh">M17.65 6.35A7.958 7.958 0 0 0 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08A5.99 5.99 0 0 1 12 18c-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z</StreamGeometry>
      <StreamGeometry x:Key="IcSearch">M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.11-.59 4.27-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z</StreamGeometry>
      <StreamGeometry x:Key="IcBack">M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z</StreamGeometry>
      <StreamGeometry x:Key="IcRewind">M11 18V6l-8.5 6 8.5 6zm.5-6l8.5 6V6l-8.5 6z</StreamGeometry>
      <StreamGeometry x:Key="IcForward">M4 18l8.5-6L4 6v12zm9-12v12l8.5-6L13 6z</StreamGeometry>
      <StreamGeometry x:Key="IcFrameNext">M6 18l8.5-6L6 6v12zM16 6v12h2V6h-2z</StreamGeometry>
      <StreamGeometry x:Key="IcFramePrev">M6 6h2v12H6zm3.5 6l8.5 6V6z</StreamGeometry>
      <StreamGeometry x:Key="IcFullscreen">M7 14H5v5h5v-2H7v-3zm-2-4h2V7h3V5H5v5zm12 7h-3v2h5v-5h-2v3zM14 5v2h3v3h2V5h-5z</StreamGeometry>
      <StreamGeometry x:Key="IcCut">M9.64 7.64c.23-.5.36-1.05.36-1.64 0-2.21-1.79-4-4-4S2 3.79 2 6s1.79 4 4 4c.59 0 1.14-.13 1.64-.36L10 12l-2.36 2.36C7.14 14.13 6.59 14 6 14c-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4c0-.59-.13-1.14-.36-1.64L12 14l7 7h3v-1L9.64 7.64zM6 8c-1.1 0-2-.89-2-2s.9-2 2-2 2 .89 2 2-.9 2-2 2zm0 12c-1.1 0-2-.89-2-2s.9-2 2-2 2 .89 2 2-.9 2-2 2zm6-7.5c-.28 0-.5-.22-.5-.5s.22-.5.5-.5.5.22.5.5-.22.5-.5.5zM19 3l-6 6 2 2 7-7V3z</StreamGeometry>
      <StreamGeometry x:Key="IcClose">M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z</StreamGeometry>
      <StreamGeometry x:Key="IcLoop">M7 7h10v3l4-4-4-4v3H5v6h2V7zm10 10H7v-3l-4 4 4 4v-3h12v-6h-2v4z</StreamGeometry>
      <StreamGeometry x:Key="IcExport">M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z</StreamGeometry>
      <StreamGeometry x:Key="IcVolume">M3 9v6h4l5 5V4L7 9H3zm13.5 3A4.5 4.5 0 0 0 14 7.97v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z</StreamGeometry>
      <StreamGeometry x:Key="IcMute">M3 9v6h4l5 5V4L7 9H3zm13.59 3L19 9.41 17.59 8 15.17 10.41 12.76 8 11.34 9.41 13.76 12l-2.42 2.59L12.76 16l2.41-2.41L17.59 16 19 14.59z</StreamGeometry>
      <StreamGeometry x:Key="IcWarn">M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z</StreamGeometry>
      <StreamGeometry x:Key="IcFilm">M18 4l2 4h-3l-2-4h-2l2 4h-3l-2-4H8l2 4H7L5 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V4h-4z</StreamGeometry>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Cinema/Styles/Controls.axaml" />
  </Application.Styles>
</Application>
