<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Cnema.App"
             Name="Savefile"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <!-- Palette -->
      <Color x:Key="Bg0Color">#090A0F</Color>
      <Color x:Key="Bg1Color">#0F111A</Color>
      <Color x:Key="Bg2Color">#161926</Color>
      <Color x:Key="Bg3Color">#20243A</Color>
      <Color x:Key="LineColor">#2A2F4A</Color>
      <Color x:Key="TextColor">#EEF0FA</Color>
      <Color x:Key="TextDimColor">#8B91B0</Color>
      <Color x:Key="AccentColor">#8E6BFF</Color>
      <Color x:Key="AccentHoverColor">#A78BFF</Color>
      <Color x:Key="DangerColor">#FF3D71</Color>

      <SolidColorBrush x:Key="Bg0" Color="{StaticResource Bg0Color}" />
      <SolidColorBrush x:Key="Bg1" Color="{StaticResource Bg1Color}" />
      <SolidColorBrush x:Key="Bg2" Color="{StaticResource Bg2Color}" />
      <SolidColorBrush x:Key="Bg3" Color="{StaticResource Bg3Color}" />
      <SolidColorBrush x:Key="Line" Color="{StaticResource LineColor}" />
      <SolidColorBrush x:Key="Text" Color="{StaticResource TextColor}" />
      <SolidColorBrush x:Key="TextDim" Color="{StaticResource TextDimColor}" />
      <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}" />
      <SolidColorBrush x:Key="AccentSoft" Color="{StaticResource AccentColor}" Opacity="0.18" />
      <SolidColorBrush x:Key="Danger" Color="{StaticResource DangerColor}" />
      <SolidColorBrush x:Key="DangerHover" Color="#FF5C87" />
      <SolidColorBrush x:Key="Highlight" Color="#C2AEFF" />
      <SolidColorBrush x:Key="OnAccent" Color="#FFFFFF" />
      <!-- Worked out from the look (dark / light) by ThemeService; these are the defaults -->
      <SolidColorBrush x:Key="TagText" Color="#C9BCFF" />
      <SolidColorBrush x:Key="PartFill" Color="#22C2AEFF" />
      <SolidColorBrush x:Key="PartLine" Color="#55C2AEFF" />
      <SolidColorBrush x:Key="Overlay" Color="#E0090A0F" />
      <SolidColorBrush x:Key="ToastBg" Color="#E614151B" />
      <SolidColorBrush x:Key="OnOverlay" Color="#EEF0FA" />
      <SolidColorBrush x:Key="Scrim" Color="#B3050609" />
      <SolidColorBrush x:Key="ScrimStrong" Color="#E6050609" />
      <SolidColorBrush x:Key="ScrimLight" Color="#99050609" />
      <BoxShadows x:Key="DialogShadow">0 18 60 0 #80000000</BoxShadows>
      <BoxShadows x:Key="CardGlow">0 0 22 0 #4D8E6BFF</BoxShadows>
      <!-- Savefile purple, flat (no gradients) -->
      <SolidColorBrush x:Key="Brand" Color="#8E6BFF" />
      <SolidColorBrush x:Key="BrandButton" Color="#8E6BFF" />
      <SolidColorBrush x:Key="BrandButtonHover" Color="#A78BFF" />

      <!-- Fluent overrides so built-in controls pick up the accent -->
      <Color x:Key="SystemAccentColor">#8E6BFF</Color>
      <Color x:Key="SystemAccentColorLight1">#A78BFF</Color>
      <Color x:Key="SystemAccentColorLight2">#C0ADFF</Color>
      <Color x:Key="SystemAccentColorDark1">#7556E0</Color>

