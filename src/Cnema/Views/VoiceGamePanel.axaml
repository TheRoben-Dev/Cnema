<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Cnema.ViewModels"
             xmlns:c="using:Cnema.Controls"
             xmlns:svc="using:Cnema.Services"
             x:Class="Cnema.Views.VoiceGamePanel"
             x:DataType="vm:MainViewModel"
             x:Name="Root">
    <Border Width="600" Margin="0,40" VerticalAlignment="Center" HorizontalAlignment="Center" Background="{DynamicResource Bg1}"
            BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="16" BoxShadow="{DynamicResource DialogShadow}"
            DataContext="{Binding VoiceGame}" x:DataType="vm:VoiceGameViewModel">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <Grid ColumnDefinitions="*,Auto,Auto" Margin="24,20,20,0">
          <StackPanel VerticalAlignment="Center" Spacing="2">
            <TextBlock svc:Tr.Text="Who's that?" FontSize="17" FontWeight="Bold" />
            <TextBlock Classes="dim" FontSize="12" svc:Tr.Text="Help Mochi learn your friends' voices" />
          </StackPanel>
          <TextBlock Grid.Column="1" Classes="dim" FontSize="12" Text="{Binding RoundText}" VerticalAlignment="Center" Margin="0,0,10,0" />
          <Button Grid.Column="2" Classes="ghost" Padding="6" svc:Tr.Tip="Done for now" Command="{Binding #Root.((vm:MainViewModel)DataContext).CloseVoiceGameCommand}">
            <PathIcon Data="{StaticResource IcClose}" Width="13" Height="13" />
          </Button>
        </Grid>
        <!-- level and points -->
        <Grid ColumnDefinitions="Auto,*,Auto" Margin="24,12,24,0" IsVisible="{Binding PointsOn}">
          <TextBlock Text="{Binding LevelText}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Highlight}" VerticalAlignment="Center" />
          <Border Grid.Column="1" Background="{DynamicResource AccentSoft}" CornerRadius="10" Padding="8,2" Margin="10,0,0,0" HorizontalAlignment="Left"
                  IsVisible="{Binding HasStreak}">
            <TextBlock Text="{Binding StreakText}" FontSize="11" FontWeight="SemiBold" />
          </Border>
          <TextBlock Grid.Column="2" Classes="dim" FontSize="11" Text="{Binding PointsText}" VerticalAlignment="Center" />
        </Grid>
        <ProgressBar Minimum="0" Maximum="1" Value="{Binding LevelFill}" Height="4" MinHeight="4" CornerRadius="2" Margin="24,6,24,0" IsVisible="{Binding PointsOn}" />
        <Border Height="1" Background="{DynamicResource Line}" Margin="24,12,24,0" IsVisible="{Binding !PointsOn}" />

        <!-- Mochi listening, and what it says -->
        <Grid ColumnDefinitions="Auto,*" Margin="24,18,24,0">
          <c:BlobMascot Width="92" Height="84" Margin="22,0,0,0" Mood="{Binding Mood}" CheerTick="{Binding Cheer}" BigCheerTick="{Binding BigCheer}" MaxFps="40"
                        Hat="{Binding #Root.((vm:MainViewModel)DataContext).MochiHat}" Still="{Binding #Root.((vm:MainViewModel)DataContext).ReducedMotion}" />
          <StackPanel Grid.Column="1" Spacing="6" Margin="4,0,0,0" VerticalAlignment="Center">
            <Border Background="{DynamicResource AccentSoft}" CornerRadius="12" Padding="12,9">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding MochiLine}" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center" />
                <Border Grid.Column="1" Background="{DynamicResource Accent}" CornerRadius="10" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center"
                        IsVisible="{Binding HasPointsPop}">
                  <TextBlock Text="{Binding PointsPop}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource OnAccent}" />
                </Border>
              </Grid>
            </Border>
            <!-- a badge just earned, or a new level -->
            <Border BorderBrush="{DynamicResource Accent}" BorderThickness="1" CornerRadius="12" Padding="10,6" IsVisible="{Binding HasToast}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <PathIcon Data="{StaticResource IcSparkle}" Width="13" Height="13" Foreground="{DynamicResource Highlight}" />
                <TextBlock Text="{Binding Toast}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </StackPanel>
        </Grid>

        <!-- the snippet -->
        <Border Margin="24,16,24,0" Padding="14,12" CornerRadius="12" Background="{DynamicResource Bg2}" IsVisible="{Binding IsPlayingRound}">
          <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto">
            <Button Grid.RowSpan="2" Classes="accent" Width="44" Height="44" CornerRadius="22" Padding="0" VerticalAlignment="Center"
                    svc:Tr.Tip="Play it again" Command="{Binding PlayCommand}">
              <PathIcon Data="{StaticResource IcPlay}" Width="16" Height="16" Margin="2,0,0,0" />
            </Button>
            <ItemsControl Grid.Column="1" ItemsSource="{Binding Current.Bars}" Margin="14,0,0,0" Height="36" VerticalAlignment="Center">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="3" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:Double">
                  <Border Width="4" Height="{Binding}" CornerRadius="2" Background="{DynamicResource Highlight}" VerticalAlignment="Center" Opacity="0.8" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Grid.Row="1" Grid.Column="1" Margin="14,6,0,0" FontSize="13" FontStyle="Italic" TextWrapping="Wrap"
                       Text="{Binding Current.Quote, StringFormat='“{0}”'}" IsVisible="{Binding Current.HasQuote}" />
            <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Classes="dim" FontSize="11" Margin="0,8,0,0" Text="{Binding Current.Context}" TextWrapping="Wrap" />
          </Grid>
        </Border>

        <!-- answered faster than Mochi found the next voices -->
        <TextBlock Classes="dim" FontSize="12" Margin="24,16,24,0" svc:Tr.Text="Mochi is finding the next voice…" IsVisible="{Binding IsWaiting}" />

        <!-- the answers -->
        <StackPanel Margin="24,14,24,0" Spacing="8" IsVisible="{Binding IsPlayingRound}">
          <StackPanel Spacing="8" IsVisible="{Binding IsChoosing}">
            <TextBlock Classes="dim" FontSize="11" FontWeight="SemiBold" svc:Tr.Text="MOCHI THINKS IT'S" IsVisible="{Binding Current.HasGuesses}" />
            <ItemsControl ItemsSource="{Binding Current.Guesses}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:VoiceGuess">
                  <Button Classes="soft" Margin="0,0,8,8" Padding="14,7" CornerRadius="18"
                          Command="{Binding #Root.((vm:MainViewModel)DataContext).VoiceGame.PickCommand}" CommandParameter="{Binding Name}">
                    <StackPanel Spacing="3">
                      <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" />
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <Border Width="{Binding Bar}" Height="3" CornerRadius="2" Background="{DynamicResource Highlight}" VerticalAlignment="Center" />
                        <TextBlock Classes="dim" FontSize="10" Text="{Binding Hint}" />
                      </StackPanel>
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <WrapPanel>
              <Button Classes="soft" Margin="0,0,8,8" Padding="12,6" CornerRadius="16" svc:Tr.Content="Someone else…" Command="{Binding SomeoneElseCommand}" />
              <Button Classes="soft" Margin="0,0,8,8" Padding="12,6" CornerRadius="16" svc:Tr.Content="That's me" Command="{Binding MeCommand}" />
              <Button Classes="ghost" Margin="0,0,8,8" Padding="12,6" svc:Tr.Content="Not sure, skip" Command="{Binding SkipCommand}" />
              <Button Classes="ghost" Margin="0,0,8,8" Padding="12,6" svc:Tr.Content="Not a person" svc:Tr.Tip="The game, music, a bot or a video: don't ask about this voice again"
                      Command="{Binding IgnoreCommand}" />
            </WrapPanel>
          </StackPanel>

          <!-- "Someone else": type a name, pick a friend or add a new one -->
          <StackPanel Spacing="8" IsVisible="{Binding IsNaming}">
            <TextBlock Classes="dim" FontSize="11" FontWeight="SemiBold" svc:Tr.Text="WHO IS IT?" />
            <Grid ColumnDefinitions="*,Auto,Auto">
              <TextBox Classes="fx" Text="{Binding NameText}" svc:Tr.Watermark="A friend's name" />
              <Button Grid.Column="1" Classes="accent" Margin="8,0,0,0" svc:Tr.Content="That's them" Command="{Binding ConfirmNameCommand}" />
              <Button Grid.Column="2" Classes="ghost" Margin="4,0,0,0" svc:Tr.Content="Back" Command="{Binding CancelNameCommand}" />
            </Grid>
            <ItemsControl ItemsSource="{Binding NameMatches}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <Button Classes="soft" Margin="0,0,6,6" Padding="10,5" CornerRadius="14" Content="{Binding}"
                          Command="{Binding #Root.((vm:MainViewModel)DataContext).VoiceGame.PickCommand}" CommandParameter="{Binding}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" svc:Tr.Text="A new name becomes a new friend, so you'll find their clips in the sidebar." />
          </StackPanel>
        </StackPanel>

        <!-- how well Mochi knows each voice -->
        <Border Margin="24,10,24,0" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,12,0,0"
                IsVisible="{Binding HasFriends}">
          <StackPanel Spacing="8">
            <TextBlock Classes="dim" FontSize="11" FontWeight="SemiBold" svc:Tr.Text="VOICES MOCHI KNOWS" />
            <ItemsControl ItemsSource="{Binding Friends}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:VoiceFriend">
                  <Grid ColumnDefinitions="90,*" Margin="0,0,16,6">
                    <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                      <ProgressBar Minimum="0" Maximum="1" Value="{Binding Fill}" Height="4" MinHeight="4" MinWidth="0" CornerRadius="2" />
                      <TextBlock Classes="dim" FontSize="10" Text="{Binding State}" />
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <!-- the game's badges -->
        <Border Margin="24,10,24,0" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,12,0,0" IsVisible="{Binding PointsOn}">
          <StackPanel Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Classes="dim" FontSize="11" FontWeight="SemiBold" svc:Tr.Text="BADGES" />
              <TextBlock Classes="dim" FontSize="11" Text="{Binding BadgeCountText}" />
            </StackPanel>
            <ItemsControl ItemsSource="{Binding Badges}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:VoiceBadgeView">
                  <Border Margin="0,0,6,6" Padding="8,3" CornerRadius="10" Opacity="{Binding Fade}" ToolTip.Tip="{Binding Description}"
                          Background="{DynamicResource Bg2}" Classes.earned="{Binding Earned}">
                    <Border.Styles>
                      <Style Selector="Border.earned"><Setter Property="Background" Value="{DynamicResource AccentSoft}" /></Style>
                    </Border.Styles>
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <PathIcon Data="{StaticResource IcSparkle}" Width="10" Height="10" Foreground="{DynamicResource Highlight}" IsVisible="{Binding Earned}" />
                      <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <Grid ColumnDefinitions="*,Auto,Auto" Margin="24,8,24,20">
          <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"
                     svc:Tr.Text="Everything stays on this computer. Answers only help Mochi tell voices apart." />
          <Button Grid.Column="1" Classes="ghost" Margin="0,0,6,0" svc:Tr.Content="Undo" IsVisible="{Binding CanUndo}" Command="{Binding UndoCommand}" />
          <Button Grid.Column="2" Classes="soft" svc:Tr.Content="Done for now" Command="{Binding #Root.((vm:MainViewModel)DataContext).CloseVoiceGameCommand}" />
        </Grid>
      </StackPanel>
      </ScrollViewer>
    </Border>
</UserControl>
