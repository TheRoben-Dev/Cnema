<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Cnema.ViewModels"
        xmlns:c="using:Cnema.Controls"
        xmlns:svc="using:Cnema.Services"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
        x:Class="Cnema.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        x:Name="Root"
        Title="Cnema"
        Icon="/Assets/cnema.png"
        Width="1320" Height="840" MinWidth="820" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bg0}"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="52">

  <Window.DataTemplates>
    <!-- A "pick one" row of chips (caption position, speed, voice track...) -->
    <DataTemplate DataType="vm:ChipGroup" x:DataType="vm:ChipGroup">
      <Border Classes="chipbar">
        <ItemsControl ItemsSource="{Binding Chips}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="1" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:OptionChip">
              <Button Classes="chip" Classes.on="{Binding IsOn}" Content="{Binding Label}" Command="{Binding PickCommand}"
                      ToolTip.Tip="{Binding Tip}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>
    </DataTemplate>

    <!-- The export queue, shown from the Exports button in the library and the editor -->
    <DataTemplate DataType="vm:ExportQueueViewModel" x:DataType="vm:ExportQueueViewModel">
      <StackPanel Width="380" Spacing="6">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Classes="label" Text="EXPORTS" VerticalAlignment="Center" Margin="4,0,0,0" />
          <Button Grid.Column="1" Classes="ghost" FontSize="11" Content="Clear finished" Padding="8,3"
                  IsVisible="{Binding HasFinished}" Command="{Binding ClearFinishedCommand}" />
        </Grid>
        <ScrollViewer MaxHeight="420">
          <ItemsControl ItemsSource="{Binding Jobs}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ExportJobViewModel">
                <Border Classes="fxcard" Margin="0,0,0,6" Padding="10,8">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="3">
                      <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Target}" />
                      <TextBlock Classes="dim" Text="{Binding Detail}" FontSize="11" />
                      <ProgressBar Value="{Binding Progress}" Height="4" MinHeight="4" CornerRadius="2" Margin="0,3,0,1" IsVisible="{Binding IsRunning}" />
                      <TextBlock Text="{Binding Status}" FontSize="11" TextWrapping="Wrap" Classes.err="{Binding IsFailed}" Classes.dim="{Binding !IsFailed}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="6,0,0,0">
                      <Button Classes="ghost" Padding="6" ToolTip.Tip="Show in folder" IsVisible="{Binding IsDone}"
                              Command="{Binding #Root.((vm:MainViewModel)DataContext).Exports.RevealCommand}" CommandParameter="{Binding}">
                        <PathIcon Data="{StaticResource IcFolder}" Width="13" Height="13" />
                      </Button>
                      <Button Classes="ghost" Padding="6" ToolTip.Tip="Cancel this export" IsVisible="{Binding CanCancel}"
                              Command="{Binding #Root.((vm:MainViewModel)DataContext).Exports.CancelCommand}" CommandParameter="{Binding}">
                        <PathIcon Data="{StaticResource IcClose}" Width="11" Height="11" />
                      </Button>
                      <Button Classes="ghost" Padding="6" ToolTip.Tip="Remove from the list" IsVisible="{Binding IsFinished}"
                              Command="{Binding #Root.((vm:MainViewModel)DataContext).Exports.RemoveCommand}" CommandParameter="{Binding}">
                        <PathIcon Data="{StaticResource IcClose}" Width="11" Height="11" />
                      </Button>
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" Margin="4,0"
                   Text="Exports run one at a time while you keep working. Quitting Cnema stops them." />
      </StackPanel>
    </DataTemplate>
  </Window.DataTemplates>

  <LayoutTransformControl x:Name="Scaler">
  <DockPanel>
    <!-- ======================= CONTROLLER LEGEND ======================= -->
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource Bg1}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0"
            Padding="22,9" IsVisible="{Binding IsControllerMode}">
      <ItemsControl ItemsSource="{Binding PadHints}" HorizontalAlignment="Right">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="20" /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:PadHint">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <Border Classes="padkey" Classes.a="{Binding IsA}" Classes.b="{Binding IsB}" Classes.x="{Binding IsX}" Classes.y="{Binding IsY}">
                <TextBlock Text="{Binding Glyph}" />
              </Border>
              <TextBlock Text="{Binding Label}" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextDim}" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Border>

  <Panel x:Name="RootPanel">
    <!-- ======================= LIBRARY ======================= -->
    <Grid ColumnDefinitions="248,*" IsVisible="{Binding !IsPlayerOpen}">

      <!-- Sidebar -->
      <Border Grid.Column="0" Background="{DynamicResource Bg1}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
        <Panel>
        <Border Background="{DynamicResource SidebarGlow}" IsHitTestVisible="False" />
        <DockPanel Margin="14,0,14,14">
          <!-- top spacer under the macOS traffic lights / drag area -->
          <Border x:Name="SidebarInset" DockPanel.Dock="Top" Height="0" IsHitTestVisible="False" />

          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="6,6,0,22">
            <Image Source="/Assets/cnema.png" Width="38" Height="38" Margin="-4" />
            <TextBlock Text="CNEMA" FontSize="17" FontWeight="Black" LetterSpacing="3" VerticalAlignment="Center" />
          </StackPanel>

          <!-- bottom: add folder + warnings -->
          <StackPanel DockPanel.Dock="Bottom" Spacing="10">
            <Border IsVisible="{Binding FfmpegMissing}" Background="{DynamicResource AccentSoft}" CornerRadius="8" Padding="10">
              <StackPanel Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Data="{StaticResource IcWarn}" Width="13" Height="13" Foreground="{DynamicResource Accent}" />
                  <TextBlock Text="ffmpeg not found" FontWeight="SemiBold" FontSize="12" />
                </StackPanel>
                <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap"
                           Text="Thumbnails and clip export need it. Install, then restart:" />
                <SelectableTextBlock Classes="mono" FontSize="11" Text="{Binding FfmpegHint}" Foreground="{DynamicResource Accent}" />
              </StackPanel>
            </Border>
            <Border IsVisible="{Binding HasVlcError}" Background="#26FF6B6B" CornerRadius="8" Padding="10">
              <TextBlock Text="{Binding VlcError}" FontSize="11" TextWrapping="Wrap" />
            </Border>
            <Button Classes="updatebar" HorizontalAlignment="Stretch" Command="{Binding OpenUpdateCommand}" IsVisible="{Binding HasUpdate}"
>
              <StackPanel Spacing="4">
                <TextBlock Text="{Binding UpdateText}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding UpdateAction}" FontSize="11" Foreground="{DynamicResource Cyan}" />
                <ProgressBar Minimum="0" Maximum="1" Value="{Binding UpdateProgress}" Height="3" MinHeight="3" MinWidth="0"
                             IsVisible="{Binding IsInstallingUpdate}" />
              </StackPanel>
            </Button>
            <!-- background clipping status -->
            <Border Classes="clipbar" Classes.on="{Binding IsClipRecording}" Classes.err="{Binding IsClipError}" IsVisible="{Binding ShowClipping}">
              <StackPanel Spacing="8">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <Ellipse Classes="clipdot" Width="8" Height="8" VerticalAlignment="Center" Margin="2,0,8,0" />
                  <TextBlock Grid.Column="1" Text="{Binding ClipTitle}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                  <ToggleSwitch x:Name="ClipToggle" Grid.Column="2" IsChecked="{Binding IsClipEnabled, Mode=OneWay}" Command="{Binding ToggleClippingCommand}"
                                OnContent="" OffContent="" MinWidth="0" Margin="0,-6,-6,-6" ToolTip.Tip="Turn background clipping on or off" />
                </Grid>
                <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" Text="{Binding ClipDetail}" IsVisible="{Binding HasClipDetail}" />
                <Button x:Name="SaveClipButton" Classes="accent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="10,7"
                        Command="{Binding SaveClipCommand}" IsVisible="{Binding IsClipRecording}">
                  <StackPanel Orientation="Horizontal" Spacing="7">
                    <PathIcon Data="{StaticResource IcCut}" Width="13" Height="13" />
                    <TextBlock Text="{Binding SaveClipLabel}" FontWeight="SemiBold" FontSize="12" />
                  </StackPanel>
                </Button>
                <Button x:Name="SessionButton" Classes="soft" Classes.rec="{Binding IsSession}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="10,7"
                        Command="{Binding ToggleSessionCommand}" IsVisible="{Binding ShowSessionButton}"
                        ToolTip.Tip="Record everything from now until you stop, as one video. The clip hotkey adds bookmarks.">
                  <StackPanel Orientation="Horizontal" Spacing="7">
                    <Ellipse Width="8" Height="8" Fill="#FF4D6D" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding SessionLabel}" FontWeight="SemiBold" FontSize="12" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </Border>
            <Grid ColumnDefinitions="*,Auto">
              <Button x:Name="AddFolderButton" Classes="soft" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                      Command="{Binding AddFolderCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <PathIcon Data="{StaticResource IcAdd}" Width="14" Height="14" />
                  <TextBlock Text="Add folder" FontWeight="SemiBold" />
                </StackPanel>
              </Button>
              <Button x:Name="SettingsButton" Grid.Column="1" Classes="soft" Margin="8,0,0,0" Padding="10" VerticalAlignment="Stretch"
                      Command="{Binding OpenSettingsCommand}" ToolTip.Tip="Settings">
                <PathIcon Data="{StaticResource IcSettings}" Width="15" Height="15" />
              </Button>
            </Grid>
          </StackPanel>

          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <TextBlock Classes="label" Text="LIBRARY" Margin="10,0,0,8" />
          <ListBox x:Name="FolderList" Classes="nav" ItemsSource="{Binding Folders}" SelectedItem="{Binding SelectedFolder}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:FolderViewModel">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ToolTip.Tip="{Binding Tooltip}" Background="Transparent">
                  <Grid.ContextMenu>
                    <ContextMenu IsVisible="{Binding IsRemovable}">
                      <MenuItem Header="Show in file manager" Click="OnRevealFolderClick" />
                      <MenuItem Header="Remove from library" Click="OnRemoveFolderClick" />
                    </ContextMenu>
                  </Grid.ContextMenu>
                  <PathIcon Classes="navicon" Grid.Column="0" Width="15" Height="15" Margin="0,0,10,0"
                            Foreground="{DynamicResource TextDim}"
                            Data="{Binding Kind, Converter={x:Static c:Converters.NavIcon}}" />
                  <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2" Classes="dim" Text="{Binding Count}" FontSize="11" VerticalAlignment="Center" Margin="6,0,0,0" />
                  <Button Grid.Column="3" Classes="ghost remove" Padding="3" Margin="4,-4,-4,-4"
                          IsVisible="{Binding IsRemovable}" ToolTip.Tip="Remove folder"
                          Command="{Binding #Root.((vm:MainViewModel)DataContext).RemoveFolderCommand}"
                          CommandParameter="{Binding}">
                    <PathIcon Data="{StaticResource IcClose}" Width="11" Height="11" Foreground="{DynamicResource TextDim}" />
                  </Button>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
              <StackPanel IsVisible="{Binding ShowCollections}">
                <Grid ColumnDefinitions="*,Auto" Margin="10,22,0,4">
                  <TextBlock Classes="label" Text="COLLECTIONS" VerticalAlignment="Center" />
                  <Button Grid.Column="1" Classes="ghost" Padding="4" ToolTip.Tip="New collection" Command="{Binding NewCollectionCommand}">
                    <PathIcon Data="{StaticResource IcAdd}" Width="12" Height="12" Foreground="{DynamicResource TextDim}" />
                  </Button>
                </Grid>
                <TextBox x:Name="CollectionNameBox" Margin="4,2,4,6" CornerRadius="8" FontSize="12" Watermark="Collection name, then Enter"
                         Text="{Binding CollectionName}" IsVisible="{Binding IsNamingCollection}" KeyDown="OnCollectionNameKeyDown" />
                <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" Margin="10,0,8,4"
                           IsVisible="{Binding !HasCollections}" Text="Group videos from any folders. Right-click a video to add it." />
                <ListBox x:Name="CollectionList" Classes="nav" ItemsSource="{Binding Collections}" SelectedItem="{Binding SelectedCollection}">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:FolderViewModel">
                      <Grid ColumnDefinitions="Auto,*,Auto" ToolTip.Tip="{Binding Tooltip}" Background="Transparent">
                        <Grid.ContextMenu>
                          <ContextMenu>
                            <MenuItem Header="Rename…" Click="OnRenameCollectionClick" />
                            <MenuItem Header="Delete collection" Click="OnDeleteCollectionClick" />
                          </ContextMenu>
                        </Grid.ContextMenu>
                        <PathIcon Classes="navicon" Grid.Column="0" Width="15" Height="15" Margin="0,0,10,0"
                                  Foreground="{DynamicResource TextDim}" Data="{StaticResource IcCollection}" />
                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Classes="dim" Text="{Binding Count}" FontSize="11" VerticalAlignment="Center" Margin="6,0,0,0" />
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </StackPanel>
              <StackPanel IsVisible="{Binding ShowTools}" Margin="0,22,0,0">
                <TextBlock Classes="label" Text="TOOLS" Margin="10,0,0,8" />
                <Button x:Name="CleanupButton" Classes="navbutton" IsVisible="{Binding ShowCleanUp}" Command="{Binding OpenCleanupCommand}"
                        ToolTip.Tip="Find duplicates and broken, empty or very short files">
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <PathIcon Data="{StaticResource IcBroom}" Width="15" Height="15" Foreground="{DynamicResource TextDim}" />
                    <TextBlock Text="Clean up" FontSize="13" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <Button x:Name="StatsButton" Classes="navbutton" IsVisible="{Binding ShowStats}" Command="{Binding OpenStatsCommand}"
                        ToolTip.Tip="Numbers about your library and clips">
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <PathIcon Data="{StaticResource IcStats}" Width="15" Height="15" Foreground="{DynamicResource TextDim}" />
                    <TextBlock Text="Stats" FontSize="13" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
              </StackPanel>
              <TextBlock Classes="label" Text="TAGS" Margin="10,22,0,8" IsVisible="{Binding HasTags}" />
              <ListBox x:Name="TagList" Classes="nav" ItemsSource="{Binding Tags}" SelectedItem="{Binding SelectedTag}" IsVisible="{Binding HasTags}">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:FolderViewModel">
                    <Grid ColumnDefinitions="Auto,*,Auto" ToolTip.Tip="{Binding Tooltip}" Background="Transparent">
                      <TextBlock Classes="navicon" Grid.Column="0" Text="#" FontSize="14" FontWeight="Bold" Width="15" Margin="0,0,10,0"
                                 TextAlignment="Center" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="2" Classes="dim" Text="{Binding Count}" FontSize="11" VerticalAlignment="Center" Margin="6,0,0,0" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
        </Panel>
      </Border>

      <!-- Main pane -->
      <DockPanel Grid.Column="1">
        <!-- Toolbar -->
        <Grid x:Name="Toolbar" DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto,Auto" Margin="28,0,28,0"
              Height="72" Background="Transparent">
          <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2" IsHitTestVisible="False">
            <TextBlock Text="{Binding HeaderTitle}" FontSize="22" FontWeight="Bold" />
            <TextBlock Classes="dim" Text="{Binding HeaderCount}" FontSize="12" />
          </StackPanel>
          <Button Grid.Column="1" Classes="soft" VerticalAlignment="Center" Margin="0,0,10,0" Padding="12,8"
                  IsVisible="{Binding Exports.HasJobs}" ToolTip.Tip="Exports running in the background">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <PathIcon Data="{StaticResource IcExport}" Width="14" Height="14" />
              <TextBlock Text="{Binding Exports.ButtonText}" FontSize="13" />
            </StackPanel>
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedRight">
                <ContentControl Content="{Binding Exports}" />
              </Flyout>
            </Button.Flyout>
          </Button>
          <Panel Grid.Column="2" Width="260" VerticalAlignment="Center" Margin="0,0,10,0">
            <TextBox Classes="search" Watermark="Search names or #tags" Text="{Binding SearchText}" x:Name="SearchBox" />
            <PathIcon Data="{StaticResource IcSearch}" Width="15" Height="15" Foreground="{DynamicResource TextDim}"
                      HorizontalAlignment="Left" Margin="12,0,0,0" IsHitTestVisible="False" />
          </Panel>
          <Button Grid.Column="3" Classes="soft" Classes.on="{Binding HasFilters}" VerticalAlignment="Center" Margin="0,0,8,0" Padding="12,8"
                  ToolTip.Tip="Filter by resolution, length, date or watched">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <PathIcon Data="{StaticResource IcFilter}" Width="14" Height="14" />
              <TextBlock Text="{Binding FilterButtonText}" FontSize="13" />
            </StackPanel>
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedRight">
                <StackPanel Spacing="10" Width="250" Margin="4">
                  <TextBlock Classes="label" Text="FILTERS" />
                  <ComboBox Classes="field" HorizontalAlignment="Stretch" ItemsSource="{x:Static vm:MainViewModel.ResolutionFilters}" SelectedIndex="{Binding FilterResolution}" />
                  <ComboBox Classes="field" HorizontalAlignment="Stretch" ItemsSource="{x:Static vm:MainViewModel.LengthFilters}" SelectedIndex="{Binding FilterLength}" />
                  <ComboBox Classes="field" HorizontalAlignment="Stretch" ItemsSource="{x:Static vm:MainViewModel.DateFilters}" SelectedIndex="{Binding FilterDate}" />
                  <CheckBox Content="Only videos I haven't watched" IsChecked="{Binding FilterUnwatched}" IsVisible="{Binding ShowUnwatchedFilter}" />
                  <Button Classes="ghost" Content="Clear filters" HorizontalAlignment="Right" Command="{Binding ClearFiltersCommand}" IsEnabled="{Binding HasFilters}" />
                </StackPanel>
              </Flyout>
            </Button.Flyout>
          </Button>
          <ComboBox x:Name="SortBox" Grid.Column="4" VerticalAlignment="Center" MinWidth="170" Margin="0,0,6,0"
                    ItemsSource="{x:Static vm:MainViewModel.SortModes}" SelectedIndex="{Binding SortIndex}"
                    CornerRadius="10" Background="{DynamicResource Bg2}" BorderBrush="{DynamicResource Line}" />
          <ToggleButton Grid.Column="5" Classes="ghost" VerticalAlignment="Center" ToolTip.Tip="Select several videos"
                        IsChecked="{Binding IsSelecting}">
            <PathIcon Data="{StaticResource IcSelect}" />
          </ToggleButton>
          <Button Grid.Column="6" Classes="ghost" VerticalAlignment="Center" ToolTip.Tip="Rescan folders"
                  Command="{Binding RescanCommand}">
            <PathIcon Data="{StaticResource IcRefresh}" />
          </Button>
        </Grid>

        <!-- Scan progress strip -->
        <Panel DockPanel.Dock="Top" Height="22" Margin="28,0">
          <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding IsScanning}">
            <ProgressBar Width="140" Height="3" MinHeight="3" Value="{Binding ScanProgress}" VerticalAlignment="Center"
                         IsIndeterminate="{Binding IsScanIndeterminate}" />
            <TextBlock Classes="dim" Text="{Binding ScanStatus}" FontSize="11" VerticalAlignment="Center" />
          </StackPanel>
        </Panel>

        <Panel>
          <!-- Grid of cards (virtualized) -->
          <ScrollViewer x:Name="GridScroller" HorizontalScrollBarVisibility="Disabled">
            <ItemsRepeater x:Name="VideoGrid" ItemsSource="{Binding Videos}" Margin="20,0,20,24">
              <ItemsRepeater.Layout>
                <UniformGridLayout MinItemWidth="250" MinItemHeight="250" MinRowSpacing="6" MinColumnSpacing="6"
                                   ItemsStretch="Fill" />
              </ItemsRepeater.Layout>
              <ItemsRepeater.ItemTemplate>
                <DataTemplate x:DataType="vm:VideoItemViewModel">
                  <Button Classes="card" Padding="8" VerticalAlignment="Top"
                          Command="{Binding #Root.((vm:MainViewModel)DataContext).OpenCommand}"
                          CommandParameter="{Binding}">
                    <Button.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="Play" Click="OnPlayItemClick" />
                        <MenuItem Header="Rename, tag or move…" Click="OnEditItemClick" />
                        <MenuItem Header="Add to / remove from favourites" Click="OnFavoriteItemClick" />
                        <MenuItem Header="{Binding WatchedMenuText}" Click="OnWatchedItemClick" Tag="watched" />
                        <MenuItem Header="Add to collection" Tag="collections" />
                        <MenuItem Header="Remove from this collection" Click="OnRemoveFromCollectionClick" Tag="uncollect" />
                        <MenuItem Header="Reset thumbnail" Click="OnResetThumbnailClick" IsVisible="{Binding HasCustomThumbnail}" />
                        <Separator />
                        <MenuItem Header="Show in file manager" Click="OnRevealItemClick" />
                        <MenuItem Header="Delete…" Click="OnDeleteItemClick" />
                      </ContextMenu>
                    </Button.ContextMenu>
                    <StackPanel Spacing="9">
                      <Panel>
                      <!-- soft glow in the scheme's accent behind the thumbnail; it fades with Opacity, which animates smoothly -->
                      <Border Classes="glow" CornerRadius="9" Background="{DynamicResource Bg2}" BoxShadow="{DynamicResource CardGlow}" IsHitTestVisible="False" />
                      <Border Classes="thumb" CornerRadius="9" ClipToBounds="True" Background="{DynamicResource Bg2}"
                              PointerEntered="OnThumbPointerEntered" PointerMoved="OnThumbPointerMoved" PointerExited="OnThumbPointerExited"
                              Height="{Binding $parent[Button].Bounds.Width, Converter={x:Static c:Converters.SixteenByNine}}">
                        <Panel>
                          <PathIcon Data="{StaticResource IcFilm}" Width="34" Height="34" Foreground="{DynamicResource Line}" />
                          <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                          <Image Source="{Binding ScrubFrame}" Stretch="UniformToFill" IsVisible="{Binding HasScrub}" />
                          <ProgressBar Classes="scrub" VerticalAlignment="Bottom" Height="3" MinHeight="3" CornerRadius="0"
                                       Maximum="1" Value="{Binding ScrubPosition}" IsVisible="{Binding HasScrub}"
                                       Background="#55000000" />
                          <Border Classes="playhint" Background="#66000000" IsVisible="{Binding !HasScrub}">
                            <Border Width="46" Height="46" CornerRadius="23" Background="{DynamicResource Brand}">
                              <PathIcon Data="{StaticResource IcPlay}" Width="20" Height="20" Foreground="{DynamicResource OnAccent}" Margin="3,0,0,0" />
                            </Border>
                          </Border>
                          <Border Classes="ring" Classes.selected="{Binding IsSelected}" CornerRadius="9" BorderThickness="2" BorderBrush="{DynamicResource Brand}" />
                          <Border Classes="selbox" Classes.checked="{Binding IsSelected}" IsVisible="{Binding ShowSelectBox}"
                                  HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8">
                            <PathIcon Data="{StaticResource IcCheck}" Width="13" Height="13" IsVisible="{Binding IsSelected}" />
                          </Border>
                          <Border Classes="badge" Classes.hi="{Binding IsHighRes}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8"
                                  IsVisible="{Binding HasResolution}">
                            <TextBlock Text="{Binding ResolutionBadge}" />
                          </Border>
                          <Border Classes="badge" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8"
                                  IsVisible="{Binding HasDuration}">
                            <TextBlock Text="{Binding DurationText}" />
                          </Border>
                          <ProgressBar VerticalAlignment="Bottom" Height="3" MinHeight="3" CornerRadius="0"
                                       Maximum="1" Value="{Binding Progress}" IsVisible="{Binding HasProgress}"
                                       Background="#55000000" />
                          <!-- favourite marker (always) and quick actions (on hover) -->
                          <Border Classes="badge fav" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" Padding="5"
                                  IsVisible="{Binding IsFavorite}">
                            <PathIcon Data="{StaticResource IcStar}" Width="12" Height="12" Foreground="#FFD166" />
                          </Border>
                          <StackPanel Classes="actions" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6" IsVisible="{Binding !ShowSelectBox}">
                            <Button Classes="mini" Focusable="False" ToolTip.Tip="Rename, tag or move"
                                    Command="{Binding #Root.((vm:MainViewModel)DataContext).BeginEditCommand}" CommandParameter="{Binding}">
                              <PathIcon Data="{StaticResource IcEdit}" Width="13" Height="13" />
                            </Button>
                            <Button Classes="mini" Focusable="False" ToolTip.Tip="Favourite"
                                    Command="{Binding #Root.((vm:MainViewModel)DataContext).ToggleFavoriteCommand}" CommandParameter="{Binding}">
                              <Panel>
                                <PathIcon Data="{StaticResource IcStarOutline}" Width="13" Height="13" IsVisible="{Binding !IsFavorite}" />
                                <PathIcon Data="{StaticResource IcStar}" Width="13" Height="13" Foreground="#FFD166" IsVisible="{Binding IsFavorite}" />
                              </Panel>
                            </Button>
                          </StackPanel>
                          <StackPanel Classes="actions" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="6,6,6,8" IsVisible="{Binding !ShowSelectBox}">
                            <Button Classes="mini del" Focusable="False" ToolTip.Tip="Delete"
                                    Command="{Binding #Root.((vm:MainViewModel)DataContext).RequestDeleteCommand}" CommandParameter="{Binding}">
                              <PathIcon Data="{StaticResource IcDelete}" Width="13" Height="13" />
                            </Button>
                          </StackPanel>
                        </Panel>
                      </Border>
                      </Panel>
                      <StackPanel Spacing="3" Margin="2,0,2,4">
                        <Grid ColumnDefinitions="Auto,*">
                          <Ellipse Width="7" Height="7" Fill="{DynamicResource Accent}" Margin="0,0,7,0" VerticalAlignment="Center"
                                   IsVisible="{Binding ShowUnwatched}" ToolTip.Tip="Not watched yet" />
                          <TextBlock Grid.Column="1" Text="{Binding Title}" ToolTip.Tip="{Binding Entry.Path}" ToolTip.ShowDelay="900" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        </Grid>
                        <TextBlock Classes="dim" Text="{Binding Details}" FontSize="11" TextTrimming="CharacterEllipsis" />
                        <ItemsControl ItemsSource="{Binding Tags}" IsVisible="{Binding HasTags}" Margin="0,3,0,0" Height="20" ClipToBounds="True">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                              <Border Classes="tag"><TextBlock Text="{Binding}" /></Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
          </ScrollViewer>

          <!-- Empty: no folders yet -->
          <StackPanel IsVisible="{Binding HasNoFolders}" HorizontalAlignment="Center" VerticalAlignment="Center"
                      Spacing="14" MaxWidth="380" Margin="0,0,0,60">
            <Border Width="72" Height="72" CornerRadius="20" Background="{DynamicResource Bg2}" HorizontalAlignment="Center">
              <PathIcon Data="{StaticResource IcLibrary}" Width="32" Height="32" Foreground="{DynamicResource Cyan}" />
            </Border>
            <TextBlock Text="Build your library" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" />
            <TextBlock Classes="dim" TextAlignment="Center" TextWrapping="Wrap" FontSize="13"
                       Text="Add the folders where you keep videos. Cnema scans them (including subfolders), builds thumbnails, and keeps watching for new files." />
            <Button Classes="accent" HorizontalAlignment="Center" Command="{Binding AddFolderCommand}" Margin="0,6,0,0">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <PathIcon Data="{StaticResource IcAdd}" Width="14" Height="14" />
                <TextBlock Text="Add a folder" />
              </StackPanel>
            </Button>
          </StackPanel>

          <!-- Empty: nothing matches -->
          <StackPanel IsVisible="{Binding HasNoResults}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6" Margin="0,0,0,60">
            <TextBlock Text="No videos here" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <TextBlock Classes="dim" Text="Try another folder or search term." FontSize="13" HorizontalAlignment="Center" />
            <Button Classes="soft" Content="Clear filters" HorizontalAlignment="Center" Margin="0,8,0,0"
                    IsVisible="{Binding HasFilters}" Command="{Binding ClearFiltersCommand}" />
          </StackPanel>

          <!-- Bulk actions while selecting -->
          <Border Classes="bulkbar" IsVisible="{Binding IsSelecting}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,22">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="{Binding SelectionText}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" Margin="6,0,10,0" MinWidth="70" />
              <Button Classes="ghost" Content="Select all" Command="{Binding SelectAllCommand}" />
              <Border Width="1" Background="{DynamicResource Line}" Margin="4,6" />
              <Button Classes="ghost" ToolTip.Tip="Favourite" Command="{Binding BulkFavoriteCommand}">
                <PathIcon Data="{StaticResource IcStarOutline}" Width="15" Height="15" />
              </Button>
              <Button x:Name="BulkTagButton" Classes="ghost" Content="Tag…">
                <Button.Flyout>
                  <Flyout Placement="Top">
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="2">
                      <TextBox Text="{Binding BulkTag}" Watermark="Tag" Width="160" CornerRadius="8" KeyDown="OnBulkTagKeyDown" />
                      <Button Classes="accent" Content="Add" Command="{Binding BulkAddTagCommand}" Click="OnBulkFlyoutDone" />
                    </StackPanel>
                  </Flyout>
                </Button.Flyout>
              </Button>
              <Button x:Name="BulkCollectionButton" Classes="ghost" Content="Collection…" IsVisible="{Binding ShowCollections}">
                <Button.Flyout>
                  <Flyout Placement="Top">
                    <StackPanel Spacing="2" MinWidth="200" Margin="2">
                      <ItemsControl ItemsSource="{Binding Collections}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:FolderViewModel">
                            <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Content="{Binding Name}"
                                    Command="{Binding #Root.((vm:MainViewModel)DataContext).BulkAddToCollectionCommand}" CommandParameter="{Binding}" Click="OnBulkFlyoutDone" />
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Content="New collection…"
                              Command="{Binding BulkNewCollectionCommand}" Click="OnBulkFlyoutDone" />
                    </StackPanel>
                  </Flyout>
                </Button.Flyout>
              </Button>
              <Button Classes="ghost" Content="Watched…" IsVisible="{Binding ShowUnwatchedFilter}">
                <Button.Flyout>
                  <MenuFlyout Placement="Top">
                    <MenuItem Header="Mark as watched" Command="{Binding BulkMarkWatchedCommand}" />
                    <MenuItem Header="Mark as unwatched" Command="{Binding BulkMarkUnwatchedCommand}" />
                  </MenuFlyout>
                </Button.Flyout>
              </Button>
              <Button Classes="ghost" ToolTip.Tip="Delete" Command="{Binding BulkDeleteCommand}">
                <PathIcon Data="{StaticResource IcDelete}" Width="15" Height="15" Foreground="{DynamicResource Danger}" />
              </Button>
              <Border Width="1" Background="{DynamicResource Line}" Margin="4,6" />
              <Button Classes="accent" Content="Done" Command="{Binding ToggleSelectModeCommand}" />
            </StackPanel>
          </Border>
        </Panel>
      </DockPanel>
    </Grid>

    <!-- ======================= QUICK PLAYER ======================= -->
    <!-- Plain playback over the library, almost window-sized; Edit opens the same video in the full editor.
         (Called the mini player in code: it started out as a small corner player.) -->
    <Panel IsVisible="{Binding #Root.((vm:MainViewModel)DataContext).IsMiniPlayerOpen}">
      <Border x:Name="MiniScrim" Background="#99050609" />
      <Border x:Name="MiniPlayer" Classes="miniplayer" Margin="48,56,48,40"
              DataContext="{Binding Player}" x:DataType="vm:PlayerViewModel">
        <DockPanel>
          <StackPanel DockPanel.Dock="Bottom" Margin="14,2,14,12" Spacing="2">
            <c:TrimTimeline Duration="{Binding Duration}" Position="{Binding Position}"
                            InPoint="{Binding InPoint}" OutPoint="{Binding OutPoint}"
                            SeekCommand="{Binding SeekCommand}" Accent="{DynamicResource Accent}" RangeBrush="{DynamicResource Cyan}"
                            Segments="{Binding SegmentRanges}" Markers="{Binding Markers}" />
            <Grid ColumnDefinitions="Auto,*,Auto">
              <StackPanel Orientation="Horizontal" Spacing="0" VerticalAlignment="Center">
                <Button Classes="ghost" Focusable="False" Command="{Binding SkipBackCommand}" ToolTip.Tip="Back 5 s (Shift+←)" Padding="6">
                  <PathIcon Data="{StaticResource IcRewind}" Width="15" Height="15" />
                </Button>
                <Button Classes="ghost" Focusable="False" Command="{Binding TogglePlayCommand}" ToolTip.Tip="Play / pause (Space)" Padding="6">
                  <Panel>
                    <PathIcon Data="{StaticResource IcPlay}" Width="18" Height="18" IsVisible="{Binding !IsPlaying}" />
                    <PathIcon Data="{StaticResource IcPause}" Width="18" Height="18" IsVisible="{Binding IsPlaying}" />
                  </Panel>
                </Button>
                <Button Classes="ghost" Focusable="False" Command="{Binding SkipForwardCommand}" ToolTip.Tip="Forward 5 s (Shift+→)" Padding="6">
                  <PathIcon Data="{StaticResource IcForward}" Width="15" Height="15" />
                </Button>
                <Button Classes="ghost" Focusable="False" Command="{Binding ToggleMuteCommand}" ToolTip.Tip="Mute (M)" Padding="6">
                  <Panel>
                    <PathIcon Data="{StaticResource IcVolume}" Width="15" Height="15" IsVisible="{Binding !IsMuted}" />
                    <PathIcon Data="{StaticResource IcMute}" Width="15" Height="15" IsVisible="{Binding IsMuted}" />
                  </Panel>
                </Button>
              </StackPanel>
              <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center" Spacing="1">
                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Title}" />
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <TextBlock Classes="dim mono" Text="{Binding PositionText}" FontSize="11" />
                  <TextBlock Classes="dim mono" Text="/" FontSize="11" />
                  <TextBlock Classes="dim mono" Text="{Binding DurationText}" FontSize="11" />
                  <TextBlock Classes="dim" Text="{Binding RateText}" FontSize="11" Margin="4,0,0,0" IsVisible="{Binding IsRateChanged}" />
                </StackPanel>
              </StackPanel>
              <Button Grid.Column="2" Classes="accent" Focusable="False" Padding="14,7" VerticalAlignment="Center"
                      ToolTip.Tip="Open in the editor: trim, export and share"
                      Command="{Binding #Root.((vm:MainViewModel)DataContext).ExpandMiniPlayerCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Data="{StaticResource IcEdit}" Width="13" Height="13" Foreground="{DynamicResource OnAccent}" />
                  <TextBlock Text="Edit" FontSize="12" />
                </StackPanel>
              </Button>
            </Grid>
          </StackPanel>
          <Panel Background="Black">
            <c:VideoSurface x:Name="MiniSurface" Frames="{Binding Frames}"
                          SourceWidth="{Binding VideoWidth}" SourceHeight="{Binding VideoHeight}" />
            <Border x:Name="MiniHit" Background="Transparent" ToolTip.Tip="Click to play or pause, double-click to edit" ToolTip.ShowDelay="1200" />
            <Border IsVisible="{Binding Toast, Converter={x:Static ObjectConverters.IsNotNull}}" IsHitTestVisible="False"
                    HorizontalAlignment="Center" VerticalAlignment="Top" Margin="48,16,48,0"
                    Background="#E614151B" CornerRadius="10" Padding="14,8" BorderBrush="{DynamicResource Line}" BorderThickness="1">
              <TextBlock Text="{Binding Toast}" FontSize="13" TextWrapping="Wrap" />
            </Border>
            <Button Classes="mini" Focusable="False" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10" ToolTip.Tip="Close (Esc)"
                    Command="{Binding #Root.((vm:MainViewModel)DataContext).CloseMiniPlayerCommand}">
              <PathIcon Data="{StaticResource IcClose}" Width="12" Height="12" />
            </Button>
          </Panel>
        </DockPanel>
      </Border>
    </Panel>

    <!-- ======================= EDIT DETAILS ======================= -->
    <Border x:Name="EditScrim" Background="#B3050609" IsVisible="{Binding IsEditing}">
      <Border Width="460" VerticalAlignment="Center" HorizontalAlignment="Center" Background="{DynamicResource Bg1}"
              BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="16" Padding="22"
              BoxShadow="0 18 60 0 #80000000" DataContext="{Binding Editor}" x:DataType="vm:EditViewModel" x:Name="EditCard">
        <StackPanel Spacing="14">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Edit details" FontSize="17" FontWeight="Bold" VerticalAlignment="Center" />
            <ToggleButton Grid.Column="1" Classes="ghost" IsChecked="{Binding Favorite}" ToolTip.Tip="Favourite">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource IcStar}" Width="14" Height="14" />
                <TextBlock Text="Favourite" FontSize="12" FontWeight="SemiBold" />
              </StackPanel>
            </ToggleButton>
          </Grid>

          <StackPanel Spacing="6">
            <TextBlock Classes="label" Text="FILE NAME" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBox x:Name="EditName" Text="{Binding Name}" CornerRadius="8" />
              <TextBlock Grid.Column="1" Classes="dim mono" Text="{Binding Extension}" VerticalAlignment="Center" Margin="8,0,0,0" />
            </Grid>
            <TextBlock Classes="dim" FontSize="11" Text="Renames the actual file on disk." />
          </StackPanel>

          <StackPanel Spacing="6" IsVisible="{Binding CanMove}">
            <TextBlock Classes="label" Text="LIBRARY FOLDER" />
            <ComboBox ItemsSource="{Binding Folders}" SelectedItem="{Binding Folder}" HorizontalAlignment="Stretch" CornerRadius="8">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:FolderViewModel">
                  <TextBlock Text="{Binding Name}" ToolTip.Tip="{Binding Path}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Classes="dim" FontSize="11" Text="Picking another folder moves the file there." />
          </StackPanel>

          <StackPanel Spacing="8">
            <TextBlock Classes="label" Text="TAGS" />
            <ItemsControl ItemsSource="{Binding Tags}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <Border Classes="tag big">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                      <Button Classes="ghost" Padding="2" Click="OnRemoveTagClick" ToolTip.Tip="Remove tag">
                        <PathIcon Data="{StaticResource IcClose}" Width="9" Height="9" />
                      </Button>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBox x:Name="EditTagInput" Text="{Binding TagInput}" Watermark="Add a tag and press Enter" CornerRadius="8" />
            <ItemsControl ItemsSource="{Binding Suggestions}" IsVisible="{Binding HasSuggestions}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <Button Classes="suggest" Click="OnSuggestedTagClick">
                    <TextBlock Text="{Binding StringFormat='+ {0}'}" />
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <TextBlock Text="{Binding Error}" Foreground="{DynamicResource Danger}" FontSize="12" TextWrapping="Wrap"
                     IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />

          <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,4,0,0">
            <Button Classes="ghost" Content="Delete…" FontSize="12" Foreground="{DynamicResource Danger}"
                    Command="{Binding #Root.((vm:MainViewModel)DataContext).RequestDeleteCommand}" CommandParameter="{Binding Item}" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
              <Button Classes="soft" Content="Cancel" Command="{Binding #Root.((vm:MainViewModel)DataContext).CancelEditCommand}" />
              <Button Classes="accent" Content="Save" Command="{Binding #Root.((vm:MainViewModel)DataContext).SaveEditCommand}" />
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>
    </Border>

    <!-- ======================= DELETE CONFIRMATION ======================= -->
    <Border x:Name="DeleteScrim" Background="#B3050609" IsVisible="{Binding IsConfirmingDelete}">
      <Border Width="420" VerticalAlignment="Center" HorizontalAlignment="Center" Background="{DynamicResource Bg1}"
              BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="16" Padding="22" BoxShadow="0 18 60 0 #80000000">
        <StackPanel Spacing="12">
          <TextBlock Text="{Binding DeleteTitle}" FontSize="17" FontWeight="Bold" />
          <TextBlock Text="{Binding DeletePrompt}" TextWrapping="Wrap" FontSize="13" />
          <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" Text="{Binding DeleteHint}" />
          <TextBlock Text="{Binding DeleteError}" Foreground="{DynamicResource Danger}" FontSize="12" TextWrapping="Wrap"
                     IsVisible="{Binding DeleteError, Converter={x:Static ObjectConverters.IsNotNull}}" />
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,4,0,0">
            <Button x:Name="DeleteCancel" Classes="soft" Content="Cancel" Command="{Binding CancelDeleteCommand}" />
            <Button Classes="danger" Content="Move to trash" Command="{Binding ConfirmDeleteCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>

    <!-- ======================= WHAT'S NEW ======================= -->
    <Border x:Name="WhatsNewScrim" Background="#B3050609" IsVisible="{Binding IsShowingWhatsNew}">
      <Border Width="520" MaxHeight="620" VerticalAlignment="Center" HorizontalAlignment="Center" Background="{DynamicResource Bg1}"
              BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="16" Padding="22" BoxShadow="0 18 60 0 #80000000">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="{Binding WhatsNewTitle}" FontSize="17" FontWeight="Bold" Margin="0,0,0,12" />
          <Button x:Name="WhatsNewClose" DockPanel.Dock="Bottom" Classes="accent" Content="Got it" HorizontalAlignment="Right"
                  Margin="0,14,0,0" Command="{Binding CloseWhatsNewCommand}" />
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding WhatsNew}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="svc:ChangelogEntry">
                  <StackPanel Spacing="6" Margin="0,0,12,16">
                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Cyan}" />
                    <ItemsControl ItemsSource="{Binding Items}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                          <Grid ColumnDefinitions="14,*" Margin="0,2">
                            <TextBlock Text="•" Classes="dim" FontSize="13" />
                            <TextBlock Grid.Column="1" Text="{Binding}" FontSize="13" TextWrapping="Wrap" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Border>

    <!-- ======================= CLEAN UP ======================= -->
    <Border x:Name="CleanupScrim" Background="#B3050609" IsVisible="{Binding IsCleaningUp}">
      <Border Width="640" MaxHeight="720" Margin="0,40" VerticalAlignment="Center" HorizontalAlignment="Center" Background="{DynamicResource Bg1}"
              BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="16" BoxShadow="0 18 60 0 #80000000"
              DataContext="{Binding Cleanup}" x:DataType="vm:CleanupViewModel">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="24,22,24,12">
            <TextBlock Text="Clean up" FontSize="17" FontWeight="Bold" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <ProgressBar IsIndeterminate="True" Width="80" Height="3" MinHeight="3" VerticalAlignment="Center" IsVisible="{Binding IsScanning}" />
              <TextBlock Classes="dim" FontSize="12" TextWrapping="Wrap" MaxWidth="560" Text="{Binding Summary}" />
            </StackPanel>
          </StackPanel>
          <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="24,14">
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
              <Button x:Name="CleanupClose" Classes="soft" Content="Close" Command="{Binding #Root.((vm:MainViewModel)DataContext).CloseCleanupCommand}" />
              <!-- TextBlock content: a bound string Content kept its first measured width when the text grew -->
              <Button Classes="danger" IsEnabled="{Binding CanRemove}"
                      Command="{Binding #Root.((vm:MainViewModel)DataContext).RemoveCleanupCommand}">
                <TextBlock Text="{Binding RemoveText}" />
              </Button>
            </StackPanel>
          </Border>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Rows}" Margin="24,0,24,16">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:CleanupRow">
                  <Border Classes="cleanrow" Classes.kept="{Binding IsKept}">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Center" MinWidth="0" Margin="0,0,8,0" />
                      <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Classes="dim" Text="{Binding Details}" FontSize="11" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                      <TextBlock Grid.Column="2" Text="{Binding Reason}" FontSize="11" Foreground="{DynamicResource Cyan}"
                                 VerticalAlignment="Center" Margin="10,0,0,0" MaxWidth="200" TextTrimming="CharacterEllipsis" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Border>

    <!-- ======================= STATS ======================= -->
    <Border x:Name="StatsScrim" Background="#B3050609" IsVisible="{Binding IsShowingStats}">
      <Border Width="640" MaxHeight="720" Margin="0,40" VerticalAlignment="Center" HorizontalAlignment="Center" Background="{DynamicResource Bg1}"
              BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="16" BoxShadow="0 18 60 0 #80000000"
              DataContext="{Binding Stats}" x:DataType="vm:StatsViewModel">
        <DockPanel>
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="24,22,24,12">
            <TextBlock Text="Stats" FontSize="17" FontWeight="Bold" VerticalAlignment="Center" />
            <Button x:Name="StatsClose" Grid.Column="1" Classes="ghost" Padding="6" Command="{Binding #Root.((vm:MainViewModel)DataContext).CloseStatsCommand}">
              <PathIcon Data="{StaticResource IcClose}" Width="13" Height="13" />
            </Button>
          </Grid>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="18" Margin="24,0,24,24">
              <ItemsControl ItemsSource="{Binding Tiles}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:StatTile">
                    <Border Classes="tile">
                      <StackPanel Spacing="2">
                        <TextBlock Text="{Binding Value}" FontSize="22" FontWeight="Bold" />
                        <TextBlock Classes="dim" Text="{Binding Label}" FontSize="12" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <StackPanel Spacing="8">
                <TextBlock Classes="label" Text="CLIPS PER WEEK" />
                <Border Classes="group" Padding="16,14">
                  <ItemsControl ItemsSource="{Binding Weeks}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:StatBar">
                        <StackPanel Spacing="4" VerticalAlignment="Bottom">
                          <TextBlock Classes="dim" Text="{Binding Count}" FontSize="11" HorizontalAlignment="Center" />
                          <Border Height="{Binding Height}" Width="26" CornerRadius="4" Background="{DynamicResource Accent}" HorizontalAlignment="Center" />
                          <TextBlock Classes="dim" Text="{Binding Label}" FontSize="10" HorizontalAlignment="Center" />
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Border>
              </StackPanel>

              <StackPanel Spacing="8" IsVisible="{Binding HasGames}">
                <TextBlock Classes="label" Text="CLIPS PER GAME" />
                <Border Classes="group" Padding="16,12">
                  <ItemsControl ItemsSource="{Binding Games}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:StatBar">
                        <Grid ColumnDefinitions="150,*,Auto" Margin="0,4">
                          <TextBlock Text="{Binding Label}" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                          <Border Grid.Column="1" Height="10" Width="{Binding Width}" CornerRadius="5" Background="{DynamicResource Cyan}"
                                  HorizontalAlignment="Left" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="2" Classes="dim" Text="{Binding Count}" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Border>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Border>

    <!-- ======================= KEYBOARD SHORTCUTS ======================= -->
    <Border x:Name="ShortcutsScrim" Background="#B3050609" IsVisible="{Binding IsShowingShortcuts}">
      <Border Width="560" MaxHeight="700" Margin="0,40" VerticalAlignment="Center" HorizontalAlignment="Center" Background="{DynamicResource Bg1}"
              BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="16" BoxShadow="0 18 60 0 #80000000"
              DataContext="{Binding ShortcutSheet}" x:DataType="vm:ShortcutsViewModel">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="24,22,24,12">
            <TextBlock Text="Keyboard shortcuts" FontSize="17" FontWeight="Bold" />
            <TextBlock Classes="dim" FontSize="12" TextWrapping="Wrap" Text="Click a key to change it." />
          </StackPanel>
          <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="24,14">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Button Classes="ghost" Content="Reset all" FontSize="12" Command="{Binding ResetAllCommand}" />
              <TextBlock Grid.Column="1" Text="{Binding Message}" Foreground="{DynamicResource Cyan}" FontSize="12" TextWrapping="Wrap"
                         VerticalAlignment="Center" Margin="12,0" />
              <Button x:Name="ShortcutsClose" Grid.Column="2" Classes="accent" Content="Done"
                      Command="{Binding #Root.((vm:MainViewModel)DataContext).CloseShortcutsCommand}" />
            </Grid>
          </Border>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Groups}" Margin="24,0,24,16">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ShortcutGroup">
                  <StackPanel Spacing="6" Margin="0,0,0,14">
                    <TextBlock Classes="label" Text="{Binding Name}" />
                    <Border Classes="group">
                      <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:ShortcutRow">
                            <Grid ColumnDefinitions="*,Auto,Auto" Margin="14,5">
                              <TextBlock Text="{Binding Label}" FontSize="13" VerticalAlignment="Center" />
                              <Button Grid.Column="1" Classes="keychip" Classes.capturing="{Binding IsCapturing}" Classes.custom="{Binding IsCustom}"
                                      Content="{Binding Keys}" IsEnabled="{Binding !IsFixed}"
                                      Command="{Binding #Root.((vm:MainViewModel)DataContext).ShortcutSheet.CaptureCommand}" CommandParameter="{Binding}" />
                              <Button Grid.Column="2" Classes="ghost" Margin="4,0,0,0" Padding="6" ToolTip.Tip="Back to the default key"
                                      IsVisible="{Binding IsCustom}"
                                      Command="{Binding #Root.((vm:MainViewModel)DataContext).ShortcutSheet.ResetCommand}" CommandParameter="{Binding}">
                                <PathIcon Data="{StaticResource IcRefresh}" Width="12" Height="12" />
                              </Button>
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Border>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Border>

    <!-- ======================= FIRST-RUN SETUP ======================= -->
    <Border x:Name="SetupScrim" Background="#E6050609" IsVisible="{Binding IsSetupOpen}">
      <Border Width="560" MaxHeight="720" Margin="0,40" VerticalAlignment="Center" HorizontalAlignment="Center" Background="{DynamicResource Bg1}"
              BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="16" BoxShadow="0 18 60 0 #80000000">
        <DockPanel>
          <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="24,14">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center"
                         Text="You can change all of this later in Settings." />
              <Button x:Name="SetupDone" Grid.Column="1" Classes="accent" Content="Start using Cnema" Command="{Binding FinishSetupCommand}" />
            </Grid>
          </Border>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12" Margin="24,24,24,18">
              <StackPanel Spacing="4">
                <TextBlock Text="Welcome to Cnema" FontSize="22" FontWeight="Bold" />
                <TextBlock Classes="dim" FontSize="13" TextWrapping="Wrap"
                           Text="A few choices to make it yours. Nothing here is required." />
              </StackPanel>

              <TextBlock Classes="label" Text="LOOK" Margin="0,6,0,0" />
              <ListBox Classes="swatches" ItemsSource="{Binding ColorSchemes}" SelectedItem="{Binding SetupScheme}">
                <ListBox.ItemsPanel>
                  <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="svc:ColorScheme">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Ellipse Width="14" Height="14" VerticalAlignment="Center" Fill="{Binding Accent}" />
                      <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="12" />
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>

              <TextBlock Classes="label" Text="YOUR VIDEOS" Margin="0,6,0,0" />
              <Border Classes="group">
                <Grid Classes="row" ColumnDefinitions="*,Auto">
                  <TextBlock Text="{Binding SetupFolders}" TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center" />
                  <Button Grid.Column="1" Classes="soft" Content="Add a folder…" Margin="10,0,0,0" Command="{Binding SetupAddFolderCommand}" />
                </Grid>
              </Border>

              <TextBlock Classes="label" Text="FEATURES" Margin="0,6,0,0" />
              <Border Classes="group">
                <StackPanel Margin="14,8" Spacing="2">
                  <CheckBox IsChecked="{Binding SetupClipping}" Content="Background clipping: save past moments with a hotkey" />
                  <CheckBox IsChecked="{Binding SetupSessions}" IsEnabled="{Binding SetupClipping}" Content="Session recording: record a whole session as one video" />
                  <CheckBox IsChecked="{Binding SetupController}" Content="Controller support, for handhelds and TVs" />
                  <CheckBox IsChecked="{Binding SetupHoverPreview}" Content="Hover preview: skim a video by moving the pointer over it" />
                  <CheckBox IsChecked="{Binding SetupLoudMarkers}" Content="Loud moment markers on the timeline" />
                  <CheckBox IsChecked="{Binding SetupHoverGlow}" Content="Hover glow around videos" />
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Border>

    <!-- ======================= SETTINGS ======================= -->
    <Border x:Name="SettingsScrim" Background="#B3050609" IsVisible="{Binding IsSettingsOpen}" ZIndex="10">
      <Border Width="580" MaxHeight="720" Margin="0,40" VerticalAlignment="Stretch" HorizontalAlignment="Center"
              Background="{DynamicResource Bg1}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="16"
              BoxShadow="0 18 60 0 #80000000" DataContext="{Binding SettingsEditor}" x:DataType="vm:SettingsViewModel">
        <DockPanel>
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="24,22,24,10">
            <TextBlock Text="Settings" FontSize="17" FontWeight="Bold" />
            <TextBlock Grid.Column="1" Classes="dim" FontSize="11" VerticalAlignment="Center"
                       Text="{Binding #Root.((vm:MainViewModel)DataContext).VersionText}" />
          </Grid>
          <ListBox DockPanel.Dock="Top" Classes="tabs" Margin="20,0,20,8" ItemsSource="{x:Static vm:SettingsViewModel.PageNames}"
                   SelectedIndex="{Binding Page}" />

          <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="24,14">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <Button Classes="ghost" Content="Quit Cnema" Click="OnQuitClick" FontSize="12"
                        ToolTip.Tip="Stops clipping and closes Cnema completely" />
                <Button Classes="ghost" Content="Copy diagnostics" FontSize="12"
                        Command="{Binding #Root.((vm:MainViewModel)DataContext).CopyDiagnosticsCommand}"
                        ToolTip.Tip="Copies version, hardware, settings and the recent log, for reporting a problem" />
              </StackPanel>
              <TextBlock Grid.Column="1" Text="{Binding Error}" Foreground="{DynamicResource Danger}" FontSize="12" TextWrapping="Wrap"
                         VerticalAlignment="Center" Margin="12,0" />
              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                <Button Classes="soft" Content="Cancel" Command="{Binding #Root.((vm:MainViewModel)DataContext).CancelSettingsCommand}" />
                <Button Classes="accent" Content="Save" Command="{Binding #Root.((vm:MainViewModel)DataContext).SaveSettingsCommand}" />
              </StackPanel>
            </Grid>
          </Border>

          <ScrollViewer x:Name="SettingsScroll" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12" Margin="24,4,24,20">

              <!-- ==== General ==== -->
              <StackPanel Spacing="12" IsVisible="{Binding IsGeneralPage}">
              <TextBlock Classes="label" Text="APPEARANCE" />
              <Border Classes="group">
                <Grid Classes="row" ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="2">
                    <TextBlock Text="Color scheme" />
                    <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" Text="Aurora is the original look with gradients." />
                  </StackPanel>
                  <ComboBox Grid.Column="1" MinWidth="190" CornerRadius="8" ItemsSource="{Binding ColorSchemes}" SelectedItem="{Binding ColorScheme}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="svc:ColorScheme">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <Ellipse Width="12" Height="12" VerticalAlignment="Center" Fill="{Binding Accent}" />
                          <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                        </StackPanel>
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </Grid>
              </Border>

              <TextBlock Classes="label" Text="STARTUP" Margin="0,8,0,0" />
              <Border Classes="group">
                <StackPanel>
                  <Grid Classes="row" ColumnDefinitions="*,Auto">
                    <TextBlock Text="Launch Cnema when I log in" />
                    <ToggleSwitch x:Name="SettingsFirst" Grid.Column="1" Classes="bare" IsChecked="{Binding LaunchAtLogin}" />
                  </Grid>
                  <Border Classes="sep" />
                  <Grid Classes="row" ColumnDefinitions="*,Auto">
                    <TextBlock Text="Tell me when a new version is out" />
                    <ToggleSwitch Grid.Column="1" Classes="bare" IsChecked="{Binding CheckForUpdates}" />
                  </Grid>
                  <Border Classes="sep" />
                  <Grid Classes="row" ColumnDefinitions="*,Auto" IsEnabled="{Binding CheckForUpdates}">
                    <StackPanel Spacing="2">
                      <TextBlock Text="Install updates automatically" />
                      <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" Text="When Cnema starts and finds a newer version, it installs it and restarts." />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" Classes="bare" IsChecked="{Binding AutoUpdate}" />
                  </Grid>
                  <Border Classes="sep" />
                  <Grid Classes="row" ColumnDefinitions="*,Auto,Auto,Auto">
                    <StackPanel Spacing="2">
                      <TextBlock Text="{Binding #Root.((vm:MainViewModel)DataContext).VersionText}" />
                      <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap"
                                 Text="{Binding #Root.((vm:MainViewModel)DataContext).UpdateStatus}" />
                    </StackPanel>
                    <Button Grid.Column="1" Classes="accent" Margin="0,0,8,0"
                            Content="{Binding #Root.((vm:MainViewModel)DataContext).UpdateAction}"
                            IsVisible="{Binding #Root.((vm:MainViewModel)DataContext).HasUpdate}"
                            Command="{Binding #Root.((vm:MainViewModel)DataContext).OpenUpdateCommand}" />
                    <Button Grid.Column="2" Classes="soft" Content="What's new" Margin="0,0,8,0"
                            Command="{Binding #Root.((vm:MainViewModel)DataContext).ShowChangelogCommand}" />
                    <Button Grid.Column="3" Classes="soft" Content="Check now"
                            Command="{Binding #Root.((vm:MainViewModel)DataContext).CheckForUpdatesNowCommand}" />
                  </Grid>
                  <Border Classes="sep" />
                  <Grid Classes="row" ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="2">
                      <TextBlock Text="{Binding BackgroundLabel}" TextWrapping="Wrap" />
                      <TextBlock Classes="dim" FontSize="11" Text="Always on while clipping is enabled." />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" Classes="bare" IsChecked="{Binding KeepInBackground}" />
                  </Grid>
                </StackPanel>
              </Border>

              <TextBlock Classes="label" Text="DISCORD" Margin="0,8,0,0" IsVisible="{Binding CanShowDiscord}" />
              <Border Classes="group" IsVisible="{Binding CanShowDiscord}">
                <StackPanel>
                  <Grid Classes="row" ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="2" Margin="0,0,12,0">
                      <TextBlock Text="Show what I'm doing in Discord" />
                      <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap"
                                 Text="Your Discord profile shows Cnema while the window is open: browsing, watching or editing clips, or recording a session. Needs the Discord app on this computer." />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" Classes="bare" IsChecked="{Binding DiscordStatus}" />
                  </Grid>
                  <StackPanel IsVisible="{Binding DiscordStatus}">
                    <Border Classes="sep" />
                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                      <TextBlock Text="Include the video's name" />
                      <ToggleSwitch Grid.Column="1" Classes="bare" IsChecked="{Binding DiscordShowNames}" />
                    </Grid>
                  </StackPanel>
                </StackPanel>
              </Border>

              <TextBlock Classes="label" Text="CONTROLLER" Margin="0,8,0,0" IsVisible="{Binding FeatureController}" />
              <Border Classes="group" IsVisible="{Binding FeatureController}">
                <StackPanel>
                  <Grid Classes="row" ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="2">
                      <TextBlock Text="Controller mode" />
                      <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap"
                                 Text="Bigger layout and full gamepad navigation, for handhelds and TVs." />
                      <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource Cyan}"
                                 Text="{Binding #Root.((vm:MainViewModel)DataContext).PadStatus}"
                                 IsVisible="{Binding #Root.((vm:MainViewModel)DataContext).IsControllerMode}" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" Classes="bare" IsChecked="{Binding ControllerMode}" />
                  </Grid>
                  <Border Classes="sep" />
                  <Grid Classes="row" ColumnDefinitions="*,Auto">
                    <TextBlock Text="Open full screen in Controller mode" />
                    <ToggleSwitch Grid.Column="1" Classes="bare" IsChecked="{Binding ControllerFullscreen}" />
                  </Grid>
                </StackPanel>
              </Border>

              <TextBlock Classes="label" Text="KEYBOARD" Margin="0,8,0,0" />
              <Border Classes="group">
                <Grid Classes="row" ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="2">
                    <TextBlock Text="Keyboard shortcuts" />
                    <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" Text="See every shortcut and change any of them. Press ? anywhere to open the list." />
                  </StackPanel>
                  <Button Grid.Column="1" Classes="soft" Content="Shortcuts…"
                          Command="{Binding #Root.((vm:MainViewModel)DataContext).ShowShortcutsCommand}" />
                </Grid>
              </Border>

              <TextBlock Classes="label" Text="BACKUP" Margin="0,8,0,0" />
              <Border Classes="group">
                <StackPanel>
                  <Grid Classes="row" ColumnDefinitions="*,Auto,Auto">
                    <StackPanel Spacing="2">
                      <TextBlock Text="Settings file" />
                      <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" Text="Save all settings to a file, or load them on another computer." />
                    </StackPanel>
                    <Button Grid.Column="1" Classes="soft" Content="Export…" Margin="0,0,8,0"
                            Command="{Binding #Root.((vm:MainViewModel)DataContext).ExportSettingsCommand}" />
                    <Button Grid.Column="2" Classes="soft" Content="Import…"
                            Command="{Binding #Root.((vm:MainViewModel)DataContext).ImportSettingsCommand}" />
                  </Grid>
                  <Border Classes="sep" />
                  <Grid Classes="row" ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="2">
                      <TextBlock Text="Portable mode" />
                      <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" Text="{Binding PortableStatus}" />
                      <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource Cyan}" Text="{Binding PortableMessage}"
                                 IsVisible="{Binding PortableMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    </StackPanel>
                    <Panel Grid.Column="1">
                      <Button Classes="soft" Content="Make portable" Command="{Binding MakePortableCommand}" IsVisible="{Binding !IsPortable}" />
                      <Button Classes="soft" Content="Show folder" Command="{Binding ShowPortableFolderCommand}" IsVisible="{Binding IsPortable}" />
                    </Panel>
                  </Grid>
                </StackPanel>
              </Border>
              </StackPanel>

              <!-- ==== Features ==== -->
              <StackPanel Spacing="12" IsVisible="{Binding IsFeaturesPage}">
                <TextBlock Classes="dim" FontSize="12" TextWrapping="Wrap" Margin="4,0"
                           Text="Switch off anything you don't use. Its buttons and settings disappear, and it stops running." />
                <Border Classes="group">
                  <StackPanel>
                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="2">
                        <TextBlock Text="Background clipping" />
                        <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" Text="Keep the last moments of your screen and save them with a hotkey." />
                      </StackPanel>
                      <ToggleSwitch Grid.Column="1" Classes="bare" IsChecked="{Binding FeatureClipping}" />
                    </Grid>
                    <Border Classes="sep" />
                    <Grid Classes="row" ColumnDefinitions="*,Auto" IsEnabled="{Binding FeatureClipping}">
                      <StackPanel Spacing="2">
                        <TextBlock Text="Session recording" />
                        <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" Text="Record a whole session as one video, with bookmarks from the clip hotkey." />
                      </StackPanel>
                      <ToggleSwitch Grid.Column="1" Classes="bare" IsChecked="{Binding FeatureSessions}" />
                    </Grid>
                    <Border Classes="sep" />
                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="2">
                        <TextBlock Text="Controller support" />
                        <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" Text="Controller mode, for handhelds and TVs." />
                      </StackPanel>
                      <ToggleSwitch Grid.Column="1" Classes="bare" IsChecked="{Binding FeatureController}" />
                    </Grid>
                    <Border Classes="sep" />
                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="2">
                        <TextBlock Text="Hover preview" />
                        <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" Text="Move the pointer across a video to skim through it." />
                      </StackPanel>
                      <ToggleSwitch Grid.Column="1" Classes="bare" IsChecked="{Binding FeatureHoverPreview}" />
                    </Grid>
                    <Border Classes="sep" />
                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="2">
                        <TextBlock Text="Loud moment markers" />
                        <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" Text="Mark loud moments on the timeline so you can jump between them." />
                      </StackPanel>
                      <ToggleSwitch Grid.Column="1" Classes="bare" IsChecked="{Binding FeatureLoudMarkers}" />
                    </Grid>
                    <Border Classes="sep" />
                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="2">
                        <TextBlock Text="Hover glow" />
                        <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" Text="A soft glow in your color scheme around the video under the pointer." />
                      </StackPanel>
                      <ToggleSwitch Grid.Column="1" Classes="bare" IsChecked="{Binding FeatureHoverGlow}" />
                    </Grid>
                    <Border Classes="sep" />
                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="2">
                        <TextBlock Text="Collections" />
                        <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" Text="Group videos from any folders, like playlists." />
                      </StackPanel>
                      <ToggleSwitch Grid.Column="1" Classes="bare" IsChecked="{Binding FeatureCollections}" />
                    </Grid>
                    <Border Classes="sep" />
                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="2">
                        <TextBlock Text="Unwatched dots" />
                        <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" Text="A dot next to videos you haven't opened yet, and an Unwatched filter." />
                      </StackPanel>
                      <ToggleSwitch Grid.Column="1" Classes="bare" IsChecked="{Binding FeatureUnwatched}" />
                    </Grid>
                    <Border Classes="sep" />
                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="2">
                        <TextBlock Text="Clean up" />
                        <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" Text="Find duplicates and broken, empty or very short files." />
                      </StackPanel>
                      <ToggleSwitch Grid.Column="1" Classes="bare" IsChecked="{Binding FeatureCleanUp}" />
                    </Grid>
                    <Border Classes="sep" />
                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="2">
                        <TextBlock Text="Stats" />
                        <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" Text="Numbers about your library and clips: per week, per game, totals." />
                      </StackPanel>
                      <ToggleSwitch Grid.Column="1" Classes="bare" IsChecked="{Binding FeatureStats}" />
                    </Grid>
                    <Border Classes="sep" />
                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="2">
                        <TextBlock Text="Quick player" />
                        <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" Text="Videos open in a large player over the library; Edit opens the full editor. Off, they open straight in the editor." />
                      </StackPanel>
                      <ToggleSwitch Grid.Column="1" Classes="bare" IsChecked="{Binding FeatureMiniPlayer}" />
                    </Grid>
                    <Border Classes="sep" />
                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="2">
                        <TextBlock Text="Chapters from bookmarks" />
                        <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" Text="Bookmarks in a session recording become chapters: in the player, in the saved file and in exports." />
                      </StackPanel>
                      <ToggleSwitch Grid.Column="1" Classes="bare" IsChecked="{Binding FeatureChapters}" />
                    </Grid>
                  </StackPanel>
                </Border>
                <TextBlock Classes="label" Text="EDITING AND EXPORT" Margin="0,8,0,0" />
                <Border Classes="group">
                  <StackPanel>
                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="2">
                        <TextBlock Text="Captions" />
                        <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" Text="Text over the video in the editor, burned into exports." />
                      </StackPanel>
                      <ToggleSwitch Grid.Column="1" Classes="bare" IsChecked="{Binding FeatureCaptions}" />
                    </Grid>
                    <Border Classes="sep" />
                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="2">
                        <TextBlock Text="Slow motion and speed ramps" />
                        <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" Text="Slow down or speed up part of a clip, easing in and out." />
                      </StackPanel>
                      <ToggleSwitch Grid.Column="1" Classes="bare" IsChecked="{Binding FeatureSpeedEffects}" />
                    </Grid>
                    <Border Classes="sep" />
                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="2">
                        <TextBlock Text="Sound tools" />
                        <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" Text="Even out loudness, boost your voice and lower the game while you talk." />
                      </StackPanel>
                      <ToggleSwitch Grid.Column="1" Classes="bare" IsChecked="{Binding FeatureAudioTools}" />
                    </Grid>
                    <Border Classes="sep" />
                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="2">
                        <TextBlock Text="Watermark and intro" />
                        <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" Text="Your logo in a corner, and an intro or outro clip around exports." />
                      </StackPanel>
                      <ToggleSwitch Grid.Column="1" Classes="bare" IsChecked="{Binding FeatureBranding}" />
                    </Grid>
                    <Border Classes="sep" />
                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="2">
                        <TextBlock Text="Export queue" />
                        <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" Text="Exports run in the background one after another, so you can keep editing. Off, the editor waits for each export." />
                      </StackPanel>
                      <ToggleSwitch Grid.Column="1" Classes="bare" IsChecked="{Binding FeatureExportQueue}" />
                    </Grid>
                  </StackPanel>
                </Border>
              </StackPanel>

              <!-- ==== Editing ==== -->
              <StackPanel Spacing="12" IsVisible="{Binding IsEditingPage}">
                <TextBlock Classes="dim" FontSize="12" TextWrapping="Wrap" Margin="4,0"
                           Text="Your watermark and intro / outro clips. Switch them on per export in the editor's Effects panel; they stay on until you switch them off." />
                <Border Classes="group" IsVisible="{Binding ShowBrandingOffNotice}">
                  <Grid Classes="row" ColumnDefinitions="*,Auto">
                    <TextBlock Text="Watermark and intro is switched off under Features." TextWrapping="Wrap" />
                    <Button Grid.Column="1" Classes="soft" Content="Switch on" Command="{Binding EnableBrandingCommand}" />
                  </Grid>
                </Border>
                <StackPanel Spacing="12" IsVisible="{Binding FeatureBranding}">
                <TextBlock Classes="label" Text="WATERMARK" />
                <Border Classes="group">
                  <StackPanel>
                    <Grid Classes="row" ColumnDefinitions="*,Auto,Auto">
                      <StackPanel Spacing="2">
                        <TextBlock Text="Image" />
                        <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" Text="{Binding WatermarkName}" />
                      </StackPanel>
                      <Button Grid.Column="1" Classes="soft" Content="Choose…" Margin="0,0,8,0" Command="{Binding ChooseWatermarkCommand}" />
                      <Button Grid.Column="2" Classes="ghost" Content="Remove" Command="{Binding RemoveWatermarkCommand}" IsVisible="{Binding HasWatermarkImage}" />
                    </Grid>
                    <StackPanel IsVisible="{Binding HasWatermarkImage}">
                      <Border Classes="sep" />
                      <Grid Classes="row" ColumnDefinitions="*,Auto">
                        <TextBlock Text="Corner" />
                        <ContentControl Grid.Column="1" Content="{Binding WatermarkCorner}" />
                      </Grid>
                      <Border Classes="sep" />
                      <Grid Classes="row" ColumnDefinitions="*,Auto,Auto">
                        <TextBlock Text="Size (share of the video's width)" />
                        <Slider Grid.Column="1" Width="180" Minimum="5" Maximum="40" TickFrequency="1" IsSnapToTickEnabled="True"
                                Value="{Binding WatermarkSize}" VerticalAlignment="Center" Margin="0,-6,10,-6" />
                        <TextBlock Grid.Column="2" Classes="mono" Width="44" TextAlignment="Right" Text="{Binding WatermarkSizeText}" />
                      </Grid>
                      <Border Classes="sep" />
                      <Grid Classes="row" ColumnDefinitions="*,Auto,Auto">
                        <TextBlock Text="Opacity" />
                        <Slider Grid.Column="1" Width="180" Minimum="20" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                                Value="{Binding WatermarkOpacity}" VerticalAlignment="Center" Margin="0,-6,10,-6" />
                        <TextBlock Grid.Column="2" Classes="mono" Width="44" TextAlignment="Right" Text="{Binding WatermarkOpacityText}" />
                      </Grid>
                      <Border Classes="sep" />
                      <Grid Classes="row" ColumnDefinitions="*,Auto">
                        <TextBlock Text="Add it to exports" />
                        <ToggleSwitch Grid.Column="1" Classes="bare" IsChecked="{Binding UseWatermark}" />
                      </Grid>
                    </StackPanel>
                  </StackPanel>
                </Border>

                <TextBlock Classes="label" Text="INTRO AND OUTRO" Margin="0,8,0,0" />
                <Border Classes="group">
                  <StackPanel>
                    <Grid Classes="row" ColumnDefinitions="*,Auto,Auto,Auto">
                      <StackPanel Spacing="2">
                        <TextBlock Text="Intro clip" />
                        <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" Text="{Binding IntroName}" />
                      </StackPanel>
                      <Button Grid.Column="1" Classes="soft" Content="Choose…" Margin="0,0,8,0" Command="{Binding ChooseIntroCommand}" />
                      <Button Grid.Column="2" Classes="ghost" Content="Remove" Margin="0,0,8,0" Command="{Binding RemoveIntroCommand}" IsVisible="{Binding HasIntroClip}" />
                      <ToggleSwitch Grid.Column="3" Classes="bare" IsChecked="{Binding UseIntro}" IsEnabled="{Binding HasIntroClip}"
                                    ToolTip.Tip="Add it to exports" />
                    </Grid>
                    <Border Classes="sep" />
                    <Grid Classes="row" ColumnDefinitions="*,Auto,Auto,Auto">
                      <StackPanel Spacing="2">
                        <TextBlock Text="Outro clip" />
                        <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" Text="{Binding OutroName}" />
                      </StackPanel>
                      <Button Grid.Column="1" Classes="soft" Content="Choose…" Margin="0,0,8,0" Command="{Binding ChooseOutroCommand}" />
                      <Button Grid.Column="2" Classes="ghost" Content="Remove" Margin="0,0,8,0" Command="{Binding RemoveOutroCommand}" IsVisible="{Binding HasOutroClip}" />
                      <ToggleSwitch Grid.Column="3" Classes="bare" IsChecked="{Binding UseOutro}" IsEnabled="{Binding HasOutroClip}"
                                    ToolTip.Tip="Add it to exports" />
                    </Grid>
                  </StackPanel>
                </Border>
                <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" Margin="4,0"
                           Text="Intro and outro clips are fitted to each export's size, with black bars if the shape differs. Exports and Share presets both use them." />
                </StackPanel>
              </StackPanel>

              <!-- ==== Accessibility ==== -->
              <StackPanel Spacing="12" IsVisible="{Binding IsAccessibilityPage}">
                <Border Classes="group">
                  <StackPanel>
                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="2">
                        <TextBlock Text="Interface size" />
                        <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" Text="Makes text, buttons and videos bigger or smaller." />
                      </StackPanel>
                      <ComboBox Grid.Column="1" Classes="field" MinWidth="120" ItemsSource="{x:Static vm:SettingsViewModel.UiScales}" SelectedItem="{Binding UiScale}" />
                    </Grid>
                    <Border Classes="sep" />
                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="2">
                        <TextBlock Text="High contrast" />
                        <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" Text="Black background, white text and clearer lines, with your scheme's accent color." />
                      </StackPanel>
                      <ToggleSwitch Grid.Column="1" Classes="bare" IsChecked="{Binding HighContrast}" />
                    </Grid>
                    <Border Classes="sep" />
                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="2">
                        <TextBlock Text="Reduce motion" />
                        <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" Text="No animations, zooming or glow." />
                      </StackPanel>
                      <ToggleSwitch Grid.Column="1" Classes="bare" IsChecked="{Binding ReducedMotion}" />
                    </Grid>
                  </StackPanel>
                </Border>
              </StackPanel>

              <!-- ==== Clipping ==== -->
              <Border Classes="group" IsVisible="{Binding ShowClippingOffNotice}" Padding="16,14">
                <TextBlock Classes="dim" FontSize="12" TextWrapping="Wrap"
                           Text="Background clipping is switched off. Switch it on under Features to set it up." />
              </Border>
              <StackPanel Spacing="12" IsVisible="{Binding ShowClippingSettings}">
              <TextBlock Classes="label" Text="CLIPPING" />
              <Border Classes="group">
                <StackPanel>
                  <Grid Classes="row" ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="2">
                      <TextBlock Text="Background clipping" />
                      <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" Text="{Binding Footprint}" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" Classes="bare" IsChecked="{Binding ClipEnabled}" />
                  </Grid>
                  <Border Classes="sep" />
                  <Grid Classes="row" ColumnDefinitions="*,220">
                    <TextBlock Text="Clip length" />
                    <ComboBox Grid.Column="1" Classes="field" ItemsSource="{x:Static vm:SettingsViewModel.Lengths}" SelectedItem="{Binding Length}" />
                  </Grid>
                  <Border Classes="sep" />
                  <Grid Classes="row" ColumnDefinitions="*,Auto">
                    <TextBlock Text="Save clip hotkey" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                      <ToggleButton Classes="mod" IsChecked="{Binding HotkeyCtrl}" Content="{Binding CtrlLabel}" />
                      <ToggleButton Classes="mod" IsChecked="{Binding HotkeyAlt}" Content="{Binding AltLabel}" />
                      <ToggleButton Classes="mod" IsChecked="{Binding HotkeyShift}" Content="{Binding ShiftLabel}" />
                      <ToggleButton Classes="mod" IsChecked="{Binding HotkeyMeta}" Content="{Binding MetaLabel}" />
                      <ComboBox Classes="field" Width="74" ItemsSource="{x:Static vm:SettingsViewModel.Keys}" SelectedItem="{Binding HotkeyKey}" />
                    </StackPanel>
                  </Grid>
                  <ItemsControl ItemsSource="{Binding ExtraHotkeys}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:HotkeyRow">
                        <StackPanel>
                          <Border Classes="sep" />
                          <Grid Classes="row" ColumnDefinitions="*,Auto">
                            <TextBlock Text="Extra hotkey" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                              <ToggleButton Classes="mod" IsChecked="{Binding Ctrl}" Content="{Binding #Root.((vm:MainViewModel)DataContext).SettingsEditor.CtrlLabel}" />
                              <ToggleButton Classes="mod" IsChecked="{Binding Alt}" Content="{Binding #Root.((vm:MainViewModel)DataContext).SettingsEditor.AltLabel}" />
                              <ToggleButton Classes="mod" IsChecked="{Binding Shift}" Content="{Binding #Root.((vm:MainViewModel)DataContext).SettingsEditor.ShiftLabel}" />
                              <ToggleButton Classes="mod" IsChecked="{Binding Meta}" Content="{Binding #Root.((vm:MainViewModel)DataContext).SettingsEditor.MetaLabel}" />
                              <ComboBox Classes="field" Width="74" ItemsSource="{x:Static vm:SettingsViewModel.Keys}" SelectedItem="{Binding Key}" />
                            </StackPanel>
                          </Grid>
                          <Grid Classes="row" ColumnDefinitions="*,Auto,Auto" Margin="14,0,14,10">
                            <TextBlock Classes="dim" Text="It saves the last" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" Classes="field" Width="180" ItemsSource="{x:Static vm:SettingsViewModel.Lengths}" SelectedItem="{Binding Length}" />
                            <Button Grid.Column="2" Classes="ghost" Margin="6,0,0,0" ToolTip.Tip="Remove this hotkey"
                                    Command="{Binding #Root.((vm:MainViewModel)DataContext).SettingsEditor.RemoveHotkeyCommand}" CommandParameter="{Binding}">
                              <PathIcon Data="{StaticResource IcClose}" Width="12" Height="12" />
                            </Button>
                          </Grid>
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Border Classes="sep" IsVisible="{Binding CanAddHotkey}" />
                  <Grid Classes="row" ColumnDefinitions="*,Auto" IsVisible="{Binding CanAddHotkey}">
                    <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center"
                               Text="Another hotkey can save a different length, say a short one for a quick play and a long one for a whole round. The buffer keeps the longest." />
                    <Button Grid.Column="1" Classes="soft" Content="Add hotkey" Command="{Binding AddHotkeyCommand}" Margin="10,0,0,0" />
                  </Grid>
                  <Border Classes="sep" />
                  <Grid Classes="row" ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="2">
                      <TextBlock Text="Save clips to" />
                      <TextBlock Classes="dim mono" FontSize="11" Text="{Binding Folder}" TextTrimming="PathSegmentEllipsis" MaxWidth="360" HorizontalAlignment="Left" />
                    </StackPanel>
                    <Button Grid.Column="1" Classes="soft" Content="Choose…" Command="{Binding BrowseFolderCommand}" />
                  </Grid>
                  <Border Classes="sep" />
                  <Grid Classes="row" ColumnDefinitions="*,Auto">
                    <TextBlock Text="Notify me when a clip is saved" />
                    <ToggleSwitch Grid.Column="1" Classes="bare" IsChecked="{Binding Notify}" />
                  </Grid>
                  <Border Classes="sep" />
                  <Grid Classes="row" ColumnDefinitions="*,Auto">
                    <TextBlock Text="Play a sound when a clip is saved" />
                    <ToggleSwitch Grid.Column="1" Classes="bare" IsChecked="{Binding Sound}" />
                  </Grid>
                  <Border Classes="sep" />
                  <Grid Classes="row" ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="2">
                      <TextBlock Text="Name and tag clips after the game" />
                      <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" Text="Uses the app that is in front when you save." />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" Classes="bare" IsChecked="{Binding TagWithGame}" />
                  </Grid>
                </StackPanel>
              </Border>

              <TextBlock Classes="label" Text="STORAGE" Margin="0,8,0,0" />
              <Border Classes="group">
                <StackPanel>
                  <Grid Classes="row" ColumnDefinitions="*,220">
                    <StackPanel Spacing="2">
                      <TextBlock Text="Remove clips older than" />
                      <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" Text="Favourites are never removed." />
                    </StackPanel>
                    <ComboBox Grid.Column="1" Classes="field" ItemsSource="{x:Static vm:SettingsViewModel.KeepDaysOptions}" SelectedItem="{Binding KeepDays}" />
                  </Grid>
                  <Border Classes="sep" />
                  <Grid Classes="row" ColumnDefinitions="*,220">
                    <StackPanel Spacing="2">
                      <TextBlock Text="Keep the clips folder under" />
                      <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" Text="{Binding StorageUsage}" />
                    </StackPanel>
                    <ComboBox Grid.Column="1" Classes="field" ItemsSource="{x:Static vm:SettingsViewModel.FolderCaps}" SelectedItem="{Binding FolderCap}" />
                  </Grid>
                  <Border Classes="sep" />
                  <Grid Classes="row" ColumnDefinitions="*,220">
                    <StackPanel Spacing="2">
                      <TextBlock Text="Removed clips go to the" />
                      <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" Text="Oldest clips go first once a limit is passed." />
                    </StackPanel>
                    <ComboBox Grid.Column="1" Classes="field" ItemsSource="{x:Static vm:SettingsViewModel.CleanupTargets}" SelectedItem="{Binding CleanupTarget}" />
                  </Grid>
                  <Border Classes="sep" IsVisible="{Binding UsesArchive}" />
                  <Grid Classes="row" ColumnDefinitions="*,Auto" IsVisible="{Binding UsesArchive}">
                    <StackPanel Spacing="2">
                      <TextBlock Text="Archive folder" />
                      <TextBlock Classes="dim mono" FontSize="11" Text="{Binding ArchiveFolder}" TextTrimming="PathSegmentEllipsis" MaxWidth="360" HorizontalAlignment="Left" />
                    </StackPanel>
                    <Button Grid.Column="1" Classes="soft" Content="Choose…" Command="{Binding BrowseArchiveCommand}" />
                  </Grid>
                </StackPanel>
              </Border>

              <TextBlock Classes="label" Text="VIDEO" Margin="0,8,0,0" />
              <Border Classes="group">
                <StackPanel>
                  <Grid Classes="row" ColumnDefinitions="*,220" IsVisible="{Binding HasSeveralScreens}">
                    <TextBlock Text="Screen" />
                    <ComboBox Grid.Column="1" Classes="field" ItemsSource="{Binding Screens}" SelectedIndex="{Binding ScreenIndex}" />
                  </Grid>
                  <Border Classes="sep" IsVisible="{Binding HasSeveralScreens}" />
                  <Grid Classes="row" ColumnDefinitions="*,220">
                    <TextBlock Text="Resolution" />
                    <ComboBox Grid.Column="1" Classes="field" ItemsSource="{x:Static vm:SettingsViewModel.Resolutions}" SelectedItem="{Binding Resolution}" />
                  </Grid>
                  <Border Classes="sep" />
                  <Grid Classes="row" ColumnDefinitions="*,220">
                    <TextBlock Text="Frame rate" />
                    <ComboBox Grid.Column="1" Classes="field" ItemsSource="{x:Static vm:SettingsViewModel.FrameRates}" SelectedItem="{Binding FrameRate}" />
                  </Grid>
                  <Border Classes="sep" />
                  <Grid Classes="row" ColumnDefinitions="*,220">
                    <TextBlock Text="Video bitrate" />
                    <ComboBox Grid.Column="1" Classes="field" ItemsSource="{x:Static vm:SettingsViewModel.Bitrates}" SelectedItem="{Binding Bitrate}" />
                  </Grid>
                  <Border Classes="sep" />
                  <Grid Classes="row" ColumnDefinitions="*,260">
                    <StackPanel Spacing="2">
                      <TextBlock Text="Format" />
                      <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" Text="{Binding CodecDetail}" />
                    </StackPanel>
                    <ComboBox Grid.Column="1" Classes="field" ItemsSource="{Binding Codecs}" SelectedItem="{Binding Codec}" />
                  </Grid>
                  <Border Classes="sep" />
                  <Grid Classes="row" ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="2">
                      <TextBlock Text="Use the graphics card to encode" />
                      <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap"
                                 Text="Much lighter on the CPU while gaming. Off records H.264 in software." />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" Classes="bare" IsChecked="{Binding HardwareEncoder}" />
                  </Grid>
                </StackPanel>
              </Border>

              <TextBlock Classes="label" Text="AUDIO" Margin="0,8,0,0" />
              <Border Classes="group">
                <StackPanel>
                  <Grid Classes="row" ColumnDefinitions="*,260">
                    <TextBlock Text="Audio device" />
                    <ComboBox Grid.Column="1" Classes="field" ItemsSource="{Binding AudioDevices}" SelectedItem="{Binding Audio1}" />
                  </Grid>
                  <Border Classes="sep" />
                  <Grid Classes="row" ColumnDefinitions="*,260">
                    <StackPanel Spacing="2">
                      <TextBlock Text="Second device" />
                      <TextBlock Classes="dim" FontSize="11" Text="Mixed in, e.g. your microphone." />
                    </StackPanel>
                    <ComboBox Grid.Column="1" Classes="field" ItemsSource="{Binding AudioDevices}" SelectedItem="{Binding Audio2}" />
                  </Grid>
                  <Border Classes="sep" />
                  <Grid Classes="row" ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="2">
                      <TextBlock Text="Keep the two devices as separate tracks" />
                      <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap"
                                 Text="Lets you mute the game or the microphone afterwards in the player. Some players and Discord only play the first track, so use a Share preset to mix them back together." />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" Classes="bare" IsChecked="{Binding SeparateTracks}" />
                  </Grid>
                  <Border Classes="sep" />
                  <Grid Classes="row" ColumnDefinitions="*,220">
                    <TextBlock Text="Audio bitrate" />
                    <ComboBox Grid.Column="1" Classes="field" ItemsSource="{x:Static vm:SettingsViewModel.AudioBitrates}" SelectedItem="{Binding AudioBitrate}" />
                  </Grid>
                </StackPanel>
              </Border>
              <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" Text="{Binding AudioHint}" Margin="4,0" />

              <TextBlock Classes="label" Text="CAMERA" Margin="0,8,0,0" />
              <Border Classes="group">
                <StackPanel>
                  <Grid Classes="row" ColumnDefinitions="*,220">
                    <StackPanel Spacing="2" Margin="0,0,12,0">
                      <TextBlock Text="Webcam in the corner" />
                      <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap"
                                 Text="Puts you in every clip and session, like a facecam. The camera stays on while clipping is on." />
                    </StackPanel>
                    <ComboBox Grid.Column="1" Classes="field" ItemsSource="{Binding Cameras}" SelectedItem="{Binding Camera}" />
                  </Grid>
                  <StackPanel IsVisible="{Binding HasCamera}">
                    <Border Classes="sep" />
                    <Grid Classes="row" ColumnDefinitions="*,220">
                      <TextBlock Text="Corner" />
                      <ComboBox Grid.Column="1" Classes="field" ItemsSource="{x:Static vm:SettingsViewModel.CameraCorners}" SelectedItem="{Binding CameraCorner}" />
                    </Grid>
                    <Border Classes="sep" />
                    <Grid Classes="row" ColumnDefinitions="*,220">
                      <TextBlock Text="Size" />
                      <ComboBox Grid.Column="1" Classes="field" ItemsSource="{x:Static vm:SettingsViewModel.CameraSizes}" SelectedItem="{Binding CameraSize}" />
                    </Grid>
                  </StackPanel>
                </StackPanel>
              </Border>

              <TextBlock Classes="label" Text="GAME PROFILES" Margin="0,8,0,0" />
              <Border Classes="group">
                <StackPanel>
                  <ItemsControl ItemsSource="{Binding Profiles}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <StackPanel>
                          <Grid Classes="row" ColumnDefinitions="*,Auto,Auto,Auto,Auto">
                            <TextBox Text="{Binding Game}" Watermark="Game or app name" CornerRadius="8" Margin="0,0,8,0" />
                            <ComboBox Grid.Column="1" Classes="field" Width="118" Margin="0,0,6,0" ItemsSource="{x:Static vm:ProfileRow.Lengths}" SelectedItem="{Binding Length}" />
                            <ComboBox Grid.Column="2" Classes="field" Width="120" Margin="0,0,6,0" ItemsSource="{x:Static vm:ProfileRow.Bitrates}" SelectedItem="{Binding Bitrate}" />
                            <ComboBox Grid.Column="3" Classes="field" Width="116" Margin="0,0,4,0" ItemsSource="{x:Static vm:ProfileRow.Formats}" SelectedItem="{Binding Format}" />
                            <Button Grid.Column="4" Classes="ghost" ToolTip.Tip="Remove this profile"
                                    Command="{Binding #Root.((vm:MainViewModel)DataContext).SettingsEditor.RemoveProfileCommand}" CommandParameter="{Binding}">
                              <PathIcon Data="{StaticResource IcClose}" Width="12" Height="12" />
                            </Button>
                          </Grid>
                          <Border Classes="sep" />
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Grid Classes="row" ColumnDefinitions="*,Auto">
                    <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center"
                               Text="While that game is in front, clips use its length, bitrate and format. The name is the one clips get tagged with; part of it is enough." />
                    <Button Grid.Column="1" Classes="soft" Content="Add profile" Command="{Binding AddProfileCommand}" Margin="10,0,0,0" />
                  </Grid>
                </StackPanel>
              </Border>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Border>

    <!-- ======================= TOAST ======================= -->
    <Border Classes="toast" Classes.lifted="{Binding IsSelecting}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Padding="16,10" CornerRadius="10"
            Background="{DynamicResource Bg3}" BorderBrush="{DynamicResource Accent}" BorderThickness="1"
            BoxShadow="0 8 30 0 #80000000" IsHitTestVisible="False"
            IsVisible="{Binding Toast, Converter={x:Static ObjectConverters.IsNotNull}}">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <PathIcon Data="{StaticResource IcCheck}" Width="13" Height="13" Foreground="{DynamicResource Cyan}" />
        <TextBlock Text="{Binding Toast}" FontSize="12" FontWeight="SemiBold" />
      </StackPanel>
    </Border>

    <!-- ======================= PLAYER (EDITOR) ======================= -->
    <!-- Video on the left; a rail of labelled tools and the page of the picked one on the right; under it all,
         the timeline, the transport and a bar with the everyday tools as buttons. -->
    <Grid x:Name="PlayerView" RowDefinitions="Auto,*,Auto" IsVisible="{Binding #Root.((vm:MainViewModel)DataContext).IsPlayerOpen}" Background="Black"
          DataContext="{Binding Player}" x:DataType="vm:PlayerViewModel">

      <!-- Top bar -->
      <Border Grid.Row="0" Background="{DynamicResource Bg1}" Height="52" x:Name="PlayerTopBar">
        <Grid x:Name="PlayerTopGrid" ColumnDefinitions="Auto,Auto,*,Auto">
          <Button Classes="ghost" Command="{Binding #Root.((vm:MainViewModel)DataContext).ClosePlayerCommand}"
                  ToolTip.Tip="Back to library (Esc)" VerticalAlignment="Center" Margin="12,0,4,0">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Data="{StaticResource IcBack}" Width="16" Height="16" />
              <TextBlock Text="Library" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" Margin="0,0,10,0">
            <Button Classes="ghost" Padding="6" Command="{Binding #Root.((vm:MainViewModel)DataContext).PreviousClipCommand}" ToolTip.Tip="Previous video (←)">
              <PathIcon Data="{StaticResource IcChevronLeft}" Width="18" Height="18" />
            </Button>
            <Button Classes="ghost" Padding="6" Command="{Binding #Root.((vm:MainViewModel)DataContext).NextClipCommand}" ToolTip.Tip="Next video (→)">
              <PathIcon Data="{StaticResource IcChevronRight}" Width="18" Height="18" />
            </Button>
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" IsHitTestVisible="False">
            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="520" />
            <TextBlock Classes="dim" Text="{Binding Subtitle}" FontSize="12" VerticalAlignment="Center" />
          </StackPanel>
          <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="0,0,12,0">
            <Button Classes="ghost" ToolTip.Tip="Exports running in the background"
                    IsVisible="{Binding #Root.((vm:MainViewModel)DataContext).Exports.HasJobs}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource IcExport}" Width="15" Height="15" />
                <TextBlock Text="{Binding #Root.((vm:MainViewModel)DataContext).Exports.ButtonText}" FontSize="12" VerticalAlignment="Center" />
              </StackPanel>
              <Button.Flyout>
                <Flyout Placement="BottomEdgeAlignedRight">
                  <ContentControl Content="{Binding #Root.((vm:MainViewModel)DataContext).Exports}" />
                </Flyout>
              </Button.Flyout>
            </Button>
            <Button Classes="ghost" ToolTip.Tip="Back to the quick player: plain playback over the library"
                    IsVisible="{Binding #Root.((vm:MainViewModel)DataContext).ShowMiniPlayerButton}"
                    Command="{Binding #Root.((vm:MainViewModel)DataContext).ShrinkToMiniPlayerCommand}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource IcMiniPlayer}" Width="15" Height="15" />
                <TextBlock Text="Quick player" FontSize="12" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="10,0,0,0">
              <Border Background="{DynamicResource Bg2}" CornerRadius="8" Padding="3" VerticalAlignment="Center" Margin="0,0,2,0">
                <StackPanel Orientation="Horizontal">
                  <RadioButton Classes="seg" GroupName="mode" Content="Lossless" IsChecked="{Binding !PreciseExport}"
                               ToolTip.Tip="Stream copy: instant, no quality loss. Start snaps to the nearest earlier keyframe." />
                  <RadioButton Classes="seg" GroupName="mode" Content="Precise" IsChecked="{Binding PreciseExport}"
                               ToolTip.Tip="Re-encode to H.264/AAC MP4: frame-accurate cut, slower." />
                </StackPanel>
              </Border>
              <Button Classes="soft" IsVisible="{Binding !IsExporting}" ToolTip.Tip="Share presets: Discord, vertical, GIF"
                      Command="{Binding PickPageCommand}" CommandParameter="{x:Static vm:ToolPage.Share}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Data="{StaticResource IcShare}" Width="14" Height="14" />
                  <TextBlock Text="Share" />
                </StackPanel>
              </Button>
              <Button Classes="accent" Command="{Binding ExportCommand}" IsVisible="{Binding !IsExporting}"
                      ToolTip.Tip="Export clip (E)">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <PathIcon Data="{StaticResource IcExport}" Width="15" Height="15" />
                  <TextBlock Text="{Binding ExportLabel}" />
                </StackPanel>
              </Button>
              <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsExporting}">
                <ProgressBar Width="150" Height="6" MinHeight="6" Value="{Binding ExportProgress}" VerticalAlignment="Center" CornerRadius="3" />
                <TextBlock Classes="mono" FontSize="12" Text="{Binding ExportProgress, StringFormat='{}{0:0}%'}" VerticalAlignment="Center" />
                <Button Classes="ghost" Command="{Binding CancelExportCommand}" ToolTip.Tip="Cancel export">
                  <PathIcon Data="{StaticResource IcClose}" Width="14" Height="14" />
                </Button>
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Video | rail | tool page -->
      <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto">
      <Panel>
        <c:VideoSurface x:Name="Surface" Frames="{Binding Frames}"
                          SourceWidth="{Binding VideoWidth}" SourceHeight="{Binding VideoHeight}" />
        <c:EffectsOverlay Captions="{Binding PreviewCaptions}" Watermark="{Binding PreviewWatermark}"
                          VideoWidth="{Binding VideoWidth}" VideoHeight="{Binding VideoHeight}" />
        <Border Background="Transparent" x:Name="SurfaceHit" />
        <Border Classes="speedbadge" IsVisible="{Binding SpeedPreviewText, Converter={x:Static ObjectConverters.IsNotNull}}"
                IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <PathIcon Data="{StaticResource IcSpeed}" Width="13" Height="13" Foreground="#FF9F43" />
            <TextBlock Text="{Binding SpeedPreviewText}" FontSize="12" FontWeight="SemiBold" />
          </StackPanel>
        </Border>
        <Border IsVisible="{Binding Toast, Converter={x:Static ObjectConverters.IsNotNull}}"
                HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,18,0,0"
                Background="#E614151B" CornerRadius="10" Padding="14,8" BorderBrush="{DynamicResource Line}" BorderThickness="1">
          <TextBlock Text="{Binding Toast}" FontSize="13" />
        </Border>
      </Panel>

      <!-- ===== TOOL RAIL ===== -->
      <Border Grid.Column="1" Background="{DynamicResource Bg1}" BorderBrush="{DynamicResource Line}" BorderThickness="1,0,0,0" Padding="6,10">
        <StackPanel Spacing="4">
          <Button Classes="rail" Classes.on="{Binding IsTrimPage}" Command="{Binding PickPageCommand}" CommandParameter="{x:Static vm:ToolPage.Trim}"
                  ToolTip.Tip="Selection, parts, markers and chapters">
            <StackPanel Spacing="4"><PathIcon Data="{StaticResource IcCut}" /><TextBlock Text="Trim" /></StackPanel>
          </Button>
          <Button Classes="rail" Classes.on="{Binding IsCaptionsPage}" Command="{Binding PickPageCommand}" CommandParameter="{x:Static vm:ToolPage.Captions}"
                  IsVisible="{Binding ShowCaptionTools}" ToolTip.Tip="Text over the video">
            <StackPanel Spacing="4"><PathIcon Data="{StaticResource IcText}" /><TextBlock Text="Captions" /></StackPanel>
          </Button>
          <Button Classes="rail" Classes.on="{Binding IsSpeedPage}" Command="{Binding PickPageCommand}" CommandParameter="{x:Static vm:ToolPage.Speed}"
                  IsVisible="{Binding ShowSpeedTools}" ToolTip.Tip="Slow motion and fast forward">
            <StackPanel Spacing="4"><PathIcon Data="{StaticResource IcSpeed}" /><TextBlock Text="Speed" /></StackPanel>
          </Button>
          <Button Classes="rail" Classes.on="{Binding IsSoundPage}" Command="{Binding PickPageCommand}" CommandParameter="{x:Static vm:ToolPage.Sound}"
                  IsVisible="{Binding ShowSoundPage}" ToolTip.Tip="Loudness, voice and audio tracks">
            <StackPanel Spacing="4"><PathIcon Data="{StaticResource IcVolume}" /><TextBlock Text="Sound" /></StackPanel>
          </Button>
          <Button Classes="rail" Classes.on="{Binding IsBrandPage}" Command="{Binding PickPageCommand}" CommandParameter="{x:Static vm:ToolPage.Brand}"
                  IsVisible="{Binding ShowBranding}" ToolTip.Tip="Watermark, intro and outro">
            <StackPanel Spacing="4"><PathIcon Data="{StaticResource IcImage}" /><TextBlock Text="Brand" /></StackPanel>
          </Button>
          <Button Classes="rail" Classes.on="{Binding IsSharePage}" Command="{Binding PickPageCommand}" CommandParameter="{x:Static vm:ToolPage.Share}"
                  ToolTip.Tip="Export modes and share presets">
            <StackPanel Spacing="4"><PathIcon Data="{StaticResource IcShare}" /><TextBlock Text="Export" /></StackPanel>
          </Button>
        </StackPanel>
      </Border>

      <!-- ===== TOOL PAGE ===== -->
      <Border Grid.Column="2" Width="330" Background="{DynamicResource Bg1}" BorderBrush="{DynamicResource Line}" BorderThickness="1,0,0,0"
              IsVisible="{Binding IsToolsOpen}">
        <DockPanel>
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="16,14,10,8">
            <TextBlock Text="{Binding PageTitle}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" />
            <Button Grid.Column="1" Classes="ghost" Command="{Binding ToggleToolsCommand}" ToolTip.Tip="Fold the panel away for a bigger picture (Shift+E)">
              <PathIcon Data="{StaticResource IcChevronRight}" Width="16" Height="16" />
            </Button>
          </Grid>
          <ScrollViewer x:Name="EffectsScroll">
            <StackPanel Spacing="14" Margin="12,0,12,18">

              <!-- trim -->
              <StackPanel Spacing="12" IsVisible="{Binding IsTrimPage}">
                <Border Classes="fxcard">
                  <StackPanel Spacing="8">
                    <TextBlock Classes="label" Text="SELECTION" />
                    <Grid ColumnDefinitions="40,*,Auto,Auto" RowDefinitions="Auto,Auto">
                      <TextBlock Text="In" FontSize="12" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Classes="mono" Text="{Binding InText}" Foreground="{DynamicResource Cyan}" FontSize="12" VerticalAlignment="Center" />
                      <Button Grid.Column="2" Classes="ghost" Padding="7,4" Command="{Binding SetInCommand}" ToolTip.Tip="Set the start at the playhead (I)">
                        <TextBlock Text="Set" FontSize="11" />
                      </Button>
                      <Button Grid.Column="3" Classes="ghost" Padding="7,4" Command="{Binding JumpToInCommand}" ToolTip.Tip="Go to the start (Shift+I)">
                        <TextBlock Text="Go to" FontSize="11" />
                      </Button>
                      <TextBlock Grid.Row="1" Text="Out" FontSize="12" VerticalAlignment="Center" />
                      <TextBlock Grid.Row="1" Grid.Column="1" Classes="mono" Text="{Binding OutText}" Foreground="{DynamicResource Cyan}" FontSize="12" VerticalAlignment="Center" />
                      <Button Grid.Row="1" Grid.Column="2" Classes="ghost" Padding="7,4" Command="{Binding SetOutCommand}" ToolTip.Tip="Set the end at the playhead (O)">
                        <TextBlock Text="Set" FontSize="11" />
                      </Button>
                      <Button Grid.Row="1" Grid.Column="3" Classes="ghost" Padding="7,4" Command="{Binding JumpToOutCommand}" ToolTip.Tip="Go to the end (Shift+O)">
                        <TextBlock Text="Go to" FontSize="11" />
                      </Button>
                    </Grid>
                    <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" IsVisible="{Binding !HasRange}"
                               Text="Mark where the clip starts and ends: In and Out in the bar below, or drag the brackets on the timeline. Without a selection, Export saves the whole video." />
                    <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasRange}">
                      <TextBlock Classes="dim" Text="Length" FontSize="12" VerticalAlignment="Center" />
                      <TextBlock Classes="mono" Text="{Binding RangeText}" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                  </StackPanel>
                </Border>

                <Border Classes="fxcard">
                  <StackPanel Spacing="8">
                    <TextBlock Classes="label" Text="PARTS" />
                    <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap"
                               Text="Keep several moments in one export: mark one, Add part, mark the next. Export joins them in order." />
                    <Button Classes="soft" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding AddSegmentCommand}"
                            IsEnabled="{Binding HasRange}" ToolTip.Tip="Keep this selection as one part (A)">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Data="{StaticResource IcAdd}" Width="12" Height="12" />
                        <TextBlock Text="Add the selection as a part" FontSize="12" />
                        <TextBlock Classes="hint" Text="A" />
                      </StackPanel>
                    </Button>
                    <ItemsControl ItemsSource="{Binding Segments}" IsVisible="{Binding HasSegments}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Classes="part" Margin="0,0,6,6">
                            <StackPanel Orientation="Horizontal" Spacing="2">
                              <Button Classes="ghost" Padding="8,3" ToolTip.Tip="Jump to this part"
                                      Command="{Binding #Root.((vm:MainViewModel)DataContext).Player.JumpToSegmentCommand}" CommandParameter="{Binding}">
                                <TextBlock Classes="mono" FontSize="12" Text="{Binding Text}" />
                              </Button>
                              <Button Classes="ghost" Padding="5,3" ToolTip.Tip="Remove this part"
                                      Command="{Binding #Root.((vm:MainViewModel)DataContext).Player.RemoveSegmentCommand}" CommandParameter="{Binding}">
                                <PathIcon Data="{StaticResource IcClose}" Width="10" Height="10" />
                              </Button>
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>

                <Border Classes="fxcard" IsVisible="{Binding HasMarkers}">
                  <StackPanel Spacing="8">
                    <TextBlock Classes="label" Text="MARKERS" />
                    <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap"
                               Text="Loud moments and bookmarks, shown as ticks on the timeline." />
                    <Grid ColumnDefinitions="*,Auto,Auto">
                      <TextBlock Text="{Binding MarkerText}" FontSize="12" VerticalAlignment="Center" />
                      <Button Grid.Column="1" Classes="ghost" Padding="7,4" Command="{Binding PreviousMarkerCommand}" ToolTip.Tip="Previous marker (Shift+N)">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                          <PathIcon Data="{StaticResource IcChevronLeft}" Width="12" Height="12" />
                          <TextBlock Text="Previous" FontSize="11" />
                        </StackPanel>
                      </Button>
                      <Button Grid.Column="2" Classes="ghost" Padding="7,4" Command="{Binding NextMarkerCommand}" ToolTip.Tip="Next marker (N)">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                          <TextBlock Text="Next" FontSize="11" />
                          <PathIcon Data="{StaticResource IcChevronRight}" Width="12" Height="12" />
                        </StackPanel>
                      </Button>
                    </Grid>
                  </StackPanel>
                </Border>

                <Border Classes="fxcard" IsVisible="{Binding HasChapters}">
                  <StackPanel Spacing="6">
                    <TextBlock Classes="label" Text="CHAPTERS" />
                    <ItemsControl ItemsSource="{Binding ChapterList}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ChapterViewModel">
                          <Grid ColumnDefinitions="*,Auto">
                            <Button Classes="menurow" Classes.on="{Binding IsCurrent}"
                                    Command="{Binding #Root.((vm:MainViewModel)DataContext).Player.JumpToChapterCommand}" CommandParameter="{Binding}">
                              <Grid ColumnDefinitions="52,*,Auto">
                                <TextBlock Classes="mono" Text="{Binding StartText}" FontSize="11" />
                                <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="2" Classes="dim mono" Text="{Binding LengthText}" FontSize="11" Margin="8,0,0,0" />
                              </Grid>
                            </Button>
                            <Button Grid.Column="1" Classes="ghost" Padding="7" Margin="2,0,0,0"
                                    ToolTip.Tip="Select this chapter, to export or loop it"
                                    Command="{Binding #Root.((vm:MainViewModel)DataContext).Player.SelectChapterCommand}" CommandParameter="{Binding}">
                              <PathIcon Data="{StaticResource IcCut}" Width="12" Height="12" />
                            </Button>
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
              </StackPanel>

              <!-- captions -->
              <StackPanel Spacing="8" IsVisible="{Binding IsCaptionsPage}">
                <Button Classes="soft" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding AddCaptionCommand}" ToolTip.Tip="Add a caption at the playhead (C)">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Data="{StaticResource IcAdd}" Width="12" Height="12" />
                    <TextBlock Text="Add a caption at the playhead" FontSize="12" />
                    <TextBlock Classes="hint" Text="C" />
                  </StackPanel>
                </Button>
                <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" Margin="4,0" IsVisible="{Binding !Captions.Count}"
                           Text="Text over the video, burned into exports. A new caption starts at the playhead and lasts 3 seconds." />
                <ItemsControl x:Name="CaptionList" ItemsSource="{Binding Captions}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:CaptionViewModel">
                      <Border Classes="fxcard" Margin="0,0,0,8">
                        <StackPanel Spacing="8">
                          <TextBox Classes="fx" Text="{Binding Text}" Watermark="Caption text" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="96" />
                          <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                            <Button Classes="ghost" Padding="4,3" HorizontalAlignment="Left" ToolTip.Tip="Jump to this caption"
                                    Command="{Binding #Root.((vm:MainViewModel)DataContext).Player.JumpToCaptionCommand}" CommandParameter="{Binding}">
                              <TextBlock Classes="mono" FontSize="11" Text="{Binding RangeText}" />
                            </Button>
                            <Button Grid.Column="1" Classes="ghost" Padding="7,3" ToolTip.Tip="Start the caption at the playhead"
                                    Command="{Binding #Root.((vm:MainViewModel)DataContext).Player.CaptionStartHereCommand}" CommandParameter="{Binding}">
                              <TextBlock Text="Start here" FontSize="11" />
                            </Button>
                            <Button Grid.Column="2" Classes="ghost" Padding="7,3" ToolTip.Tip="End the caption at the playhead"
                                    Command="{Binding #Root.((vm:MainViewModel)DataContext).Player.CaptionEndHereCommand}" CommandParameter="{Binding}">
                              <TextBlock Text="End here" FontSize="11" />
                            </Button>
                            <Button Grid.Column="3" Classes="ghost" Padding="6" ToolTip.Tip="Remove this caption"
                                    Command="{Binding #Root.((vm:MainViewModel)DataContext).Player.RemoveCaptionCommand}" CommandParameter="{Binding}">
                              <PathIcon Data="{StaticResource IcDelete}" Width="13" Height="13" />
                            </Button>
                          </Grid>
                          <WrapPanel Orientation="Horizontal">
                            <ContentControl Content="{Binding Position}" Margin="0,0,6,6" />
                            <ContentControl Content="{Binding Size}" Margin="0,0,6,6" />
                            <ContentControl Content="{Binding Look}" Margin="0,0,0,6" />
                          </WrapPanel>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>


              <!-- slow motion / fast forward -->
              <StackPanel Spacing="8" IsVisible="{Binding IsSpeedPage}">
                <Button Classes="soft" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding AddSpeedSectionCommand}" ToolTip.Tip="Slow down or speed up part of the clip, starting at the playhead">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Data="{StaticResource IcAdd}" Width="12" Height="12" />
                    <TextBlock Text="Add slow motion at the playhead" FontSize="12" />
                  </StackPanel>
                </Button>
                <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" Margin="4,0" IsVisible="{Binding !SpeedSections.Count}"
                           Text="Slow motion or fast forward for part of the clip; the player plays it at that speed so you can check it. Slow motion is smoothest on 60 fps recordings." />
                <ItemsControl ItemsSource="{Binding SpeedSections}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SpeedSectionViewModel">
                      <Border Classes="fxcard" Margin="0,0,0,8">
                        <StackPanel Spacing="8">
                          <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                            <StackPanel Spacing="0">
                              <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" Margin="4,0,0,0" />
                              <Button Classes="ghost" Padding="4,2" HorizontalAlignment="Left" ToolTip.Tip="Play this part"
                                      Command="{Binding #Root.((vm:MainViewModel)DataContext).Player.JumpToSpeedSectionCommand}" CommandParameter="{Binding}">
                                <TextBlock Classes="mono" FontSize="11" Text="{Binding RangeText}" />
                              </Button>
                            </StackPanel>
                            <Button Grid.Column="1" Classes="ghost" Padding="7,3" VerticalAlignment="Center" ToolTip.Tip="Start at the playhead"
                                    Command="{Binding #Root.((vm:MainViewModel)DataContext).Player.SpeedStartHereCommand}" CommandParameter="{Binding}">
                              <TextBlock Text="Start here" FontSize="11" />
                            </Button>
                            <Button Grid.Column="2" Classes="ghost" Padding="7,3" VerticalAlignment="Center" ToolTip.Tip="End at the playhead"
                                    Command="{Binding #Root.((vm:MainViewModel)DataContext).Player.SpeedEndHereCommand}" CommandParameter="{Binding}">
                              <TextBlock Text="End here" FontSize="11" />
                            </Button>
                            <Button Grid.Column="3" Classes="ghost" Padding="6" VerticalAlignment="Center" ToolTip.Tip="Remove"
                                    Command="{Binding #Root.((vm:MainViewModel)DataContext).Player.RemoveSpeedSectionCommand}" CommandParameter="{Binding}">
                              <PathIcon Data="{StaticResource IcDelete}" Width="13" Height="13" />
                            </Button>
                          </Grid>
                          <ContentControl Content="{Binding Rate}" />
                          <CheckBox IsChecked="{Binding Ramp}" FontSize="12" Content="Ease in and out (speed ramp)"
                                    ToolTip.Tip="Change speed gradually over 0.6 s at each end instead of in one jump" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>


              <!-- sound and audio tracks -->
              <StackPanel Spacing="12" IsVisible="{Binding IsSoundPage}">
              <!-- sound -->
              <StackPanel Spacing="8" IsVisible="{Binding ShowAudioTools}">
                <Border Classes="fxcard">
                  <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="2">
                        <TextBlock Text="Even out loudness" FontSize="12" />
                        <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" Text="Brings exports to the same loudness YouTube and Twitch use (−14 LUFS), so quiet clips aren't too quiet." />
                      </StackPanel>
                      <ToggleSwitch Grid.Column="1" Classes="bare" IsChecked="{Binding Normalize}" />
                    </Grid>
                    <StackPanel Spacing="10" IsVisible="{Binding HasVoiceTrackChoice}">
                      <Border Classes="sep" />
                      <StackPanel Spacing="6">
                        <TextBlock Text="Voice track" FontSize="12" />
                        <ContentControl Content="{Binding VoiceTrack}" />
                      </StackPanel>
                      <StackPanel Spacing="6">
                        <TextBlock Text="Voice boost" FontSize="12" />
                        <ContentControl Content="{Binding VoiceBoost}" />
                      </StackPanel>
                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="2">
                          <TextBlock Text="Lower the game while you talk" FontSize="12" />
                          <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" Text="The other tracks duck under your voice, then come back." />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" Classes="bare" IsChecked="{Binding Duck}" />
                      </Grid>
                    </StackPanel>
                    <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" IsVisible="{Binding !HasVoiceTrackChoice}"
                               Text="Voice boost and lowering the game need the microphone on its own track: Settings, Clipping, two audio devices with Separate tracks." />
                  </StackPanel>
                </Border>
              </StackPanel>


                <Border Classes="fxcard" IsVisible="{Binding HasAudioTracks}">
                  <StackPanel Spacing="8">
                    <TextBlock Classes="label" Text="AUDIO TRACKS" />
                    <ItemsControl ItemsSource="{Binding AudioTracks}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <ToggleButton Classes="mod" IsChecked="{Binding Enabled}" Content="{Binding Label}" Margin="0,0,6,6"
                                        ToolTip.Tip="Switched off: this track is left out of exports. Playback uses the first track that is on." />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" Text="Export keeps the tracks that are on. Share presets mix them into one." />
                  </StackPanel>
                </Border>
              </StackPanel>

              <!-- watermark, intro, outro -->
              <StackPanel Spacing="8" IsVisible="{Binding IsBrandPage}">
                <Border Classes="fxcard">
                  <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="2">
                        <TextBlock Text="Watermark" FontSize="12" />
                        <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" Text="{Binding WatermarkName}" />
                      </StackPanel>
                      <ToggleSwitch Grid.Column="1" Classes="bare" IsChecked="{Binding UseWatermark}" IsEnabled="{Binding HasWatermark}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="2">
                        <TextBlock Text="Intro clip" FontSize="12" />
                        <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" Text="{Binding IntroName}" />
                      </StackPanel>
                      <ToggleSwitch Grid.Column="1" Classes="bare" IsChecked="{Binding UseIntro}" IsEnabled="{Binding HasIntro}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="2">
                        <TextBlock Text="Outro clip" FontSize="12" />
                        <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" Text="{Binding OutroName}" />
                      </StackPanel>
                      <ToggleSwitch Grid.Column="1" Classes="bare" IsChecked="{Binding UseOutro}" IsEnabled="{Binding HasOutro}" />
                    </Grid>
                    <Button Classes="soft" HorizontalAlignment="Left" Padding="10,5" FontSize="12" Content="Set up in Settings…"
                            Command="{Binding #Root.((vm:MainViewModel)DataContext).OpenEditingSettingsCommand}" />
                  </StackPanel>
                </Border>
              </StackPanel>


              <!-- export and share -->
              <StackPanel Spacing="12" IsVisible="{Binding IsSharePage}">
                <Border Classes="fxcard">
                  <StackPanel Spacing="10">
                    <TextBlock Classes="label" Text="EXPORT CLIP" />
                    <RadioButton GroupName="exportmode" IsChecked="{Binding !PreciseExport}">
                      <StackPanel Spacing="2">
                        <TextBlock Text="Lossless" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" Text="Instant, no quality loss. The start snaps to the keyframe before your In point." />
                      </StackPanel>
                    </RadioButton>
                    <RadioButton GroupName="exportmode" IsChecked="{Binding PreciseExport}">
                      <StackPanel Spacing="2">
                        <TextBlock Text="Precise" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" Text="Frame-accurate. Re-encodes to H.264, so it takes a little while. Effects always export this way." />
                      </StackPanel>
                    </RadioButton>
                  </StackPanel>
                </Border>
                <Border Classes="fxcard">
                  <StackPanel Spacing="8">
                    <TextBlock Classes="label" Text="SHARE" />
                    <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" Text="Converts the selection (or the whole video) and saves it next to the original." />
                    <Button Classes="preset" Command="{Binding ShareCommand}" CommandParameter="Discord10">
                      <StackPanel Spacing="1">
                        <TextBlock Text="Discord" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock Classes="dim" FontSize="11" Text="Fits in 10 MB" />
                      </StackPanel>
                    </Button>
                    <Button Classes="preset" Command="{Binding ShareCommand}" CommandParameter="Discord50">
                      <StackPanel Spacing="1">
                        <TextBlock Text="Discord Nitro Basic" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock Classes="dim" FontSize="11" Text="Fits in 50 MB" />
                      </StackPanel>
                    </Button>
                    <Button Classes="preset" Command="{Binding ShareCommand}" CommandParameter="Vertical">
                      <StackPanel Spacing="1">
                        <TextBlock Text="Vertical 9:16" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock Classes="dim" FontSize="11" Text="Shorts, Reels and TikTok" />
                      </StackPanel>
                    </Button>
                    <Button Classes="preset" Command="{Binding ShareCommand}" CommandParameter="Gif">
                      <StackPanel Spacing="1">
                        <TextBlock Text="GIF" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock Classes="dim" FontSize="11" Text="Up to 20 seconds" />
                      </StackPanel>
                    </Button>
                  </StackPanel>
                </Border>
              </StackPanel>

              <Button Classes="ghost" HorizontalAlignment="Center" FontSize="12" Content="Remove all captions and speed changes"
                      Command="{Binding ClearEffectsCommand}" IsVisible="{Binding ShowClearEffects}" />
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>
      </Grid>

      <!-- Controls -->
      <Border Grid.Row="2" Background="{DynamicResource Bg1}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0"
              Padding="18,4,18,10" x:Name="ControlsPanel">
        <StackPanel Spacing="6">
          <c:TrimTimeline Duration="{Binding Duration}" Position="{Binding Position}"
                          InPoint="{Binding InPoint}" OutPoint="{Binding OutPoint}"
                          SeekCommand="{Binding SeekCommand}" Accent="{DynamicResource Accent}" RangeBrush="{DynamicResource Cyan}"
                          Segments="{Binding SegmentRanges}" Markers="{Binding Markers}" Effects="{Binding EffectRanges}" />

          <!-- Transport row -->
          <Grid ColumnDefinitions="*,Auto,*">
            <Button Classes="ghost" Padding="4,2" Margin="-4,0,0,0" VerticalAlignment="Center" Command="{Binding ToggleClockCommand}"
                    ToolTip.Tip="Click to switch between tenths of a second and frames">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Classes="mono" Text="{Binding PositionText}" FontSize="13" />
                <TextBlock Classes="dim mono" Text="/" FontSize="13" Margin="4,0" />
                <TextBlock Classes="dim mono" Text="{Binding DurationText}" FontSize="13" />
              </StackPanel>
            </Button>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
              <Button Classes="ghost" Command="{Binding StepFrameBackCommand}" ToolTip.Tip="Previous frame (,)" VerticalAlignment="Center">
                <PathIcon Data="{StaticResource IcFramePrev}" />
              </Button>
              <Button Classes="ghost" Command="{Binding SkipBackCommand}" ToolTip.Tip="Back 5 s (Shift+←)" VerticalAlignment="Center">
                <PathIcon Data="{StaticResource IcRewind}" />
              </Button>
              <Button Classes="play" Command="{Binding TogglePlayCommand}" ToolTip.Tip="Play / pause (Space)" Margin="6,0">
                <Panel>
                  <PathIcon Data="{StaticResource IcPlay}" Width="20" Height="20" Margin="3,0,0,0" Foreground="{DynamicResource Bg0}" IsVisible="{Binding !IsPlaying}" />
                  <PathIcon Data="{StaticResource IcPause}" Width="20" Height="20" Foreground="{DynamicResource Bg0}" IsVisible="{Binding IsPlaying}" />
                </Panel>
              </Button>
              <Button Classes="ghost" Command="{Binding SkipForwardCommand}" ToolTip.Tip="Forward 5 s (Shift+→)" VerticalAlignment="Center">
                <PathIcon Data="{StaticResource IcForward}" />
              </Button>
              <Button Classes="ghost" Command="{Binding StepFrameCommand}" ToolTip.Tip="Next frame (.)" VerticalAlignment="Center">
                <PathIcon Data="{StaticResource IcFrameNext}" />
              </Button>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right" VerticalAlignment="Center">
              <Button Classes="ghost" Classes.on="{Binding LoopRange}" Command="{Binding AbLoopCommand}" ToolTip.Tip="{Binding AbTip}" MinWidth="54">
                <StackPanel Orientation="Horizontal" Spacing="5">
                  <PathIcon Data="{StaticResource IcLoop}" Width="13" Height="13" />
                  <TextBlock Text="{Binding AbText}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Classes="ghost" Classes.on="{Binding IsRateChanged}" ToolTip.Tip="Playback speed (Shift+, slower, Shift+. faster)" MinWidth="52">
                <TextBlock Text="{Binding RateText}" FontSize="13" FontWeight="SemiBold" />
                <Button.Flyout>
                  <Flyout Placement="TopEdgeAlignedRight">
                    <StackPanel Spacing="2" MinWidth="150">
                      <TextBlock Classes="label" Text="SPEED" Margin="8,0,0,6" />
                      <ItemsControl ItemsSource="{Binding RateOptions}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:RateOption">
                            <Button Classes="menurow" Classes.on="{Binding IsCurrent}" Content="{Binding Label}" Click="OnFlyoutRowClick"
                                    Command="{Binding #Root.((vm:MainViewModel)DataContext).Player.SetRateCommand}" CommandParameter="{Binding}" />
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Flyout>
                </Button.Flyout>
              </Button>
              <Button Classes="ghost" Command="{Binding ToggleMuteCommand}" ToolTip.Tip="Mute (M)">
                <Panel>
                  <PathIcon Data="{StaticResource IcVolume}" IsVisible="{Binding !IsMuted}" />
                  <PathIcon Data="{StaticResource IcMute}" IsVisible="{Binding IsMuted}" />
                </Panel>
              </Button>
              <Slider Width="110" Minimum="0" Maximum="125" Value="{Binding Volume}" VerticalAlignment="Center" Margin="0,-6,8,-6" />
              <Button Classes="ghost" Click="OnFullscreenClick" ToolTip.Tip="Fullscreen (F)">
                <PathIcon Data="{StaticResource IcFullscreen}" />
              </Button>
            </StackPanel>
          </Grid>


          <!-- Tool bar: the everyday tools as buttons -->
          <Grid Margin="0,2,0,0">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Button Classes="tool" Command="{Binding SetInCommand}" ToolTip.Tip="Start the selection at the playhead (I)">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="In" FontWeight="SemiBold" VerticalAlignment="Center" />
                  <TextBlock Classes="mono" Text="{Binding InText}" Foreground="{DynamicResource Cyan}" FontSize="12" VerticalAlignment="Center" />
                  <TextBlock Classes="hint" Text="I" />
                </StackPanel>
              </Button>
              <Button Classes="tool" Command="{Binding SetOutCommand}" ToolTip.Tip="End the selection at the playhead (O)">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="Out" FontWeight="SemiBold" VerticalAlignment="Center" />
                  <TextBlock Classes="mono" Text="{Binding OutText}" Foreground="{DynamicResource Cyan}" FontSize="12" VerticalAlignment="Center" />
                  <TextBlock Classes="hint" Text="O" />
                </StackPanel>
              </Button>
              <Button Classes="tool" Command="{Binding PreviewRangeCommand}" ToolTip.Tip="Play the selection (P)" IsEnabled="{Binding HasRange}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Data="{StaticResource IcPlay}" />
                  <TextBlock Text="Play" VerticalAlignment="Center" />
                  <TextBlock Classes="hint" Text="P" />
                </StackPanel>
              </Button>
              <ToggleButton Classes="tool" IsChecked="{Binding LoopRange}" IsEnabled="{Binding HasRange}" ToolTip.Tip="Loop the selection (L)">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Data="{StaticResource IcLoop}" />
                  <TextBlock Text="Loop" VerticalAlignment="Center" />
                  <TextBlock Classes="hint" Text="L" />
                </StackPanel>
              </ToggleButton>
              <Button Classes="tool" Command="{Binding ClearRangeCommand}" ToolTip.Tip="Clear In and Out (X)">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Data="{StaticResource IcClose}" />
                  <TextBlock Text="Clear" VerticalAlignment="Center" />
                  <TextBlock Classes="hint" Text="X" />
                </StackPanel>
              </Button>
              <Button Classes="tool" Command="{Binding AddSegmentCommand}" ToolTip.Tip="Keep this selection as one part and mark another; Export joins all parts (A)" IsEnabled="{Binding HasRange}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Data="{StaticResource IcAdd}" />
                  <TextBlock Text="Add part" VerticalAlignment="Center" />
                  <TextBlock Classes="hint" Text="A" />
                </StackPanel>
              </Button>
              <Border Classes="toolsep" />
              <Button Classes="tool" Command="{Binding NextMarkerCommand}" ToolTip.Tip="Jump to the next loud moment or bookmark (N; Shift+N goes back)" IsEnabled="{Binding HasMarkers}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Data="{StaticResource IcMarker}" />
                  <TextBlock Text="Next marker" VerticalAlignment="Center" />
                  <TextBlock Classes="hint" Text="N" />
                </StackPanel>
              </Button>
              <Border Classes="toolsep" />
              <Button Classes="tool" Command="{Binding AddCaptionCommand}" ToolTip.Tip="Add a caption at the playhead (C)" IsVisible="{Binding ShowCaptionTools}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Data="{StaticResource IcText}" />
                  <TextBlock Text="Caption" VerticalAlignment="Center" />
                  <TextBlock Classes="hint" Text="C" />
                </StackPanel>
              </Button>
              <Button Classes="tool" Command="{Binding AddSpeedSectionCommand}" ToolTip.Tip="Slow down or speed up part of the clip, starting at the playhead" IsVisible="{Binding ShowSpeedTools}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Data="{StaticResource IcSpeed}" />
                  <TextBlock Text="Slow-mo" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Border Classes="toolsep" />
              <Button Classes="tool" Command="{Binding #Root.((vm:MainViewModel)DataContext).UseFrameAsThumbnailCommand}" ToolTip.Tip="Use this frame as the video's thumbnail in the library (T)">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Data="{StaticResource IcImage}" />
                  <TextBlock Text="Thumbnail" VerticalAlignment="Center" />
                  <TextBlock Classes="hint" Text="T" />
                </StackPanel>
              </Button>
              <Button Classes="tool" Command="{Binding #Root.((vm:MainViewModel)DataContext).SaveFrameCommand}" ToolTip.Tip="Save this frame as a PNG next to the video (G)">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Data="{StaticResource IcCamera}" />
                  <TextBlock Text="Save frame" VerticalAlignment="Center" />
                  <TextBlock Classes="hint" Text="G" />
                </StackPanel>
              </Button>
            </WrapPanel>

          </Grid>
        </StackPanel>
      </Border>
    </Grid>
  </Panel>
  </DockPanel>
  </LayoutTransformControl>
</Window>
