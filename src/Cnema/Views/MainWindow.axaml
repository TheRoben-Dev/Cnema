<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Cnema.ViewModels"
        xmlns:c="using:Cnema.Controls"
        xmlns:svc="using:Cnema.Services"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
        x:Class="Cnema.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        x:Name="Root"
        Title="Savefile"
        Icon="/Assets/cnema.png"
        Width="1320" Height="840" MinWidth="820" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bg0}"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="52">

  <Window.DataTemplates>
    <!-- A "pick one" row of chips (caption position, speed, voice track...) -->
    <DataTemplate DataType="vm:ChipGroup" x:DataType="vm:ChipGroup">
      <Border Classes="chipbar">
        <ItemsControl ItemsSource="{Binding Chips}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="1" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:OptionChip">
              <Button Classes="chip" Classes.on="{Binding IsOn}" Content="{Binding Label}" Command="{Binding PickCommand}"
                      ToolTip.Tip="{Binding Tip}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>
    </DataTemplate>

    <!-- The export queue, shown from the Exports button in the library and the editor -->
    <DataTemplate DataType="vm:ExportQueueViewModel" x:DataType="vm:ExportQueueViewModel">
      <StackPanel Width="380" Spacing="6">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Classes="label" svc:Tr.Text="EXPORTS" VerticalAlignment="Center" Margin="4,0,0,0" />
          <Button Grid.Column="1" Classes="ghost" FontSize="11" svc:Tr.Content="Clear finished" Padding="8,3"
                  IsVisible="{Binding HasFinished}" Command="{Binding ClearFinishedCommand}" />
        </Grid>
        <ScrollViewer MaxHeight="420">
          <ItemsControl ItemsSource="{Binding Jobs}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ExportJobViewModel">
                <Border Classes="fxcard" Margin="0,0,0,6" Padding="10,8">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="3">
                      <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Target}" />
                      <TextBlock Classes="dim" Text="{Binding Detail}" FontSize="11" />
                      <ProgressBar Value="{Binding Progress}" Height="4" MinHeight="4" CornerRadius="2" Margin="0,3,0,1" IsVisible="{Binding IsRunning}" />
                      <TextBlock Text="{Binding Status}" FontSize="11" TextWrapping="Wrap" Classes.err="{Binding IsFailed}" Classes.dim="{Binding !IsFailed}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="6,0,0,0">
                      <Button Classes="ghost" Padding="6" svc:Tr.Tip="Show in folder" IsVisible="{Binding IsDone}"
                              Command="{Binding #Root.((vm:MainViewModel)DataContext).Exports.RevealCommand}" CommandParameter="{Binding}">
                        <PathIcon Data="{StaticResource IcFolder}" Width="13" Height="13" />
                      </Button>
                      <Button Classes="ghost" Padding="6" svc:Tr.Tip="Cancel this export" IsVisible="{Binding CanCancel}"
                              Command="{Binding #Root.((vm:MainViewModel)DataContext).Exports.CancelCommand}" CommandParameter="{Binding}">
                        <PathIcon Data="{StaticResource IcClose}" Width="11" Height="11" />
                      </Button>
                      <Button Classes="ghost" Padding="6" svc:Tr.Tip="Remove from the list" IsVisible="{Binding IsFinished}"
                              Command="{Binding #Root.((vm:MainViewModel)DataContext).Exports.RemoveCommand}" CommandParameter="{Binding}">
                        <PathIcon Data="{StaticResource IcClose}" Width="11" Height="11" />
                      </Button>
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" Margin="4,0"
                   svc:Tr.Text="Exports run one at a time while you keep working. Quitting Savefile stops them." />
      </StackPanel>
    </DataTemplate>
  </Window.DataTemplates>

  <LayoutTransformControl x:Name="Scaler">
  <DockPanel>
  <Panel x:Name="RootPanel">
    <!-- ======================= LIBRARY ======================= -->
    <Grid ColumnDefinitions="248,*" IsVisible="{Binding !IsPlayerOpen}">

      <!-- Sidebar -->
      <Border Grid.Column="0" Background="{DynamicResource Bg1}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
        <Panel>
        <DockPanel Margin="14,0,14,14">
          <!-- top spacer under the macOS traffic lights / drag area -->
          <Border x:Name="SidebarInset" DockPanel.Dock="Top" Height="0" IsHitTestVisible="False" />

          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="6,6,0,22">
            <!-- The Savefile mark (a memory card with a play button) drawn straight onto the sidebar in the
                 colour scheme's accent, without the app icon's square, so it belongs to the window. -->
            <Viewbox Width="24" Height="30" VerticalAlignment="Center" Margin="2,0,0,0">
              <Canvas Width="240" Height="324">
                <Path Data="M14 0H194L240 46V296A28 28 0 0 1 212 324H28A28 28 0 0 1 0 296V14A14 14 0 0 1 14 0Z" Fill="{DynamicResource Accent}" />
                <Path Data="M40 260h18v40h-18z M76 260h18v40h-18z M112 260h18v40h-18z M148 260h18v40h-18z M184 260h18v40h-18z" Fill="{DynamicResource Bg1}" Opacity="0.45" />
                <Path Data="M92 90L92 194L174 142Z" Fill="{DynamicResource Bg1}" Stroke="{DynamicResource Bg1}" StrokeThickness="24" StrokeJoin="Round" />
              </Canvas>
            </Viewbox>
            <TextBlock Text="savefile" FontSize="20" FontWeight="Bold" LetterSpacing="-0.3" VerticalAlignment="Center" />
          </StackPanel>

          <!-- bottom: add folder + warnings -->
          <StackPanel DockPanel.Dock="Bottom" Spacing="10">
            <!-- indexing: the blob looking through your clips while the smart features work; details on click -->
            <Button x:Name="IndexCard" Classes="indexcard" HorizontalAlignment="Stretch" IsVisible="{Binding ShowIndexing}"
                    svc:Tr.Tip="What Savefile is doing">
              <Grid ColumnDefinitions="Auto,*">
                <c:BlobMascot Width="52" Height="48" Reading="True" Still="{Binding ReducedMotion}" CheerTick="{Binding IndexCheer}" MaxFps="30" />
                <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" Spacing="3">
                  <TextBlock Text="{Binding IndexTitle}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" />
                  <TextBlock Classes="dim" Text="{Binding IndexCount}" FontSize="11" />
                  <ProgressBar Minimum="0" Maximum="1" Value="{Binding IndexProgress}" Height="3" MinHeight="3" MinWidth="0" CornerRadius="2" />
                </StackPanel>
              </Grid>
              <Button.Flyout>
                <Flyout Placement="RightEdgeAlignedBottom">
                  <StackPanel Width="310" Spacing="12" Margin="6">
                    <StackPanel Spacing="3">
                      <TextBlock svc:Tr.Text="Looking through your clips" FontSize="14" FontWeight="Bold" />
                      <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap"
                                 svc:Tr.Text="Finding the best moments and learning what's in each video, so search and Worth a rewatch can find them. It all happens on this computer and gives way to your games." />
                    </StackPanel>
                    <StackPanel Spacing="8">
                      <StackPanel Spacing="1" IsVisible="{Binding HasMomentsActivity}">
                        <TextBlock svc:Tr.Text="Best moments" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock Classes="dim" Text="{Binding SmartActivity}" FontSize="11" TextWrapping="Wrap" />
                      </StackPanel>
                      <StackPanel Spacing="1" IsVisible="{Binding HasSpeechActivity}">
                        <TextBlock svc:Tr.Text="What's said" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock Classes="dim" Text="{Binding SpeechActivity}" FontSize="11" TextWrapping="Wrap" />
                      </StackPanel>
                      <StackPanel Spacing="1" IsVisible="{Binding HasVisualActivity}">
                        <TextBlock svc:Tr.Text="What's on screen" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock Classes="dim" Text="{Binding VisualActivity}" FontSize="11" TextWrapping="Wrap" />
                      </StackPanel>
                      <StackPanel Spacing="1" IsVisible="{Binding HasSoundActivity}">
                        <TextBlock svc:Tr.Text="Laughter and hype" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock Classes="dim" Text="{Binding SoundActivity}" FontSize="11" TextWrapping="Wrap" />
                      </StackPanel>
                      <StackPanel Spacing="1" IsVisible="{Binding HasVoiceActivity}">
                        <TextBlock svc:Tr.Text="Who's talking" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock Classes="dim" Text="{Binding VoiceActivity}" FontSize="11" TextWrapping="Wrap" />
                      </StackPanel>
                      <StackPanel Spacing="1" IsVisible="{Binding HasScreenActivity}">
                        <TextBlock svc:Tr.Text="Text on screen" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock Classes="dim" Text="{Binding ScreenActivity}" FontSize="11" TextWrapping="Wrap" />
                      </StackPanel>
                    </StackPanel>
                    <Button Classes="soft" HorizontalAlignment="Left" Content="{Binding IndexPauseText}" Command="{Binding ToggleIndexPauseCommand}" />
                  </StackPanel>
                </Flyout>
              </Button.Flyout>
            </Button>
            <!-- Mochi carrying a box while a backup runs (Settings, Features, Mochi, Helps with backups) -->
            <Border Classes="mochicard" IsVisible="{Binding ShowBackupBuddy}">
              <Grid ColumnDefinitions="Auto,*">
                <c:BlobMascot Width="46" Height="44" Mood="Carrying" Hat="{Binding MochiHat}" Still="{Binding ReducedMotion}" MaxFps="30" />
                <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" Spacing="2">
                  <TextBlock svc:Tr.Text="Taking your clips to your server" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" />
                  <TextBlock Classes="dim" Text="{Binding BackupActivity}" FontSize="11" />
                </StackPanel>
              </Grid>
            </Border>
            <Border IsVisible="{Binding FfmpegMissing}" Background="{DynamicResource AccentSoft}" CornerRadius="8" Padding="10">
              <StackPanel Spacing="4">
                <c:BlobMascot Width="40" Height="36" HorizontalAlignment="Left" Mood="Puzzled" Hat="{Binding MochiHat}" Still="{Binding ReducedMotion}" MaxFps="24"
                              IsVisible="{Binding ShowMochiHelper}" />
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Data="{StaticResource IcWarn}" Width="13" Height="13" Foreground="{DynamicResource Accent}" />
                  <TextBlock svc:Tr.Text="ffmpeg not found" FontWeight="SemiBold" FontSize="12" />
                </StackPanel>
                <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap"
                           svc:Tr.Text="Thumbnails and clip export need it. Install, then restart:" />
                <SelectableTextBlock Classes="mono" FontSize="11" Text="{Binding FfmpegHint}" Foreground="{DynamicResource Accent}" />
              </StackPanel>
            </Border>
            <Border IsVisible="{Binding HasVlcError}" Background="#26FF6B6B" CornerRadius="8" Padding="10">
              <StackPanel Spacing="4">
                <c:BlobMascot Width="40" Height="36" HorizontalAlignment="Left" Mood="Puzzled" Hat="{Binding MochiHat}" Still="{Binding ReducedMotion}" MaxFps="24"
                              IsVisible="{Binding ShowMochiHelper}" />
                <TextBlock Text="{Binding VlcError}" FontSize="11" TextWrapping="Wrap" />
                <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" IsVisible="{Binding ShowMochiHelper}"
                           svc:Tr.Text="Mochi's fix: download Savefile again and replace the app. It brings its own video player, so nothing else needs installing." />
              </StackPanel>
            </Border>
            <Button Classes="updatebar" HorizontalAlignment="Stretch" Command="{Binding OpenUpdateCommand}" IsVisible="{Binding HasUpdate}"
>
              <StackPanel Spacing="4">
                <TextBlock Text="{Binding UpdateText}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding UpdateAction}" FontSize="11" Foreground="{DynamicResource Highlight}" />
                <ProgressBar Minimum="0" Maximum="1" Value="{Binding UpdateProgress}" Height="3" MinHeight="3" MinWidth="0"
                             IsVisible="{Binding IsInstallingUpdate}" />
              </StackPanel>
            </Button>
            <!-- background clipping status -->
            <Border Classes="clipbar" Classes.on="{Binding IsClipRecording}" Classes.err="{Binding IsClipError}" IsVisible="{Binding ShowClipping}">
              <StackPanel Spacing="8">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <Ellipse Classes="clipdot" Width="8" Height="8" VerticalAlignment="Center" Margin="2,0,8,0" />
                  <TextBlock Grid.Column="1" Text="{Binding ClipTitle}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                  <ToggleSwitch x:Name="ClipToggle" Grid.Column="2" IsChecked="{Binding IsClipEnabled, Mode=OneWay}" Command="{Binding ToggleClippingCommand}"
                                OnContent="" OffContent="" MinWidth="0" Margin="0,-6,-6,-6" svc:Tr.Tip="Turn background clipping on or off" />
                </Grid>
                <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" Text="{Binding ClipDetail}" IsVisible="{Binding HasClipDetail}" />
                <Button x:Name="SquadButton" Classes="squad" Classes.on="{Binding HasSquad}" IsVisible="{Binding ShowPlayingWith}"
                        Command="{Binding EditSquadCommand}" svc:Tr.Tip="Friends you're playing with get tagged on every clip you save">
                  <Grid ColumnDefinitions="Auto,*">
                    <PathIcon Data="{StaticResource IcPeople}" Width="13" Height="13" Margin="0,0,7,0" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding PlayingWithLabel}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" />
                  </Grid>
                  <Button.Flyout>
                    <Flyout Placement="RightEdgeAlignedTop">
                      <StackPanel Width="260" Spacing="10" Margin="4">
                        <TextBlock svc:Tr.Text="Who are you playing with?" FontWeight="SemiBold" />
                        <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap"
                                   svc:Tr.Text="They get tagged on every clip and session you save, until you clear it." />
                        <TextBox x:Name="SquadBox" Classes="field" Text="{Binding SquadText}" svc:Tr.Watermark="Names, separated by commas"
                                 KeyDown="OnSquadKeyDown" />
                        <ItemsControl ItemsSource="{Binding SquadSuggestions}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                              <Button Classes="chip" Content="{Binding}" Margin="0,0,6,6"
                                      Command="{Binding #Root.((vm:MainViewModel)DataContext).AddToSquadCommand}" CommandParameter="{Binding}" />
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                          <Button Classes="soft" svc:Tr.Content="Clear" Command="{Binding ClearSquadCommand}" Click="OnSquadDone" />
                          <Button Classes="accent" svc:Tr.Content="Save" Command="{Binding SaveSquadCommand}" Click="OnSquadDone" />
                        </StackPanel>
                      </StackPanel>
                    </Flyout>
                  </Button.Flyout>
                </Button>
                <Button x:Name="SaveClipButton" Classes="accent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="10,7"
                        Command="{Binding SaveClipCommand}" IsVisible="{Binding IsClipRecording}">
                  <StackPanel Orientation="Horizontal" Spacing="7">
                    <PathIcon Data="{StaticResource IcCut}" Width="13" Height="13" />
                    <TextBlock Text="{Binding SaveClipLabel}" FontWeight="SemiBold" FontSize="12" />
                  </StackPanel>
                </Button>
                <Button x:Name="SessionButton" Classes="soft" Classes.rec="{Binding IsSession}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="10,7"
                        Command="{Binding ToggleSessionCommand}" IsVisible="{Binding ShowSessionButton}"
                        svc:Tr.Tip="Record everything from now until you stop, as one video. The clip hotkey adds bookmarks.">
                  <StackPanel Orientation="Horizontal" Spacing="7">
                    <Ellipse Width="8" Height="8" Fill="#FF4D6D" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding SessionLabel}" FontWeight="SemiBold" FontSize="12" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </Border>
            <Grid ColumnDefinitions="*,Auto">
              <Button x:Name="AddFolderButton" Classes="soft" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                      Command="{Binding AddFolderCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <PathIcon Data="{StaticResource IcAdd}" Width="14" Height="14" />
                  <TextBlock Text="{Binding AddFolderLabel}" FontWeight="SemiBold" />
                </StackPanel>
              </Button>
              <Button x:Name="SettingsButton" Grid.Column="1" Classes="soft" Margin="8,0,0,0" Padding="10" VerticalAlignment="Stretch"
                      Command="{Binding OpenSettingsCommand}" svc:Tr.Tip="Settings">
                <PathIcon Data="{StaticResource IcSettings}" Width="15" Height="15" />
              </Button>
            </Grid>
          </StackPanel>

          <ScrollViewer VerticalScrollBarVisibility="Hidden">
            <StackPanel>
              <TextBlock Classes="label" svc:Tr.Text="LIBRARY" Margin="10,0,0,8" />
          <ListBox x:Name="FolderList" Classes="nav" ItemsSource="{Binding Folders}" SelectedItem="{Binding SelectedFolder}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:FolderViewModel">
                <Grid ColumnDefinitions="Auto,*,Auto" ToolTip.Tip="{Binding Tooltip}" Background="Transparent">
                  <Grid.ContextMenu>
                    <ContextMenu IsVisible="{Binding IsRemovable}">
                      <MenuItem svc:Tr.Header="Show in file manager" Click="OnRevealFolderClick" />
                      <MenuItem svc:Tr.Header="Remove from library" Click="OnRemoveFolderClick" />
                    </ContextMenu>
                  </Grid.ContextMenu>
                  <PathIcon Classes="navicon" Grid.Column="0" Width="15" Height="15" Margin="0,0,10,0"
                            Foreground="{DynamicResource TextDim}"
                            Data="{Binding Kind, Converter={x:Static c:Converters.NavIcon}}" />
                  <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                  <!-- The count, swapped for a remove button on hover, so every row's count lines up -->
                  <Panel Grid.Column="2" Classes.removable="{Binding IsRemovable}" Margin="6,0,0,0" VerticalAlignment="Center">
                    <TextBlock Classes="dim count" Text="{Binding Count}" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right" />
                    <Button Classes="ghost remove" Padding="3" Margin="0,-4,-4,-4" HorizontalAlignment="Right"
                            IsVisible="{Binding IsRemovable}" svc:Tr.Tip="Remove folder"
                            Command="{Binding #Root.((vm:MainViewModel)DataContext).RemoveFolderCommand}"
                            CommandParameter="{Binding}">
                      <PathIcon Data="{StaticResource IcClose}" Width="11" Height="11" Foreground="{DynamicResource TextDim}" />
                    </Button>
                  </Panel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
              <!-- Savefile's bin: every delete goes here first (Settings, Features, Savefile bin) -->
              <Button x:Name="BinNav" Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="10,8" Margin="0,2,0,0"
                      IsVisible="{Binding ShowBinNav}" Command="{Binding OpenBinCommand}" svc:Tr.Tip="Deleted videos wait here for 24 hours">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <PathIcon Width="15" Height="15" Margin="0,0,10,0" Foreground="{DynamicResource TextDim}" Data="{StaticResource IcDelete}" />
                  <TextBlock Grid.Column="1" svc:Tr.Text="Bin" FontSize="13" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2" Classes="dim" Text="{Binding BinCountText}" FontSize="11" VerticalAlignment="Center" />
                </Grid>
              </Button>
              <StackPanel IsVisible="{Binding ShowCollections}">
                <Grid ColumnDefinitions="*,Auto" Margin="10,22,0,4">
                  <TextBlock Classes="label" svc:Tr.Text="COLLECTIONS" VerticalAlignment="Center" />
                  <Button Grid.Column="1" Classes="ghost" Padding="4" svc:Tr.Tip="New collection" Command="{Binding NewCollectionCommand}">
                    <PathIcon Data="{StaticResource IcAdd}" Width="12" Height="12" Foreground="{DynamicResource TextDim}" />
                  </Button>
                </Grid>
                <TextBox x:Name="CollectionNameBox" Margin="4,2,4,6" CornerRadius="8" FontSize="12" svc:Tr.Watermark="Collection name, then Enter"
                         Text="{Binding CollectionName}" IsVisible="{Binding IsNamingCollection}" KeyDown="OnCollectionNameKeyDown" />
                <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" Margin="10,0,8,4"
                           IsVisible="{Binding !HasCollections}" svc:Tr.Text="Group videos from any folders. Right-click a video to add it." />
                <ListBox x:Name="CollectionList" Classes="nav" ItemsSource="{Binding Collections}" SelectedItem="{Binding SelectedCollection}">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:FolderViewModel">
                      <Grid ColumnDefinitions="Auto,*,Auto" ToolTip.Tip="{Binding Tooltip}" Background="Transparent">
                        <Grid.ContextMenu>
                          <ContextMenu>
                            <MenuItem svc:Tr.Header="Rename…" Click="OnRenameCollectionClick" />
                            <MenuItem svc:Tr.Header="Delete collection" Click="OnDeleteCollectionClick" />
                          </ContextMenu>
                        </Grid.ContextMenu>
                        <PathIcon Classes="navicon" Grid.Column="0" Width="15" Height="15" Margin="0,0,10,0"
                                  Foreground="{DynamicResource TextDim}" Data="{StaticResource IcCollection}" />
                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Classes="dim" Text="{Binding Count}" FontSize="11" VerticalAlignment="Center" Margin="6,0,0,0" />
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </StackPanel>
              <StackPanel IsVisible="{Binding ShowTools}" Margin="0,22,0,0">
                <TextBlock Classes="label" svc:Tr.Text="TOOLS" Margin="10,0,0,8" />
                <Button x:Name="CleanupButton" Classes="navbutton" IsVisible="{Binding ShowCleanUp}" Command="{Binding OpenCleanupCommand}"
                        svc:Tr.Tip="Find duplicates and broken, empty or very short files">
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <PathIcon Data="{StaticResource IcBroom}" Width="15" Height="15" Foreground="{DynamicResource TextDim}" />
                    <TextBlock svc:Tr.Text="Clean up" FontSize="13" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <Button x:Name="StatsButton" Classes="navbutton" IsVisible="{Binding ShowStats}" Command="{Binding OpenStatsCommand}"
                        svc:Tr.Tip="Numbers about your library and clips">
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <PathIcon Data="{StaticResource IcStats}" Width="15" Height="15" Foreground="{DynamicResource TextDim}" />
                    <TextBlock svc:Tr.Text="Stats" FontSize="13" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <Button x:Name="ShrinkButton" Classes="navbutton" IsVisible="{Binding ShowShrink}" Command="{Binding OpenShrinkCommand}"
                        svc:Tr.Tip="Win back space from big videos you don't watch, without losing quality">
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <PathIcon Data="{StaticResource IcCompress}" Width="15" Height="15" Foreground="{DynamicResource TextDim}" />
                    <TextBlock svc:Tr.Text="Make room" FontSize="13" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <Button x:Name="SmartRenameButton" Classes="navbutton" IsVisible="{Binding ShowSmartTitles}" Command="{Binding OpenSmartRenameCommand}"
                        svc:Tr.Tip="Better names for your clips, from the game, who was there and when">
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <PathIcon Data="{StaticResource IcEdit}" Width="15" Height="15" Foreground="{DynamicResource TextDim}" />
                    <TextBlock svc:Tr.Text="Smart rename" FontSize="13" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <Button x:Name="RecapButton" Classes="navbutton" IsVisible="{Binding ShowRecap}" Command="{Binding OpenRecapCommand}"
                        svc:Tr.Tip="Look back on a year of moments with your friends">
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <PathIcon Data="{StaticResource IcSparkle}" Width="15" Height="15" Foreground="{DynamicResource TextDim}" />
                    <TextBlock svc:Tr.Text="Year in clips" FontSize="13" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <Button x:Name="MontageButton" Classes="navbutton" IsVisible="{Binding ShowMontage}" Command="{Binding OpenMontageCommand}"
                        svc:Tr.Tip="Stitch the best moments of your favourites into one video">
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <PathIcon Data="{StaticResource IcFilm}" Width="15" Height="15" Foreground="{DynamicResource TextDim}" />
                    <TextBlock svc:Tr.Text="Auto montage" FontSize="13" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <Button x:Name="RecordersButton" Classes="navbutton" IsVisible="{Binding ShowRecorders}" Command="{Binding OpenRecordersCommand}"
                        svc:Tr.Tip="Bring in videos from OBS, NVIDIA, Xbox Game Bar and Steam">
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <PathIcon Data="{StaticResource IcImport}" Width="15" Height="15" Foreground="{DynamicResource TextDim}" />
                    <TextBlock svc:Tr.Text="Other recorders" FontSize="13" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <Button x:Name="BackupButton" Classes="navbutton" IsVisible="{Binding ShowBackup}" Command="{Binding OpenBackupCommand}"
                        svc:Tr.Tip="Back your videos up to your own server">
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <PathIcon Data="{StaticResource IcCloud}" Width="15" Height="15" Foreground="{DynamicResource TextDim}" />
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock svc:Tr.Text="Backup" FontSize="13" />
                      <TextBlock Text="{Binding BackupActivity}" FontSize="10" Foreground="{DynamicResource Highlight}"
                                 IsVisible="{Binding BackupActivity, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                  </StackPanel>
                </Button>
              </StackPanel>
              <TextBlock Classes="label" svc:Tr.Text="FRIENDS" Margin="10,22,0,8" IsVisible="{Binding HasFriends}" />
              <TextBox Margin="4,2,4,6" CornerRadius="8" FontSize="12" svc:Tr.Watermark="New name, then Enter"
                       x:Name="FriendRenameBox" Text="{Binding RenameText}" IsVisible="{Binding IsRenamingFriend}" KeyDown="OnRenameNameKeyDown" />
              <ListBox x:Name="FriendList" Classes="nav" ItemsSource="{Binding Friends}" SelectedItem="{Binding SelectedFriend}" IsVisible="{Binding HasFriends}">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:FolderViewModel">
                    <Grid ColumnDefinitions="Auto,*,Auto" ToolTip.Tip="{Binding Tooltip}" Background="Transparent">
                      <Grid.ContextMenu>
                        <ContextMenu>
                          <MenuItem svc:Tr.Header="Rename…" Click="OnRenameNameClick" />
                          <MenuItem svc:Tr.Header="Untag from all videos" Click="OnRemoveNameClick" />
                        </ContextMenu>
                      </Grid.ContextMenu>
                      <Border Grid.Column="0" Width="18" Height="18" CornerRadius="9" Margin="-1,0,9,0" VerticalAlignment="Center"
                              Background="{DynamicResource AccentSoft}">
                        <TextBlock Text="{Binding Initial}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Accent}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                      <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="2" Classes="dim" Text="{Binding Count}" FontSize="11" VerticalAlignment="Center" Margin="6,0,0,0" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <TextBlock Classes="label" svc:Tr.Text="TAGS" Margin="10,22,0,8" IsVisible="{Binding HasTags}" />
              <TextBox Margin="4,2,4,6" CornerRadius="8" FontSize="12" svc:Tr.Watermark="New name, then Enter"
                       x:Name="TagRenameBox" Text="{Binding RenameText}" IsVisible="{Binding IsRenamingTag}" KeyDown="OnRenameNameKeyDown" />
              <ListBox x:Name="TagList" Classes="nav" ItemsSource="{Binding Tags}" SelectedItem="{Binding SelectedTag}" IsVisible="{Binding HasTags}">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:FolderViewModel">
                    <Grid ColumnDefinitions="Auto,*,Auto" ToolTip.Tip="{Binding Tooltip}" Background="Transparent">
                      <Grid.ContextMenu>
                        <ContextMenu>
                          <MenuItem svc:Tr.Header="Rename…" Click="OnRenameNameClick" />
                          <MenuItem svc:Tr.Header="Remove from all videos" Click="OnRemoveNameClick" />
                        </ContextMenu>
                      </Grid.ContextMenu>
                      <TextBlock Classes="navicon" Grid.Column="0" Text="#" FontSize="14" FontWeight="Bold" Width="15" Margin="0,0,10,0"
                                 TextAlignment="Center" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="2" Classes="dim" Text="{Binding Count}" FontSize="11" VerticalAlignment="Center" Margin="6,0,0,0" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
        </Panel>
      </Border>

      <!-- Main pane -->
      <DockPanel Grid.Column="1" x:Name="MainPane">
        <!-- Toolbar -->
        <Grid x:Name="Toolbar" DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto,Auto" Margin="28,0,28,0"
              Height="72" Background="Transparent">
          <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2" Margin="0,0,14,0" ClipToBounds="True" Background="Transparent"
                      ToolTip.Tip="{Binding HeaderTitle}">
            <TextBlock Text="{Binding HeaderTitle}" FontSize="22" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
            <TextBlock Classes="dim" Text="{Binding HeaderCount}" FontSize="12" TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Classes="soft" VerticalAlignment="Center" Margin="0,0,10,0" Padding="12,8"
                  IsVisible="{Binding IsShowingSimilar}" Command="{Binding ClearSimilarCommand}"
                  svc:Tr.Tip="Back to all your videos">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <PathIcon Data="{StaticResource IcClose}" Width="12" Height="12" />
              <TextBlock svc:Tr.Text="Done" FontSize="13" />
            </StackPanel>
          </Button>
          <Button x:Name="PlayAllButton" Classes="soft" VerticalAlignment="Center" Margin="0,0,10,0" Padding="12,8"
                  IsVisible="{Binding CanPlayAll}" Command="{Binding PlayAllFromStartCommand}"
                  svc:Tr.Tip="Watch everything in this view, one after another">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <PathIcon Data="{StaticResource IcPlay}" Width="14" Height="14" />
              <TextBlock svc:Tr.Text="Play all" FontSize="13" />
            </StackPanel>
          </Button>
          <Button x:Name="FriendMontageButton" Classes="soft" VerticalAlignment="Center" Margin="0,0,10,0" Padding="12,8"
                  IsVisible="{Binding ShowFriendMontage}" Command="{Binding MakeFriendMontageCommand}"
                  svc:Tr.Tip="Your best moments together in one video">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <PathIcon Data="{StaticResource IcFilm}" Width="14" Height="14" />
              <TextBlock x:Name="FriendMontageLabel" svc:Tr.Text="Make a montage" FontSize="13" />
            </StackPanel>
          </Button>
          <Button x:Name="FriendWrappedButton" Classes="soft" VerticalAlignment="Center" Margin="0,0,10,0" Padding="12,8"
                  IsVisible="{Binding ShowFriendWrapped}" Command="{Binding MakeFriendWrappedCommand}" IsEnabled="{Binding !IsMakingWrapped}"
                  svc:Tr.Tip="A shorter Wrapped of only your clips together this year, cut to your Wrapped songs">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <PathIcon Data="{StaticResource IcFilm}" Width="14" Height="14" />
              <TextBlock x:Name="FriendWrappedText" Text="{Binding FriendWrappedLabel}" FontSize="13" />
            </StackPanel>
          </Button>
          <Button Classes="soft" VerticalAlignment="Center" Margin="0,0,10,0" Padding="12,8"
                  IsVisible="{Binding Exports.HasJobs}" svc:Tr.Tip="Exports running in the background">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <PathIcon Data="{StaticResource IcExport}" Width="14" Height="14" />
              <TextBlock Text="{Binding Exports.ButtonText}" FontSize="13" />
            </StackPanel>
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedRight">
                <ContentControl Content="{Binding Exports}" />
              </Flyout>
            </Button.Flyout>
          </Button>
          </StackPanel>
          <Panel Grid.Column="2" Width="260" VerticalAlignment="Center" Margin="0,0,10,0">
            <TextBox Classes="search" svc:Tr.Watermark="Search names, #tags or @friends" Text="{Binding SearchText}" x:Name="SearchBox" />
            <PathIcon Data="{StaticResource IcSearch}" Width="15" Height="15" Foreground="{DynamicResource TextDim}"
                      HorizontalAlignment="Left" Margin="12,0,0,0" IsHitTestVisible="False" />
          </Panel>
          <Button Grid.Column="3" Classes="soft" Classes.on="{Binding HasFilters}" VerticalAlignment="Center" Margin="0,0,8,0" Padding="12,8"
                  svc:Tr.Tip="Filter by resolution, length, date or watched">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <PathIcon Data="{StaticResource IcFilter}" Width="14" Height="14" />
              <TextBlock Text="{Binding FilterButtonText}" FontSize="13" />
            </StackPanel>
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedRight">
                <StackPanel Spacing="10" Width="250" Margin="4">
                  <TextBlock Classes="label" svc:Tr.Text="FILTERS" />
                  <ComboBox Classes="field" HorizontalAlignment="Stretch" ItemsSource="{x:Static vm:MainViewModel.ResolutionFilters}" SelectedIndex="{Binding FilterResolution}">
                    <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:LocalizedText"><TextBlock Text="{Binding Text}" /></DataTemplate></ComboBox.ItemTemplate>
                  </ComboBox>
                  <ComboBox Classes="field" HorizontalAlignment="Stretch" ItemsSource="{x:Static vm:MainViewModel.LengthFilters}" SelectedIndex="{Binding FilterLength}">
                    <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:LocalizedText"><TextBlock Text="{Binding Text}" /></DataTemplate></ComboBox.ItemTemplate>
                  </ComboBox>
                  <ComboBox Classes="field" HorizontalAlignment="Stretch" ItemsSource="{x:Static vm:MainViewModel.DateFilters}" SelectedIndex="{Binding FilterDate}">
                    <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:LocalizedText"><TextBlock Text="{Binding Text}" /></DataTemplate></ComboBox.ItemTemplate>
                  </ComboBox>
                  <CheckBox svc:Tr.Content="Only videos I haven't watched" IsChecked="{Binding FilterUnwatched}" IsVisible="{Binding ShowUnwatchedFilter}" />
                  <Button Classes="ghost" svc:Tr.Content="Clear filters" HorizontalAlignment="Right" Command="{Binding ClearFiltersCommand}" IsEnabled="{Binding HasFilters}" />
                </StackPanel>
              </Flyout>
            </Button.Flyout>
          </Button>
          <ComboBox x:Name="SortBox" Grid.Column="4" VerticalAlignment="Center" MinWidth="170" Margin="0,0,6,0"
                    ItemsSource="{x:Static vm:MainViewModel.SortModes}" SelectedIndex="{Binding SortIndex}"
                    CornerRadius="10" Background="{DynamicResource Bg2}" BorderBrush="{DynamicResource Line}">
            <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:LocalizedText"><TextBlock Text="{Binding Text}" /></DataTemplate></ComboBox.ItemTemplate>
          </ComboBox>
          <ToggleButton Grid.Column="5" Classes="ghost" VerticalAlignment="Center" svc:Tr.Tip="Select several videos"
                        IsChecked="{Binding IsSelecting}">
            <PathIcon Data="{StaticResource IcSelect}" />
          </ToggleButton>
          <Button Grid.Column="6" Classes="ghost" VerticalAlignment="Center" svc:Tr.Tip="Rescan folders"
                  Command="{Binding RescanCommand}">
            <PathIcon Data="{StaticResource IcRefresh}" />
          </Button>
        </Grid>

        <!-- Scan progress strip -->
        <Panel DockPanel.Dock="Top" Height="22" Margin="28,0">
          <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding IsScanning}">
            <ProgressBar Width="140" Height="3" MinHeight="3" Value="{Binding ScanProgress}" VerticalAlignment="Center"
                         IsIndeterminate="{Binding IsScanIndeterminate}" />
            <TextBlock Classes="dim" Text="{Binding ScanStatus}" FontSize="11" VerticalAlignment="Center" />
          </StackPanel>
        </Panel>

        <Panel>
          <!-- Grid of cards (virtualized) -->
          <ScrollViewer x:Name="GridScroller" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
            <!-- On this day: a clip from this date in an earlier year (Settings, Features, On this day) -->
            <!-- December to mid-January: the year's look back is ready (Settings, Features, Year in clips) -->
            <Border IsVisible="{Binding ShowRecapBanner}" Margin="26,0,26,16" Padding="16,14" CornerRadius="14"
                    Background="{DynamicResource AccentSoft}">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <Border Width="40" Height="40" CornerRadius="20" Background="{DynamicResource Accent}" VerticalAlignment="Center">
                  <PathIcon Data="{StaticResource IcSparkle}" Width="18" Height="18" Foreground="{DynamicResource OnAccent}" />
                </Border>
                <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center" Spacing="2">
                  <TextBlock Text="{Binding RecapBannerTitle}" FontSize="15" FontWeight="SemiBold" />
                  <TextBlock Classes="dim" Text="{Binding RecapBannerText}" FontSize="12" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <Button Classes="accent" Command="{Binding OpenRecapFromBannerCommand}" svc:Tr.Content="Look back" />
                  <Button Classes="ghost" svc:Tr.Tip="Hide until next year" Command="{Binding CloseRecapBannerCommand}">
                    <PathIcon Data="{StaticResource IcClose}" Width="12" Height="12" />
                  </Button>
                </StackPanel>
              </Grid>
            </Border>

            <!-- More than three folders (or several in one-folder mode): offer to merge them into one -->
            <Border IsVisible="{Binding ShowMergeSuggestion}" Margin="26,0,26,16" Padding="16,14" CornerRadius="14"
                    Background="{DynamicResource Bg2}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <Border Width="40" Height="40" CornerRadius="20" Background="{DynamicResource AccentSoft}" VerticalAlignment="Center">
                  <PathIcon Data="{StaticResource IcFolder}" Width="18" Height="18" Foreground="{DynamicResource Highlight}" />
                </Border>
                <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center" Spacing="2">
                  <TextBlock svc:Tr.Text="Bring your videos into one folder?" FontSize="15" FontWeight="SemiBold" />
                  <TextBlock Classes="dim" Text="{Binding MergeSuggestionText}" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <Button Classes="accent" Command="{Binding OpenMergeCommand}" svc:Tr.Content="See what moves" />
                  <Button Classes="ghost" svc:Tr.Tip="Don't suggest this again" Command="{Binding CloseMergeSuggestionCommand}">
                    <PathIcon Data="{StaticResource IcClose}" Width="12" Height="12" />
                  </Button>
                </StackPanel>
              </Grid>
            </Border>

            <Border Classes="memory" IsVisible="{Binding ShowMemory}" Margin="26,0,26,16" Padding="12" CornerRadius="14"
                    Background="{DynamicResource Bg2}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
              <Grid ColumnDefinitions="Auto,*,Auto" DataContext="{Binding MemoryItem}" x:DataType="vm:VideoItemViewModel">
                <Border Width="168" Height="94" CornerRadius="9" ClipToBounds="True" Background="{DynamicResource Bg3}">
                  <Panel>
                    <PathIcon Data="{StaticResource IcFilm}" Width="26" Height="26" Foreground="{DynamicResource Line}" />
                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                  </Panel>
                </Border>
                <StackPanel Grid.Column="1" Margin="16,0,12,0" VerticalAlignment="Center" Spacing="4">
                  <TextBlock Text="{Binding #Root.((vm:MainViewModel)DataContext).MemoryTitle}" FontSize="11" FontWeight="Bold"
                             LetterSpacing="1.2" Foreground="{DynamicResource Accent}" />
                  <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  <TextBlock Classes="dim" Text="{Binding MemoryLine}" FontSize="12" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <Button Classes="accent" Command="{Binding #Root.((vm:MainViewModel)DataContext).OpenCommand}" CommandParameter="{Binding}">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                      <PathIcon Data="{StaticResource IcPlay}" Width="13" Height="13" />
                      <TextBlock svc:Tr.Text="Watch again" />
                    </StackPanel>
                  </Button>
                  <Button Classes="ghost" svc:Tr.Tip="Not today" Command="{Binding #Root.((vm:MainViewModel)DataContext).DismissMemoryCommand}">
                    <PathIcon Data="{StaticResource IcClose}" Width="12" Height="12" />
                  </Button>
                </StackPanel>
              </Grid>
            </Border>

            <!-- Worth a rewatch: older favourites and clips with friends (Settings, Features, Worth a rewatch) -->
            <StackPanel IsVisible="{Binding ShowFeatured}" Margin="0,0,0,10" Spacing="8">
              <StackPanel Orientation="Horizontal" Spacing="10" Margin="28,0,28,0" IsVisible="{Binding !ShowMascot}">
                <TextBlock svc:Tr.Text="Worth a rewatch" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" />
                <TextBlock Classes="dim" svc:Tr.Text="Old favourites and nights with friends. A new pick every day." FontSize="12" VerticalAlignment="Center" />
              </StackPanel>
              <!-- The blob presents the shelf, with a line about your clips (Settings, Features, The blob) -->
              <Grid ColumnDefinitions="Auto,Auto,Auto,*" Margin="22,0,28,0" IsVisible="{Binding ShowMascot}">
                <c:BlobMascot x:Name="Mascot" Width="64" Height="58" VerticalAlignment="Bottom" CheerTick="{Binding MascotCheer}" Still="{Binding ReducedMotion}"
                              Mood="{Binding ShelfMood}" Hat="{Binding MochiHat}" FollowPointer="{Binding MochiFollows}" Pokeable="{Binding MochiPokeable}"
                              BigCheerTick="{Binding MochiBigCheer}" EasterEgg="OnMochiEasterEgg"
                              Cursor="Hand" PointerPressed="OnMascotPressed" svc:Tr.Tip="Say something else" />
                <!-- From 1 November the blob holds out a present: your Wrapped (offered once; then it stays, opened) -->
                <Button Grid.Column="1" Classes="ghost" Padding="2" Margin="0,0,2,0" VerticalAlignment="Bottom" Cursor="Hand"
                        IsVisible="{Binding ShowWrappedGift}" Command="{Binding OpenGiftCommand}" ToolTip.Tip="{Binding GiftTip}">
                  <c:GiftBox Width="70" Height="60" Opened="{Binding GiftOpened}" Still="{Binding ReducedMotion}"
                             Picture="{Binding WrappedPicture}" Progress="{Binding WrappedProgress}" Tinsel="{Binding MochiTinsel}" />
                </Button>
                <!-- speech bubble, its tail pointing at the blob -->
                <Panel Grid.Column="2" Margin="4,0,0,8" VerticalAlignment="Center">
                  <Path Data="M 0,14 L 9,8 L 9,20 Z" Fill="{DynamicResource AccentSoft}" HorizontalAlignment="Left" VerticalAlignment="Top" />
                  <Border Classes="bubble" Margin="8,0,0,0" Padding="12,7" CornerRadius="12" Background="{DynamicResource AccentSoft}" MaxWidth="560">
                    <StackPanel Spacing="1">
                      <TextBlock svc:Tr.Text="Worth a rewatch" FontSize="11" FontWeight="Bold" LetterSpacing="0.6" Foreground="{DynamicResource Highlight}" />
                      <TextBlock Classes="mascotline" Text="{Binding MascotLine}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"
                                 Opacity="{Binding MascotLineShown, Converter={x:Static c:Converters.BoolToOpacity}}" />
                      <!-- a favourite Mochi is reminding you of: play it from here -->
                      <Button Classes="soft" Padding="10,3" Margin="0,5,0,0" HorizontalAlignment="Left" FontSize="12" IsVisible="{Binding ShowNudge}"
                              Command="{Binding WatchNudgeCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <PathIcon Data="{StaticResource IcPlay}" Width="10" Height="10" />
                          <TextBlock svc:Tr.Text="Watch it" />
                        </StackPanel>
                      </Button>
                    </StackPanel>
                  </Border>
                </Panel>
              </Grid>
              <!-- Friend picks: the shelf for you, or the best of your clips with one friend (Settings, Memories) -->
              <ItemsControl ItemsSource="{Binding ShelfChips.Chips}" Margin="28,0,28,0" IsVisible="{Binding ShowShelfFriends}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:OptionChip">
                    <Button Classes="chip" Classes.on="{Binding IsOn}" Content="{Binding Label}" Command="{Binding PickCommand}" Margin="0,0,6,0" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <!-- The shelf scrolls sideways with a trackpad, Shift+wheel or the arrows that show on hover; no bar -->
              <Panel x:Name="ShelfPanel">
              <ScrollViewer x:Name="ShelfScroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Featured}" Margin="20,0,20,10">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6" /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:VideoItemViewModel">
                      <Button Classes="card" Padding="8" Width="236" VerticalAlignment="Top"
                              Command="{Binding #Root.((vm:MainViewModel)DataContext).OpenCommand}" CommandParameter="{Binding}">
                        <StackPanel Spacing="8">
                          <Panel>
                            <Border Classes="glow" CornerRadius="9" Background="{DynamicResource Bg2}" BoxShadow="{DynamicResource CardGlow}" IsHitTestVisible="False" />
                            <Border Classes="thumb" CornerRadius="9" ClipToBounds="True" Background="{DynamicResource Bg2}" Height="124">
                              <Panel>
                                <PathIcon Data="{StaticResource IcFilm}" Width="28" Height="28" Foreground="{DynamicResource Line}" />
                                <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                <Border Classes="playhint" Background="#66000000">
                                  <Border Width="40" Height="40" CornerRadius="20" Background="{DynamicResource Brand}">
                                    <PathIcon Data="{StaticResource IcPlay}" Width="17" Height="17" Foreground="{DynamicResource OnAccent}" Margin="3,0,0,0" />
                                  </Border>
                                </Border>
                                <Border Classes="badge" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="7" IsVisible="{Binding HasDuration}">
                                  <TextBlock Text="{Binding DurationText}" />
                                </Border>
                                <Border Classes="badge fav" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="7" Padding="5" IsVisible="{Binding IsFavorite}">
                                  <PathIcon Data="{StaticResource IcStar}" Width="11" Height="11" Foreground="#FFD166" />
                                </Border>
                              </Panel>
                            </Border>
                          </Panel>
                          <StackPanel Spacing="2" Margin="2,0,2,2">
                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Classes="dim" Text="{Binding MemoryLine}" FontSize="11" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                        </StackPanel>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
              <Button x:Name="ShelfLeft" Classes="shelfarrow" HorizontalAlignment="Left" Margin="10,0,0,40" svc:Tr.Tip="Back" IsVisible="False">
                <PathIcon Data="{StaticResource IcChevronLeft}" Width="18" Height="18" />
              </Button>
              <Button x:Name="ShelfRight" Classes="shelfarrow" HorizontalAlignment="Right" Margin="0,0,10,40" svc:Tr.Tip="More" IsVisible="False">
                <PathIcon Data="{StaticResource IcChevronRight}" Width="18" Height="18" />
              </Button>
              </Panel>
              <TextBlock svc:Tr.Text="Everything" FontSize="15" FontWeight="Bold" Margin="28,4,28,0" />
            </StackPanel>

            <ItemsRepeater x:Name="VideoGrid" ItemsSource="{Binding Videos}" Margin="20,0,20,24">
              <ItemsRepeater.Layout>
                <c:CardGridLayout MinItemWidth="250" Spacing="6" />
              </ItemsRepeater.Layout>
              <ItemsRepeater.ItemTemplate>
                <DataTemplate x:DataType="vm:VideoItemViewModel">
                  <Button Classes="card" Padding="8" VerticalAlignment="Top"
                          Command="{Binding #Root.((vm:MainViewModel)DataContext).OpenCommand}"
                          CommandParameter="{Binding}">
                    <Button.ContextMenu>
                      <ContextMenu>
                        <MenuItem svc:Tr.Header="Play" Click="OnPlayItemClick" />
                        <MenuItem svc:Tr.Header="Rename, tag or move…" Click="OnEditItemClick" />
                        <MenuItem svc:Tr.Header="Add to / remove from favourites" Click="OnFavoriteItemClick" />
                        <MenuItem Header="{Binding WatchedMenuText}" Click="OnWatchedItemClick" Tag="watched" />
                        <MenuItem svc:Tr.Header="Videos like this one" Click="OnSimilarItemClick" Tag="similar" />
                        <MenuItem svc:Tr.Header="Add to collection" Tag="collections" />
                        <MenuItem svc:Tr.Header="Remove from this collection" Click="OnRemoveFromCollectionClick" Tag="uncollect" />
                        <MenuItem svc:Tr.Header="Reset thumbnail" Click="OnResetThumbnailClick" IsVisible="{Binding HasCustomThumbnail}" />
                        <Separator />
                        <MenuItem svc:Tr.Header="Show in file manager" Click="OnRevealItemClick" />
                        <MenuItem svc:Tr.Header="Delete…" Click="OnDeleteItemClick" />
                      </ContextMenu>
                    </Button.ContextMenu>
                    <StackPanel Spacing="9">
                      <!-- always 16:9 of the card's width, so every card is the same height -->
                      <c:AspectPanel>
                      <!-- soft glow in the scheme's accent behind the thumbnail; it fades with Opacity, which animates smoothly -->
                      <Border Classes="glow" CornerRadius="9" Background="{DynamicResource Bg2}" BoxShadow="{DynamicResource CardGlow}" IsHitTestVisible="False" />
                      <Border Classes="thumb" CornerRadius="9" ClipToBounds="True" Background="{DynamicResource Bg2}"
                              PointerEntered="OnThumbPointerEntered" PointerMoved="OnThumbPointerMoved" PointerExited="OnThumbPointerExited">
                        <Panel>
                          <PathIcon Data="{StaticResource IcFilm}" Width="34" Height="34" Foreground="{DynamicResource Line}" />
                          <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                          <Image Source="{Binding ScrubFrame}" Stretch="UniformToFill" IsVisible="{Binding HasScrub}" />
                          <ProgressBar Classes="scrub" VerticalAlignment="Bottom" Height="3" MinHeight="3" CornerRadius="0"
                                       Maximum="1" Value="{Binding ScrubPosition}" IsVisible="{Binding HasScrub}"
                                       Background="#55000000" />
                          <Border Classes="playhint" Background="#66000000" IsVisible="{Binding !HasScrub}">
                            <Border Width="46" Height="46" CornerRadius="23" Background="{DynamicResource Brand}">
                              <PathIcon Data="{StaticResource IcPlay}" Width="20" Height="20" Foreground="{DynamicResource OnAccent}" Margin="3,0,0,0" />
                            </Border>
                          </Border>
                          <Border Classes="ring" Classes.selected="{Binding IsSelected}" CornerRadius="9" BorderThickness="2" BorderBrush="{DynamicResource Brand}" />
                          <Border Classes="selbox" Classes.checked="{Binding IsSelected}" IsVisible="{Binding ShowSelectBox}"
                                  HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8">
                            <PathIcon Data="{StaticResource IcCheck}" Width="13" Height="13" IsVisible="{Binding IsSelected}" />
                          </Border>
                          <Border Classes="badge" Classes.hi="{Binding IsHighRes}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8"
                                  IsVisible="{Binding HasResolution}">
                            <TextBlock Text="{Binding ResolutionBadge}" />
                          </Border>
                          <Border Classes="badge" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8"
                                  IsVisible="{Binding HasDuration}">
                            <TextBlock Text="{Binding DurationText}" />
                          </Border>
                          <ProgressBar VerticalAlignment="Bottom" Height="3" MinHeight="3" CornerRadius="0"
                                       Maximum="1" Value="{Binding Progress}" IsVisible="{Binding HasProgress}"
                                       Background="#55000000" />
                          <!-- favourite marker (always) and quick actions (on hover) -->
                          <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8">
                            <Border Classes="badge fav" Padding="5" IsVisible="{Binding IsHighlight}" svc:Tr.Tip="One of your best moments">
                              <PathIcon Data="{StaticResource IcSparkle}" Width="12" Height="12" Foreground="White" />
                            </Border>
                            <Border Classes="badge fav" Padding="5" IsVisible="{Binding IsFavorite}">
                              <PathIcon Data="{StaticResource IcStar}" Width="12" Height="12" Foreground="#FFD166" />
                            </Border>
                          </StackPanel>
                          <StackPanel Classes="actions" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6" IsVisible="{Binding !ShowSelectBox}">
                            <Button Classes="mini" Focusable="False" svc:Tr.Tip="Rename, tag or move"
                                    Command="{Binding #Root.((vm:MainViewModel)DataContext).BeginEditCommand}" CommandParameter="{Binding}">
                              <PathIcon Data="{StaticResource IcEdit}" Width="13" Height="13" />
                            </Button>
                            <Button Classes="mini" Focusable="False" svc:Tr.Tip="Favourite"
                                    Command="{Binding #Root.((vm:MainViewModel)DataContext).ToggleFavoriteCommand}" CommandParameter="{Binding}">
                              <Panel>
                                <PathIcon Data="{StaticResource IcStarOutline}" Width="13" Height="13" IsVisible="{Binding !IsFavorite}" />
                                <PathIcon Data="{StaticResource IcStar}" Width="13" Height="13" Foreground="#FFD166" IsVisible="{Binding IsFavorite}" />
                              </Panel>
                            </Button>
                          </StackPanel>
                          <StackPanel Classes="actions" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="6,6,6,8" IsVisible="{Binding !ShowSelectBox}">
                            <Button Classes="mini del" Focusable="False" svc:Tr.Tip="Delete"
                                    Command="{Binding #Root.((vm:MainViewModel)DataContext).RequestDeleteCommand}" CommandParameter="{Binding}">
                              <PathIcon Data="{StaticResource IcDelete}" Width="13" Height="13" />
                            </Button>
                          </StackPanel>
                        </Panel>
                      </Border>
                      </c:AspectPanel>
                      <StackPanel Spacing="3" Margin="2,0,2,4">
                        <Grid ColumnDefinitions="Auto,*">
                          <Ellipse Width="7" Height="7" Fill="{DynamicResource Accent}" Margin="0,0,7,0" VerticalAlignment="Center"
                                   IsVisible="{Binding ShowUnwatched}" svc:Tr.Tip="Not watched yet" />
                          <TextBlock Grid.Column="1" Text="{Binding Title}" ToolTip.Tip="{Binding Entry.Path}" ToolTip.ShowDelay="900" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*" ToolTip.Tip="{Binding SubtitleTip}">
                          <PathIcon Data="{StaticResource IcNote}" Width="11" Height="11" Margin="0,0,5,0" Foreground="{DynamicResource Highlight}"
                                    IsVisible="{Binding HasNote}" VerticalAlignment="Center" />
                          <PathIcon Data="{StaticResource IcCloudDone}" Width="12" Height="12" Margin="0,0,5,0" Foreground="{DynamicResource TextDim}"
                                    IsVisible="{Binding IsBackedUp}" VerticalAlignment="Center" svc:Tr.Tip="Backed up" />
                          <TextBlock Grid.Column="1" Classes="dim" Text="{Binding Subtitle}" FontSize="11" TextTrimming="CharacterEllipsis" />
                        </Grid>
                        <!-- Always takes its row, empty or not: the grid sizes every card like the first one, so
                             cards line up and a tagged card is never cut off -->
                        <Panel Margin="0,3,0,0" Height="20">
                        <Border Classes="said" IsVisible="{Binding HasSaid}" HorizontalAlignment="Left" ToolTip.Tip="{Binding Said}">
                          <StackPanel Orientation="Horizontal" Spacing="5">
                            <PathIcon Data="{StaticResource IcCaptions}" Width="12" Height="12" Foreground="{DynamicResource Highlight}" />
                            <TextBlock Text="{Binding Said, StringFormat='“{0}”'}" FontSize="11" FontStyle="Italic" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                          </StackPanel>
                        </Border>
                        <Border Classes="said" IsVisible="{Binding ShowSeen}" HorizontalAlignment="Left" svc:Tr.Tip="Found by what's on screen">
                          <StackPanel Orientation="Horizontal" Spacing="5">
                            <PathIcon Data="{StaticResource IcEye}" Width="12" Height="12" Foreground="{DynamicResource Highlight}" />
                            <TextBlock svc:Tr.Text="Looks like it" FontSize="11" FontStyle="Italic" VerticalAlignment="Center" />
                          </StackPanel>
                        </Border>
                        <ItemsControl ItemsSource="{Binding Tags}" Height="20" ClipToBounds="True" IsVisible="{Binding ShowTags}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                              <Border Classes="tag"><TextBlock Text="{Binding}" /></Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </Panel>
                      </StackPanel>
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
            </StackPanel>
          </ScrollViewer>

          <!-- Empty: no folders yet -->
          <StackPanel IsVisible="{Binding HasNoFolders}" HorizontalAlignment="Center" VerticalAlignment="Center"
                      Spacing="14" MaxWidth="380" Margin="0,0,0,60">
            <Border Width="72" Height="72" CornerRadius="20" Background="{DynamicResource Bg2}" HorizontalAlignment="Center">
              <PathIcon Data="{StaticResource IcLibrary}" Width="32" Height="32" Foreground="{DynamicResource Highlight}" />
            </Border>
            <TextBlock svc:Tr.Text="Your saves start here" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" />
            <TextBlock Classes="dim" TextAlignment="Center" TextWrapping="Wrap" FontSize="13"
                       svc:Tr.Text="Add the folders where your clips live. Savefile finds every video in them, subfolders too, and keeps an eye out for new ones." />
            <Button Classes="accent" HorizontalAlignment="Center" Command="{Binding AddFolderCommand}" Margin="0,6,0,0">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <PathIcon Data="{StaticResource IcAdd}" Width="14" Height="14" />
                <TextBlock svc:Tr.Text="Add a folder" />
              </StackPanel>
            </Button>
          </StackPanel>

          <!-- Empty: nothing matches -->
          <StackPanel IsVisible="{Binding HasNoResults}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6" Margin="0,0,0,60" MaxWidth="420">
            <!-- Mochi peeking up from below (Settings, Features, Mochi, Fills empty pages) -->
            <Border Width="96" Height="46" HorizontalAlignment="Center" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,2" Margin="0,0,0,8"
                    IsVisible="{Binding ShowMochiEmpty}">
              <c:BlobMascot Width="96" Height="44" Mood="Peek" Hat="{Binding MochiHat}" FollowPointer="{Binding MochiFollows}"
                            Still="{Binding ReducedMotion}" MaxFps="30" />
            </Border>
            <TextBlock Text="{Binding NoResultsTitle}" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
            <TextBlock Classes="dim" Text="{Binding NoResultsText}" FontSize="13" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
            <Button Classes="soft" svc:Tr.Content="Clear filters" HorizontalAlignment="Center" Margin="0,8,0,0"
                    IsVisible="{Binding HasFilters}" Command="{Binding ClearFiltersCommand}" />
          </StackPanel>

          <!-- Bulk actions while selecting -->
          <Border Classes="bulkbar" IsVisible="{Binding IsSelecting}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,22">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="{Binding SelectionText}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" Margin="6,0,10,0" MinWidth="70" />
              <Button Classes="ghost" svc:Tr.Content="Select all" Command="{Binding SelectAllCommand}" />
              <Border Width="1" Background="{DynamicResource Line}" Margin="4,6" />
              <Button Classes="ghost" svc:Tr.Tip="Favourite" Command="{Binding BulkFavoriteCommand}">
                <PathIcon Data="{StaticResource IcStarOutline}" Width="15" Height="15" />
              </Button>
              <Button x:Name="BulkTagButton" Classes="ghost" svc:Tr.Content="Tag…">
                <Button.Flyout>
                  <Flyout Placement="Top">
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="2">
                      <TextBox Text="{Binding BulkTag}" svc:Tr.Watermark="Tag" Width="160" CornerRadius="8" KeyDown="OnBulkTagKeyDown" />
                      <Button Classes="accent" svc:Tr.Content="Add" Command="{Binding BulkAddTagCommand}" Click="OnBulkFlyoutDone" />
                    </StackPanel>
                  </Flyout>
                </Button.Flyout>
              </Button>
              <Button Classes="ghost" svc:Tr.Content="Montage…" IsVisible="{Binding ShowMontage}" Command="{Binding OpenMontageCommand}"
                      svc:Tr.Tip="Stitch the best moments of the selected videos into one" />
              <Button x:Name="BulkCollectionButton" Classes="ghost" svc:Tr.Content="Collection…" IsVisible="{Binding ShowCollections}">
                <Button.Flyout>
                  <Flyout Placement="Top">
                    <StackPanel Spacing="2" MinWidth="200" Margin="2">
                      <ItemsControl ItemsSource="{Binding Collections}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:FolderViewModel">
                            <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Content="{Binding Name}"
                                    Command="{Binding #Root.((vm:MainViewModel)DataContext).BulkAddToCollectionCommand}" CommandParameter="{Binding}" Click="OnBulkFlyoutDone" />
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" svc:Tr.Content="New collection…"
                              Command="{Binding BulkNewCollectionCommand}" Click="OnBulkFlyoutDone" />
                    </StackPanel>
                  </Flyout>
                </Button.Flyout>
              </Button>
              <Button Classes="ghost" svc:Tr.Content="Watched…" IsVisible="{Binding ShowUnwatchedFilter}">
                <Button.Flyout>
                  <MenuFlyout Placement="Top">
                    <MenuItem svc:Tr.Header="Mark as watched" Command="{Binding BulkMarkWatchedCommand}" />
                    <MenuItem svc:Tr.Header="Mark as unwatched" Command="{Binding BulkMarkUnwatchedCommand}" />
                  </MenuFlyout>
                </Button.Flyout>
              </Button>
              <Button Classes="ghost" svc:Tr.Tip="Delete" Command="{Binding BulkDeleteCommand}">
                <PathIcon Data="{StaticResource IcDelete}" Width="15" Height="15" Foreground="{DynamicResource Danger}" />
              </Button>
              <Border Width="1" Background="{DynamicResource Line}" Margin="4,6" />
              <Button Classes="accent" svc:Tr.Content="Done" Command="{Binding ToggleSelectModeCommand}" />
            </StackPanel>
          </Border>
        </Panel>
      </DockPanel>
    </Grid>

    <!-- ======================= QUICK PLAYER ======================= -->
    <!-- Plain playback over the library, almost window-sized; Edit opens the same video in the full editor.
         (Called the mini player in code: it started out as a small corner player.) -->
    <Panel x:Name="MiniArea" IsVisible="{Binding #Root.((vm:MainViewModel)DataContext).IsMiniPlayerOpen}">
      <Border x:Name="MiniScrim" Background="{DynamicResource ScrimLight}" />
      <!-- Sized in code to the video's shape (MainWindow.QuickPlayer.cs), so there are no black bars -->
      <Border x:Name="MiniPlayer" Classes="miniplayer" Margin="48,56,48,40" HorizontalAlignment="Center" VerticalAlignment="Center"
              DataContext="{Binding Player}" x:DataType="vm:PlayerViewModel">
        <DockPanel>
          <StackPanel x:Name="MiniBar" DockPanel.Dock="Bottom" Margin="14,2,14,12" Spacing="2">
            <c:TrimTimeline Duration="{Binding Duration}" Position="{Binding Position}"
                            InPoint="{Binding InPoint}" OutPoint="{Binding OutPoint}"
                            SeekCommand="{Binding SeekCommand}" Accent="{DynamicResource Accent}" RangeBrush="{DynamicResource Highlight}"
                            Segments="{Binding SegmentRanges}" Markers="{Binding Markers}" />
            <Grid ColumnDefinitions="Auto,*,Auto">
              <StackPanel Orientation="Horizontal" Spacing="0" VerticalAlignment="Center">
                <Button Classes="ghost" Focusable="False" Command="{Binding SkipBackCommand}" svc:Tr.Tip="Back 5 s (Shift+←)" Padding="6">
                  <PathIcon Data="{StaticResource IcRewind}" Width="15" Height="15" />
                </Button>
                <Button Classes="ghost" Focusable="False" Command="{Binding TogglePlayCommand}" svc:Tr.Tip="Play / pause (Space)" Padding="6">
                  <Panel>
                    <PathIcon Data="{StaticResource IcPlay}" Width="18" Height="18" IsVisible="{Binding !IsPlaying}" />
                    <PathIcon Data="{StaticResource IcPause}" Width="18" Height="18" IsVisible="{Binding IsPlaying}" />
                  </Panel>
                </Button>
                <Button Classes="ghost" Focusable="False" Command="{Binding SkipForwardCommand}" svc:Tr.Tip="Forward 5 s (Shift+→)" Padding="6">
                  <PathIcon Data="{StaticResource IcForward}" Width="15" Height="15" />
                </Button>
                <Button Classes="ghost" Focusable="False" Command="{Binding ToggleMuteCommand}" svc:Tr.Tip="Mute (M)" Padding="6">
                  <Panel>
                    <PathIcon Data="{StaticResource IcVolume}" Width="15" Height="15" IsVisible="{Binding !IsMuted}" />
                    <PathIcon Data="{StaticResource IcMute}" Width="15" Height="15" IsVisible="{Binding IsMuted}" />
                  </Panel>
                </Button>
              </StackPanel>
              <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center" Spacing="1">
                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Title}" />
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <TextBlock Classes="dim mono" Text="{Binding PositionText}" FontSize="11" />
                  <TextBlock Classes="dim mono" Text="/" FontSize="11" />
                  <TextBlock Classes="dim mono" Text="{Binding DurationText}" FontSize="11" />
                  <TextBlock Classes="dim" Text="{Binding RateText}" FontSize="11" Margin="4,0,0,0" IsVisible="{Binding IsRateChanged}" />
                  <TextBlock Classes="dim" Text="·" FontSize="11" Margin="4,0,0,0" />
                  <TextBlock Classes="dim" Text="{Binding Current.PlayerLine}" FontSize="11" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </StackPanel>
              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                <Button Classes="ghost" Classes.on="{Binding ShowSpoken}" Focusable="False" Padding="6" Margin="0,0,4,0"
                        IsVisible="{Binding #Root.((vm:MainViewModel)DataContext).ShowSpeech}"
                        svc:Tr.Tip="Captions: show what's said (V)" Command="{Binding ToggleSpokenCommand}">
                  <PathIcon Data="{StaticResource IcCaptions}" Width="16" Height="16" />
                </Button>
                <Button Classes="ghost" Classes.on="{Binding #Root.((vm:MainViewModel)DataContext).PlayAll}" Focusable="False" Padding="6" Margin="0,0,4,0"
                        IsVisible="{Binding #Root.((vm:MainViewModel)DataContext).ShowPlayAll}"
                        svc:Tr.Tip="Play all: go on to the next video when this one ends"
                        Click="OnTogglePlayAll">
                  <PathIcon Data="{StaticResource IcLoop}" Width="16" Height="16" />
                </Button>
                <!-- The same previous / next video buttons as in the editor (← / →) -->
                <Button Classes="ghost" Focusable="False" Padding="6" svc:Tr.Tip="Previous video (←)"
                        Command="{Binding #Root.((vm:MainViewModel)DataContext).PreviousClipCommand}">
                  <PathIcon Data="{StaticResource IcChevronLeft}" Width="18" Height="18" />
                </Button>
                <Button Classes="ghost" Focusable="False" Padding="6" Margin="0,0,8,0" svc:Tr.Tip="Next video (→)"
                        Command="{Binding #Root.((vm:MainViewModel)DataContext).NextClipCommand}">
                  <PathIcon Data="{StaticResource IcChevronRight}" Width="18" Height="18" />
                </Button>
                <!-- Favourite: the star fills, and a glow bursts out of it when it's turned on -->
                <Button Classes="ghost" Focusable="False" Padding="6" svc:Tr.Tip="Favourite (F)" Click="OnQuickFavorite">
                  <Panel Width="16" Height="16">
                    <Ellipse x:Name="QuickFavRing" Width="16" Height="16" Opacity="0" IsHitTestVisible="False"
                             Stroke="#FFD166" StrokeThickness="2" RenderTransform="scale(1)" />
                    <Panel x:Name="QuickFavStar" RenderTransform="scale(1)">
                      <PathIcon Data="{StaticResource IcStarOutline}" Width="16" Height="16" IsVisible="{Binding !IsFavorite}" />
                      <Border IsVisible="{Binding IsFavorite}" CornerRadius="8" BoxShadow="0 0 10 1 #66FFD166">
                        <c:GoldStar x:Name="QuickGoldStar" Width="16" Height="16"
                                    Still="{Binding #Root.((vm:MainViewModel)DataContext).ReducedMotion}" />
                      </Border>
                    </Panel>
                  </Panel>
                </Button>
                <!-- Name, tags and friends of this video, and Delete (to the bin), without leaving the player -->
                <Button Classes="ghost" Focusable="False" Padding="6" svc:Tr.Tip="Name, tags and friends (I)"
                        Command="{Binding #Root.((vm:MainViewModel)DataContext).EditPlayingCommand}">
                  <PathIcon Data="{StaticResource IcLabel}" Width="16" Height="16" />
                </Button>
                <Button Classes="ghost" Focusable="False" Padding="6" Margin="0,0,8,0" svc:Tr.Tip="Delete (Del): to the bin for 24 hours, then the next video plays"
                        Command="{Binding #Root.((vm:MainViewModel)DataContext).DeletePlayingCommand}">
                  <PathIcon Data="{StaticResource IcDelete}" Width="16" Height="16" />
                </Button>
                <Button Classes="accent" Focusable="False" VerticalAlignment="Center"
                        svc:Tr.Tip="Open in the editor: trim, export and share"
                        Command="{Binding #Root.((vm:MainViewModel)DataContext).ExpandMiniPlayerCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <PathIcon Data="{StaticResource IcEdit}" Width="13" Height="13" Foreground="{DynamicResource OnAccent}" />
                    <TextBlock svc:Tr.Text="Edit" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </Grid>
          </StackPanel>
          <Panel Background="Black">
            <c:VideoSurface x:Name="MiniSurface" Frames="{Binding Frames}"
                          SourceWidth="{Binding VideoWidth}" SourceHeight="{Binding VideoHeight}" />
            <Border Classes="spoken" IsVisible="{Binding SpokenLine, Converter={x:Static ObjectConverters.IsNotNull}}" Margin="48,0,48,22">
              <TextBlock Text="{Binding SpokenLine}" FontSize="17" />
            </Border>
            <Border x:Name="MiniHit" Background="Transparent" svc:Tr.Tip="Click to play or pause, double-click to edit" ToolTip.ShowDelay="1200" />
            <Border IsVisible="{Binding Toast, Converter={x:Static ObjectConverters.IsNotNull}}" IsHitTestVisible="False"
                    HorizontalAlignment="Center" VerticalAlignment="Top" Margin="48,16,48,0"
                    Background="{DynamicResource ToastBg}" CornerRadius="10" Padding="14,8" BorderBrush="{DynamicResource Line}" BorderThickness="1">
              <TextBlock Text="{Binding Toast}" FontSize="13" TextWrapping="Wrap" />
            </Border>
            <Button Classes="mini" Focusable="False" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10" svc:Tr.Tip="Close (Esc)"
                    Command="{Binding #Root.((vm:MainViewModel)DataContext).CloseMiniPlayerCommand}">
              <PathIcon Data="{StaticResource IcClose}" Width="12" Height="12" />
            </Button>
          </Panel>
        </DockPanel>
      </Border>
    </Panel>

    <!-- ======================= WRAPPED THEATRE ======================= -->
    <!-- Watching your Wrapped: the video and nothing else, with pause and scrubbing. The first viewing fills the
         screen; later ones play in the window, with Save a copy. No editing here. -->
    <Panel x:Name="Theatre" Background="Black" IsVisible="{Binding #Root.((vm:MainViewModel)DataContext).IsTheatreOpen}"
           DataContext="{Binding Player}" x:DataType="vm:PlayerViewModel">
      <c:VideoSurface x:Name="TheatreSurface" Frames="{Binding Frames}"
                      SourceWidth="{Binding VideoWidth}" SourceHeight="{Binding VideoHeight}" />
      <Border x:Name="TheatreHit" Background="Transparent" />
      <Border IsVisible="{Binding Toast, Converter={x:Static ObjectConverters.IsNotNull}}" IsHitTestVisible="False"
              HorizontalAlignment="Center" VerticalAlignment="Top" Margin="48,22,48,0"
              Background="{DynamicResource ToastBg}" CornerRadius="10" Padding="14,8" BorderBrush="{DynamicResource Line}" BorderThickness="1">
        <TextBlock Text="{Binding Toast}" FontSize="13" TextWrapping="Wrap" />
      </Border>
      <Panel x:Name="TheatreChrome">
        <Panel.Transitions>
          <Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.3" /></Transitions>
        </Panel.Transitions>
        <Button Classes="mini" Focusable="False" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="16" svc:Tr.Tip="Close (Esc)"
                Command="{Binding #Root.((vm:MainViewModel)DataContext).CloseTheatreCommand}">
          <PathIcon Data="{StaticResource IcClose}" Width="12" Height="12" />
        </Button>
        <Border VerticalAlignment="Bottom" Margin="24,0,24,22" Padding="14,8,14,10" CornerRadius="14" Background="#C8141414" MaxWidth="1100">
          <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
            <Button Classes="ghost" Focusable="False" Padding="6" Command="{Binding TogglePlayCommand}" svc:Tr.Tip="Play / pause (Space)" VerticalAlignment="Center">
              <Panel>
                <PathIcon Data="{StaticResource IcPlay}" Width="20" Height="20" Foreground="White" IsVisible="{Binding !IsPlaying}" />
                <PathIcon Data="{StaticResource IcPause}" Width="20" Height="20" Foreground="White" IsVisible="{Binding IsPlaying}" />
              </Panel>
            </Button>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="6,0,12,0">
              <TextBlock Classes="mono" Text="{Binding PositionText}" FontSize="12" Foreground="White" />
              <TextBlock Classes="mono" Text="/" FontSize="12" Foreground="#99FFFFFF" />
              <TextBlock Classes="mono" Text="{Binding DurationText}" FontSize="12" Foreground="#99FFFFFF" />
            </StackPanel>
            <c:TrimTimeline Grid.Column="2" VerticalAlignment="Center" Duration="{Binding Duration}" Position="{Binding Position}"
                            SeekCommand="{Binding SeekCommand}" Accent="{DynamicResource Accent}" RangeBrush="Transparent" />
            <Button Grid.Column="3" Classes="ghost" Focusable="False" Padding="6" Margin="10,0,0,0" svc:Tr.Tip="Mute (M)" Command="{Binding ToggleMuteCommand}" VerticalAlignment="Center">
              <Panel>
                <PathIcon Data="{StaticResource IcVolume}" Width="16" Height="16" Foreground="White" IsVisible="{Binding !IsMuted}" />
                <PathIcon Data="{StaticResource IcMute}" Width="16" Height="16" Foreground="White" IsVisible="{Binding IsMuted}" />
              </Panel>
            </Button>
            <Button Grid.Column="4" Classes="soft" Focusable="False" Margin="8,0,0,0" VerticalAlignment="Center"
                    IsVisible="{Binding !#Root.((vm:MainViewModel)DataContext).TheatreFirst}"
                    Command="{Binding #Root.((vm:MainViewModel)DataContext).SaveTheatreCopyCommand}" svc:Tr.Tip="Save a copy of the video somewhere else">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource IcExport}" Width="13" Height="13" />
                <TextBlock svc:Tr.Text="Export" />
              </StackPanel>
            </Button>
          </Grid>
        </Border>
      </Panel>
    </Panel>

    <!-- ======================= EDIT DETAILS ======================= -->
    <Border x:Name="EditScrim" Background="{DynamicResource Scrim}" IsVisible="{Binding IsEditing}">
      <Border Width="460" VerticalAlignment="Center" HorizontalAlignment="Center" Background="{DynamicResource Bg1}"
              BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="16" Padding="22"
              BoxShadow="{DynamicResource DialogShadow}" DataContext="{Binding Editor}" x:DataType="vm:EditViewModel" x:Name="EditCard">
        <StackPanel Spacing="14">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock svc:Tr.Text="Edit details" FontSize="17" FontWeight="Bold" VerticalAlignment="Center" />
            <ToggleButton Grid.Column="1" Classes="ghost" IsChecked="{Binding Favorite}" svc:Tr.Tip="Favourite">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource IcStar}" Width="14" Height="14" />
                <TextBlock svc:Tr.Text="Favourite" FontSize="12" FontWeight="SemiBold" />
              </StackPanel>
            </ToggleButton>
          </Grid>

          <StackPanel Spacing="6">
            <TextBlock Classes="label" Text="{Binding NameLabel}" />
            <Grid ColumnDefinitions="*,Auto,Auto">
              <TextBox x:Name="EditName" Text="{Binding Name}" CornerRadius="8" />
              <TextBlock Grid.Column="1" Classes="dim mono" Text="{Binding Extension}" VerticalAlignment="Center" Margin="8,0,0,0" IsVisible="{Binding ShowExtension}" />
              <Button Grid.Column="2" Classes="ghost" Padding="7" Margin="4,0,0,0" IsVisible="{Binding CanSuggest}" svc:Tr.Tip="Suggest a name from the game, who was there and the date"
                      Command="{Binding SuggestNameCommand}">
                <PathIcon Data="{StaticResource IcSparkle}" Width="14" Height="14" />
              </Button>
            </Grid>
            <TextBlock Classes="dim" FontSize="11" Text="{Binding NameHint}" TextWrapping="Wrap" />
          </StackPanel>

          <StackPanel Spacing="6" IsVisible="{Binding CanMove}">
            <TextBlock Classes="label" svc:Tr.Text="LIBRARY FOLDER" />
            <ComboBox ItemsSource="{Binding Folders}" SelectedItem="{Binding Folder}" HorizontalAlignment="Stretch" CornerRadius="8">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:FolderViewModel">
                  <TextBlock Text="{Binding Name}" ToolTip.Tip="{Binding Path}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Classes="dim" FontSize="11" svc:Tr.Text="Picking another folder moves the file there." />
          </StackPanel>

          <StackPanel Spacing="8">
            <TextBlock Classes="label" svc:Tr.Text="TAGS" />
            <ItemsControl ItemsSource="{Binding Tags}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <Border Classes="tag big">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                      <Button Classes="ghost" Padding="2" Click="OnRemoveTagClick" svc:Tr.Tip="Remove tag">
                        <PathIcon Data="{StaticResource IcClose}" Width="9" Height="9" />
                      </Button>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBox x:Name="EditTagInput" Text="{Binding TagInput}" svc:Tr.Watermark="Add a tag and press Enter" CornerRadius="8" />
            <ItemsControl ItemsSource="{Binding Suggestions}" IsVisible="{Binding HasSuggestions}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <Button Classes="suggest" Click="OnSuggestedTagClick">
                    <TextBlock Text="{Binding StringFormat='+ {0}'}" />
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <StackPanel Spacing="6" IsVisible="{Binding ShowNote}">
            <TextBlock Classes="label" svc:Tr.Text="NOTE" />
            <TextBox x:Name="EditNote" Text="{Binding Note}" svc:Tr.Watermark="What happened in this clip? Search finds it." CornerRadius="8"
                     TextWrapping="Wrap" MaxLength="300" MaxHeight="80" />
          </StackPanel>

          <StackPanel Spacing="6" IsVisible="{Binding ShowPeople}">
            <TextBlock Classes="label" svc:Tr.Text="WHO WAS THERE" />
            <TextBox x:Name="EditPeople" Text="{Binding People}" svc:Tr.Watermark="Friends in this clip, like Alex, Sam" CornerRadius="8" MaxLength="300" />
            <ItemsControl ItemsSource="{Binding PeopleSuggestions}" IsVisible="{Binding HasPeopleSuggestions}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <Button Classes="suggest" Command="{Binding #Root.((vm:MainViewModel)DataContext).Editor.AddPersonCommand}" CommandParameter="{Binding}">
                    <TextBlock Text="{Binding StringFormat='+ {0}'}" />
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <TextBlock Text="{Binding Error}" Foreground="{DynamicResource Danger}" FontSize="12" TextWrapping="Wrap"
                     IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />

          <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,4,0,0">
            <Button Classes="ghost" svc:Tr.Content="Delete…" FontSize="12" Foreground="{DynamicResource Danger}"
                    Command="{Binding #Root.((vm:MainViewModel)DataContext).RequestDeleteCommand}" CommandParameter="{Binding Item}" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
              <Button Classes="soft" svc:Tr.Content="Cancel" Command="{Binding #Root.((vm:MainViewModel)DataContext).CancelEditCommand}" />
              <Button Classes="accent" svc:Tr.Content="Save" Command="{Binding #Root.((vm:MainViewModel)DataContext).SaveEditCommand}" />
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>
    </Border>

    <!-- ======================= DELETE CONFIRMATION ======================= -->
    <!-- ======================= THE BIN ======================= -->
    <Border x:Name="BinScrim" Background="{DynamicResource Scrim}" IsVisible="{Binding IsShowingBin}">
      <Border Width="560" MaxHeight="640" Margin="0,40" VerticalAlignment="Center" HorizontalAlignment="Center" Background="{DynamicResource Bg1}"
              BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="16" BoxShadow="{DynamicResource DialogShadow}">
        <DockPanel Margin="24,22,24,20">
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
            <StackPanel Spacing="3">
              <TextBlock svc:Tr.Text="Bin" FontSize="19" FontWeight="Bold" />
              <TextBlock Classes="dim" FontSize="12" TextWrapping="Wrap" svc:Tr.Text="Each video waits here for 24 hours from when you deleted it, then it's deleted for good. Put it back to keep it, with its favourite, tags and friends." />
            </StackPanel>
            <Button Grid.Column="1" Classes="ghost" Padding="6" VerticalAlignment="Top" svc:Tr.Tip="Close (Esc)" Command="{Binding CloseBinCommand}">
              <PathIcon Data="{StaticResource IcClose}" Width="13" Height="13" />
            </Button>
          </Grid>
          <StackPanel DockPanel.Dock="Top" Margin="0,18,0,18" Spacing="8" HorizontalAlignment="Center" IsVisible="{Binding BinIsEmpty}">
            <Border Width="96" Height="46" HorizontalAlignment="Center" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,2"
                    IsVisible="{Binding ShowMochiEmpty}">
              <c:BlobMascot Width="96" Height="44" Mood="Peek" Hat="{Binding MochiHat}" FollowPointer="{Binding MochiFollows}"
                            Still="{Binding ReducedMotion}" MaxFps="30" />
            </Border>
            <TextBlock Classes="dim" FontSize="13" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="380" Text="{Binding BinEmptyText}" />
          </StackPanel>
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding BinRows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:BinRowViewModel">
                  <Border Background="{DynamicResource Bg2}" CornerRadius="10" Padding="12,9" Margin="0,0,0,6">
                    <Grid ColumnDefinitions="*,Auto,Auto">
                      <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Folder}" />
                        <TextBlock Classes="dim" Text="{Binding Left}" FontSize="11" />
                      </StackPanel>
                      <Button Grid.Column="1" Classes="soft" Margin="10,0,6,0" VerticalAlignment="Center" svc:Tr.Content="Put back"
                              Command="{Binding #Root.((vm:MainViewModel)DataContext).RestoreFromBinCommand}" CommandParameter="{Binding}" />
                      <Button Grid.Column="2" Classes="ghost" Padding="6" VerticalAlignment="Center" svc:Tr.Tip="Delete for good now"
                              Command="{Binding #Root.((vm:MainViewModel)DataContext).DeleteFromBinNowCommand}" CommandParameter="{Binding}">
                        <PathIcon Data="{StaticResource IcDelete}" Width="14" Height="14" Foreground="{DynamicResource TextDim}" />
                      </Button>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Border>

    <Border x:Name="DeleteScrim" Background="{DynamicResource Scrim}" IsVisible="{Binding IsConfirmingDelete}">
      <Border Width="420" VerticalAlignment="Center" HorizontalAlignment="Center" Background="{DynamicResource Bg1}"
              BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="16" Padding="22" BoxShadow="{DynamicResource DialogShadow}">
        <StackPanel Spacing="12">
          <TextBlock Text="{Binding DeleteTitle}" FontSize="17" FontWeight="Bold" />
          <TextBlock Text="{Binding DeletePrompt}" TextWrapping="Wrap" FontSize="13" />
          <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" Text="{Binding DeleteHint}" />
          <TextBlock Text="{Binding DeleteError}" Foreground="{DynamicResource Danger}" FontSize="12" TextWrapping="Wrap"
                     IsVisible="{Binding DeleteError, Converter={x:Static ObjectConverters.IsNotNull}}" />
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,4,0,0">
            <Button x:Name="DeleteCancel" Classes="soft" svc:Tr.Content="Cancel" Command="{Binding CancelDeleteCommand}" />
            <Button Classes="danger" svc:Tr.Content="Move to trash" Command="{Binding ConfirmDeleteCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>

    <!-- ======================= WHAT'S NEW ======================= -->
    <Border x:Name="WhatsNewScrim" Background="{DynamicResource Scrim}" IsVisible="{Binding IsShowingWhatsNew}">
      <Border Width="520" MaxHeight="620" VerticalAlignment="Center" HorizontalAlignment="Center" Background="{DynamicResource Bg1}"
              BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="16" Padding="22" BoxShadow="{DynamicResource DialogShadow}">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="{Binding WhatsNewTitle}" FontSize="17" FontWeight="Bold" Margin="0,0,0,12" />
          <Button x:Name="WhatsNewClose" DockPanel.Dock="Bottom" Classes="accent" svc:Tr.Content="Got it" HorizontalAlignment="Right"
                  Margin="0,14,0,0" Command="{Binding CloseWhatsNewCommand}" />
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding WhatsNew}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="svc:ChangelogEntry">
                  <StackPanel Spacing="6" Margin="0,0,12,16">
                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Highlight}" />
                    <ItemsControl ItemsSource="{Binding Items}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                          <Grid ColumnDefinitions="14,*" Margin="0,2">
                            <TextBlock Text="•" Classes="dim" FontSize="13" />
                            <TextBlock Grid.Column="1" Text="{Binding}" FontSize="13" TextWrapping="Wrap" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Border>

    <!-- ======================= CLEAN UP ======================= -->
    <Border x:Name="CleanupScrim" Background="{DynamicResource Scrim}" IsVisible="{Binding IsCleaningUp}">
      <Border Width="640" MaxHeight="720" Margin="0,40" VerticalAlignment="Center" HorizontalAlignment="Center" Background="{DynamicResource Bg1}"
              BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="16" BoxShadow="{DynamicResource DialogShadow}"
              DataContext="{Binding Cleanup}" x:DataType="vm:CleanupViewModel">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="24,22,24,12">
            <TextBlock svc:Tr.Text="Clean up" FontSize="17" FontWeight="Bold" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <ProgressBar IsIndeterminate="True" Width="80" Height="3" MinHeight="3" VerticalAlignment="Center" IsVisible="{Binding IsScanning}" />
              <TextBlock Classes="dim" FontSize="12" TextWrapping="Wrap" MaxWidth="560" Text="{Binding Summary}" />
            </StackPanel>
          </StackPanel>
          <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="24,14">
            <Grid ColumnDefinitions="*,Auto">
            <Button Classes="ghost" HorizontalAlignment="Left" svc:Tr.Content="Merge folders into one…"
                    IsVisible="{Binding #Root.((vm:MainViewModel)DataContext).HasSeveralFolders}"
                    Command="{Binding #Root.((vm:MainViewModel)DataContext).OpenMergeCommand}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
              <Button x:Name="CleanupClose" Classes="soft" svc:Tr.Content="Close" Command="{Binding #Root.((vm:MainViewModel)DataContext).CloseCleanupCommand}" />
              <!-- TextBlock content: a bound string Content kept its first measured width when the text grew -->
              <Button Classes="danger" IsEnabled="{Binding CanRemove}"
                      Command="{Binding #Root.((vm:MainViewModel)DataContext).RemoveCleanupCommand}">
                <TextBlock Text="{Binding RemoveText}" />
              </Button>
            </StackPanel>
            </Grid>
          </Border>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Rows}" Margin="24,0,24,16">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:CleanupRow">
                  <Border Classes="cleanrow" Classes.kept="{Binding IsKept}">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Center" MinWidth="0" Margin="0,0,8,0" />
                      <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Classes="dim" Text="{Binding Details}" FontSize="11" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                      <TextBlock Grid.Column="2" Text="{Binding Reason}" FontSize="11" Foreground="{DynamicResource Highlight}"
                                 VerticalAlignment="Center" Margin="10,0,0,0" MaxWidth="200" TextTrimming="CharacterEllipsis" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Border>

    <!-- ======================= AUTO MONTAGE ======================= -->
    <Border x:Name="MontageScrim" Background="{DynamicResource Scrim}" IsVisible="{Binding IsMakingMontage}">
      <Border Width="560" MaxHeight="720" Margin="0,40" VerticalAlignment="Center" HorizontalAlignment="Center" Background="{DynamicResource Bg1}"
              BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="16" BoxShadow="{DynamicResource DialogShadow}"
              DataContext="{Binding Montage}" x:DataType="vm:MontageViewModel">
        <DockPanel>
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="24,22,24,4">
            <TextBlock svc:Tr.Text="Auto montage" FontSize="17" FontWeight="Bold" VerticalAlignment="Center" />
            <Button x:Name="MontageClose" Grid.Column="1" Classes="ghost" Padding="6" Command="{Binding #Root.((vm:MainViewModel)DataContext).CloseMontageCommand}">
              <PathIcon Data="{StaticResource IcClose}" Width="13" Height="13" />
            </Button>
          </Grid>
          <TextBlock DockPanel.Dock="Top" Classes="dim" FontSize="12" TextWrapping="Wrap" Margin="24,0,24,14"
                     svc:Tr.Text="Savefile takes the loudest moment of each video, puts them one after another with a transition, and saves a new video. Your clips stay as they are." />
          <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="24,14">
            <Grid ColumnDefinitions="*,Auto,Auto">
              <TextBlock Text="{Binding Summary}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" />
              <Button Grid.Column="1" Classes="soft" Margin="8,0" svc:Tr.Content="Cancel" Command="{Binding #Root.((vm:MainViewModel)DataContext).CloseMontageCommand}" />
              <Button Grid.Column="2" Classes="accent" IsEnabled="{Binding CanMake}" Command="{Binding #Root.((vm:MainViewModel)DataContext).MakeMontageCommand}">
                <TextBlock svc:Tr.Text="Make montage" />
              </Button>
            </Grid>
          </Border>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="14" Margin="24,0,24,18">
              <StackPanel Spacing="6">
                <TextBlock Classes="label" svc:Tr.Text="VIDEOS" />
                <ContentControl Content="{Binding Source}" />
              </StackPanel>
              <StackPanel Spacing="6">
                <TextBlock Classes="label" svc:Tr.Text="FROM EACH VIDEO" />
                <ContentControl Content="{Binding Length}" />
              </StackPanel>
              <StackPanel Spacing="6">
                <TextBlock Classes="label" svc:Tr.Text="TRANSITION" />
                <ContentControl Content="{Binding Transition}" />
              </StackPanel>
              <StackPanel Spacing="6">
                <TextBlock Classes="label" svc:Tr.Text="ORDER" />
                <ContentControl Content="{Binding Order}" />
              </StackPanel>
              <StackPanel Spacing="8">
                <TextBlock Classes="label" svc:Tr.Text="MUSIC" />
                <Grid ColumnDefinitions="*,Auto,Auto">
                  <TextBlock Text="{Binding MusicName}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding MusicPath}" />
                  <Button Grid.Column="1" Classes="soft" Padding="10,5" Margin="8,0,0,0" Command="{Binding #Root.((vm:MainViewModel)DataContext).PickMontageMusicCommand}">
                    <TextBlock svc:Tr.Text="Pick a song…" FontSize="12" />
                  </Button>
                  <Button Grid.Column="2" Classes="ghost" Padding="6" Margin="4,0,0,0" IsVisible="{Binding HasMusic}" svc:Tr.Tip="No music"
                          Click="OnClearMontageMusicClick">
                    <PathIcon Data="{StaticResource IcDelete}" Width="13" Height="13" />
                  </Button>
                </Grid>
                <StackPanel Spacing="10" IsVisible="{Binding HasMusic}">
                  <ContentControl Content="{Binding MusicVolume}" />
                  <CheckBox IsChecked="{Binding MusicDuck}" FontSize="12" svc:Tr.Content="Lower it when the game is loud" />
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Border>

    <!-- ======================= SMART RENAME ======================= -->
    <Border x:Name="RenameScrim" Background="{DynamicResource Scrim}" IsVisible="{Binding IsShowingRename}">
      <Border Width="760" MaxHeight="760" Margin="0,40" VerticalAlignment="Center" HorizontalAlignment="Center" Background="{DynamicResource Bg1}"
              BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="16" BoxShadow="{DynamicResource DialogShadow}"
              DataContext="{Binding Rename}" x:DataType="vm:SmartRenameViewModel">
        <DockPanel>
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="24,22,24,6">
            <TextBlock svc:Tr.Text="Smart rename" FontSize="17" FontWeight="Bold" VerticalAlignment="Center" />
            <Button Grid.Column="1" Classes="ghost" Padding="6" IsEnabled="{Binding IsIdle}" Command="{Binding #Root.((vm:MainViewModel)DataContext).CloseSmartRenameCommand}">
              <PathIcon Data="{StaticResource IcClose}" Width="13" Height="13" />
            </Button>
          </Grid>
          <TextBlock DockPanel.Dock="Top" Classes="dim" FontSize="12" TextWrapping="Wrap" Margin="24,0,24,12" Text="{Binding Intro}" />
          <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="24,12">
            <StackPanel Spacing="8">
              <CheckBox IsChecked="{Binding RenameFiles}" IsEnabled="{Binding IsIdle}" IsVisible="{Binding HasRows}">
                <TextBlock svc:Tr.Text="Rename the files too (otherwise only the name shown in Savefile changes)" FontSize="12" />
              </CheckBox>
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding Status}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                  <Button Classes="soft" svc:Tr.Content="Undo" IsVisible="{Binding CanUndo}" IsEnabled="{Binding IsIdle}"
                          Command="{Binding #Root.((vm:MainViewModel)DataContext).UndoSmartRenameCommand}" />
                  <Button Classes="accent" svc:Tr.Content="Rename" IsEnabled="{Binding IsIdle}" IsVisible="{Binding HasRows}"
                          Command="{Binding #Root.((vm:MainViewModel)DataContext).ApplySmartRenameCommand}" />
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Rows}" Margin="24,0,24,16" IsEnabled="{Binding IsIdle}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:SmartRenameRow">
                  <Border Classes="cleanrow">
                    <Grid ColumnDefinitions="Auto,*,Auto,1.3*">
                      <CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Center" MinWidth="0" Margin="0,0,8,0" />
                      <TextBlock Grid.Column="1" Classes="dim" Text="{Binding OldTitle}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip.Tip="{Binding Item.Entry.Path}" />
                      <TextBlock Grid.Column="2" Classes="dim" Text="→" Margin="10,0" VerticalAlignment="Center" />
                      <TextBox Grid.Column="3" Text="{Binding NewTitle}" CornerRadius="8" FontSize="12" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Border>

    <!-- ======================= MAKE ROOM ======================= -->
    <!-- ======================= WHO'S THAT? (voice game) ======================= -->
    <Border x:Name="VoiceScrim" Background="{DynamicResource Scrim}" IsVisible="{Binding IsShowingVoiceGame}">
      <Border Width="600" Margin="0,40" VerticalAlignment="Center" HorizontalAlignment="Center" Background="{DynamicResource Bg1}"
              BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="16" BoxShadow="{DynamicResource DialogShadow}"
              DataContext="{Binding VoiceGame}" x:DataType="vm:VoiceGameViewModel">
        <StackPanel>
          <Grid ColumnDefinitions="*,Auto,Auto" Margin="24,20,20,0">
            <StackPanel VerticalAlignment="Center" Spacing="2">
              <TextBlock svc:Tr.Text="Who's that?" FontSize="17" FontWeight="Bold" />
              <TextBlock Classes="dim" FontSize="12" svc:Tr.Text="Help Mochi learn your friends' voices" />
            </StackPanel>
            <TextBlock Grid.Column="1" Classes="dim" FontSize="12" Text="{Binding RoundText}" VerticalAlignment="Center" Margin="0,0,10,0" />
            <Button Grid.Column="2" Classes="ghost" Padding="6" svc:Tr.Tip="Done for now" Command="{Binding #Root.((vm:MainViewModel)DataContext).CloseVoiceGameCommand}">
              <PathIcon Data="{StaticResource IcClose}" Width="13" Height="13" />
            </Button>
          </Grid>
          <ProgressBar Minimum="0" Maximum="1" Value="{Binding Progress}" Height="3" MinHeight="3" CornerRadius="2" Margin="24,12,24,0" />

          <!-- Mochi listening, and what it says -->
          <Grid ColumnDefinitions="Auto,*" Margin="24,18,24,0">
            <c:BlobMascot Width="92" Height="84" Margin="22,0,0,0" Mood="{Binding Mood}" CheerTick="{Binding Cheer}" MaxFps="40"
                          Hat="{Binding #Root.((vm:MainViewModel)DataContext).MochiHat}" Still="{Binding #Root.((vm:MainViewModel)DataContext).ReducedMotion}" />
            <Border Grid.Column="1" Background="{DynamicResource AccentSoft}" CornerRadius="12" Padding="12,9" Margin="4,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="{Binding MochiLine}" FontSize="13" TextWrapping="Wrap" />
            </Border>
          </Grid>

          <!-- the snippet -->
          <Border Margin="24,16,24,0" Padding="14,12" CornerRadius="12" Background="{DynamicResource Bg2}" IsVisible="{Binding IsPlayingRound}">
            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto">
              <Button Grid.RowSpan="2" Classes="accent" Width="44" Height="44" CornerRadius="22" Padding="0" VerticalAlignment="Center"
                      svc:Tr.Tip="Play it again" Command="{Binding PlayCommand}">
                <PathIcon Data="{StaticResource IcPlay}" Width="16" Height="16" Margin="2,0,0,0" />
              </Button>
              <ItemsControl Grid.Column="1" ItemsSource="{Binding Current.Bars}" Margin="14,0,0,0" Height="36" VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="3" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:Double">
                    <Border Width="4" Height="{Binding}" CornerRadius="2" Background="{DynamicResource Highlight}" VerticalAlignment="Center" Opacity="0.8" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Grid.Row="1" Grid.Column="1" Margin="14,6,0,0" FontSize="13" FontStyle="Italic" TextWrapping="Wrap"
                         Text="{Binding Current.Quote, StringFormat='“{0}”'}" IsVisible="{Binding Current.HasQuote}" />
              <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Classes="dim" FontSize="11" Margin="0,8,0,0" Text="{Binding Current.Context}" TextWrapping="Wrap" />
            </Grid>
          </Border>

          <!-- the answers -->
          <StackPanel Margin="24,14,24,0" Spacing="8" IsVisible="{Binding IsPlayingRound}">
            <StackPanel Spacing="8" IsVisible="{Binding IsChoosing}">
              <TextBlock Classes="dim" FontSize="11" FontWeight="SemiBold" svc:Tr.Text="MOCHI THINKS IT'S" IsVisible="{Binding Current.HasGuesses}" />
              <ItemsControl ItemsSource="{Binding Current.Guesses}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:VoiceGuess">
                    <Button Classes="soft" Margin="0,0,8,8" Padding="14,7" CornerRadius="18"
                            Command="{Binding #Root.((vm:MainViewModel)DataContext).VoiceGame.PickCommand}" CommandParameter="{Binding Name}">
                      <StackPanel Spacing="3">
                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <Border Width="{Binding Bar}" Height="3" CornerRadius="2" Background="{DynamicResource Highlight}" VerticalAlignment="Center" />
                          <TextBlock Classes="dim" FontSize="10" Text="{Binding Hint}" />
                        </StackPanel>
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <WrapPanel>
                <Button Classes="soft" Margin="0,0,8,8" Padding="12,6" CornerRadius="16" svc:Tr.Content="Someone else…" Command="{Binding SomeoneElseCommand}" />
                <Button Classes="soft" Margin="0,0,8,8" Padding="12,6" CornerRadius="16" svc:Tr.Content="That's me" Command="{Binding MeCommand}" />
                <Button Classes="ghost" Margin="0,0,8,8" Padding="12,6" svc:Tr.Content="Not sure, skip" Command="{Binding SkipCommand}" />
                <Button Classes="ghost" Margin="0,0,8,8" Padding="12,6" svc:Tr.Content="Not a person" svc:Tr.Tip="The game, music, a bot or a video: don't ask about this voice again"
                        Command="{Binding IgnoreCommand}" />
              </WrapPanel>
            </StackPanel>

            <!-- "Someone else": type a name, pick a friend or add a new one -->
            <StackPanel Spacing="8" IsVisible="{Binding IsNaming}">
              <TextBlock Classes="dim" FontSize="11" FontWeight="SemiBold" svc:Tr.Text="WHO IS IT?" />
              <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBox Classes="fx" Text="{Binding NameText}" svc:Tr.Watermark="A friend's name" />
                <Button Grid.Column="1" Classes="accent" Margin="8,0,0,0" svc:Tr.Content="That's them" Command="{Binding ConfirmNameCommand}" />
                <Button Grid.Column="2" Classes="ghost" Margin="4,0,0,0" svc:Tr.Content="Back" Command="{Binding CancelNameCommand}" />
              </Grid>
              <ItemsControl ItemsSource="{Binding NameMatches}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <Button Classes="soft" Margin="0,0,6,6" Padding="10,5" CornerRadius="14" Content="{Binding}"
                            Command="{Binding #Root.((vm:MainViewModel)DataContext).VoiceGame.PickCommand}" CommandParameter="{Binding}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" svc:Tr.Text="A new name becomes a new friend, so you'll find their clips in the sidebar." />
            </StackPanel>
          </StackPanel>

          <!-- how well Mochi knows each voice -->
          <Border Margin="24,10,24,0" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,12,0,0"
                  IsVisible="{Binding HasFriends}">
            <StackPanel Spacing="8">
              <TextBlock Classes="dim" FontSize="11" FontWeight="SemiBold" svc:Tr.Text="VOICES MOCHI KNOWS" />
              <ItemsControl ItemsSource="{Binding Friends}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:VoiceFriend">
                    <Grid ColumnDefinitions="90,*" Margin="0,0,16,6">
                      <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                      <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <ProgressBar Minimum="0" Maximum="1" Value="{Binding Fill}" Height="4" MinHeight="4" MinWidth="0" CornerRadius="2" />
                        <TextBlock Classes="dim" FontSize="10" Text="{Binding State}" />
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <Grid ColumnDefinitions="*,Auto,Auto" Margin="24,8,24,20">
            <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"
                       svc:Tr.Text="Everything stays on this computer. Answers only help Mochi tell voices apart." />
            <Button Grid.Column="1" Classes="ghost" Margin="0,0,6,0" svc:Tr.Content="Undo" IsVisible="{Binding CanUndo}" Command="{Binding UndoCommand}" />
            <Button Grid.Column="2" Classes="soft" svc:Tr.Content="Done for now" Command="{Binding #Root.((vm:MainViewModel)DataContext).CloseVoiceGameCommand}" />
          </Grid>
        </StackPanel>
      </Border>
    </Border>

    <Border x:Name="ShrinkScrim" Background="{DynamicResource Scrim}" IsVisible="{Binding IsShowingShrink}">
      <Border Width="720" MaxHeight="760" Margin="0,40" VerticalAlignment="Center" HorizontalAlignment="Center" Background="{DynamicResource Bg1}"
              BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="16" BoxShadow="{DynamicResource DialogShadow}"
              DataContext="{Binding Shrink}" x:DataType="vm:ShrinkViewModel">
        <DockPanel>
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="24,22,24,6">
            <TextBlock svc:Tr.Text="Make room" FontSize="17" FontWeight="Bold" VerticalAlignment="Center" />
            <Button Grid.Column="1" Classes="ghost" Padding="6" svc:Tr.Tip="Close (stops after the video it's on)" Command="{Binding #Root.((vm:MainViewModel)DataContext).CloseShrinkCommand}">
              <PathIcon Data="{StaticResource IcClose}" Width="13" Height="13" />
            </Button>
          </Grid>
          <TextBlock DockPanel.Dock="Top" Classes="dim" FontSize="12" TextWrapping="Wrap" Margin="24,0,24,10" Text="{Binding Intro}" />
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="24,0,24,8" IsVisible="{Binding HasRows}" IsEnabled="{Binding IsIdle}">
            <Button Classes="ghost" Padding="8,3" FontSize="12" svc:Tr.Content="Tick all" Command="{Binding #Root.((vm:MainViewModel)DataContext).ShrinkCheckAllCommand}" />
            <Button Classes="ghost" Padding="8,3" FontSize="12" svc:Tr.Content="Tick none" Command="{Binding #Root.((vm:MainViewModel)DataContext).ShrinkCheckNoneCommand}" />
          </StackPanel>
          <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="24,12" IsVisible="{Binding HasRows}">
            <StackPanel Spacing="8">
              <TextBlock Classes="dim" Text="{Binding Total}" FontSize="12" TextWrapping="Wrap" />
              <!-- the confirmation, before anything is touched -->
              <Border Background="{DynamicResource AccentSoft}" CornerRadius="10" Padding="12,10" IsVisible="{Binding IsConfirming}">
                <StackPanel Spacing="8">
                  <TextBlock FontSize="12" TextWrapping="Wrap"
                             svc:Tr.Text="Each ticked video is encoded again on this computer, quietly in the background (a big one can take a few minutes). When a new copy is checked and clearly smaller, it takes the original's place, keeping its name, date, favourite, tags, friends and notes. The original goes to the bin for 24 hours." />
                  <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button Classes="soft" svc:Tr.Content="Not now" Command="{Binding #Root.((vm:MainViewModel)DataContext).CancelShrinkAskCommand}" />
                    <Button Classes="soft" svc:Tr.Content="Try one first" Command="{Binding #Root.((vm:MainViewModel)DataContext).ShrinkOneCommand}" />
                    <Button Classes="accent" svc:Tr.Content="Make them smaller" Command="{Binding #Root.((vm:MainViewModel)DataContext).ShrinkAllCommand}" />
                  </StackPanel>
                </StackPanel>
              </Border>
              <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding !IsConfirming}">
                <TextBlock Text="{Binding Status}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" />
                <Button Grid.Column="1" Classes="accent" svc:Tr.Content="Make room…" IsEnabled="{Binding IsIdle}"
                        Command="{Binding #Root.((vm:MainViewModel)DataContext).AskShrinkCommand}" />
              </Grid>
            </StackPanel>
          </Border>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Rows}" Margin="24,0,24,16">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ShrinkRow">
                  <Border Classes="cleanrow">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Center" MinWidth="0" Margin="0,0,8,0"
                                IsEnabled="{Binding #Root.((vm:MainViewModel)DataContext).Shrink.IsIdle}" />
                      <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Item.Entry.Path}" />
                        <TextBlock Classes="dim" Text="{Binding Detail}" FontSize="11" />
                        <ProgressBar Minimum="0" Maximum="1" Value="{Binding Progress}" Height="3" MinHeight="3" CornerRadius="2" IsVisible="{Binding IsWorking}" />
                      </StackPanel>
                      <TextBlock Grid.Column="2" Text="{Binding State}" FontSize="12" Foreground="{DynamicResource Highlight}" VerticalAlignment="Center"
                                 MaxWidth="240" TextWrapping="Wrap" TextAlignment="Right" Margin="10,0,0,0" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Border>

    <!-- ======================= MERGE FOLDERS ======================= -->
    <Border x:Name="MergeScrim" Background="{DynamicResource Scrim}" IsVisible="{Binding IsShowingMerge}">
      <Border Width="640" MaxHeight="720" Margin="0,40" VerticalAlignment="Center" HorizontalAlignment="Center" Background="{DynamicResource Bg1}"
              BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="16" BoxShadow="{DynamicResource DialogShadow}"
              DataContext="{Binding Merge}" x:DataType="vm:FolderMergeViewModel">
        <DockPanel>
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="24,22,24,6">
            <TextBlock svc:Tr.Text="Merge folders into one" FontSize="17" FontWeight="Bold" VerticalAlignment="Center" />
            <Button Grid.Column="1" Classes="ghost" Padding="6" IsEnabled="{Binding IsIdle}" Command="{Binding #Root.((vm:MainViewModel)DataContext).CloseMergeCommand}">
              <PathIcon Data="{StaticResource IcClose}" Width="13" Height="13" />
            </Button>
          </Grid>
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="24,0,24,12">
            <TextBlock Classes="dim" FontSize="12" TextWrapping="Wrap" Text="{Binding TargetText}" VerticalAlignment="Center" Margin="0,0,12,0" />
            <Button Grid.Column="1" Classes="soft" svc:Tr.Content="Change…" IsEnabled="{Binding IsIdle}"
                    Command="{Binding #Root.((vm:MainViewModel)DataContext).PickMergeTargetCommand}" />
          </Grid>
          <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="24,12">
            <StackPanel Spacing="8">
              <ProgressBar Minimum="0" Maximum="1" Value="{Binding Progress}" Height="4" MinHeight="4" CornerRadius="2" IsVisible="{Binding IsBusy}" />
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding Status}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" Classes.error="{Binding StatusIsError}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                  <Button Classes="soft" svc:Tr.Content="Undo merge" IsVisible="{Binding CanUndo}" IsEnabled="{Binding IsIdle}"
                          Command="{Binding #Root.((vm:MainViewModel)DataContext).UndoMergeCommand}" />
                  <Button Classes="accent" svc:Tr.Content="Merge" IsEnabled="{Binding IsIdle}" IsVisible="{Binding !IsDone}"
                          Command="{Binding #Root.((vm:MainViewModel)DataContext).RunMergeCommand}" />
                  <Button Classes="accent" svc:Tr.Content="Done" IsVisible="{Binding IsDone}" IsEnabled="{Binding IsIdle}"
                          Command="{Binding #Root.((vm:MainViewModel)DataContext).CloseMergeCommand}" />
                </StackPanel>
              </Grid>
              <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap"
                         svc:Tr.Text="Only videos move. Favourites, tags, friends, notes, collections, edits and backups go with them. Nothing is overwritten or deleted, and Undo merge puts everything back." />
            </StackPanel>
          </Border>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Rows}" Margin="24,0,24,16" IsEnabled="{Binding IsIdle}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:MergeRow">
                  <Border Classes="cleanrow">
                    <Grid ColumnDefinitions="Auto,*">
                      <CheckBox IsChecked="{Binding IsChecked}" IsEnabled="{Binding CanMerge}" VerticalAlignment="Center" MinWidth="0" Margin="0,0,8,0" />
                      <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Path}" />
                          <TextBlock Grid.Column="1" Classes="dim" Text="{Binding Details}" FontSize="11" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Classes="dim" Text="{Binding Path}" FontSize="11" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Note}" FontSize="11" Foreground="{DynamicResource Highlight}" TextWrapping="Wrap" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Border>

    <!-- ======================= BACKUP ======================= -->
    <Border x:Name="BackupScrim" Background="{DynamicResource Scrim}" IsVisible="{Binding IsShowingBackup}">
      <Border Width="600" MaxHeight="760" Margin="0,40" VerticalAlignment="Center" HorizontalAlignment="Center" Background="{DynamicResource Bg1}"
              BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="16" BoxShadow="{DynamicResource DialogShadow}"
              DataContext="{Binding BackupPanel}" x:DataType="vm:BackupViewModel">
        <DockPanel>
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="24,22,24,6">
            <TextBlock svc:Tr.Text="Backup to your own server" FontSize="17" FontWeight="Bold" VerticalAlignment="Center" />
            <Button x:Name="BackupClose" Grid.Column="1" Classes="ghost" Padding="6" Command="{Binding #Root.((vm:MainViewModel)DataContext).CloseBackupCommand}">
              <PathIcon Data="{StaticResource IcClose}" Width="13" Height="13" />
            </Button>
          </Grid>
          <TextBlock DockPanel.Dock="Top" Classes="dim" FontSize="12" TextWrapping="Wrap" Margin="24,0,24,12"
                     svc:Tr.Text="Savefile copies your videos to a server you run yourself, on your own network: a folder on any computer you can SSH into, or an S3 storage server. Nothing is deleted there, and nothing goes anywhere else." />
          <!-- actions -->
          <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="24,12">
            <StackPanel Spacing="8">
              <StackPanel Spacing="4" IsVisible="{Binding IsBusy}">
                <ProgressBar Minimum="0" Maximum="1" Value="{Binding Progress}" Height="4" MinHeight="4" CornerRadius="2" />
                <TextBlock Classes="dim" FontSize="11" Text="{Binding ProgressText}" />
              </StackPanel>
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="dim" FontSize="12" Text="{Binding Summary}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                  <Button Classes="soft" svc:Tr.Content="Stop" IsVisible="{Binding IsBusy}" Command="{Binding #Root.((vm:MainViewModel)DataContext).StopBackupCommand}" />
                  <Button x:Name="BackupNow" Classes="accent" IsEnabled="{Binding IsIdle}" Command="{Binding #Root.((vm:MainViewModel)DataContext).BackUpNowCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                      <PathIcon Data="{StaticResource IcCloud}" Width="13" Height="13" />
                      <TextBlock svc:Tr.Text="Back up now" FontWeight="SemiBold" />
                    </StackPanel>
                  </Button>
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12" Margin="24,0,24,16">
              <TextBlock Classes="label" svc:Tr.Text="SERVER" />
              <Border Classes="group">
                <StackPanel Margin="14,12" Spacing="10">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                      <TextBlock FontSize="12" svc:Tr.Text="Connect with" />
                      <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" IsVisible="{Binding IsSftp}"
                                 svc:Tr.Text="Any computer you can SSH into: a Linux server, a NAS, a Mac with Remote Login on." />
                      <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" IsVisible="{Binding IsS3}"
                                 svc:Tr.Text="A storage server that speaks S3: Garage, SeaweedFS, MinIO." />
                    </StackPanel>
                    <ItemsControl Grid.Column="1" ItemsSource="{Binding Kind.Chips}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6" /></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:OptionChip">
                          <Button Classes="chip" Classes.on="{Binding IsOn}" Content="{Binding Label}" Command="{Binding PickCommand}" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Grid>
                  <Border Classes="sep" Margin="-14,0" />

                  <!-- SFTP -->
                  <StackPanel Spacing="10" IsVisible="{Binding IsSftp}">
                    <Grid ColumnDefinitions="*,12,90">
                      <StackPanel Spacing="4">
                        <TextBlock FontSize="12" svc:Tr.Text="Server" />
                        <TextBox x:Name="BackupHost" Text="{Binding Host}" CornerRadius="8" Watermark="192.168.1.20" />
                      </StackPanel>
                      <StackPanel Grid.Column="2" Spacing="4">
                        <TextBlock FontSize="12" svc:Tr.Text="Port" />
                        <TextBox Text="{Binding Port}" CornerRadius="8" Watermark="22" />
                      </StackPanel>
                    </Grid>
                    <Grid ColumnDefinitions="*,12,*">
                      <StackPanel Spacing="4">
                        <TextBlock FontSize="12" svc:Tr.Text="User name" />
                        <TextBox Text="{Binding User}" CornerRadius="8" />
                      </StackPanel>
                      <StackPanel Grid.Column="2" Spacing="4">
                        <TextBlock FontSize="12" svc:Tr.Text="Folder on the server" />
                        <TextBox Text="{Binding RemoteFolder}" CornerRadius="8" Watermark="savefile"
                                 svc:Tr.Tip="A path like /srv/backups/savefile, or a folder name inside your home folder. Savefile makes it if it isn't there." />
                      </StackPanel>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock FontSize="12" svc:Tr.Text="Sign in with" VerticalAlignment="Center" />
                      <ItemsControl Grid.Column="1" ItemsSource="{Binding SignIn.Chips}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6" /></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:OptionChip">
                          <Button Classes="chip" Classes.on="{Binding IsOn}" Content="{Binding Label}" Command="{Binding PickCommand}" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </Grid>
                    <Grid ColumnDefinitions="*,12,*" IsVisible="{Binding UseKey}">
                      <StackPanel Spacing="4">
                        <TextBlock FontSize="12" svc:Tr.Text="Key file" />
                        <Grid ColumnDefinitions="*,6,Auto">
                          <TextBox Text="{Binding KeyFile}" CornerRadius="8" Watermark="{Binding KeyFileHint}" />
                          <Button Grid.Column="2" Classes="soft" svc:Tr.Content="Choose…"
                                  Command="{Binding #Root.((vm:MainViewModel)DataContext).PickKeyFileCommand}" />
                        </Grid>
                      </StackPanel>
                      <StackPanel Grid.Column="2" Spacing="4">
                        <TextBlock FontSize="12" svc:Tr.Text="Passphrase (if the key has one)" />
                        <TextBox Text="{Binding SftpSecret}" CornerRadius="8" PasswordChar="•" RevealPassword="False" />
                      </StackPanel>
                    </Grid>
                    <StackPanel Spacing="4" IsVisible="{Binding UsePassword}">
                      <TextBlock FontSize="12" svc:Tr.Text="Password" />
                      <TextBox Text="{Binding SftpSecret}" CornerRadius="8" PasswordChar="•" RevealPassword="False" />
                    </StackPanel>
                    <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasHostKey}">
                      <TextBlock Classes="dim" FontSize="11" Text="{Binding HostKeyText}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"
                                 svc:Tr.Tip="Savefile only talks to the server with this key, so nothing else on the network can pretend to be it." />
                      <Button Grid.Column="1" Classes="ghost" FontSize="11" svc:Tr.Content="Forget server key"
                              Command="{Binding #Root.((vm:MainViewModel)DataContext).ForgetHostKeyCommand}" />
                    </Grid>
                  </StackPanel>

                  <!-- S3 -->
                  <StackPanel Spacing="10" IsVisible="{Binding IsS3}">
                    <StackPanel Spacing="4">
                      <TextBlock FontSize="12" svc:Tr.Text="Address" />
                      <TextBox x:Name="BackupEndpoint" Text="{Binding Endpoint}" CornerRadius="8" Watermark="http://192.168.1.20:3900" />
                    </StackPanel>
                    <Grid ColumnDefinitions="*,12,*">
                      <StackPanel Spacing="4">
                        <TextBlock FontSize="12" svc:Tr.Text="Bucket" />
                        <TextBox Text="{Binding Bucket}" CornerRadius="8" Watermark="savefile" />
                      </StackPanel>
                      <StackPanel Grid.Column="2" Spacing="4">
                        <TextBlock FontSize="12" svc:Tr.Text="Region" />
                        <TextBox Text="{Binding Region}" CornerRadius="8" svc:Tr.Tip="Garage uses &quot;garage&quot;; most other servers accept anything." />
                      </StackPanel>
                    </Grid>
                    <Grid ColumnDefinitions="*,12,*">
                      <StackPanel Spacing="4">
                        <TextBlock FontSize="12" svc:Tr.Text="Access key" />
                        <TextBox Text="{Binding AccessKey}" CornerRadius="8" />
                      </StackPanel>
                      <StackPanel Grid.Column="2" Spacing="4">
                        <TextBlock FontSize="12" svc:Tr.Text="Secret key" />
                        <TextBox Text="{Binding SecretKey}" CornerRadius="8" PasswordChar="•" RevealPassword="False" />
                      </StackPanel>
                    </Grid>
                    <StackPanel Spacing="4">
                      <TextBlock FontSize="12" svc:Tr.Text="Folder in the bucket" />
                      <TextBox Text="{Binding Prefix}" CornerRadius="8" svc:Tr.Tip="Lets one bucket hold the backups of several computers." />
                    </StackPanel>
                  </StackPanel>

                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding Status}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"
                               Classes.error="{Binding StatusIsError}" IsVisible="{Binding HasStatus}" />
                    <Button Grid.Column="1" Classes="soft" svc:Tr.Content="Test connection" IsEnabled="{Binding IsIdle}"
                            Command="{Binding #Root.((vm:MainViewModel)DataContext).TestBackupCommand}" />
                  </Grid>
                  <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap"
                             svc:Tr.Text="Passwords and keys are kept in your system's keychain, not in Savefile's settings file." />
                </StackPanel>
              </Border>

              <TextBlock Classes="label" svc:Tr.Text="WHAT TO BACK UP" />
              <Border Classes="group">
                <StackPanel>
                  <Grid Classes="row" ColumnDefinitions="*,Auto">
                    <TextBlock svc:Tr.Text="Videos" VerticalAlignment="Center" />
                    <ItemsControl Grid.Column="1" ItemsSource="{Binding What.Chips}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6" /></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:OptionChip">
                          <Button Classes="chip" Classes.on="{Binding IsOn}" Content="{Binding Label}" Command="{Binding PickCommand}" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Grid>
                  <Border Classes="sep" />
                  <Grid Classes="row" ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="2">
                      <TextBlock svc:Tr.Text="Back up on its own" />
                      <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" svc:Tr.Text="New clips and new favourites are backed up a little while after they're saved, while Savefile is open." />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" Classes="bare" IsChecked="{Binding Automatic}" />
                  </Grid>
                  <Border Classes="sep" />
                  <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" Margin="14,10"
                             svc:Tr.Text="Favourites, tags, friends and notes go along with the videos, so a restore brings them back too." />
                </StackPanel>
              </Border>

              <TextBlock Classes="label" svc:Tr.Text="NEW COMPUTER" />
              <Border Classes="group">
                <StackPanel Margin="14,12" Spacing="10">
                  <TextBlock Classes="dim" FontSize="12" TextWrapping="Wrap"
                             svc:Tr.Text="Bring back videos that are on the server but not on this computer. They go to a Restored folder in your clips folder, with their favourites, tags, friends and notes." />
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding RestoreText}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                      <Button Classes="soft" svc:Tr.Content="Find videos to restore" IsEnabled="{Binding IsIdle}"
                              Command="{Binding #Root.((vm:MainViewModel)DataContext).FindRestoreCommand}" />
                      <Button Classes="accent" svc:Tr.Content="Restore" IsVisible="{Binding HasRestorePlan}" IsEnabled="{Binding IsIdle}"
                              Command="{Binding #Root.((vm:MainViewModel)DataContext).RestoreCommand}" />
                    </StackPanel>
                  </Grid>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Border>

    <!-- ======================= OTHER RECORDERS ======================= -->
    <Border x:Name="RecordersScrim" Background="{DynamicResource Scrim}" IsVisible="{Binding IsShowingRecorders}">
      <Border Width="640" MaxHeight="720" Margin="0,40" VerticalAlignment="Center" HorizontalAlignment="Center" Background="{DynamicResource Bg1}"
              BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="16" BoxShadow="{DynamicResource DialogShadow}"
              DataContext="{Binding Recorders}" x:DataType="vm:RecordersViewModel">
        <DockPanel>
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="24,22,24,6">
            <TextBlock svc:Tr.Text="Other recorders" FontSize="17" FontWeight="Bold" VerticalAlignment="Center" />
            <Button x:Name="RecordersClose" Grid.Column="1" Classes="ghost" Padding="6" Command="{Binding #Root.((vm:MainViewModel)DataContext).CloseRecordersCommand}">
              <PathIcon Data="{StaticResource IcClose}" Width="13" Height="13" />
            </Button>
          </Grid>
          <TextBlock DockPanel.Dock="Top" Classes="dim" FontSize="12" TextWrapping="Wrap" Margin="24,0,24,12"
                     svc:Tr.Text="Add another app's recording folder and its videos show up here as well, and new ones appear by themselves. Nothing is moved or changed." />
          <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="24,12">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="2" VerticalAlignment="Center">
                <TextBlock svc:Tr.Text="Tag by game" FontSize="13" />
                <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" svc:Tr.Text="New videos get the game's name as a tag, when the recorder tells which game it was." />
              </StackPanel>
              <ToggleSwitch Grid.Column="1" Classes="bare" IsChecked="{Binding TagByGame}" />
            </Grid>
          </Border>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Rows}" Margin="24,0,24,16">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:RecorderRow">
                  <Border Classes="cleanrow" Margin="0,0,0,8" Padding="14,12">
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                      <StackPanel Spacing="3">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" />
                          <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{DynamicResource Highlight}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Classes="dim" Classes.mono="{Binding HasPath}" Text="{Binding PathText}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Path}" />
                        <TextBlock Classes="dim" Text="{Binding Description}" FontSize="11" TextWrapping="Wrap" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="12,0,0,0"
                                  IsVisible="{Binding IsSupported}">
                        <Button Classes="ghost" svc:Tr.Content="Change…" FontSize="12"
                                Command="{Binding #Root.((vm:MainViewModel)DataContext).ChangeRecorderFolderCommand}" CommandParameter="{Binding}" />
                        <Button Classes="accent" svc:Tr.Content="Add" IsVisible="{Binding CanAdd}"
                                Command="{Binding #Root.((vm:MainViewModel)DataContext).AddRecorderCommand}" CommandParameter="{Binding}" />
                        <Button Classes="soft" svc:Tr.Content="Remove" IsVisible="{Binding IsAdded}"
                                Command="{Binding #Root.((vm:MainViewModel)DataContext).RemoveRecorderCommand}" CommandParameter="{Binding}" />
                      </StackPanel>
                      <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8" Margin="0,10,0,0" IsVisible="{Binding HasPending}">
                        <Button Classes="soft" Command="{Binding #Root.((vm:MainViewModel)DataContext).ConvertSteamClipsCommand}" IsEnabled="{Binding !IsConverting}">
                          <TextBlock Text="{Binding PendingText}" />
                        </Button>
                        <ProgressBar IsIndeterminate="True" Width="80" Height="3" MinHeight="3" VerticalAlignment="Center" IsVisible="{Binding IsConverting}" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Border>

    <!-- ======================= STATS ======================= -->
    <Border x:Name="StatsScrim" Background="{DynamicResource Scrim}" IsVisible="{Binding IsShowingStats}">
      <Border Width="640" MaxHeight="720" Margin="0,40" VerticalAlignment="Center" HorizontalAlignment="Center" Background="{DynamicResource Bg1}"
              BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="16" BoxShadow="{DynamicResource DialogShadow}"
              DataContext="{Binding Stats}" x:DataType="vm:StatsViewModel">
        <DockPanel>
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="24,22,24,12">
            <TextBlock svc:Tr.Text="Stats" FontSize="17" FontWeight="Bold" VerticalAlignment="Center" />
            <Button x:Name="StatsClose" Grid.Column="1" Classes="ghost" Padding="6" Command="{Binding #Root.((vm:MainViewModel)DataContext).CloseStatsCommand}">
              <PathIcon Data="{StaticResource IcClose}" Width="13" Height="13" />
            </Button>
          </Grid>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="18" Margin="24,0,24,24">
              <ItemsControl ItemsSource="{Binding Tiles}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:StatTile">
                    <Border Classes="tile">
                      <StackPanel Spacing="2">
                        <TextBlock Text="{Binding Value}" FontSize="22" FontWeight="Bold" />
                        <TextBlock Classes="dim" Text="{Binding Label}" FontSize="12" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <StackPanel Spacing="8">
                <TextBlock Classes="label" svc:Tr.Text="CLIPS PER WEEK" />
                <Border Classes="group" Padding="16,14">
                  <ItemsControl ItemsSource="{Binding Weeks}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:StatBar">
                        <StackPanel Spacing="4" VerticalAlignment="Bottom">
                          <TextBlock Classes="dim" Text="{Binding Count}" FontSize="11" HorizontalAlignment="Center" />
                          <Border Height="{Binding Height}" Width="26" CornerRadius="4" Background="{DynamicResource Accent}" HorizontalAlignment="Center" />
                          <TextBlock Classes="dim" Text="{Binding Label}" FontSize="10" HorizontalAlignment="Center" />
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Border>
              </StackPanel>

              <StackPanel Spacing="8" IsVisible="{Binding HasGames}">
                <TextBlock Classes="label" svc:Tr.Text="CLIPS PER GAME" />
                <Border Classes="group" Padding="16,12">
                  <ItemsControl ItemsSource="{Binding Games}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:StatBar">
                        <Grid ColumnDefinitions="150,*,Auto" Margin="0,4">
                          <TextBlock Text="{Binding Label}" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                          <Border Grid.Column="1" Height="10" Width="{Binding Width}" CornerRadius="5" Background="{DynamicResource Highlight}"
                                  HorizontalAlignment="Left" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="2" Classes="dim" Text="{Binding Count}" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Border>
              </StackPanel>

              <!-- Badges (Settings, Features, Badges) -->
              <StackPanel Spacing="8" IsVisible="{Binding HasBadges}">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Classes="label" svc:Tr.Text="BADGES" />
                  <TextBlock Grid.Column="1" Classes="dim" Text="{Binding BadgeCount}" FontSize="11" />
                </Grid>
                <ItemsControl ItemsSource="{Binding Badges}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:BadgeRow">
                      <Border Classes="tile" Margin="0,0,8,8" Opacity="{Binding Faded}">
                        <Grid ColumnDefinitions="Auto,*">
                          <Panel Width="34" Height="34" VerticalAlignment="Top">
                            <Ellipse Fill="#E09B1A" IsVisible="{Binding Earned}" />
                            <Ellipse Margin="2" Fill="#FFC53D" IsVisible="{Binding Earned}" />
                            <Ellipse Fill="{DynamicResource Bg3}" IsVisible="{Binding !Earned}" />
                            <Path Data="M 12,2 L 14.9,8.3 L 21.8,9 L 16.6,13.6 L 18.1,20.4 L 12,16.9 L 5.9,20.4 L 7.4,13.6 L 2.2,9 L 9.1,8.3 Z"
                                  Fill="White" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                          </Panel>
                          <StackPanel Grid.Column="1" Margin="10,0,0,0" Spacing="1">
                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Classes="dim" Text="{Binding Description}" FontSize="11" TextWrapping="Wrap" />
                            <TextBlock Classes="dim" Text="{Binding When}" FontSize="10" IsVisible="{Binding Earned}" Foreground="{DynamicResource Highlight}" />
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <!-- Playtime (Settings, Features, Playtime): only what was counted here, and it says since when -->
              <StackPanel Spacing="8" IsVisible="{Binding HasPlaytime}">
                <TextBlock Classes="label" svc:Tr.Text="PLAYTIME" />
                <Border Classes="group" Padding="16,12">
                  <StackPanel Spacing="6">
                    <ItemsControl ItemsSource="{Binding Playtime}" IsVisible="{Binding HasPlaytimeBars}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:PlayBar">
                          <Grid ColumnDefinitions="150,*,Auto" Margin="0,4">
                            <TextBlock Text="{Binding Label}" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <Border Grid.Column="1" Height="10" Width="{Binding Width}" CornerRadius="5" Background="{DynamicResource Highlight}"
                                    HorizontalAlignment="Left" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Classes="dim" Text="{Binding Text}" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Classes="dim" FontSize="12" IsVisible="{Binding !HasPlaytimeBars}" TextWrapping="Wrap"
                               svc:Tr.Text="Nothing counted yet. Play a game Savefile knows (one you've clipped, or a well-known one) and it shows up here." />
                    <TextBlock Classes="dim" FontSize="11" Text="{Binding PlaytimeSince}" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Border>

    <!-- ======================= YEAR IN CLIPS ======================= -->
    <Border x:Name="RecapScrim" Background="{DynamicResource Scrim}" IsVisible="{Binding IsShowingRecap}">
      <Border Width="680" MaxHeight="760" Margin="0,40" VerticalAlignment="Center" HorizontalAlignment="Center" Background="{DynamicResource Bg1}"
              BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="16" BoxShadow="{DynamicResource DialogShadow}"
              DataContext="{Binding Recap}" x:DataType="vm:RecapViewModel">
        <DockPanel>
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="24,22,24,4">
            <StackPanel Spacing="3">
              <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="Bold" />
              <TextBlock Classes="dim" Text="{Binding Subtitle}" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
            <Button x:Name="RecapClose" Grid.Column="1" Classes="ghost" Padding="6" VerticalAlignment="Top"
                    Command="{Binding #Root.((vm:MainViewModel)DataContext).CloseRecapCommand}">
              <PathIcon Data="{StaticResource IcClose}" Width="13" Height="13" />
            </Button>
          </Grid>
          <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Year.Chips}" Margin="24,10,24,6" IsVisible="{Binding HasSeveralYears}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:OptionChip">
                <Button Classes="chip" Classes.on="{Binding IsOn}" Content="{Binding Label}" Command="{Binding PickCommand}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <!-- actions -->
          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="24,12,24,22">
            <Button Classes="soft" svc:Tr.Content="Close" Command="{Binding #Root.((vm:MainViewModel)DataContext).CloseRecapCommand}" />
            <Button x:Name="RecapImage" Classes="soft" Command="{Binding #Root.((vm:MainViewModel)DataContext).SaveRecapImageCommand}"
                    svc:Tr.Tip="Save this page as a picture to share with your friends">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <PathIcon Data="{StaticResource IcImage}" Width="13" Height="13" />
                <TextBlock svc:Tr.Text="Save as picture" />
              </StackPanel>
            </Button>
            <Button x:Name="RecapMontage" Classes="accent" Command="{Binding #Root.((vm:MainViewModel)DataContext).MakeRecapMontageCommand}"
                    IsVisible="{Binding #Root.((vm:MainViewModel)DataContext).ShowRecapMontage}"
                    svc:Tr.Tip="Your favourites from the year (and clips with friends) in one video">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <PathIcon Data="{StaticResource IcFilm}" Width="13" Height="13" />
                <TextBlock svc:Tr.Text="Make a montage of the year" FontWeight="SemiBold" />
              </StackPanel>
            </Button>
          </StackPanel>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
           <StackPanel>
            <StackPanel x:Name="RecapContent" Spacing="18" Margin="24,8,24,4">
              <!-- only drawn into the shared picture -->
              <StackPanel x:Name="RecapImageHeader" Spacing="3" IsVisible="False" Margin="0,8,0,0">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Viewbox Width="15" Height="20" VerticalAlignment="Center">
                    <Canvas Width="240" Height="324">
                      <Path Data="M14 0H194L240 46V296A28 28 0 0 1 212 324H28A28 28 0 0 1 0 296V14A14 14 0 0 1 14 0Z" Fill="{DynamicResource Accent}" />
                      <Path Data="M40 260h18v40h-18z M76 260h18v40h-18z M112 260h18v40h-18z M148 260h18v40h-18z M184 260h18v40h-18z" Fill="{DynamicResource Bg1}" Opacity="0.45" />
                      <Path Data="M92 90L92 194L174 142Z" Fill="{DynamicResource Bg1}" Stroke="{DynamicResource Bg1}" StrokeThickness="24" StrokeJoin="Round" />
                    </Canvas>
                  </Viewbox>
                  <TextBlock Text="savefile" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="Bold" />
              </StackPanel>
              <ItemsControl ItemsSource="{Binding Tiles}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><UniformGrid Columns="4" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:StatTile">
                    <Border Classes="tile">
                      <StackPanel Spacing="2">
                        <TextBlock Text="{Binding Value}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource Accent}" />
                        <TextBlock Classes="dim" Text="{Binding Label}" FontSize="12" TextWrapping="Wrap" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <!-- moments to go back to -->
              <Grid ColumnDefinitions="*,12,*">
                <Button Classes="recapmoment" Command="{Binding #Root.((vm:MainViewModel)DataContext).WatchRecapClipCommand}"
                        CommandParameter="{Binding FirstSave}" IsEnabled="{Binding FirstSave, Converter={x:Static ObjectConverters.IsNotNull}}">
                  <Grid ColumnDefinitions="96,*">
                    <Border Width="96" Height="54" CornerRadius="8" ClipToBounds="True" Background="{DynamicResource Bg3}">
                      <Image Source="{Binding FirstSave.Thumbnail}" Stretch="UniformToFill" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Spacing="2">
                      <TextBlock Classes="label" svc:Tr.Text="FIRST SAVE OF THE YEAR" />
                      <TextBlock Text="{Binding FirstSaveText}" FontSize="12" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </Grid>
                </Button>
                <Button Grid.Column="2" Classes="recapmoment" Command="{Binding #Root.((vm:MainViewModel)DataContext).WatchRecapClipCommand}"
                        CommandParameter="{Binding BestDay}" IsVisible="{Binding BestDay, Converter={x:Static ObjectConverters.IsNotNull}}">
                  <Grid ColumnDefinitions="96,*">
                    <Border Width="96" Height="54" CornerRadius="8" ClipToBounds="True" Background="{DynamicResource Bg3}">
                      <Image Source="{Binding BestDay.Thumbnail}" Stretch="UniformToFill" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Spacing="2">
                      <TextBlock Classes="label" svc:Tr.Text="YOUR BIGGEST DAY" />
                      <TextBlock Text="{Binding BestDayText}" FontSize="12" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </Grid>
                </Button>
              </Grid>

              <StackPanel Spacing="8">
                <TextBlock Classes="label" svc:Tr.Text="MONTH BY MONTH" />
                <Border Classes="group" Padding="16,14">
                  <StackPanel Spacing="10">
                    <ItemsControl ItemsSource="{Binding Months}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:StatBar">
                          <StackPanel Spacing="4" VerticalAlignment="Bottom">
                            <TextBlock Classes="dim" Text="{Binding CountText}" FontSize="10" HorizontalAlignment="Center" />
                            <Border Height="{Binding Height}" Width="22" CornerRadius="4" Background="{DynamicResource Accent}" HorizontalAlignment="Center" />
                            <TextBlock Classes="dim" Text="{Binding Label}" FontSize="10" HorizontalAlignment="Center" />
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding Busiest}" FontSize="12" Classes="dim" TextWrapping="Wrap"
                               IsVisible="{Binding Busiest, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                  </StackPanel>
                </Border>
              </StackPanel>

              <Grid ColumnDefinitions="*,12,*">
                <StackPanel Spacing="8" IsVisible="{Binding PeopleEnabled}">
                  <TextBlock Classes="label" svc:Tr.Text="WHO WAS THERE MOST" />
                  <Border Classes="group" Padding="14,10">
                    <Panel>
                      <TextBlock Classes="dim" FontSize="12" TextWrapping="Wrap" IsVisible="{Binding !HasFriends}"
                                 svc:Tr.Text="Tag your friends under Rename, tag or move, and the people you played with most show up here." />
                      <ItemsControl ItemsSource="{Binding Friends}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:RecapRow">
                            <Grid ColumnDefinitions="Auto,*" Margin="0,4">
                              <Border Width="26" Height="26" CornerRadius="13" Background="{DynamicResource AccentSoft}" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Initial}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Accent}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                              </Border>
                              <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Classes="dim" Text="{Binding Detail}" FontSize="11" />
                              </StackPanel>
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Panel>
                  </Border>
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="8">
                  <TextBlock Classes="label" svc:Tr.Text="WHAT YOU PLAYED" />
                  <Border Classes="group" Padding="14,10">
                    <Panel>
                      <TextBlock Classes="dim" FontSize="12" TextWrapping="Wrap" IsVisible="{Binding !HasGames}"
                                 svc:Tr.Text="Clips get tagged with their game when you save them, so your games show up here." />
                      <ItemsControl ItemsSource="{Binding Games}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:RecapRow">
                            <StackPanel Margin="0,4" Spacing="4">
                              <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" Classes="dim" Text="{Binding Detail}" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center" />
                              </Grid>
                              <Border Height="6" Width="{Binding Width}" CornerRadius="3" Background="{DynamicResource Highlight}" HorizontalAlignment="Left" />
                            </StackPanel>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Panel>
                  </Border>
                </StackPanel>
              </Grid>
            </StackPanel>
            <!-- Wrapped: outside RecapContent so it stays out of "Save as picture" -->
            <Border x:Name="RecapWrapped" Margin="24,18,24,4" Padding="16,14" CornerRadius="12" Background="{DynamicResource Bg2}"
                    DataContext="{Binding #Root.DataContext}" x:DataType="vm:MainViewModel" IsVisible="{Binding ShowWrapped}">
              <StackPanel Spacing="10">
                <Grid ColumnDefinitions="Auto,*">
                  <PathIcon Data="{StaticResource IcFilm}" Width="16" Height="16" Margin="0,2,10,0" VerticalAlignment="Top" Foreground="{DynamicResource Accent}" />
                  <StackPanel Grid.Column="1" Spacing="3">
                    <TextBlock Text="{Binding WrappedTitle}" FontSize="16" FontWeight="Bold" />
                    <TextBlock Classes="dim" FontSize="12" TextWrapping="Wrap" svc:Tr.Text="A video of your year: your stats, then your best moments cut to the beat of your own songs. Made on this computer." />
                    <TextBlock Classes="dim" FontSize="12" TextWrapping="Wrap" Text="{Binding WrappedPlanText}" />
                  </StackPanel>
                </Grid>
                <ItemsControl ItemsSource="{Binding WrappedSongs}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:WrappedSongRow">
                      <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                        <StackPanel Spacing="1" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                          <TextBlock Classes="dim" Text="{Binding Detail}" FontSize="11" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Button Grid.Column="1" Classes="ghost" Padding="6" svc:Tr.Tip="Remove this song"
                                Command="{Binding #Root.((vm:MainViewModel)DataContext).RemoveWrappedSongCommand}" CommandParameter="{Binding}">
                          <PathIcon Data="{StaticResource IcClose}" Width="10" Height="10" />
                        </Button>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Classes="dim" FontSize="11" Foreground="{DynamicResource Highlight}" Text="{Binding WrappedStatus}" TextWrapping="Wrap" IsVisible="{Binding IsMakingWrapped}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button x:Name="WrappedAddSongs" Classes="soft" Command="{Binding AddWrappedSongsCommand}" svc:Tr.Tip="Pick MP3s (or other music) for the video">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                      <PathIcon Data="{StaticResource IcAdd}" Width="12" Height="12" />
                      <TextBlock svc:Tr.Text="Add songs" />
                    </StackPanel>
                  </Button>
                  <Button x:Name="WrappedWatch" Classes="soft" Command="{Binding WatchWrappedCommand}" IsVisible="{Binding HasWrappedVideo}">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                      <PathIcon Data="{StaticResource IcPlay}" Width="12" Height="12" />
                      <TextBlock svc:Tr.Text="Watch" />
                    </StackPanel>
                  </Button>
                  <Button x:Name="WrappedMake" Classes="accent" Command="{Binding MakeWrappedCommand}" IsEnabled="{Binding !IsMakingWrapped}">
                    <TextBlock Text="{Binding MakeWrappedLabel}" FontWeight="SemiBold" />
                  </Button>
                </StackPanel>
              </StackPanel>
            </Border>
           </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Border>

    <!-- ======================= THE PRESENT: YOUR WRAPPED ======================= -->
    <Border x:Name="GiftScrim" Background="{DynamicResource Scrim}" IsVisible="{Binding IsWrappedGiftOpen}">
      <Border Width="540" MaxHeight="720" Margin="0,40" VerticalAlignment="Center" HorizontalAlignment="Center" Background="{DynamicResource Bg1}"
              BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="16" BoxShadow="{DynamicResource DialogShadow}">
        <ScrollViewer>
          <StackPanel Margin="28,24,28,22" Spacing="14">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <c:BlobMascot Width="58" Height="52" VerticalAlignment="Bottom" CheerTick="{Binding MascotCheer}" Still="{Binding ReducedMotion}" Hat="{Binding MochiHat}" />
              <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="{Binding GiftTitle}" FontSize="21" FontWeight="Bold" />
                <TextBlock Classes="dim" FontSize="12" svc:Tr.Text="Your year in clips, as a film." />
              </StackPanel>
              <Button Grid.Column="2" Classes="ghost" Padding="6" VerticalAlignment="Top" svc:Tr.Tip="Close (Esc)" Command="{Binding CloseWrappedGiftCommand}">
                <PathIcon Data="{StaticResource IcClose}" Width="13" Height="13" />
              </Button>
            </Grid>
            <TextBlock FontSize="13" TextWrapping="Wrap" LineHeight="20"
                       svc:Tr.Text="A 5 to 10 minute video of your year, made only from your clips: your games, your people, your biggest night and the best laughs, with a card for each friend and your best moments cut to the beat of your own music." />
            <StackPanel Spacing="6">
              <TextBlock FontSize="12" FontWeight="Bold" svc:Tr.Text="How it works" />
              <TextBlock Classes="dim" FontSize="12" TextWrapping="Wrap" svc:Tr.Text="1. Add two or three songs you love (MP3 or similar). Without songs, the clips keep their own sound." />
              <TextBlock Classes="dim" FontSize="12" TextWrapping="Wrap" svc:Tr.Text="2. Savefile makes it on this computer, in the background. Nothing leaves it. If you quit, it carries on next time." />
              <TextBlock Classes="dim" FontSize="12" TextWrapping="Wrap" svc:Tr.Text="3. When it's ready, the present next to Mochi holds it. The first time, it plays full screen." />
            </StackPanel>
            <Border Padding="14,12" CornerRadius="12" Background="{DynamicResource Bg2}">
              <StackPanel Spacing="8">
                <TextBlock Classes="dim" FontSize="12" TextWrapping="Wrap" Text="{Binding WrappedPlanText}" />
                <ItemsControl ItemsSource="{Binding WrappedSongs}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:WrappedSongRow">
                      <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                        <StackPanel Spacing="1" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                          <TextBlock Classes="dim" Text="{Binding Detail}" FontSize="11" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Button Grid.Column="1" Classes="ghost" Padding="6" svc:Tr.Tip="Remove this song"
                                Command="{Binding #Root.((vm:MainViewModel)DataContext).RemoveWrappedSongCommand}" CommandParameter="{Binding}">
                          <PathIcon Data="{StaticResource IcClose}" Width="10" Height="10" />
                        </Button>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button x:Name="GiftAddSongs" Classes="soft" HorizontalAlignment="Left" Command="{Binding AddWrappedSongsCommand}" svc:Tr.Tip="Pick MP3s (or other music) for the video">
                  <StackPanel Orientation="Horizontal" Spacing="7">
                    <PathIcon Data="{StaticResource IcAdd}" Width="12" Height="12" />
                    <TextBlock svc:Tr.Text="Add songs" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </Border>
            <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" Text="{Binding WrappedCostText}" />
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
              <Button Classes="ghost" svc:Tr.Content="Not now" Command="{Binding CloseWrappedGiftCommand}" />
              <Button x:Name="GiftMake" Classes="accent" Command="{Binding MakeWrappedFromGiftCommand}" IsEnabled="{Binding !IsMakingWrapped}">
                <TextBlock svc:Tr.Text="Make my Wrapped" FontWeight="SemiBold" />
              </Button>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Border>

    <!-- ======================= KEYBOARD SHORTCUTS ======================= -->
    <Border x:Name="ShortcutsScrim" Background="{DynamicResource Scrim}" IsVisible="{Binding IsShowingShortcuts}">
      <Border Width="560" MaxHeight="700" Margin="0,40" VerticalAlignment="Center" HorizontalAlignment="Center" Background="{DynamicResource Bg1}"
              BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="16" BoxShadow="{DynamicResource DialogShadow}"
              DataContext="{Binding ShortcutSheet}" x:DataType="vm:ShortcutsViewModel">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="24,22,24,12">
            <TextBlock svc:Tr.Text="Keyboard shortcuts" FontSize="17" FontWeight="Bold" />
            <TextBlock Classes="dim" FontSize="12" TextWrapping="Wrap" svc:Tr.Text="Click a key to change it." />
          </StackPanel>
          <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="24,14">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Button Classes="ghost" svc:Tr.Content="Reset all" FontSize="12" Command="{Binding ResetAllCommand}" />
              <TextBlock Grid.Column="1" Text="{Binding Message}" Foreground="{DynamicResource Highlight}" FontSize="12" TextWrapping="Wrap"
                         VerticalAlignment="Center" Margin="12,0" />
              <Button x:Name="ShortcutsClose" Grid.Column="2" Classes="accent" svc:Tr.Content="Done"
                      Command="{Binding #Root.((vm:MainViewModel)DataContext).CloseShortcutsCommand}" />
            </Grid>
          </Border>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Groups}" Margin="24,0,24,16">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ShortcutGroup">
                  <StackPanel Spacing="6" Margin="0,0,0,14">
                    <TextBlock Classes="label" Text="{Binding Name}" />
                    <Border Classes="group">
                      <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:ShortcutRow">
                            <Grid ColumnDefinitions="*,Auto,Auto" Margin="14,5">
                              <TextBlock Text="{Binding Label}" FontSize="13" VerticalAlignment="Center" />
                              <Button Grid.Column="1" Classes="keychip" Classes.capturing="{Binding IsCapturing}" Classes.custom="{Binding IsCustom}"
                                      Content="{Binding Keys}" IsEnabled="{Binding !IsFixed}"
                                      Command="{Binding #Root.((vm:MainViewModel)DataContext).ShortcutSheet.CaptureCommand}" CommandParameter="{Binding}" />
                              <Button Grid.Column="2" Classes="ghost" Margin="4,0,0,0" Padding="6" svc:Tr.Tip="Back to the default key"
                                      IsVisible="{Binding IsCustom}"
                                      Command="{Binding #Root.((vm:MainViewModel)DataContext).ShortcutSheet.ResetCommand}" CommandParameter="{Binding}">
                                <PathIcon Data="{StaticResource IcRefresh}" Width="12" Height="12" />
                              </Button>
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Border>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Border>

    <!-- ======================= FIRST-RUN SETUP ======================= -->
    <Border x:Name="SetupScrim" Background="{DynamicResource ScrimStrong}" IsVisible="{Binding IsSetupOpen}">
      <Border Width="560" MaxHeight="720" Margin="0,40" VerticalAlignment="Center" HorizontalAlignment="Center" Background="{DynamicResource Bg1}"
              BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="16" BoxShadow="{DynamicResource DialogShadow}">
        <DockPanel>
          <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="24,14">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center"
                         svc:Tr.Text="You can change all of this later in Settings." />
              <Button x:Name="SetupDone" Grid.Column="1" Classes="accent" svc:Tr.Content="Start using Savefile" Command="{Binding FinishSetupCommand}" />
            </Grid>
          </Border>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12" Margin="24,24,24,18">
              <StackPanel Spacing="4">
                <TextBlock svc:Tr.Text="Welcome to Savefile" FontSize="22" FontWeight="Bold" />
                <TextBlock Classes="dim" FontSize="13" TextWrapping="Wrap"
                           svc:Tr.Text="A few choices to make it yours, then go make some memories. Nothing here is required." />
              </StackPanel>

              <TextBlock Classes="label" svc:Tr.Text="LANGUAGE" Margin="0,6,0,0" />
              <ListBox Classes="swatches" ItemsSource="{Binding SetupLanguages}" SelectedItem="{Binding SetupLanguage}">
                <ListBox.ItemsPanel>
                  <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:LanguageOption">
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="12" />
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>

              <TextBlock Classes="label" svc:Tr.Text="LOOK" Margin="0,6,0,0" />
              <ListBox Classes="swatches" ItemsSource="{Binding ThemeModes}" SelectedItem="{Binding SetupMode}">
                <ListBox.ItemsPanel>
                  <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="svc:ThemeModeOption">
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="12" />
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>

              <TextBlock Classes="label" svc:Tr.Text="YOUR VIDEOS" Margin="0,6,0,0" />
              <Border Classes="group">
                <Grid Classes="row" ColumnDefinitions="*,Auto">
                  <TextBlock Text="{Binding SetupFolders}" TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center" />
                  <Button Grid.Column="1" Classes="soft" svc:Tr.Content="Add a folder…" Margin="10,0,0,0" Command="{Binding SetupAddFolderCommand}" />
                </Grid>
              </Border>

              <TextBlock Classes="label" svc:Tr.Text="FEATURES" Margin="0,6,0,0" />
              <Border Classes="group">
                <StackPanel Margin="14,8" Spacing="2">
                  <CheckBox IsChecked="{Binding SetupClipping}" svc:Tr.Content="Background clipping: save past moments with a hotkey" />
                  <CheckBox IsChecked="{Binding SetupSessions}" IsEnabled="{Binding SetupClipping}" svc:Tr.Content="Session recording: record a whole session as one video" />
                  <CheckBox IsChecked="{Binding SetupHoverPreview}" svc:Tr.Content="Hover preview: skim a video by moving the pointer over it" />
                  <CheckBox IsChecked="{Binding SetupLoudMarkers}" svc:Tr.Content="Loud moment markers on the timeline" />
                  <CheckBox IsChecked="{Binding SetupHoverGlow}" svc:Tr.Content="Hover glow around videos" />
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Border>

    <!-- ======================= SETTINGS ======================= -->
    <Border x:Name="SettingsScrim" Background="{DynamicResource Scrim}" IsVisible="{Binding IsSettingsOpen}" ZIndex="10">
      <Border Width="580" MaxHeight="720" Margin="0,40" VerticalAlignment="Stretch" HorizontalAlignment="Center"
              Background="{DynamicResource Bg1}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="16"
              BoxShadow="{DynamicResource DialogShadow}" DataContext="{Binding SettingsEditor}" x:DataType="vm:SettingsViewModel">
        <DockPanel>
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="24,22,24,10">
            <TextBlock svc:Tr.Text="Settings" FontSize="17" FontWeight="Bold" />
            <TextBlock Grid.Column="1" Classes="dim" FontSize="11" VerticalAlignment="Center"
                       Text="{Binding #Root.((vm:MainViewModel)DataContext).VersionText}" />
          </Grid>
          <ListBox DockPanel.Dock="Top" Classes="tabs" Margin="20,0,20,8" ItemsSource="{x:Static vm:SettingsViewModel.PageNames}"
                   SelectedIndex="{Binding Page}">
            <ListBox.ItemTemplate><DataTemplate x:DataType="vm:LocalizedText"><TextBlock Text="{Binding Text}" /></DataTemplate></ListBox.ItemTemplate>
          </ListBox>

          <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="24,14">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <Button Classes="ghost" svc:Tr.Content="Quit Savefile" Click="OnQuitClick" FontSize="12"
                        svc:Tr.Tip="Stops clipping and closes Savefile completely" />
                <Button Classes="ghost" svc:Tr.Content="Copy diagnostics" FontSize="12"
                        Command="{Binding #Root.((vm:MainViewModel)DataContext).CopyDiagnosticsCommand}"
                        svc:Tr.Tip="Copies version, hardware, settings and the recent log, for reporting a problem" />
              </StackPanel>
              <TextBlock Grid.Column="1" Text="{Binding Error}" Foreground="{DynamicResource Danger}" FontSize="12" TextWrapping="Wrap"
                         VerticalAlignment="Center" Margin="12,0" />
              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                <Button Classes="soft" svc:Tr.Content="Cancel" Command="{Binding #Root.((vm:MainViewModel)DataContext).CancelSettingsCommand}" />
                <Button Classes="accent" svc:Tr.Content="Save" Command="{Binding #Root.((vm:MainViewModel)DataContext).SaveSettingsCommand}" />
              </StackPanel>
            </Grid>
          </Border>

          <ScrollViewer x:Name="SettingsScroll" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12" Margin="24,4,24,20">

              <!-- ==== General ==== -->
              <StackPanel Spacing="12" IsVisible="{Binding IsGeneralPage}">
              <TextBlock Classes="label" svc:Tr.Text="APPEARANCE" />
              <Border Classes="group">
                <StackPanel>
                <Grid Classes="row" ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="2">
                    <TextBlock svc:Tr.Text="Language" />
                    <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" svc:Tr.Text="Changes right away. A few lists switch over after Savefile restarts." />
                  </StackPanel>
                  <ComboBox Grid.Column="1" MinWidth="190" CornerRadius="8" ItemsSource="{Binding LanguageOptions}" SelectedItem="{Binding Language}" />
                </Grid>
                <Border Classes="sep" />
                <Grid Classes="row" ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="2">
                    <TextBlock svc:Tr.Text="Appearance" />
                    <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" svc:Tr.Text="Dark, light, or follow your system." />
                  </StackPanel>
                  <ComboBox Grid.Column="1" MinWidth="190" CornerRadius="8" ItemsSource="{Binding ThemeModes}" SelectedItem="{Binding ThemeMode}" />
                </Grid>
                </StackPanel>
              </Border>

              <TextBlock Classes="label" svc:Tr.Text="STARTUP" Margin="0,8,0,0" />
              <Border Classes="group">
                <StackPanel>
                  <Grid Classes="row" ColumnDefinitions="*,Auto">
                    <TextBlock svc:Tr.Text="Launch Savefile when I log in" />
                    <ToggleSwitch x:Name="SettingsFirst" Grid.Column="1" Classes="bare" IsChecked="{Binding LaunchAtLogin}" />
                  </Grid>
                  <Border Classes="sep" />
                  <Grid Classes="row" ColumnDefinitions="*,Auto">
                    <TextBlock svc:Tr.Text="Tell me when a new version is out" />
                    <ToggleSwitch Grid.Column="1" Classes="bare" IsChecked="{Binding CheckForUpdates}" />
                  </Grid>
                  <Border Classes="sep" />
                  <Grid Classes="row" ColumnDefinitions="*,Auto" IsEnabled="{Binding CheckForUpdates}">
                    <StackPanel Spacing="2">
                      <TextBlock svc:Tr.Text="Install updates automatically" />
                      <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" svc:Tr.Text="When Savefile starts and finds a newer version, it installs it and restarts." />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" Classes="bare" IsChecked="{Binding AutoUpdate}" />
                  </Grid>
                  <Border Classes="sep" />
                  <Grid Classes="row" ColumnDefinitions="*,Auto,Auto,Auto">
                    <StackPanel Spacing="2">
                      <TextBlock Text="{Binding #Root.((vm:MainViewModel)DataContext).VersionText}" />
                      <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap"
                                 Text="{Binding #Root.((vm:MainViewModel)DataContext).UpdateStatus}" />
                    </StackPanel>
                    <Button Grid.Column="1" Classes="accent" Margin="0,0,8,0"
                            Content="{Binding #Root.((vm:MainViewModel)DataContext).UpdateAction}"
                            IsVisible="{Binding #Root.((vm:MainViewModel)DataContext).HasUpdate}"
                            Command="{Binding #Root.((vm:MainViewModel)DataContext).OpenUpdateCommand}" />
                    <Button Grid.Column="2" Classes="soft" svc:Tr.Content="What's new" Margin="0,0,8,0"
                            Command="{Binding #Root.((vm:MainViewModel)DataContext).ShowChangelogCommand}" />
                    <Button Grid.Column="3" Classes="soft" svc:Tr.Content="Check now"
                            Command="{Binding #Root.((vm:MainViewModel)DataContext).CheckForUpdatesNowCommand}" />
                  </Grid>
                  <Border Classes="sep" />
                  <Grid Classes="row" ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="2">
                      <TextBlock Text="{Binding BackgroundLabel}" TextWrapping="Wrap" />
                      <TextBlock Classes="dim" FontSize="11" svc:Tr.Text="Always on while clipping is enabled." />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" Classes="bare" IsChecked="{Binding KeepInBackground}" />
                  </Grid>
                </StackPanel>
              </Border>

              <TextBlock Classes="label" svc:Tr.Text="KEYBOARD" Margin="0,8,0,0" />
              <Border Classes="group">
                <Grid Classes="row" ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="2">
                    <TextBlock svc:Tr.Text="Keyboard shortcuts" />
                    <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" svc:Tr.Text="See every shortcut and change any of them. Press ? anywhere to open the list." />
                  </StackPanel>
                  <Button Grid.Column="1" Classes="soft" svc:Tr.Content="Shortcuts…"
                          Command="{Binding #Root.((vm:MainViewModel)DataContext).ShowShortcutsCommand}" />
                </Grid>
              </Border>

              <TextBlock Classes="label" svc:Tr.Text="BACKUP" Margin="0,8,0,0" />
              <Border Classes="group">
                <StackPanel>
                  <Grid Classes="row" ColumnDefinitions="*,Auto,Auto">
                    <StackPanel Spacing="2">
                      <TextBlock svc:Tr.Text="Settings file" />
                      <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" svc:Tr.Text="Save all settings to a file, or load them on another computer." />
                    </StackPanel>
                    <Button Grid.Column="1" Classes="soft" svc:Tr.Content="Export…" Margin="0,0,8,0"
                            Command="{Binding #Root.((vm:MainViewModel)DataContext).ExportSettingsCommand}" />
                    <Button Grid.Column="2" Classes="soft" svc:Tr.Content="Import…"
                            Command="{Binding #Root.((vm:MainViewModel)DataContext).ImportSettingsCommand}" />
                  </Grid>
                  <Border Classes="sep" />
                  <Grid Classes="row" ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="2">
                      <TextBlock svc:Tr.Text="Portable mode" />
                      <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" Text="{Binding PortableStatus}" />
                      <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource Highlight}" Text="{Binding PortableMessage}"
                                 IsVisible="{Binding PortableMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    </StackPanel>
                    <Panel Grid.Column="1">
                      <Button Classes="soft" svc:Tr.Content="Make portable" Command="{Binding MakePortableCommand}" IsVisible="{Binding CanMakePortable}" />
                      <Button Classes="soft" svc:Tr.Content="Show folder" Command="{Binding ShowPortableFolderCommand}" IsVisible="{Binding IsPortable}" />
                    </Panel>
                  </Grid>
                </StackPanel>
              </Border>

              <TextBlock Classes="label" svc:Tr.Text="WELCOME SETUP" Margin="0,8,0,0" />
              <Border Classes="group">
                <Grid Classes="row" ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="2">
                    <TextBlock svc:Tr.Text="Run the welcome setup again" />
                    <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap"
                               svc:Tr.Text="Starts from your current choices. Folders, hotkeys and everything else stay as they are." />
                  </StackPanel>
                  <Button Grid.Column="1" Classes="soft" svc:Tr.Content="Start setup"
                          Command="{Binding #Root.((vm:MainViewModel)DataContext).RestartSetupCommand}" />
                </Grid>
              </Border>
              </StackPanel>

              <!-- ==== Features ==== -->
              <StackPanel Spacing="12" IsVisible="{Binding IsFeaturesPage}">
                <TextBlock Classes="dim" FontSize="12" TextWrapping="Wrap" Margin="4,0"
                           svc:Tr.Text="Switch off anything you don't use. Its buttons and settings disappear, and it stops running." />
                <Border Classes="group">
                  <StackPanel>
                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="2">
                        <TextBlock svc:Tr.Text="Background clipping" />
                        <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" svc:Tr.Text="Keep the last moments of your screen and save them with a hotkey." />
                      </StackPanel>
                      <ToggleSwitch Grid.Column="1" Classes="bare" IsChecked="{Binding FeatureClipping}" />
                    </Grid>
                    <Border Classes="sep" />
                    <Grid Classes="row" ColumnDefinitions="*,Auto" IsEnabled="{Binding FeatureClipping}">
                      <StackPanel Spacing="2">
                        <TextBlock svc:Tr.Text="Session recording" />
                        <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" svc:Tr.Text="Record a whole session as one video, with bookmarks from the clip hotkey." />
                      </StackPanel>
                      <ToggleSwitch Grid.Column="1" Classes="bare" IsChecked="{Binding FeatureSessions}" />
                    </Grid>
                    <Border Classes="sep" />
                    <Grid Classes="row" ColumnDefinitions="*,Auto" IsEnabled="{Binding FeatureSessions}">
                      <StackPanel Spacing="2">
                        <TextBlock svc:Tr.Text="Crash-safe sessions" />
                        <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" svc:Tr.Text="If Savefile or your computer stops in the middle of a session, what was recorded is saved the next time Savefile starts." />
                      </StackPanel>
                      <ToggleSwitch Grid.Column="1" Classes="bare" IsChecked="{Binding FeatureRecoverSessions}" />
                    </Grid>
                    <Border Classes="sep" />
                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="2">
                        <TextBlock svc:Tr.Text="Hover preview" />
                        <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" svc:Tr.Text="Move the pointer across a video to skim through it." />
                      </StackPanel>
                      <ToggleSwitch Grid.Column="1" Classes="bare" IsChecked="{Binding FeatureHoverPreview}" />
                    </Grid>
                    <Border Classes="sep" />
                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="2">
                        <TextBlock svc:Tr.Text="Loud moment markers" />
                        <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" svc:Tr.Text="Mark loud moments on the timeline so you can jump between them." />
                      </StackPanel>
                      <ToggleSwitch Grid.Column="1" Classes="bare" IsChecked="{Binding FeatureLoudMarkers}" />
                    </Grid>
                    <Border Classes="sep" />
                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="2">
                        <TextBlock svc:Tr.Text="Hover glow" />
                        <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" svc:Tr.Text="A soft purple glow around the video under the pointer." />
                      </StackPanel>
                      <ToggleSwitch Grid.Column="1" Classes="bare" IsChecked="{Binding FeatureHoverGlow}" />
                    </Grid>
                    <Border Classes="sep" />
                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="2">
                        <TextBlock svc:Tr.Text="Loading screen" />
                        <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" svc:Tr.Text="The logo, Mochi and what's being got ready while Savefile starts, including waking up the smart models you switched on. Click it to skip. Never shown when Savefile starts at login." />
                      </StackPanel>
                      <ToggleSwitch Grid.Column="1" Classes="bare" IsChecked="{Binding FeatureSplash}" />
                    </Grid>
                    <Border Classes="sep" />
                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="2">
                        <TextBlock svc:Tr.Text="Collections" />
                        <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" svc:Tr.Text="Group videos from any folders, like playlists." />
                      </StackPanel>
                      <ToggleSwitch Grid.Column="1" Classes="bare" IsChecked="{Binding FeatureCollections}" />
                    </Grid>
                    <Border Classes="sep" />
                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="2">
                        <TextBlock svc:Tr.Text="Unwatched dots" />
                        <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" svc:Tr.Text="A dot next to videos you haven't opened yet, and an Unwatched filter." />
                      </StackPanel>
                      <ToggleSwitch Grid.Column="1" Classes="bare" IsChecked="{Binding FeatureUnwatched}" />
                    </Grid>
                    <Border Classes="sep" />
                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="2">
                        <TextBlock svc:Tr.Text="Clean up" />
                        <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" svc:Tr.Text="Find duplicates and broken, empty or very short files." />
                      </StackPanel>
                      <ToggleSwitch Grid.Column="1" Classes="bare" IsChecked="{Binding FeatureCleanUp}" />
                    </Grid>
                    <Border Classes="sep" />
                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="2">
                        <TextBlock svc:Tr.Text="Make room" />
                        <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" svc:Tr.Text="Under Tools: big videos you haven't watched in months, encoded again as HEVC so they look the same in about half the space. You pick which, and the originals wait in the bin for 24 hours." />
                      </StackPanel>
                      <ToggleSwitch Grid.Column="1" Classes="bare" IsChecked="{Binding FeatureMakeRoom}" />
                    </Grid>
                    <Border Classes="sep" />
                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="2">
                        <TextBlock svc:Tr.Text="Stats" />
                        <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" svc:Tr.Text="Numbers about your library and clips: per week, per game, totals." />
                      </StackPanel>
                      <ToggleSwitch Grid.Column="1" Classes="bare" IsChecked="{Binding FeatureStats}" />
                    </Grid>
                    <Border Classes="sep" />
                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="2">
                        <TextBlock svc:Tr.Text="Quick player" />
                        <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" svc:Tr.Text="Videos open in a large player over the library; Edit opens the full editor. Off, they open straight in the editor." />
                      </StackPanel>
                      <ToggleSwitch Grid.Column="1" Classes="bare" IsChecked="{Binding FeatureMiniPlayer}" />
                    </Grid>
                    <Border Classes="sep" />
                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="2">
                        <TextBlock svc:Tr.Text="Chapters from bookmarks" />
                        <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" svc:Tr.Text="Bookmarks in a session recording become chapters: in the player, in the saved file and in exports." />
                      </StackPanel>
                      <ToggleSwitch Grid.Column="1" Classes="bare" IsChecked="{Binding FeatureChapters}" />
                    </Grid>
                    <Border Classes="sep" />
                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="2">
                        <TextBlock svc:Tr.Text="Notes" />
                        <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" svc:Tr.Text="Write a line about a video under Rename, tag or move. It shows on the card and search finds it." />
                      </StackPanel>
                      <ToggleSwitch Grid.Column="1" Classes="bare" IsChecked="{Binding FeatureNotes}" />
                    </Grid>
                    <Border Classes="sep" />
                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="2">
                        <TextBlock svc:Tr.Text="Drag out" />
                        <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" svc:Tr.Text="Drag a video from the library straight into Discord, a browser or a folder." />
                      </StackPanel>
                      <ToggleSwitch Grid.Column="1" Classes="bare" IsChecked="{Binding FeatureDragOut}" />
                    </Grid>
                    <Grid Classes="row" ColumnDefinitions="*,Auto" Margin="18,0,0,0" IsVisible="{Binding FeatureDragOut}">
                      <StackPanel Spacing="2">
                        <TextBlock svc:Tr.Text="Make it Discord-sized" />
                        <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" svc:Tr.Text="A video too big for Discord becomes a copy that fits (10 MB) while you hold it. Smaller videos go as they are. Off: always drag the original file." />
                      </StackPanel>
                      <ToggleSwitch Grid.Column="1" Classes="bare" IsChecked="{Binding FeatureDragDiscord}" />
                    </Grid>
                    <Grid Classes="row" ColumnDefinitions="*,Auto" Margin="18,0,0,0" IsVisible="{Binding FeatureDragOut}" IsEnabled="{Binding FeatureDragDiscord}">
                      <StackPanel Spacing="2">
                        <TextBlock svc:Tr.Text="I have Discord Nitro" />
                        <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" svc:Tr.Text="Copies can be up to 50 MB, so they keep more quality." />
                      </StackPanel>
                      <ToggleSwitch Grid.Column="1" Classes="bare" IsChecked="{Binding FeatureDiscordNitro}" />
                    </Grid>
                    <Border Classes="sep" />
                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="2">
                        <TextBlock svc:Tr.Text="Savefile bin" />
                        <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" svc:Tr.Text="A deleted video waits in the bin for 24 hours, so you can put it back, then it's deleted for good. Each video has its own 24 hours. Off: deleted videos go to the system Trash." />
                      </StackPanel>
                      <ToggleSwitch Grid.Column="1" Classes="bare" IsChecked="{Binding FeatureBin}" />
                    </Grid>
                    <Border Classes="sep" />
                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="2">
                        <TextBlock svc:Tr.Text="Other recorders" />
                        <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" svc:Tr.Text="Bring in videos from OBS, NVIDIA, Xbox Game Bar and Steam, tagged by game." />
                      </StackPanel>
                      <ToggleSwitch Grid.Column="1" Classes="bare" IsChecked="{Binding FeatureRecorders}" />
                    </Grid>
                  </StackPanel>
                </Border>
                <TextBlock Classes="label" svc:Tr.Text="MEMORIES" Margin="0,8,0,0" />
                <Border Classes="group">
                  <StackPanel>
                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="2">
                        <TextBlock svc:Tr.Text="Worth a rewatch" />
                        <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" svc:Tr.Text="A row at the top of the library with old favourites and clips with friends. A new pick every day." />
                      </StackPanel>
                      <ToggleSwitch Grid.Column="1" Classes="bare" IsChecked="{Binding FeatureRewatch}" />
                    </Grid>
                    <Border Classes="sep" />
                    <Grid Classes="row" ColumnDefinitions="*,Auto" IsEnabled="{Binding FeatureRewatch}">
                      <StackPanel Spacing="2">
                        <TextBlock svc:Tr.Text="Friend picks" />
                        <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" svc:Tr.Text="Your closest friends' names above Worth a rewatch. Pick one for the best of your clips together, and Mochi tells you about the two of you." />
                      </StackPanel>
                      <ToggleSwitch Grid.Column="1" Classes="bare" IsChecked="{Binding FeatureFriendShelf}" />
                    </Grid>
                    <Border Classes="sep" />
                    <Grid Classes="row" ColumnDefinitions="*,Auto" IsEnabled="{Binding FeatureRewatch}">
                      <StackPanel Spacing="2">
                        <TextBlock svc:Tr.Text="Mochi" />
                        <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" svc:Tr.Text="Mochi, a little purple blob, presents Worth a rewatch with something about your clips: a keeper from last night, a run with a friend, what you played a year ago. Click Mochi for the next line." />
                      </StackPanel>
                      <ToggleSwitch Grid.Column="1" Classes="bare" IsChecked="{Binding FeatureMascot}" />
                    </Grid>
                    <!-- What Mochi does besides the shelf: each its own switch -->
                    <StackPanel Margin="28,0,14,12" Spacing="8" IsVisible="{Binding FeatureMascot}">
                      <CheckBox IsChecked="{Binding FeatureRewatchReminders}">
                        <StackPanel Spacing="1">
                          <TextBlock svc:Tr.Text="Reminds you of old favourites" FontSize="12" />
                          <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" svc:Tr.Text="Every few days at most, Mochi brings up a favourite you haven't watched in a couple of months, with a button to play it." />
                        </StackPanel>
                      </CheckBox>
                      <CheckBox IsChecked="{Binding FeatureMochiSaves}">
                        <StackPanel Spacing="1">
                          <TextBlock svc:Tr.Text="Reacts when you save" FontSize="12" />
                          <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" svc:Tr.Text="A squish and some sparkles; an extra hop when a fresh clip turns out to be a big moment." />
                        </StackPanel>
                      </CheckBox>
                      <CheckBox IsChecked="{Binding FeatureMochiEmpty}">
                        <StackPanel Spacing="1">
                          <TextBlock svc:Tr.Text="Fills empty pages" FontSize="12" />
                          <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" svc:Tr.Text="Peeks in when the bin is empty, a search finds nothing or a friend has no clips yet." />
                        </StackPanel>
                      </CheckBox>
                      <CheckBox IsChecked="{Binding FeatureMochiBadges}">
                        <StackPanel Spacing="1">
                          <TextBlock svc:Tr.Text="Holds up milestones" FontSize="12" />
                          <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" svc:Tr.Text="Shows off the badge for your 100th save and the rest." />
                        </StackPanel>
                      </CheckBox>
                      <CheckBox IsChecked="{Binding FeatureMochiSeasonal}">
                        <StackPanel Spacing="1">
                          <TextBlock svc:Tr.Text="Dresses up" FontSize="12" />
                          <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" svc:Tr.Text="A Santa hat in December, a party hat on Savefile's birthday, tinsel on the present." />
                        </StackPanel>
                      </CheckBox>
                      <CheckBox IsChecked="{Binding FeatureMochiSleepy}">
                        <StackPanel Spacing="1">
                          <TextBlock svc:Tr.Text="Gets sleepy" FontSize="12" />
                          <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" svc:Tr.Text="After midnight Mochi yawns and asks if it's a late session." />
                        </StackPanel>
                      </CheckBox>
                      <CheckBox IsChecked="{Binding FeatureMochiFollow}">
                        <StackPanel Spacing="1">
                          <TextBlock svc:Tr.Text="Watches the pointer" FontSize="12" />
                          <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" svc:Tr.Text="Mochi's eyes follow the pointer when it's idle." />
                        </StackPanel>
                      </CheckBox>
                      <CheckBox IsChecked="{Binding FeatureMochiPoke}">
                        <StackPanel Spacing="1">
                          <TextBlock svc:Tr.Text="Wobbles when clicked" FontSize="12" />
                          <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" svc:Tr.Text="Like jelly. Click a lot, quickly, and see what happens." />
                        </StackPanel>
                      </CheckBox>
                      <CheckBox IsChecked="{Binding FeatureMochiBackup}">
                        <StackPanel Spacing="1">
                          <TextBlock svc:Tr.Text="Helps with backups" FontSize="12" />
                          <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" svc:Tr.Text="Carries a box in the sidebar while your clips go to your server." />
                        </StackPanel>
                      </CheckBox>
                      <CheckBox IsChecked="{Binding FeatureMochiHelper}">
                        <StackPanel Spacing="1">
                          <TextBlock svc:Tr.Text="Helps with problems" FontSize="12" />
                          <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" svc:Tr.Text="Looks puzzled next to a problem and says how to fix it in plain words." />
                        </StackPanel>
                      </CheckBox>
                    </StackPanel>
                    <Border Classes="sep" />
                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="2">
                        <TextBlock svc:Tr.Text="On this day" />
                        <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" svc:Tr.Text="A card with what you recorded on this day in earlier years, or a month ago." />
                      </StackPanel>
                      <ToggleSwitch Grid.Column="1" Classes="bare" IsChecked="{Binding FeatureOnThisDay}" />
                    </Grid>
                    <Border Classes="sep" />
                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="2">
                        <TextBlock svc:Tr.Text="Who was there" />
                        <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" svc:Tr.Text="Tag the friends in a clip under Rename, tag or move. Their names show on the card, they get a Friends list in the sidebar, and @name finds them." />
                      </StackPanel>
                      <ToggleSwitch Grid.Column="1" Classes="bare" IsChecked="{Binding FeaturePeople}" />
                    </Grid>
                    <Border Classes="sep" />
                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="2">
                        <TextBlock svc:Tr.Text="Milestones" />
                        <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" svc:Tr.Text="A small celebration for your first save, your 100th, and so on." />
                      </StackPanel>
                      <ToggleSwitch Grid.Column="1" Classes="bare" IsChecked="{Binding FeatureMilestones}" />
                    </Grid>
                    <Border Classes="sep" />
                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="2">
                        <TextBlock svc:Tr.Text="Badges" />
                        <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" svc:Tr.Text="Earn badges for what your clips show: a night owl, a full squad, clips 7 days in a row. They're under Tools, Stats." />
                      </StackPanel>
                      <ToggleSwitch Grid.Column="1" Classes="bare" IsChecked="{Binding FeatureBadges}" />
                    </Grid>
                    <Border Classes="sep" />
                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="2">
                        <TextBlock svc:Tr.Text="Playtime" />
                        <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" svc:Tr.Text="Count hours played per game while Savefile runs, like Steam does. Only games Savefile knows, only from when you turn it on, and it stays on this computer. Shown under Tools, Stats." />
                        <Button Classes="soft" Padding="10,3" Margin="0,4,0,0" HorizontalAlignment="Left" FontSize="12" IsVisible="{Binding FeaturePlaytime}"
                                svc:Tr.Content="Start counting again" Command="{Binding #Root.((vm:MainViewModel)DataContext).ResetPlaytimeCommand}" />
                      </StackPanel>
                      <ToggleSwitch Grid.Column="1" Classes="bare" IsChecked="{Binding FeaturePlaytime}" />
                    </Grid>
                    <Border Classes="sep" />
                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="2">
                        <TextBlock svc:Tr.Text="Year in clips" />
                        <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" svc:Tr.Text="Look back on a year: your moments, the friends you played with most, your games, and a montage of the best bits." />
                      </StackPanel>
                      <ToggleSwitch Grid.Column="1" Classes="bare" IsChecked="{Binding FeatureRecap}" />
                    </Grid>
                    <Border Classes="sep" IsVisible="{Binding #Root.((vm:MainViewModel)DataContext).WrappedReadyUi}" />
                    <Grid Classes="row" ColumnDefinitions="*,Auto" IsEnabled="{Binding FeatureRecap}" IsVisible="{Binding #Root.((vm:MainViewModel)DataContext).WrappedReadyUi}">
                      <StackPanel Spacing="2">
                        <TextBlock svc:Tr.Text="Wrapped" />
                        <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" svc:Tr.Text="A video of your year: chapters about your games and your people, then your best moments cut to the beat of songs you pick. From 1 November to 31 December, Mochi has it for you as a present." />
                        <Grid ColumnDefinitions="Auto,*" Margin="0,4,0,0">
                          <PathIcon Data="{StaticResource IcSpeed}" Width="11" Height="11" Margin="0,2,6,0" VerticalAlignment="Top" Foreground="{DynamicResource TextDim}" />
                          <TextBlock Grid.Column="1" Classes="dim cost" FontSize="11" TextWrapping="Wrap" Text="{Binding #Root.((vm:MainViewModel)DataContext).WrappedCostText}" />
                        </Grid>
                      </StackPanel>
                      <ToggleSwitch Grid.Column="1" Classes="bare" IsChecked="{Binding FeatureWrapped}" />
                    </Grid>
                    <Border Classes="sep" />
                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="2">
                        <TextBlock svc:Tr.Text="Play all" />
                        <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" svc:Tr.Text="Watch a whole view one clip after another in the Quick player, like a slideshow of a night, a friend or a year." />
                      </StackPanel>
                      <ToggleSwitch Grid.Column="1" Classes="bare" IsChecked="{Binding FeaturePlayAll}" />
                    </Grid>
                    <Border Classes="sep" />
                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="2">
                        <TextBlock svc:Tr.Text="Backup to your own server" />
                        <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" svc:Tr.Text="Keep a copy of your favourites (or every video) on a server you run at home, over SSH or S3, and bring them back on a new computer. Nothing goes anywhere else." />
                      </StackPanel>
                      <ToggleSwitch Grid.Column="1" Classes="bare" IsChecked="{Binding FeatureBackup}" />
                    </Grid>
                    <Border Classes="sep" />
                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="2">
                        <TextBlock svc:Tr.Text="Several folders" />
                        <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" svc:Tr.Text="Show videos from more than one folder. Off, your library is one folder, the same one clips are saved to. Folders you already added are never dropped." />
                      </StackPanel>
                      <ToggleSwitch Grid.Column="1" Classes="bare" IsChecked="{Binding FeatureSeveralFolders}" />
                    </Grid>
                  </StackPanel>
                </Border>

                <TextBlock Classes="label" svc:Tr.Text="SMART" Margin="0,8,0,0" />
                <Border Classes="group">
                  <StackPanel>
                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="2">
                        <TextBlock svc:Tr.Text="Best moments" />
                        <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" svc:Tr.Text="Savefile listens to and watches your videos, on this computer and only when it's not busy, to find the moments that stand out. They get a sparkle, come first under Best moments, and lead Worth a rewatch, montages and Year in clips. It waits while you play." />
                        <Grid ColumnDefinitions="Auto,*" Margin="0,4,0,0">
                          <PathIcon Data="{StaticResource IcSpeed}" Width="11" Height="11" Margin="0,2,6,0" VerticalAlignment="Top" Foreground="{DynamicResource TextDim}" />
                          <TextBlock Grid.Column="1" Classes="dim cost" FontSize="11" TextWrapping="Wrap" Text="{Binding #Root.((vm:MainViewModel)DataContext).MomentsCostText}" />
                        </Grid>
                        <TextBlock Classes="dim" FontSize="11" Foreground="{DynamicResource Highlight}" Text="{Binding #Root.((vm:MainViewModel)DataContext).SmartActivity}"
                                   IsVisible="{Binding #Root.((vm:MainViewModel)DataContext).SmartActivity, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                      </StackPanel>
                      <ToggleSwitch Grid.Column="1" Classes="bare" IsChecked="{Binding FeatureHighlights}" />
                    </Grid>
                    <Border Classes="sep" />
                    <Grid Classes="row" ColumnDefinitions="*,Auto" IsEnabled="{Binding FeatureHighlights}">
                      <StackPanel Spacing="2">
                        <TextBlock svc:Tr.Text="Smart thumbnails" />
                        <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" svc:Tr.Text="Thumbnails from a lively frame near the best moment, never a black screen or a loading screen. A frame you picked yourself stays." />
                        <Grid ColumnDefinitions="Auto,*" Margin="0,4,0,0">
                          <PathIcon Data="{StaticResource IcSpeed}" Width="11" Height="11" Margin="0,2,6,0" VerticalAlignment="Top" Foreground="{DynamicResource TextDim}" />
                          <TextBlock Grid.Column="1" Classes="dim cost" FontSize="11" TextWrapping="Wrap" svc:Tr.Text="Costs next to nothing: Best moments already looked; this grabs one small frame per video." />
                        </Grid>
                      </StackPanel>
                      <ToggleSwitch Grid.Column="1" Classes="bare" IsChecked="{Binding FeatureSmartThumbs}" />
                    </Grid>
                    <Border Classes="sep" />
                    <Grid Classes="row" ColumnDefinitions="*,Auto" IsEnabled="{Binding FeatureHighlights}">
                      <StackPanel Spacing="2">
                        <TextBlock svc:Tr.Text="Trim suggestions" />
                        <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" svc:Tr.Text="When a video starts or ends with a blank screen and no sound (a loading screen, a fade, the menu before the round), the editor offers to trim it. Nothing is cut until you say so." />
                        <Grid ColumnDefinitions="Auto,*" Margin="0,4,0,0">
                          <PathIcon Data="{StaticResource IcSpeed}" Width="11" Height="11" Margin="0,2,6,0" VerticalAlignment="Top" Foreground="{DynamicResource TextDim}" />
                          <TextBlock Grid.Column="1" Classes="dim cost" FontSize="11" TextWrapping="Wrap" svc:Tr.Text="Costs nothing extra: it uses what Best moments already found." />
                        </Grid>
                      </StackPanel>
                      <ToggleSwitch Grid.Column="1" Classes="bare" IsChecked="{Binding FeatureTrimSuggestions}" />
                    </Grid>
                    <Border Classes="sep" />
                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="2">
                        <TextBlock svc:Tr.Text="Smart crop" />
                        <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" svc:Tr.Text="The vertical (9:16) export follows where the action is instead of always cutting out the middle. A HUD that never moves is ignored, and the slice stays in the middle when nothing stands out." />
                        <Grid ColumnDefinitions="Auto,*" Margin="0,4,0,0">
                          <PathIcon Data="{StaticResource IcSpeed}" Width="11" Height="11" Margin="0,2,6,0" VerticalAlignment="Top" Foreground="{DynamicResource TextDim}" />
                          <TextBlock Grid.Column="1" Classes="dim cost" FontSize="11" TextWrapping="Wrap" svc:Tr.Text="Only when you export a vertical video: a few seconds of one core looking at a small copy first." />
                        </Grid>
                      </StackPanel>
                      <ToggleSwitch Grid.Column="1" Classes="bare" IsChecked="{Binding FeatureSmartCrop}" />
                    </Grid>
                    <Border Classes="sep" />
                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="2">
                        <TextBlock svc:Tr.Text="Smart titles" />
                        <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" svc:Tr.Text="Names that say what happened: a line someone shouted at the big moment, what set off a laugh, or the game, who was there and when. Like &quot;Alex: “Behind you!” · Valorant&quot;. With Voice search and Laughter and hype on, they get better. Suggested when you edit a video, and for the whole library under Tools, Smart rename." />
                        <Grid ColumnDefinitions="Auto,*" Margin="0,4,0,0">
                          <PathIcon Data="{StaticResource IcSpeed}" Width="11" Height="11" Margin="0,2,6,0" VerticalAlignment="Top" Foreground="{DynamicResource TextDim}" />
                          <TextBlock Grid.Column="1" Classes="dim cost" FontSize="11" TextWrapping="Wrap" Text="{Binding #Root.((vm:MainViewModel)DataContext).TitlesCostText}" />
                        </Grid>
                      </StackPanel>
                      <ToggleSwitch Grid.Column="1" Classes="bare" IsChecked="{Binding FeatureSmartTitles}" />
                    </Grid>
                    <Border Classes="sep" />
                    <Grid Classes="row" ColumnDefinitions="*,Auto" IsEnabled="{Binding FeatureSmartTitles}">
                      <StackPanel Spacing="2">
                        <TextBlock svc:Tr.Text="Name new clips by themselves" />
                        <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" svc:Tr.Text="New clips with a name a recorder made up get a smart title in Savefile. The file keeps its name." />
                      </StackPanel>
                      <ToggleSwitch Grid.Column="1" Classes="bare" IsChecked="{Binding FeatureAutoTitles}" />
                    </Grid>
                    <Border Classes="sep" />
                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="2">
                        <TextBlock svc:Tr.Text="Voice search and captions" />
                        <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" svc:Tr.Text="Savefile writes down what's said in your videos, on this computer and only when it's not busy. Search finds the words and opens the video where they're said, the player can show them as captions, and the editor turns them into captions for an export." />
                        <Grid ColumnDefinitions="Auto,*" Margin="0,4,0,0">
                          <PathIcon Data="{StaticResource IcSpeed}" Width="11" Height="11" Margin="0,2,6,0" VerticalAlignment="Top" Foreground="{DynamicResource TextDim}" />
                          <TextBlock Grid.Column="1" Classes="dim cost" FontSize="11" TextWrapping="Wrap" Text="{Binding #Root.((vm:MainViewModel)DataContext).SpeechCostText}" />
                        </Grid>
                      </StackPanel>
                      <ToggleSwitch Grid.Column="1" Classes="bare" IsChecked="{Binding FeatureSpeech}" />
                    </Grid>
                    <StackPanel Spacing="8" Margin="14,0,14,14" IsVisible="{Binding FeatureSpeech}">
                      <Grid ColumnDefinitions="Auto,*">
                        <TextBlock svc:Tr.Text="Model" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding #Root.((vm:MainViewModel)DataContext).SpeechModelOptions}"
                                  SelectedIndex="{Binding #Root.((vm:MainViewModel)DataContext).SpeechModelIndex}"
                                  svc:Tr.Tip="Both understand Swedish and English mixed together; the Swedish one is much more accurate in Swedish." />
                      </Grid>
                      <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" Text="{Binding #Root.((vm:MainViewModel)DataContext).SpeechModelText}"
                                 Classes.err="{Binding #Root.((vm:MainViewModel)DataContext).SpeechModelError, Converter={x:Static ObjectConverters.IsNotNull}}" />
                      <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding #Root.((vm:MainViewModel)DataContext).SpeechHelp, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <c:BlobMascot Width="36" Height="32" Mood="Puzzled" Still="{Binding #Root.((vm:MainViewModel)DataContext).ReducedMotion}" MaxFps="24" />
                        <TextBlock Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="11" TextWrapping="Wrap"
                                   Text="{Binding #Root.((vm:MainViewModel)DataContext).SpeechHelp}" />
                      </Grid>
                      <ProgressBar Minimum="0" Maximum="1" Value="{Binding #Root.((vm:MainViewModel)DataContext).SpeechDownloadProgress}" Height="4" MinHeight="4" CornerRadius="2"
                                   IsVisible="{Binding #Root.((vm:MainViewModel)DataContext).IsDownloadingSpeech}" />
                      <TextBlock Classes="dim" FontSize="11" Foreground="{DynamicResource Highlight}" Text="{Binding #Root.((vm:MainViewModel)DataContext).SpeechActivity}"
                                 IsVisible="{Binding #Root.((vm:MainViewModel)DataContext).SpeechActivity, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Classes="accent" Command="{Binding #Root.((vm:MainViewModel)DataContext).DownloadSpeechModelCommand}" IsVisible="{Binding #Root.((vm:MainViewModel)DataContext).CanDownloadSpeech}">
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{StaticResource IcImport}" Width="12" Height="12" Foreground="{DynamicResource OnAccent}" />
                            <TextBlock svc:Tr.Text="Download the speech model" />
                          </StackPanel>
                        </Button>
                        <Button Classes="soft" svc:Tr.Content="Cancel" Command="{Binding #Root.((vm:MainViewModel)DataContext).CancelSpeechDownloadCommand}" IsVisible="{Binding #Root.((vm:MainViewModel)DataContext).IsDownloadingSpeech}" />
                        <Button Classes="soft" svc:Tr.Content="Remove the model" Command="{Binding #Root.((vm:MainViewModel)DataContext).RemoveSpeechModelCommand}" IsVisible="{Binding #Root.((vm:MainViewModel)DataContext).SpeechModelReady}"
                                svc:Tr.Tip="Frees the space. The words already found stay searchable." />
                      </StackPanel>
                    </StackPanel>
                    <Border Classes="sep" />
                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="2">
                        <TextBlock svc:Tr.Text="Visual search and similar videos" />
                        <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" svc:Tr.Text="Savefile looks at a few frames of each video, on this computer and only when it's not busy. Search finds what's on screen (&quot;snow&quot;, &quot;a car&quot;, &quot;night&quot;), right-click a video for Videos like this one, and Clean up spots copies that were saved again." />
                        <Grid ColumnDefinitions="Auto,*" Margin="0,4,0,0">
                          <PathIcon Data="{StaticResource IcSpeed}" Width="11" Height="11" Margin="0,2,6,0" VerticalAlignment="Top" Foreground="{DynamicResource TextDim}" />
                          <TextBlock Grid.Column="1" Classes="dim cost" FontSize="11" TextWrapping="Wrap" Text="{Binding #Root.((vm:MainViewModel)DataContext).VisualCostText}" />
                        </Grid>
                      </StackPanel>
                      <ToggleSwitch Grid.Column="1" Classes="bare" IsChecked="{Binding FeatureVisual}" />
                    </Grid>
                    <StackPanel Spacing="8" Margin="14,0,14,14" IsVisible="{Binding FeatureVisual}">
                      <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" Text="{Binding #Root.((vm:MainViewModel)DataContext).VisualModelText}"
                                 Classes.err="{Binding #Root.((vm:MainViewModel)DataContext).VisualModelError, Converter={x:Static ObjectConverters.IsNotNull}}" />
                      <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding #Root.((vm:MainViewModel)DataContext).VisualHelp, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <c:BlobMascot Width="36" Height="32" Mood="Puzzled" Still="{Binding #Root.((vm:MainViewModel)DataContext).ReducedMotion}" MaxFps="24" />
                        <TextBlock Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="11" TextWrapping="Wrap"
                                   Text="{Binding #Root.((vm:MainViewModel)DataContext).VisualHelp}" />
                      </Grid>
                      <ProgressBar Minimum="0" Maximum="1" Value="{Binding #Root.((vm:MainViewModel)DataContext).VisualDownloadProgress}" Height="4" MinHeight="4" CornerRadius="2"
                                   IsVisible="{Binding #Root.((vm:MainViewModel)DataContext).IsDownloadingVisual}" />
                      <TextBlock Classes="dim" FontSize="11" Foreground="{DynamicResource Highlight}" Text="{Binding #Root.((vm:MainViewModel)DataContext).VisualActivity}"
                                 IsVisible="{Binding #Root.((vm:MainViewModel)DataContext).VisualActivity, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Classes="accent" Command="{Binding #Root.((vm:MainViewModel)DataContext).DownloadVisualModelCommand}" IsVisible="{Binding #Root.((vm:MainViewModel)DataContext).CanDownloadVisual}">
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{StaticResource IcImport}" Width="12" Height="12" Foreground="{DynamicResource OnAccent}" />
                            <TextBlock svc:Tr.Text="Download the visual model" />
                          </StackPanel>
                        </Button>
                        <Button Classes="soft" svc:Tr.Content="Cancel" Command="{Binding #Root.((vm:MainViewModel)DataContext).CancelVisualDownloadCommand}" IsVisible="{Binding #Root.((vm:MainViewModel)DataContext).IsDownloadingVisual}" />
                        <Button Classes="soft" svc:Tr.Content="Remove the model" Command="{Binding #Root.((vm:MainViewModel)DataContext).RemoveVisualModelCommand}" IsVisible="{Binding #Root.((vm:MainViewModel)DataContext).VisualModelReady}"
                                svc:Tr.Tip="Frees the space. Videos already looked at stay searchable once it's back." />
                      </StackPanel>
                    </StackPanel>
                    <Border Classes="sep" />
                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="2">
                        <TextBlock svc:Tr.Text="Laughter and hype" />
                        <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" svc:Tr.Text="Savefile listens for laughing, cheering and shouting, on this computer and only when it's not busy. The videos where everyone lost it come first in Worth a rewatch, Mochi tells you about them, and search finds them with &quot;laughing&quot; or &quot;hype&quot;." />
                        <Grid ColumnDefinitions="Auto,*" Margin="0,4,0,0">
                          <PathIcon Data="{StaticResource IcSpeed}" Width="11" Height="11" Margin="0,2,6,0" VerticalAlignment="Top" Foreground="{DynamicResource TextDim}" />
                          <TextBlock Grid.Column="1" Classes="dim cost" FontSize="11" TextWrapping="Wrap" Text="{Binding #Root.((vm:MainViewModel)DataContext).SoundCostText}" />
                        </Grid>
                      </StackPanel>
                      <ToggleSwitch Grid.Column="1" Classes="bare" IsChecked="{Binding FeatureLaughs}" />
                    </Grid>
                    <StackPanel Spacing="8" Margin="14,0,14,14" IsVisible="{Binding FeatureLaughs}">
                      <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" Text="{Binding #Root.((vm:MainViewModel)DataContext).SoundModelText}"
                                 Classes.err="{Binding #Root.((vm:MainViewModel)DataContext).SoundModelError, Converter={x:Static ObjectConverters.IsNotNull}}" />
                      <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding #Root.((vm:MainViewModel)DataContext).SoundHelp, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <c:BlobMascot Width="36" Height="32" Mood="Puzzled" Still="{Binding #Root.((vm:MainViewModel)DataContext).ReducedMotion}" MaxFps="24" />
                        <TextBlock Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="11" TextWrapping="Wrap"
                                   Text="{Binding #Root.((vm:MainViewModel)DataContext).SoundHelp}" />
                      </Grid>
                      <ProgressBar Minimum="0" Maximum="1" Value="{Binding #Root.((vm:MainViewModel)DataContext).SoundDownloadProgress}" Height="4" MinHeight="4" CornerRadius="2"
                                   IsVisible="{Binding #Root.((vm:MainViewModel)DataContext).IsDownloadingSound}" />
                      <TextBlock Classes="dim" FontSize="11" Foreground="{DynamicResource Highlight}" Text="{Binding #Root.((vm:MainViewModel)DataContext).SoundActivity}"
                                 IsVisible="{Binding #Root.((vm:MainViewModel)DataContext).SoundActivity, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Classes="accent" Command="{Binding #Root.((vm:MainViewModel)DataContext).DownloadSoundModelCommand}" IsVisible="{Binding #Root.((vm:MainViewModel)DataContext).CanDownloadSound}">
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{StaticResource IcImport}" Width="12" Height="12" Foreground="{DynamicResource OnAccent}" />
                            <TextBlock svc:Tr.Text="Download the sound model" />
                          </StackPanel>
                        </Button>
                        <Button Classes="soft" svc:Tr.Content="Cancel" Command="{Binding #Root.((vm:MainViewModel)DataContext).CancelSoundDownloadCommand}" IsVisible="{Binding #Root.((vm:MainViewModel)DataContext).IsDownloadingSound}" />
                        <Button Classes="soft" svc:Tr.Content="Remove the model" Command="{Binding #Root.((vm:MainViewModel)DataContext).RemoveSoundModelCommand}" IsVisible="{Binding #Root.((vm:MainViewModel)DataContext).SoundModelReady}"
                                svc:Tr.Tip="Frees the space. What was already heard stays." />
                      </StackPanel>
                    </StackPanel>
<Border Classes="sep" />
                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="2">
                        <TextBlock svc:Tr.Text="Text on screen" />
                        <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" svc:Tr.Text="Savefile reads kill feeds, scoreboards and banners in a few frames of each video, on this computer and only when it's not busy. Search finds the words (a name from the kill feed, &quot;ace&quot;), smart titles name the banner (Victory Royale, Ace), and a clip with no game yet gets one when the game's own words give it away." />
                        <Grid ColumnDefinitions="Auto,*" Margin="0,4,0,0">
                          <PathIcon Data="{StaticResource IcSpeed}" Width="11" Height="11" Margin="0,2,6,0" VerticalAlignment="Top" Foreground="{DynamicResource TextDim}" />
                          <TextBlock Grid.Column="1" Classes="dim cost" FontSize="11" TextWrapping="Wrap" Text="{Binding #Root.((vm:MainViewModel)DataContext).ScreenCostText}" />
                        </Grid>
                      </StackPanel>
                      <ToggleSwitch Grid.Column="1" Classes="bare" IsChecked="{Binding FeatureScreenText}" />
                    </Grid>
                    <StackPanel Spacing="8" Margin="14,0,14,14" IsVisible="{Binding FeatureScreenText}">
                      <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" Text="{Binding #Root.((vm:MainViewModel)DataContext).ScreenModelText}"
                                 Classes.err="{Binding #Root.((vm:MainViewModel)DataContext).ScreenModelError, Converter={x:Static ObjectConverters.IsNotNull}}" />
                      <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding #Root.((vm:MainViewModel)DataContext).ScreenHelp, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <c:BlobMascot Width="36" Height="32" Mood="Puzzled" Still="{Binding #Root.((vm:MainViewModel)DataContext).ReducedMotion}" MaxFps="24" />
                        <TextBlock Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="11" TextWrapping="Wrap"
                                   Text="{Binding #Root.((vm:MainViewModel)DataContext).ScreenHelp}" />
                      </Grid>
                      <ProgressBar Minimum="0" Maximum="1" Value="{Binding #Root.((vm:MainViewModel)DataContext).ScreenDownloadProgress}" Height="4" MinHeight="4" CornerRadius="2"
                                   IsVisible="{Binding #Root.((vm:MainViewModel)DataContext).IsDownloadingScreen}" />
                      <TextBlock Classes="dim" FontSize="11" Foreground="{DynamicResource Highlight}" Text="{Binding #Root.((vm:MainViewModel)DataContext).ScreenActivity}"
                                 IsVisible="{Binding #Root.((vm:MainViewModel)DataContext).ScreenActivity, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Classes="accent" Command="{Binding #Root.((vm:MainViewModel)DataContext).DownloadScreenModelCommand}" IsVisible="{Binding #Root.((vm:MainViewModel)DataContext).CanDownloadScreen}">
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{StaticResource IcImport}" Width="12" Height="12" Foreground="{DynamicResource OnAccent}" />
                            <TextBlock svc:Tr.Text="Download the text reader" />
                          </StackPanel>
                        </Button>
                        <Button Classes="soft" svc:Tr.Content="Cancel" Command="{Binding #Root.((vm:MainViewModel)DataContext).CancelScreenDownloadCommand}" IsVisible="{Binding #Root.((vm:MainViewModel)DataContext).IsDownloadingScreen}" />
                        <Button Classes="soft" svc:Tr.Content="Remove the model" Command="{Binding #Root.((vm:MainViewModel)DataContext).RemoveScreenModelCommand}" IsVisible="{Binding #Root.((vm:MainViewModel)DataContext).ScreenModelReady}"
                                svc:Tr.Tip="Frees the space. What was already read stays." />
                      </StackPanel>
                    </StackPanel>
                    <Border Classes="sep" />
                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="2">
                        <TextBlock svc:Tr.Text="Who's talking" />
                        <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" svc:Tr.Text="Savefile tells your friends' voices apart in the lines Voice search writes down, and fills in Who was there for the clips it's sure about. Mochi learns the voices from a little game: you listen to a few snippets and say who it is." />
                        <Grid ColumnDefinitions="Auto,*" Margin="0,4,0,0">
                          <PathIcon Data="{StaticResource IcSpeed}" Width="11" Height="11" Margin="0,2,6,0" VerticalAlignment="Top" Foreground="{DynamicResource TextDim}" />
                          <TextBlock Grid.Column="1" Classes="dim cost" FontSize="11" TextWrapping="Wrap" Text="{Binding #Root.((vm:MainViewModel)DataContext).VoicesCostText}" />
                        </Grid>
                      </StackPanel>
                      <ToggleSwitch Grid.Column="1" Classes="bare" IsChecked="{Binding FeatureVoices}" />
                    </Grid>
                    <StackPanel Spacing="8" Margin="14,0,14,14" IsVisible="{Binding FeatureVoices}">
                      <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" Text="{Binding #Root.((vm:MainViewModel)DataContext).VoiceModelText}"
                                 Classes.err="{Binding #Root.((vm:MainViewModel)DataContext).VoiceModelError, Converter={x:Static ObjectConverters.IsNotNull}}" />
                      <ProgressBar Minimum="0" Maximum="1" Value="{Binding #Root.((vm:MainViewModel)DataContext).VoiceDownloadProgress}" Height="4" MinHeight="4" CornerRadius="2"
                                   IsVisible="{Binding #Root.((vm:MainViewModel)DataContext).IsDownloadingVoice}" />
                      <TextBlock Classes="dim" FontSize="11" Foreground="{DynamicResource Highlight}" Text="{Binding #Root.((vm:MainViewModel)DataContext).VoiceActivity}"
                                 IsVisible="{Binding #Root.((vm:MainViewModel)DataContext).VoiceActivity, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Classes="accent" Command="{Binding #Root.((vm:MainViewModel)DataContext).DownloadVoiceModelCommand}" IsVisible="{Binding #Root.((vm:MainViewModel)DataContext).CanDownloadVoice}">
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{StaticResource IcImport}" Width="12" Height="12" Foreground="{DynamicResource OnAccent}" />
                            <TextBlock svc:Tr.Text="Download the voice model" />
                          </StackPanel>
                        </Button>
                        <Button Classes="accent" Command="{Binding #Root.((vm:MainViewModel)DataContext).OpenVoiceGameCommand}" IsVisible="{Binding #Root.((vm:MainViewModel)DataContext).CanPlayVoiceGame}">
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <c:BlobMascot Width="18" Height="16" Mood="Listening" Still="True" />
                            <TextBlock svc:Tr.Text="Help recognise voices…" />
                          </StackPanel>
                        </Button>
                        <Button Classes="soft" svc:Tr.Content="Cancel" Command="{Binding #Root.((vm:MainViewModel)DataContext).CancelVoiceDownloadCommand}" IsVisible="{Binding #Root.((vm:MainViewModel)DataContext).IsDownloadingVoice}" />
                        <Button Classes="soft" svc:Tr.Content="Remove the model" Command="{Binding #Root.((vm:MainViewModel)DataContext).RemoveVoiceModelCommand}" IsVisible="{Binding #Root.((vm:MainViewModel)DataContext).VoiceModelReady}"
                                svc:Tr.Tip="Frees the space. The voices Mochi knows stay." />
                      </StackPanel>
                    </StackPanel>
                  </StackPanel>
                </Border>
                <TextBlock Classes="label" svc:Tr.Text="EDITING AND EXPORT" Margin="0,8,0,0" />
                <Border Classes="group">
                  <StackPanel>
                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="2">
                        <TextBlock svc:Tr.Text="Captions" />
                        <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" svc:Tr.Text="Text over the video in the editor, burned into exports." />
                      </StackPanel>
                      <ToggleSwitch Grid.Column="1" Classes="bare" IsChecked="{Binding FeatureCaptions}" />
                    </Grid>
                    <Border Classes="sep" />
                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="2">
                        <TextBlock svc:Tr.Text="Slow motion and speed ramps" />
                        <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" svc:Tr.Text="Slow down or speed up part of a clip, easing in and out." />
                      </StackPanel>
                      <ToggleSwitch Grid.Column="1" Classes="bare" IsChecked="{Binding FeatureSpeedEffects}" />
                    </Grid>
                    <Border Classes="sep" />
                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="2">
                        <TextBlock svc:Tr.Text="Zoom and pan" />
                        <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" svc:Tr.Text="Punch in on the action and follow it, gliding between keyframes." />
                      </StackPanel>
                      <ToggleSwitch Grid.Column="1" Classes="bare" IsChecked="{Binding FeatureZoomPan}" />
                    </Grid>
                    <Border Classes="sep" />
                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="2">
                        <TextBlock svc:Tr.Text="Blur" />
                        <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" svc:Tr.Text="Blur or pixelate names, chat or the HUD before you share." />
                      </StackPanel>
                      <ToggleSwitch Grid.Column="1" Classes="bare" IsChecked="{Binding FeatureBlur}" />
                    </Grid>
                    <Border Classes="sep" />
                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="2">
                        <TextBlock svc:Tr.Text="Music" />
                        <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" svc:Tr.Text="Put a song under an export, lowered while the game is loud." />
                      </StackPanel>
                      <ToggleSwitch Grid.Column="1" Classes="bare" IsChecked="{Binding FeatureMusic}" />
                    </Grid>
                    <Border Classes="sep" />
                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="2">
                        <TextBlock svc:Tr.Text="Auto montage" />
                        <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" svc:Tr.Text="Stitch the best moments of your favourites into one video, with transitions and music." />
                      </StackPanel>
                      <ToggleSwitch Grid.Column="1" Classes="bare" IsChecked="{Binding FeatureMontage}" />
                    </Grid>
                    <Border Classes="sep" />
                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="2">
                        <TextBlock svc:Tr.Text="Sound tools" />
                        <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" svc:Tr.Text="Even out loudness, boost your voice and lower the game while you talk." />
                      </StackPanel>
                      <ToggleSwitch Grid.Column="1" Classes="bare" IsChecked="{Binding FeatureAudioTools}" />
                    </Grid>
                    <Border Classes="sep" />
                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="2">
                        <TextBlock svc:Tr.Text="Watermark and intro" />
                        <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" svc:Tr.Text="Your logo in a corner, and an intro or outro clip around exports." />
                      </StackPanel>
                      <ToggleSwitch Grid.Column="1" Classes="bare" IsChecked="{Binding FeatureBranding}" />
                    </Grid>
                    <Border Classes="sep" />
                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="2">
                        <TextBlock svc:Tr.Text="Export queue" />
                        <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" svc:Tr.Text="Exports run in the background one after another, so you can keep editing. Off, the editor waits for each export." />
                      </StackPanel>
                      <ToggleSwitch Grid.Column="1" Classes="bare" IsChecked="{Binding FeatureExportQueue}" />
                    </Grid>
                    <Border Classes="sep" />
                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="2">
                        <TextBlock svc:Tr.Text="Remember edits" />
                        <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" svc:Tr.Text="Trim marks, parts, captions and speed changes are still there when you open a video again. The video file itself only changes when you export, and Start over clears them." />
                      </StackPanel>
                      <ToggleSwitch Grid.Column="1" Classes="bare" IsChecked="{Binding FeatureKeepEdits}" />
                    </Grid>
                  </StackPanel>
                </Border>
              </StackPanel>

              <!-- ==== Editing ==== -->
              <StackPanel Spacing="12" IsVisible="{Binding IsEditingPage}">
                <TextBlock Classes="dim" FontSize="12" TextWrapping="Wrap" Margin="4,0"
                           svc:Tr.Text="Your watermark and intro / outro clips. Switch them on per export in the editor's Effects panel; they stay on until you switch them off." />
                <Border Classes="group" IsVisible="{Binding ShowBrandingOffNotice}">
                  <Grid Classes="row" ColumnDefinitions="*,Auto">
                    <TextBlock svc:Tr.Text="Watermark and intro is switched off under Features." TextWrapping="Wrap" />
                    <Button Grid.Column="1" Classes="soft" svc:Tr.Content="Switch on" Command="{Binding EnableBrandingCommand}" />
                  </Grid>
                </Border>
                <StackPanel Spacing="12" IsVisible="{Binding FeatureBranding}">
                <TextBlock Classes="label" svc:Tr.Text="WATERMARK" />
                <Border Classes="group">
                  <StackPanel>
                    <Grid Classes="row" ColumnDefinitions="*,Auto,Auto">
                      <StackPanel Spacing="2">
                        <TextBlock svc:Tr.Text="Image" />
                        <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" Text="{Binding WatermarkName}" />
                      </StackPanel>
                      <Button Grid.Column="1" Classes="soft" svc:Tr.Content="Choose…" Margin="0,0,8,0" Command="{Binding ChooseWatermarkCommand}" />
                      <Button Grid.Column="2" Classes="ghost" svc:Tr.Content="Remove" Command="{Binding RemoveWatermarkCommand}" IsVisible="{Binding HasWatermarkImage}" />
                    </Grid>
                    <StackPanel IsVisible="{Binding HasWatermarkImage}">
                      <Border Classes="sep" />
                      <Grid Classes="row" ColumnDefinitions="*,Auto">
                        <TextBlock svc:Tr.Text="Corner" />
                        <ContentControl Grid.Column="1" Content="{Binding WatermarkCorner}" />
                      </Grid>
                      <Border Classes="sep" />
                      <Grid Classes="row" ColumnDefinitions="*,Auto,Auto">
                        <TextBlock svc:Tr.Text="Size (share of the video's width)" />
                        <Slider Grid.Column="1" Width="180" Minimum="5" Maximum="40" TickFrequency="1" IsSnapToTickEnabled="True"
                                Value="{Binding WatermarkSize}" VerticalAlignment="Center" Margin="0,-6,10,-6" />
                        <TextBlock Grid.Column="2" Classes="mono" Width="44" TextAlignment="Right" Text="{Binding WatermarkSizeText}" />
                      </Grid>
                      <Border Classes="sep" />
                      <Grid Classes="row" ColumnDefinitions="*,Auto,Auto">
                        <TextBlock svc:Tr.Text="Opacity" />
                        <Slider Grid.Column="1" Width="180" Minimum="20" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                                Value="{Binding WatermarkOpacity}" VerticalAlignment="Center" Margin="0,-6,10,-6" />
                        <TextBlock Grid.Column="2" Classes="mono" Width="44" TextAlignment="Right" Text="{Binding WatermarkOpacityText}" />
                      </Grid>
                      <Border Classes="sep" />
                      <Grid Classes="row" ColumnDefinitions="*,Auto">
                        <TextBlock svc:Tr.Text="Add it to exports" />
                        <ToggleSwitch Grid.Column="1" Classes="bare" IsChecked="{Binding UseWatermark}" />
                      </Grid>
                    </StackPanel>
                  </StackPanel>
                </Border>

                <TextBlock Classes="label" svc:Tr.Text="INTRO AND OUTRO" Margin="0,8,0,0" />
                <Border Classes="group">
                  <StackPanel>
                    <Grid Classes="row" ColumnDefinitions="*,Auto,Auto,Auto">
                      <StackPanel Spacing="2">
                        <TextBlock svc:Tr.Text="Intro clip" />
                        <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" Text="{Binding IntroName}" />
                      </StackPanel>
                      <Button Grid.Column="1" Classes="soft" svc:Tr.Content="Choose…" Margin="0,0,8,0" Command="{Binding ChooseIntroCommand}" />
                      <Button Grid.Column="2" Classes="ghost" svc:Tr.Content="Remove" Margin="0,0,8,0" Command="{Binding RemoveIntroCommand}" IsVisible="{Binding HasIntroClip}" />
                      <ToggleSwitch Grid.Column="3" Classes="bare" IsChecked="{Binding UseIntro}" IsEnabled="{Binding HasIntroClip}"
                                    svc:Tr.Tip="Add it to exports" />
                    </Grid>
                    <Border Classes="sep" />
                    <Grid Classes="row" ColumnDefinitions="*,Auto,Auto,Auto">
                      <StackPanel Spacing="2">
                        <TextBlock svc:Tr.Text="Outro clip" />
                        <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" Text="{Binding OutroName}" />
                      </StackPanel>
                      <Button Grid.Column="1" Classes="soft" svc:Tr.Content="Choose…" Margin="0,0,8,0" Command="{Binding ChooseOutroCommand}" />
                      <Button Grid.Column="2" Classes="ghost" svc:Tr.Content="Remove" Margin="0,0,8,0" Command="{Binding RemoveOutroCommand}" IsVisible="{Binding HasOutroClip}" />
                      <ToggleSwitch Grid.Column="3" Classes="bare" IsChecked="{Binding UseOutro}" IsEnabled="{Binding HasOutroClip}"
                                    svc:Tr.Tip="Add it to exports" />
                    </Grid>
                  </StackPanel>
                </Border>
                <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" Margin="4,0"
                           svc:Tr.Text="Intro and outro clips are fitted to each export's size, with black bars if the shape differs. Exports and Share presets both use them." />
                </StackPanel>
              </StackPanel>

              <!-- ==== Accessibility ==== -->
              <StackPanel Spacing="12" IsVisible="{Binding IsAccessibilityPage}">
                <Border Classes="group">
                  <StackPanel>
                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="2">
                        <TextBlock svc:Tr.Text="Interface size" />
                        <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" svc:Tr.Text="Makes text, buttons and videos bigger or smaller." />
                      </StackPanel>
                      <ComboBox Grid.Column="1" Classes="field" MinWidth="120" ItemsSource="{x:Static vm:SettingsViewModel.UiScales}" SelectedItem="{Binding UiScale}" />
                    </Grid>
                    <Border Classes="sep" />
                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="2">
                        <TextBlock svc:Tr.Text="High contrast" />
                        <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" svc:Tr.Text="Black background, white text and clearer lines, with the purple accent." />
                      </StackPanel>
                      <ToggleSwitch Grid.Column="1" Classes="bare" IsChecked="{Binding HighContrast}" />
                    </Grid>
                    <Border Classes="sep" />
                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="2">
                        <TextBlock svc:Tr.Text="Reduce motion" />
                        <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" svc:Tr.Text="No animations, zooming or glow." />
                      </StackPanel>
                      <ToggleSwitch Grid.Column="1" Classes="bare" IsChecked="{Binding ReducedMotion}" />
                    </Grid>
                  </StackPanel>
                </Border>
              </StackPanel>

              <!-- ==== Clipping ==== -->
              <Border Classes="group" IsVisible="{Binding ShowClippingOffNotice}" Padding="16,14">
                <TextBlock Classes="dim" FontSize="12" TextWrapping="Wrap"
                           svc:Tr.Text="Background clipping is switched off. Switch it on under Features to set it up." />
              </Border>
              <StackPanel Spacing="12" IsVisible="{Binding ShowClippingSettings}">
              <TextBlock Classes="label" svc:Tr.Text="CLIPPING" />
              <Border Classes="group">
                <StackPanel>
                  <Grid Classes="row" ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="2">
                      <TextBlock svc:Tr.Text="Background clipping" />
                      <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" Text="{Binding Footprint}" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" Classes="bare" IsChecked="{Binding ClipEnabled}" />
                  </Grid>
                  <Border Classes="sep" />
                  <Grid Classes="row" ColumnDefinitions="*,220">
                    <TextBlock svc:Tr.Text="Clip length" />
                    <ComboBox Grid.Column="1" Classes="field" ItemsSource="{x:Static vm:SettingsViewModel.Lengths}" SelectedItem="{Binding Length}" />
                  </Grid>
                  <Border Classes="sep" />
                  <Grid Classes="row" ColumnDefinitions="*,Auto">
                    <TextBlock svc:Tr.Text="Save clip hotkey" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                      <ToggleButton Classes="mod" IsChecked="{Binding HotkeyCtrl}" Content="{Binding CtrlLabel}" />
                      <ToggleButton Classes="mod" IsChecked="{Binding HotkeyAlt}" Content="{Binding AltLabel}" />
                      <ToggleButton Classes="mod" IsChecked="{Binding HotkeyShift}" Content="{Binding ShiftLabel}" />
                      <ToggleButton Classes="mod" IsChecked="{Binding HotkeyMeta}" Content="{Binding MetaLabel}" />
                      <ComboBox Classes="field" Width="74" ItemsSource="{x:Static vm:SettingsViewModel.Keys}" SelectedItem="{Binding HotkeyKey}" />
                    </StackPanel>
                  </Grid>
                  <ItemsControl ItemsSource="{Binding ExtraHotkeys}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:HotkeyRow">
                        <StackPanel>
                          <Border Classes="sep" />
                          <Grid Classes="row" ColumnDefinitions="*,Auto">
                            <TextBlock svc:Tr.Text="Extra hotkey" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                              <ToggleButton Classes="mod" IsChecked="{Binding Ctrl}" Content="{Binding #Root.((vm:MainViewModel)DataContext).SettingsEditor.CtrlLabel}" />
                              <ToggleButton Classes="mod" IsChecked="{Binding Alt}" Content="{Binding #Root.((vm:MainViewModel)DataContext).SettingsEditor.AltLabel}" />
                              <ToggleButton Classes="mod" IsChecked="{Binding Shift}" Content="{Binding #Root.((vm:MainViewModel)DataContext).SettingsEditor.ShiftLabel}" />
                              <ToggleButton Classes="mod" IsChecked="{Binding Meta}" Content="{Binding #Root.((vm:MainViewModel)DataContext).SettingsEditor.MetaLabel}" />
                              <ComboBox Classes="field" Width="74" ItemsSource="{x:Static vm:SettingsViewModel.Keys}" SelectedItem="{Binding Key}" />
                            </StackPanel>
                          </Grid>
                          <Grid Classes="row" ColumnDefinitions="*,Auto,Auto" Margin="14,0,14,10">
                            <TextBlock Classes="dim" svc:Tr.Text="It saves the last" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" Classes="field" Width="180" ItemsSource="{x:Static vm:SettingsViewModel.Lengths}" SelectedItem="{Binding Length}" />
                            <Button Grid.Column="2" Classes="ghost" Margin="6,0,0,0" svc:Tr.Tip="Remove this hotkey"
                                    Command="{Binding #Root.((vm:MainViewModel)DataContext).SettingsEditor.RemoveHotkeyCommand}" CommandParameter="{Binding}">
                              <PathIcon Data="{StaticResource IcClose}" Width="12" Height="12" />
                            </Button>
                          </Grid>
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Border Classes="sep" IsVisible="{Binding CanAddHotkey}" />
                  <Grid Classes="row" ColumnDefinitions="*,Auto" IsVisible="{Binding CanAddHotkey}">
                    <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center"
                               svc:Tr.Text="Another hotkey can save a different length, say a short one for a quick play and a long one for a whole round. The buffer keeps the longest." />
                    <Button Grid.Column="1" Classes="soft" svc:Tr.Content="Add hotkey" Command="{Binding AddHotkeyCommand}" Margin="10,0,0,0" />
                  </Grid>
                  <Border Classes="sep" />
                  <Grid Classes="row" ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="2">
                      <TextBlock svc:Tr.Text="Save clips to" />
                      <TextBlock Classes="dim mono" FontSize="11" Text="{Binding Folder}" TextTrimming="PathSegmentEllipsis" MaxWidth="360" HorizontalAlignment="Left" />
                    </StackPanel>
                    <Button Grid.Column="1" Classes="soft" svc:Tr.Content="Choose…" Command="{Binding BrowseFolderCommand}" />
                  </Grid>
                  <Border Classes="sep" />
                  <Grid Classes="row" ColumnDefinitions="*,Auto">
                    <TextBlock svc:Tr.Text="Notify me when a clip is saved" />
                    <ToggleSwitch Grid.Column="1" Classes="bare" IsChecked="{Binding Notify}" />
                  </Grid>
                  <Border Classes="sep" />
                  <Grid Classes="row" ColumnDefinitions="*,Auto">
                    <TextBlock svc:Tr.Text="Play a sound when a clip is saved" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                      <Button Classes="soft" svc:Tr.Content="Hear it" IsVisible="{Binding Sound}"
                              Command="{Binding #Root.((vm:MainViewModel)DataContext).HearSaveSoundCommand}" />
                      <ToggleSwitch Classes="bare" IsChecked="{Binding Sound}" />
                    </StackPanel>
                  </Grid>
                  <Border Classes="sep" />
                  <Grid Classes="row" ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="2">
                      <TextBlock svc:Tr.Text="Name and tag clips after the game" />
                      <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" svc:Tr.Text="Uses the app that is in front when you save." />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" Classes="bare" IsChecked="{Binding TagWithGame}" />
                  </Grid>
                </StackPanel>
              </Border>

              <TextBlock Classes="label" svc:Tr.Text="STORAGE" Margin="0,8,0,0" />
              <Border Classes="group">
                <StackPanel>
                  <Grid Classes="row" ColumnDefinitions="*,220">
                    <StackPanel Spacing="2">
                      <TextBlock svc:Tr.Text="Remove clips older than" />
                      <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" svc:Tr.Text="Favourites are never removed." />
                    </StackPanel>
                    <ComboBox Grid.Column="1" Classes="field" ItemsSource="{x:Static vm:SettingsViewModel.KeepDaysOptions}" SelectedItem="{Binding KeepDays}" />
                  </Grid>
                  <Border Classes="sep" />
                  <Grid Classes="row" ColumnDefinitions="*,220">
                    <StackPanel Spacing="2">
                      <TextBlock svc:Tr.Text="Keep the clips folder under" />
                      <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" Text="{Binding StorageUsage}" />
                    </StackPanel>
                    <ComboBox Grid.Column="1" Classes="field" ItemsSource="{x:Static vm:SettingsViewModel.FolderCaps}" SelectedItem="{Binding FolderCap}" />
                  </Grid>
                  <Border Classes="sep" />
                  <Grid Classes="row" ColumnDefinitions="*,220">
                    <StackPanel Spacing="2">
                      <TextBlock svc:Tr.Text="Removed clips go to the" />
                      <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" svc:Tr.Text="Oldest clips go first once a limit is passed." />
                    </StackPanel>
                    <ComboBox Grid.Column="1" Classes="field" ItemsSource="{x:Static vm:SettingsViewModel.CleanupTargets}" SelectedItem="{Binding CleanupTarget}" />
                  </Grid>
                  <Border Classes="sep" IsVisible="{Binding UsesArchive}" />
                  <Grid Classes="row" ColumnDefinitions="*,Auto" IsVisible="{Binding UsesArchive}">
                    <StackPanel Spacing="2">
                      <TextBlock svc:Tr.Text="Archive folder" />
                      <TextBlock Classes="dim mono" FontSize="11" Text="{Binding ArchiveFolder}" TextTrimming="PathSegmentEllipsis" MaxWidth="360" HorizontalAlignment="Left" />
                    </StackPanel>
                    <Button Grid.Column="1" Classes="soft" svc:Tr.Content="Choose…" Command="{Binding BrowseArchiveCommand}" />
                  </Grid>
                </StackPanel>
              </Border>

              <TextBlock Classes="label" svc:Tr.Text="VIDEO" Margin="0,8,0,0" />
              <Border Classes="group">
                <StackPanel>
                  <Grid Classes="row" ColumnDefinitions="*,220" IsVisible="{Binding HasSeveralScreens}">
                    <TextBlock svc:Tr.Text="Screen" />
                    <ComboBox Grid.Column="1" Classes="field" ItemsSource="{Binding Screens}" SelectedIndex="{Binding ScreenIndex}" />
                  </Grid>
                  <Border Classes="sep" IsVisible="{Binding HasSeveralScreens}" />
                  <Grid Classes="row" ColumnDefinitions="*,220">
                    <TextBlock svc:Tr.Text="Resolution" />
                    <ComboBox Grid.Column="1" Classes="field" ItemsSource="{x:Static vm:SettingsViewModel.Resolutions}" SelectedItem="{Binding Resolution}" />
                  </Grid>
                  <Border Classes="sep" />
                  <Grid Classes="row" ColumnDefinitions="*,220">
                    <TextBlock svc:Tr.Text="Frame rate" />
                    <ComboBox Grid.Column="1" Classes="field" ItemsSource="{x:Static vm:SettingsViewModel.FrameRates}" SelectedItem="{Binding FrameRate}" />
                  </Grid>
                  <Border Classes="sep" />
                  <Grid Classes="row" ColumnDefinitions="*,220">
                    <TextBlock svc:Tr.Text="Video bitrate" />
                    <ComboBox Grid.Column="1" Classes="field" ItemsSource="{x:Static vm:SettingsViewModel.Bitrates}" SelectedItem="{Binding Bitrate}" />
                  </Grid>
                  <Border Classes="sep" />
                  <Grid Classes="row" ColumnDefinitions="*,260">
                    <StackPanel Spacing="2">
                      <TextBlock svc:Tr.Text="Format" />
                      <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" Text="{Binding CodecDetail}" />
                    </StackPanel>
                    <ComboBox Grid.Column="1" Classes="field" ItemsSource="{Binding Codecs}" SelectedItem="{Binding Codec}" />
                  </Grid>
                  <Border Classes="sep" />
                  <Grid Classes="row" ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="2">
                      <TextBlock svc:Tr.Text="Use the graphics card to encode" />
                      <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap"
                                 svc:Tr.Text="Much lighter on the CPU while gaming. Off records H.264 in software." />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" Classes="bare" IsChecked="{Binding HardwareEncoder}" />
                  </Grid>
                </StackPanel>
              </Border>

              <TextBlock Classes="label" svc:Tr.Text="AUDIO" Margin="0,8,0,0" />
              <Border Classes="group">
                <StackPanel>
                  <Grid Classes="row" ColumnDefinitions="*,260">
                    <TextBlock svc:Tr.Text="Audio device" />
                    <ComboBox Grid.Column="1" Classes="field" ItemsSource="{Binding AudioDevices}" SelectedItem="{Binding Audio1}" />
                  </Grid>
                  <Border Classes="sep" />
                  <Grid Classes="row" ColumnDefinitions="*,260">
                    <StackPanel Spacing="2">
                      <TextBlock svc:Tr.Text="Second device" />
                      <TextBlock Classes="dim" FontSize="11" svc:Tr.Text="Mixed in, e.g. your microphone." />
                    </StackPanel>
                    <ComboBox Grid.Column="1" Classes="field" ItemsSource="{Binding AudioDevices}" SelectedItem="{Binding Audio2}" />
                  </Grid>
                  <Border Classes="sep" />
                  <Grid Classes="row" ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="2">
                      <TextBlock svc:Tr.Text="Keep the two devices as separate tracks" />
                      <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap"
                                 svc:Tr.Text="Lets you mute the game or the microphone afterwards in the player. Some players and Discord only play the first track, so use a Share preset to mix them back together." />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" Classes="bare" IsChecked="{Binding SeparateTracks}" />
                  </Grid>
                  <Border Classes="sep" />
                  <Grid Classes="row" ColumnDefinitions="*,220">
                    <TextBlock svc:Tr.Text="Audio bitrate" />
                    <ComboBox Grid.Column="1" Classes="field" ItemsSource="{x:Static vm:SettingsViewModel.AudioBitrates}" SelectedItem="{Binding AudioBitrate}" />
                  </Grid>
                </StackPanel>
              </Border>
              <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" Text="{Binding AudioHint}" Margin="4,0" />

              <TextBlock Classes="label" svc:Tr.Text="CAMERA" Margin="0,8,0,0" />
              <Border Classes="group">
                <StackPanel>
                  <Grid Classes="row" ColumnDefinitions="*,220">
                    <StackPanel Spacing="2" Margin="0,0,12,0">
                      <TextBlock svc:Tr.Text="Webcam in the corner" />
                      <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap"
                                 svc:Tr.Text="Puts you in every clip and session, like a facecam. The camera stays on while clipping is on." />
                    </StackPanel>
                    <ComboBox Grid.Column="1" Classes="field" ItemsSource="{Binding Cameras}" SelectedItem="{Binding Camera}" />
                  </Grid>
                  <StackPanel IsVisible="{Binding HasCamera}">
                    <Border Classes="sep" />
                    <Grid Classes="row" ColumnDefinitions="*,220">
                      <TextBlock svc:Tr.Text="Corner" />
                      <ComboBox Grid.Column="1" Classes="field" ItemsSource="{x:Static vm:SettingsViewModel.CameraCorners}" SelectedItem="{Binding CameraCorner}" />
                    </Grid>
                    <Border Classes="sep" />
                    <Grid Classes="row" ColumnDefinitions="*,220">
                      <TextBlock svc:Tr.Text="Size" />
                      <ComboBox Grid.Column="1" Classes="field" ItemsSource="{x:Static vm:SettingsViewModel.CameraSizes}" SelectedItem="{Binding CameraSize}" />
                    </Grid>
                  </StackPanel>
                </StackPanel>
              </Border>

              <TextBlock Classes="label" svc:Tr.Text="GAME PROFILES" Margin="0,8,0,0" />
              <Border Classes="group">
                <StackPanel>
                  <ItemsControl ItemsSource="{Binding Profiles}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <StackPanel>
                          <Grid Classes="row" ColumnDefinitions="*,Auto,Auto,Auto,Auto">
                            <TextBox Text="{Binding Game}" svc:Tr.Watermark="Game or app name" CornerRadius="8" Margin="0,0,8,0" />
                            <ComboBox Grid.Column="1" Classes="field" Width="118" Margin="0,0,6,0" ItemsSource="{x:Static vm:ProfileRow.Lengths}" SelectedItem="{Binding Length}" />
                            <ComboBox Grid.Column="2" Classes="field" Width="120" Margin="0,0,6,0" ItemsSource="{x:Static vm:ProfileRow.Bitrates}" SelectedItem="{Binding Bitrate}" />
                            <ComboBox Grid.Column="3" Classes="field" Width="116" Margin="0,0,4,0" ItemsSource="{x:Static vm:ProfileRow.Formats}" SelectedItem="{Binding Format}" />
                            <Button Grid.Column="4" Classes="ghost" svc:Tr.Tip="Remove this profile"
                                    Command="{Binding #Root.((vm:MainViewModel)DataContext).SettingsEditor.RemoveProfileCommand}" CommandParameter="{Binding}">
                              <PathIcon Data="{StaticResource IcClose}" Width="12" Height="12" />
                            </Button>
                          </Grid>
                          <Border Classes="sep" />
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Grid Classes="row" ColumnDefinitions="*,Auto">
                    <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center"
                               svc:Tr.Text="While that game is in front, clips use its length, bitrate and format. The name is the one clips get tagged with; part of it is enough." />
                    <Button Grid.Column="1" Classes="soft" svc:Tr.Content="Add profile" Command="{Binding AddProfileCommand}" Margin="10,0,0,0" />
                  </Grid>
                </StackPanel>
              </Border>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Border>

    <!-- ======================= TOAST ======================= -->
    <Border Classes="toast" Classes.lifted="{Binding IsSelecting}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Padding="16,10" CornerRadius="10"
            Background="{DynamicResource Bg3}" BorderBrush="{DynamicResource Accent}" BorderThickness="1"
            BoxShadow="0 8 30 0 #80000000" IsHitTestVisible="False"
            IsVisible="{Binding Toast, Converter={x:Static ObjectConverters.IsNotNull}}">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <PathIcon Data="{StaticResource IcCheck}" Width="13" Height="13" Foreground="{DynamicResource Highlight}" IsVisible="{Binding !HasToastMochi}" />
        <!-- Mochi reacting to a save: a squish and sparkles, a big hop for a big one, the badge for a milestone -->
        <c:BlobMascot Width="40" Height="36" Margin="-6,-12,-2,-6" VerticalAlignment="Center" IsVisible="{Binding HasToastMochi}" MaxFps="40"
                      Mood="{Binding ToastMochiMood}" Hat="{Binding MochiHat}" SparkleTick="{Binding MochiSparkle}" BigCheerTick="{Binding MochiBigCheer}"
                      Still="{Binding ReducedMotion}" />
        <TextBlock Text="{Binding Toast}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
      </StackPanel>
    </Border>

    <!-- ======================= PLAYER (EDITOR) ======================= -->
    <!-- Video on the left; a rail of labelled tools and the page of the picked one on the right; under it all,
         the timeline, the transport and a bar with the everyday tools as buttons. -->
    <Grid x:Name="PlayerView" RowDefinitions="Auto,*,Auto" IsVisible="{Binding #Root.((vm:MainViewModel)DataContext).IsPlayerOpen}" Background="Black"
          DataContext="{Binding Player}" x:DataType="vm:PlayerViewModel">

      <!-- Top bar -->
      <Border Grid.Row="0" Background="{DynamicResource Bg1}" Height="52" x:Name="PlayerTopBar">
        <Grid x:Name="PlayerTopGrid" ColumnDefinitions="Auto,Auto,*,Auto">
          <Button Classes="ghost" Command="{Binding #Root.((vm:MainViewModel)DataContext).ClosePlayerCommand}"
                  svc:Tr.Tip="Back to library (Esc)" VerticalAlignment="Center" Margin="12,0,4,0">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Data="{StaticResource IcBack}" Width="16" Height="16" />
              <TextBlock svc:Tr.Text="Library" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" Margin="0,0,10,0">
            <Button Classes="ghost" Padding="6" Command="{Binding #Root.((vm:MainViewModel)DataContext).PreviousClipCommand}" svc:Tr.Tip="Previous video (←)">
              <PathIcon Data="{StaticResource IcChevronLeft}" Width="18" Height="18" />
            </Button>
            <Button Classes="ghost" Padding="6" Command="{Binding #Root.((vm:MainViewModel)DataContext).NextClipCommand}" svc:Tr.Tip="Next video (→)">
              <PathIcon Data="{StaticResource IcChevronRight}" Width="18" Height="18" />
            </Button>
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" IsHitTestVisible="False">
            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="520" />
            <TextBlock Classes="dim" Text="{Binding Subtitle}" FontSize="12" VerticalAlignment="Center" />
          </StackPanel>
          <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="0,0,12,0">
            <Button Classes="ghost" svc:Tr.Tip="Exports running in the background"
                    IsVisible="{Binding #Root.((vm:MainViewModel)DataContext).Exports.HasJobs}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource IcExport}" Width="15" Height="15" />
                <TextBlock Text="{Binding #Root.((vm:MainViewModel)DataContext).Exports.ButtonText}" FontSize="12" VerticalAlignment="Center" />
              </StackPanel>
              <Button.Flyout>
                <Flyout Placement="BottomEdgeAlignedRight">
                  <ContentControl Content="{Binding #Root.((vm:MainViewModel)DataContext).Exports}" />
                </Flyout>
              </Button.Flyout>
            </Button>
            <Button Classes="ghost" svc:Tr.Tip="Back to the quick player: plain playback over the library"
                    IsVisible="{Binding #Root.((vm:MainViewModel)DataContext).ShowMiniPlayerButton}"
                    Command="{Binding #Root.((vm:MainViewModel)DataContext).ShrinkToMiniPlayerCommand}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource IcMiniPlayer}" Width="15" Height="15" />
                <TextBlock svc:Tr.Text="Quick player" FontSize="12" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="10,0,0,0">
              <Border Background="{DynamicResource Bg2}" CornerRadius="8" Padding="3" VerticalAlignment="Center" Margin="0,0,2,0">
                <StackPanel Orientation="Horizontal">
                  <RadioButton Classes="seg" GroupName="mode" svc:Tr.Content="Lossless" IsChecked="{Binding !PreciseExport}"
                               svc:Tr.Tip="Stream copy: instant, no quality loss. Start snaps to the nearest earlier keyframe." />
                  <RadioButton Classes="seg" GroupName="mode" svc:Tr.Content="Precise" IsChecked="{Binding PreciseExport}"
                               svc:Tr.Tip="Re-encode to H.264/AAC MP4: frame-accurate cut, slower." />
                </StackPanel>
              </Border>
              <Button Classes="soft" IsVisible="{Binding !IsExporting}" svc:Tr.Tip="Share presets: Discord, vertical, GIF"
                      Command="{Binding PickPageCommand}" CommandParameter="{x:Static vm:ToolPage.Share}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Data="{StaticResource IcShare}" Width="14" Height="14" />
                  <TextBlock svc:Tr.Text="Share" />
                </StackPanel>
              </Button>
              <Button Classes="accent" Command="{Binding ExportCommand}" IsVisible="{Binding !IsExporting}"
                      svc:Tr.Tip="Export clip (E)">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <PathIcon Data="{StaticResource IcExport}" Width="15" Height="15" />
                  <TextBlock Text="{Binding ExportLabel}" />
                </StackPanel>
              </Button>
              <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsExporting}">
                <ProgressBar Width="150" Height="6" MinHeight="6" Value="{Binding ExportProgress}" VerticalAlignment="Center" CornerRadius="3" />
                <TextBlock Classes="mono" FontSize="12" Text="{Binding ExportProgress, StringFormat='{}{0:0}%'}" VerticalAlignment="Center" />
                <Button Classes="ghost" Command="{Binding CancelExportCommand}" svc:Tr.Tip="Cancel export">
                  <PathIcon Data="{StaticResource IcClose}" Width="14" Height="14" />
                </Button>
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Video | rail | tool page -->
      <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto">
      <Panel>
        <c:VideoSurface x:Name="Surface" Frames="{Binding Frames}"
                          SourceWidth="{Binding VideoWidth}" SourceHeight="{Binding VideoHeight}"
                          View="{Binding PreviewView}" Blurs="{Binding PreviewBlurs}" />
        <c:EffectsOverlay Captions="{Binding PreviewCaptions}" Watermark="{Binding PreviewWatermark}"
                          VideoWidth="{Binding VideoWidth}" VideoHeight="{Binding VideoHeight}" />
        <Border Classes="spoken" IsVisible="{Binding SpokenLine, Converter={x:Static ObjectConverters.IsNotNull}}" Margin="48,0,48,22">
          <TextBlock Text="{Binding SpokenLine}" FontSize="17" />
        </Border>
        <Border Background="Transparent" x:Name="SurfaceHit" />
        <c:FrameEditor x:Name="FrameEdit" Regions="{Binding FrameRegions}" VideoWidth="{Binding VideoWidth}" VideoHeight="{Binding VideoHeight}" />
        <Border Classes="speedbadge" IsVisible="{Binding SpeedPreviewText, Converter={x:Static ObjectConverters.IsNotNull}}"
                IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <PathIcon Data="{StaticResource IcSpeed}" Width="13" Height="13" Foreground="#FF9F43" />
            <TextBlock Text="{Binding SpeedPreviewText}" FontSize="12" FontWeight="SemiBold" />
          </StackPanel>
        </Border>
        <Border IsVisible="{Binding Toast, Converter={x:Static ObjectConverters.IsNotNull}}"
                HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,18,0,0"
                Background="{DynamicResource ToastBg}" CornerRadius="10" Padding="14,8" BorderBrush="{DynamicResource Line}" BorderThickness="1">
          <TextBlock Text="{Binding Toast}" FontSize="13" />
        </Border>
      </Panel>

      <!-- ===== TOOL RAIL ===== -->
      <Border Grid.Column="1" Background="{DynamicResource Bg1}" BorderBrush="{DynamicResource Line}" BorderThickness="1,0,0,0" Padding="6,10">
        <StackPanel Spacing="4">
          <Button Classes="rail" Classes.on="{Binding IsTrimPage}" Command="{Binding PickPageCommand}" CommandParameter="{x:Static vm:ToolPage.Trim}"
                  svc:Tr.Tip="Selection, parts, markers and chapters">
            <StackPanel Spacing="4"><PathIcon Data="{StaticResource IcCut}" /><TextBlock svc:Tr.Text="Trim" /></StackPanel>
          </Button>
          <Button Classes="rail" Classes.on="{Binding IsCaptionsPage}" Command="{Binding PickPageCommand}" CommandParameter="{x:Static vm:ToolPage.Captions}"
                  IsVisible="{Binding ShowCaptionsTool}" svc:Tr.Tip="Text over the video">
            <StackPanel Spacing="4"><PathIcon Data="{StaticResource IcText}" /><TextBlock svc:Tr.Text="Captions" /></StackPanel>
          </Button>
          <Button Classes="rail" Classes.on="{Binding IsSpeedPage}" Command="{Binding PickPageCommand}" CommandParameter="{x:Static vm:ToolPage.Speed}"
                  IsVisible="{Binding ShowSpeedTool}" svc:Tr.Tip="Slow motion and fast forward">
            <StackPanel Spacing="4"><PathIcon Data="{StaticResource IcSpeed}" /><TextBlock svc:Tr.Text="Speed" /></StackPanel>
          </Button>
          <Button Classes="rail" Classes.on="{Binding IsZoomPage}" Command="{Binding PickPageCommand}" CommandParameter="{x:Static vm:ToolPage.Zoom}"
                  IsVisible="{Binding ShowZoomTool}" svc:Tr.Tip="Zoom in on the action and follow it, with keyframes">
            <StackPanel Spacing="4"><PathIcon Data="{StaticResource IcZoom}" /><TextBlock svc:Tr.Text="Zoom" /></StackPanel>
          </Button>
          <Button Classes="rail" Classes.on="{Binding IsBlurPage}" Command="{Binding PickPageCommand}" CommandParameter="{x:Static vm:ToolPage.Blur}"
                  IsVisible="{Binding ShowBlurTool}" svc:Tr.Tip="Hide names, chat or HUD before sharing">
            <StackPanel Spacing="4"><PathIcon Data="{StaticResource IcBlur}" /><TextBlock svc:Tr.Text="Blur" /></StackPanel>
          </Button>
          <Button Classes="rail" Classes.on="{Binding IsSoundPage}" Command="{Binding PickPageCommand}" CommandParameter="{x:Static vm:ToolPage.Sound}"
                  IsVisible="{Binding ShowSoundTool}" svc:Tr.Tip="Loudness, voice and audio tracks">
            <StackPanel Spacing="4"><PathIcon Data="{StaticResource IcVolume}" /><TextBlock svc:Tr.Text="Sound" /></StackPanel>
          </Button>
          <Button Classes="rail" Classes.on="{Binding IsBrandPage}" Command="{Binding PickPageCommand}" CommandParameter="{x:Static vm:ToolPage.Brand}"
                  IsVisible="{Binding ShowBrandTool}" svc:Tr.Tip="Watermark, intro and outro">
            <StackPanel Spacing="4"><PathIcon Data="{StaticResource IcImage}" /><TextBlock svc:Tr.Text="Brand" /></StackPanel>
          </Button>
          <Button Classes="rail" Classes.on="{Binding IsSharePage}" Command="{Binding PickPageCommand}" CommandParameter="{x:Static vm:ToolPage.Share}"
                  svc:Tr.Tip="Export modes and share presets">
            <StackPanel Spacing="4"><PathIcon Data="{StaticResource IcShare}" /><TextBlock svc:Tr.Text="Export" /></StackPanel>
          </Button>
        </StackPanel>
      </Border>

      <!-- ===== TOOL PAGE ===== -->
      <Border Grid.Column="2" Width="330" Background="{DynamicResource Bg1}" BorderBrush="{DynamicResource Line}" BorderThickness="1,0,0,0"
              IsVisible="{Binding IsToolsOpen}">
        <DockPanel>
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="16,14,10,8">
            <TextBlock Text="{Binding PageTitle}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" />
            <Button Grid.Column="1" Classes="ghost" Command="{Binding ToggleToolsCommand}" svc:Tr.Tip="Fold the panel away for a bigger picture (Shift+E)">
              <PathIcon Data="{StaticResource IcChevronRight}" Width="16" Height="16" />
            </Button>
          </Grid>
          <ScrollViewer x:Name="EffectsScroll">
            <StackPanel Spacing="14" Margin="12,0,12,18">

              <!-- trim -->
              <StackPanel Spacing="12" IsVisible="{Binding IsTrimPage}">
                <!-- auto-trim suggestion: blank picture and no sound at the start or end -->
                <Border Classes="fxcard" IsVisible="{Binding ShowTrimSuggestion}" Background="{DynamicResource AccentSoft}">
                  <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <PathIcon Data="{StaticResource IcSparkle}" Width="12" Height="12" Foreground="{DynamicResource Highlight}" />
                      <TextBlock Classes="label" svc:Tr.Text="DEAD AIR" Foreground="{DynamicResource Highlight}" />
                    </StackPanel>
                    <TextBlock Text="{Binding TrimSuggestionText}" FontSize="12" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <Button Classes="accent" Command="{Binding ApplyTrimSuggestionCommand}" svc:Tr.Content="Trim it" />
                      <Button Classes="soft" Command="{Binding DismissTrimSuggestionCommand}" svc:Tr.Content="Keep it" />
                    </StackPanel>
                  </StackPanel>
                </Border>
                <Border Classes="fxcard">
                  <StackPanel Spacing="8">
                    <TextBlock Classes="label" svc:Tr.Text="SELECTION" />
                    <Grid ColumnDefinitions="40,*,Auto,Auto" RowDefinitions="Auto,Auto">
                      <TextBlock svc:Tr.Text="In" FontSize="12" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Classes="mono" Text="{Binding InText}" Foreground="{DynamicResource Highlight}" FontSize="12" VerticalAlignment="Center" />
                      <Button Grid.Column="2" Classes="ghost" Padding="7,4" Command="{Binding SetInCommand}" svc:Tr.Tip="Set the start at the playhead (I)">
                        <TextBlock svc:Tr.Text="Set" FontSize="11" />
                      </Button>
                      <Button Grid.Column="3" Classes="ghost" Padding="7,4" Command="{Binding JumpToInCommand}" svc:Tr.Tip="Go to the start (Shift+I)">
                        <TextBlock svc:Tr.Text="Go to" FontSize="11" />
                      </Button>
                      <TextBlock Grid.Row="1" svc:Tr.Text="Out" FontSize="12" VerticalAlignment="Center" />
                      <TextBlock Grid.Row="1" Grid.Column="1" Classes="mono" Text="{Binding OutText}" Foreground="{DynamicResource Highlight}" FontSize="12" VerticalAlignment="Center" />
                      <Button Grid.Row="1" Grid.Column="2" Classes="ghost" Padding="7,4" Command="{Binding SetOutCommand}" svc:Tr.Tip="Set the end at the playhead (O)">
                        <TextBlock svc:Tr.Text="Set" FontSize="11" />
                      </Button>
                      <Button Grid.Row="1" Grid.Column="3" Classes="ghost" Padding="7,4" Command="{Binding JumpToOutCommand}" svc:Tr.Tip="Go to the end (Shift+O)">
                        <TextBlock svc:Tr.Text="Go to" FontSize="11" />
                      </Button>
                    </Grid>
                    <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" IsVisible="{Binding !HasRange}"
                               svc:Tr.Text="Mark where the clip starts and ends: In and Out in the bar below, or drag the brackets on the timeline. Without a selection, Export saves the whole video." />
                    <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasRange}">
                      <TextBlock Classes="dim" svc:Tr.Text="Length" FontSize="12" VerticalAlignment="Center" />
                      <TextBlock Classes="mono" Text="{Binding RangeText}" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                  </StackPanel>
                </Border>

                <Border Classes="fxcard">
                  <StackPanel Spacing="8">
                    <TextBlock Classes="label" svc:Tr.Text="PARTS" />
                    <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap"
                               svc:Tr.Text="Keep several moments in one export: mark one, Add part, mark the next. Export joins them in order." />
                    <Button Classes="soft" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding AddSegmentCommand}"
                            IsEnabled="{Binding HasRange}" svc:Tr.Tip="Keep this selection as one part (A)">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Data="{StaticResource IcAdd}" Width="12" Height="12" />
                        <TextBlock svc:Tr.Text="Add the selection as a part" FontSize="12" />
                        <TextBlock Classes="hint" Text="A" />
                      </StackPanel>
                    </Button>
                    <ItemsControl ItemsSource="{Binding Segments}" IsVisible="{Binding HasSegments}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Classes="part" Margin="0,0,6,6">
                            <StackPanel Orientation="Horizontal" Spacing="2">
                              <Button Classes="ghost" Padding="8,3" svc:Tr.Tip="Jump to this part"
                                      Command="{Binding #Root.((vm:MainViewModel)DataContext).Player.JumpToSegmentCommand}" CommandParameter="{Binding}">
                                <TextBlock Classes="mono" FontSize="12" Text="{Binding Text}" />
                              </Button>
                              <Button Classes="ghost" Padding="5,3" svc:Tr.Tip="Remove this part"
                                      Command="{Binding #Root.((vm:MainViewModel)DataContext).Player.RemoveSegmentCommand}" CommandParameter="{Binding}">
                                <PathIcon Data="{StaticResource IcClose}" Width="10" Height="10" />
                              </Button>
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>

                <Border Classes="fxcard" IsVisible="{Binding HasMarkers}">
                  <StackPanel Spacing="8">
                    <TextBlock Classes="label" svc:Tr.Text="MARKERS" />
                    <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap"
                               svc:Tr.Text="Loud moments and bookmarks, shown as ticks on the timeline." />
                    <Grid ColumnDefinitions="*,Auto,Auto">
                      <TextBlock Text="{Binding MarkerText}" FontSize="12" VerticalAlignment="Center" />
                      <Button Grid.Column="1" Classes="ghost" Padding="7,4" Command="{Binding PreviousMarkerCommand}" svc:Tr.Tip="Previous marker (Shift+N)">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                          <PathIcon Data="{StaticResource IcChevronLeft}" Width="12" Height="12" />
                          <TextBlock svc:Tr.Text="Previous" FontSize="11" />
                        </StackPanel>
                      </Button>
                      <Button Grid.Column="2" Classes="ghost" Padding="7,4" Command="{Binding NextMarkerCommand}" svc:Tr.Tip="Next marker (N)">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                          <TextBlock svc:Tr.Text="Next" FontSize="11" />
                          <PathIcon Data="{StaticResource IcChevronRight}" Width="12" Height="12" />
                        </StackPanel>
                      </Button>
                    </Grid>
                  </StackPanel>
                </Border>

                <Border Classes="fxcard" IsVisible="{Binding HasChapters}">
                  <StackPanel Spacing="6">
                    <TextBlock Classes="label" svc:Tr.Text="CHAPTERS" />
                    <ItemsControl ItemsSource="{Binding ChapterList}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ChapterViewModel">
                          <Grid ColumnDefinitions="*,Auto">
                            <Button Classes="menurow" Classes.on="{Binding IsCurrent}"
                                    Command="{Binding #Root.((vm:MainViewModel)DataContext).Player.JumpToChapterCommand}" CommandParameter="{Binding}">
                              <Grid ColumnDefinitions="52,*,Auto">
                                <TextBlock Classes="mono" Text="{Binding StartText}" FontSize="11" />
                                <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="2" Classes="dim mono" Text="{Binding LengthText}" FontSize="11" Margin="8,0,0,0" />
                              </Grid>
                            </Button>
                            <Button Grid.Column="1" Classes="ghost" Padding="7" Margin="2,0,0,0"
                                    svc:Tr.Tip="Select this chapter, to export or loop it"
                                    Command="{Binding #Root.((vm:MainViewModel)DataContext).Player.SelectChapterCommand}" CommandParameter="{Binding}">
                              <PathIcon Data="{StaticResource IcCut}" Width="12" Height="12" />
                            </Button>
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>

                <Button Classes="soft" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding StartOverCommand}"
                        svc:Tr.Tip="Remove trim marks, parts, captions and speed changes from this video">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Data="{StaticResource IcRefresh}" Width="12" Height="12" />
                    <TextBlock svc:Tr.Text="Start over" />
                  </StackPanel>
                </Button>
              </StackPanel>

              <!-- captions -->
              <StackPanel Spacing="8" IsVisible="{Binding IsCaptionsPage}">
                <Button Classes="soft" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding AddCaptionCommand}" svc:Tr.Tip="Add a caption at the playhead (C)">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Data="{StaticResource IcAdd}" Width="12" Height="12" />
                    <TextBlock svc:Tr.Text="Add a caption at the playhead" FontSize="12" />
                    <TextBlock Classes="hint" Text="C" />
                  </StackPanel>
                </Button>
                <Button Classes="soft" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding CaptionsFromSpeechCommand}"
                        IsVisible="{Binding HasSpeech}" svc:Tr.Tip="Every line said in the part you export becomes a caption you can edit">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Data="{StaticResource IcCaptions}" Width="13" Height="13" />
                    <TextBlock svc:Tr.Text="Add captions from what's said" FontSize="12" />
                  </StackPanel>
                </Button>
                <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" Margin="4,0" IsVisible="{Binding !Captions.Count}"
                           svc:Tr.Text="Text over the video, burned into exports. A new caption starts at the playhead and lasts 3 seconds." />
                <ItemsControl x:Name="CaptionList" ItemsSource="{Binding Captions}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:CaptionViewModel">
                      <Border Classes="fxcard" Margin="0,0,0,8">
                        <StackPanel Spacing="8">
                          <TextBox Classes="fx" Text="{Binding Text}" svc:Tr.Watermark="Caption text" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="96" />
                          <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                            <Button Classes="ghost" Padding="4,3" HorizontalAlignment="Left" svc:Tr.Tip="Jump to this caption"
                                    Command="{Binding #Root.((vm:MainViewModel)DataContext).Player.JumpToCaptionCommand}" CommandParameter="{Binding}">
                              <TextBlock Classes="mono" FontSize="11" Text="{Binding RangeText}" />
                            </Button>
                            <Button Grid.Column="1" Classes="ghost" Padding="7,3" svc:Tr.Tip="Start the caption at the playhead"
                                    Command="{Binding #Root.((vm:MainViewModel)DataContext).Player.CaptionStartHereCommand}" CommandParameter="{Binding}">
                              <TextBlock svc:Tr.Text="Start here" FontSize="11" />
                            </Button>
                            <Button Grid.Column="2" Classes="ghost" Padding="7,3" svc:Tr.Tip="End the caption at the playhead"
                                    Command="{Binding #Root.((vm:MainViewModel)DataContext).Player.CaptionEndHereCommand}" CommandParameter="{Binding}">
                              <TextBlock svc:Tr.Text="End here" FontSize="11" />
                            </Button>
                            <Button Grid.Column="3" Classes="ghost" Padding="6" svc:Tr.Tip="Remove this caption"
                                    Command="{Binding #Root.((vm:MainViewModel)DataContext).Player.RemoveCaptionCommand}" CommandParameter="{Binding}">
                              <PathIcon Data="{StaticResource IcDelete}" Width="13" Height="13" />
                            </Button>
                          </Grid>
                          <WrapPanel Orientation="Horizontal">
                            <ContentControl Content="{Binding Position}" Margin="0,0,6,6" />
                            <ContentControl Content="{Binding Size}" Margin="0,0,6,6" />
                            <ContentControl Content="{Binding Look}" Margin="0,0,0,6" />
                          </WrapPanel>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>


              <!-- slow motion / fast forward -->
              <StackPanel Spacing="8" IsVisible="{Binding IsSpeedPage}">
                <Button Classes="soft" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding AddSpeedSectionCommand}" svc:Tr.Tip="Slow down or speed up part of the clip, starting at the playhead">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Data="{StaticResource IcAdd}" Width="12" Height="12" />
                    <TextBlock svc:Tr.Text="Add slow motion at the playhead" FontSize="12" />
                  </StackPanel>
                </Button>
                <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" Margin="4,0" IsVisible="{Binding !SpeedSections.Count}"
                           svc:Tr.Text="Slow motion or fast forward for part of the clip; the player plays it at that speed so you can check it. Slow motion is smoothest on 60 fps recordings." />
                <ItemsControl ItemsSource="{Binding SpeedSections}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SpeedSectionViewModel">
                      <Border Classes="fxcard" Margin="0,0,0,8">
                        <StackPanel Spacing="8">
                          <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                            <StackPanel Spacing="0">
                              <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" Margin="4,0,0,0" />
                              <Button Classes="ghost" Padding="4,2" HorizontalAlignment="Left" svc:Tr.Tip="Play this part"
                                      Command="{Binding #Root.((vm:MainViewModel)DataContext).Player.JumpToSpeedSectionCommand}" CommandParameter="{Binding}">
                                <TextBlock Classes="mono" FontSize="11" Text="{Binding RangeText}" />
                              </Button>
                            </StackPanel>
                            <Button Grid.Column="1" Classes="ghost" Padding="7,3" VerticalAlignment="Center" svc:Tr.Tip="Start at the playhead"
                                    Command="{Binding #Root.((vm:MainViewModel)DataContext).Player.SpeedStartHereCommand}" CommandParameter="{Binding}">
                              <TextBlock svc:Tr.Text="Start here" FontSize="11" />
                            </Button>
                            <Button Grid.Column="2" Classes="ghost" Padding="7,3" VerticalAlignment="Center" svc:Tr.Tip="End at the playhead"
                                    Command="{Binding #Root.((vm:MainViewModel)DataContext).Player.SpeedEndHereCommand}" CommandParameter="{Binding}">
                              <TextBlock svc:Tr.Text="End here" FontSize="11" />
                            </Button>
                            <Button Grid.Column="3" Classes="ghost" Padding="6" VerticalAlignment="Center" svc:Tr.Tip="Remove"
                                    Command="{Binding #Root.((vm:MainViewModel)DataContext).Player.RemoveSpeedSectionCommand}" CommandParameter="{Binding}">
                              <PathIcon Data="{StaticResource IcDelete}" Width="13" Height="13" />
                            </Button>
                          </Grid>
                          <ContentControl Content="{Binding Rate}" />
                          <CheckBox IsChecked="{Binding Ramp}" FontSize="12" svc:Tr.Content="Ease in and out (speed ramp)"
                                    svc:Tr.Tip="Change speed gradually over 0.6 s at each end instead of in one jump" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>


              <!-- zoom and pan -->
              <StackPanel Spacing="8" IsVisible="{Binding IsZoomPage}">
                <Button Classes="soft" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding PunchInCommand}"
                        svc:Tr.Tip="Zoom in to 2× at the playhead for 1.5 seconds, then back out (Z)">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Data="{StaticResource IcZoom}" Width="13" Height="13" />
                    <TextBlock svc:Tr.Text="Punch in here" FontSize="12" />
                    <TextBlock Classes="hint" Text="Z" />
                  </StackPanel>
                </Button>
                <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding AddZoomKeyCommand}"
                        svc:Tr.Tip="Add a keyframe at the playhead with the view as it is there">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Data="{StaticResource IcAdd}" Width="12" Height="12" />
                    <TextBlock svc:Tr.Text="Add a keyframe at the playhead" FontSize="12" />
                  </StackPanel>
                </Button>
                <Border Classes="fxcard">
                  <StackPanel Spacing="6">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock svc:Tr.Text="Zoom at the playhead" FontSize="12" />
                      <TextBlock Grid.Column="1" Classes="mono" FontSize="12" Text="{Binding ZoomAtPlayheadText}" />
                    </Grid>
                    <Slider Minimum="1" Maximum="4" Value="{Binding ZoomAtPlayhead}" SmallChange="0.1" LargeChange="0.5" />
                    <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap"
                               svc:Tr.Text="On this page you see the whole picture with the zoom frame on it. Drag the frame to aim, or its corners to zoom. Changing it sets a keyframe at the playhead; Savefile glides smoothly from one keyframe to the next." />
                  </StackPanel>
                </Border>
                <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" Margin="4,0" IsVisible="{Binding !HasZoomKeys}"
                           svc:Tr.Text="No zoom yet. Punch in adds a quick zoom on the moment at the playhead; open another page or fold this one away to watch the result." />
                <ItemsControl ItemsSource="{Binding ZoomKeys}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ZoomKeyViewModel">
                      <Border Classes="fxcard" Classes.picked="{Binding IsSelected}" Margin="0,0,0,6" Padding="8,4">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                          <Button Classes="ghost" Padding="4,2" svc:Tr.Tip="Go to this keyframe"
                                  Command="{Binding #Root.((vm:MainViewModel)DataContext).Player.JumpToZoomKeyCommand}" CommandParameter="{Binding}">
                            <TextBlock Classes="mono" FontSize="11" Text="{Binding TimeText}" />
                          </Button>
                          <TextBlock Grid.Column="1" Text="{Binding ZoomText}" FontSize="12" VerticalAlignment="Center" Margin="8,0" />
                          <Button Grid.Column="2" Classes="ghost" Padding="6" svc:Tr.Tip="Remove this keyframe"
                                  Command="{Binding #Root.((vm:MainViewModel)DataContext).Player.RemoveZoomKeyCommand}" CommandParameter="{Binding}">
                            <PathIcon Data="{StaticResource IcDelete}" Width="13" Height="13" />
                          </Button>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <!-- blur -->
              <StackPanel Spacing="8" IsVisible="{Binding IsBlurPage}">
                <Button Classes="soft" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding AddBlurCommand}"
                        svc:Tr.Tip="Hide part of the picture: for the selection if you marked one, otherwise for the whole video (H)">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Data="{StaticResource IcAdd}" Width="12" Height="12" />
                    <TextBlock svc:Tr.Text="Hide an area" FontSize="12" />
                    <TextBlock Classes="hint" Text="H" />
                  </StackPanel>
                </Button>
                <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" Margin="4,0" IsVisible="{Binding !Blurs.Count}"
                           svc:Tr.Text="Blur or pixelate names, chat or parts of the HUD. Drag the box on the video into place and pull its corners to fit. It covers the whole video unless you set a start and end." />
                <ItemsControl ItemsSource="{Binding Blurs}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:BlurViewModel">
                      <Border Classes="fxcard" Classes.picked="{Binding IsSelected}" Margin="0,0,0,8">
                        <StackPanel Spacing="8">
                          <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                            <StackPanel Spacing="0">
                              <Button Classes="ghost" Padding="4,2" HorizontalAlignment="Left" svc:Tr.Tip="Show this area on the video"
                                      Command="{Binding #Root.((vm:MainViewModel)DataContext).Player.SelectBlurCommand}" CommandParameter="{Binding}">
                                <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" />
                              </Button>
                              <TextBlock Classes="mono dim" FontSize="11" Text="{Binding RangeText}" Margin="4,0,0,0" />
                            </StackPanel>
                            <Button Grid.Column="1" Classes="ghost" Padding="7,3" VerticalAlignment="Center" svc:Tr.Tip="Start at the playhead"
                                    Command="{Binding #Root.((vm:MainViewModel)DataContext).Player.BlurStartHereCommand}" CommandParameter="{Binding}">
                              <TextBlock svc:Tr.Text="Start here" FontSize="11" />
                            </Button>
                            <Button Grid.Column="2" Classes="ghost" Padding="7,3" VerticalAlignment="Center" svc:Tr.Tip="End at the playhead"
                                    Command="{Binding #Root.((vm:MainViewModel)DataContext).Player.BlurEndHereCommand}" CommandParameter="{Binding}">
                              <TextBlock svc:Tr.Text="End here" FontSize="11" />
                            </Button>
                            <Button Grid.Column="3" Classes="ghost" Padding="6" VerticalAlignment="Center" svc:Tr.Tip="Remove"
                                    Command="{Binding #Root.((vm:MainViewModel)DataContext).Player.RemoveBlurCommand}" CommandParameter="{Binding}">
                              <PathIcon Data="{StaticResource IcDelete}" Width="13" Height="13" />
                            </Button>
                          </Grid>
                          <Grid ColumnDefinitions="*,Auto">
                            <ContentControl Content="{Binding Look}" />
                            <Button Grid.Column="1" Classes="ghost" Padding="7,3" svc:Tr.Tip="Cover the whole video"
                                    Command="{Binding #Root.((vm:MainViewModel)DataContext).Player.BlurWholeVideoCommand}" CommandParameter="{Binding}">
                              <TextBlock svc:Tr.Text="Whole video" FontSize="11" />
                            </Button>
                          </Grid>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <!-- sound and audio tracks -->
              <StackPanel Spacing="12" IsVisible="{Binding IsSoundPage}">
              <!-- music -->
              <Border Classes="fxcard" IsVisible="{Binding ShowMusicTools}">
                <StackPanel Spacing="10">
                  <StackPanel Spacing="2">
                    <TextBlock svc:Tr.Text="Music" FontSize="12" FontWeight="SemiBold" />
                    <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap"
                               svc:Tr.Text="A song under the export. It repeats if it's shorter than the clip and fades in and out. You hear it in the exported file." />
                  </StackPanel>
                  <Grid ColumnDefinitions="*,Auto,Auto">
                    <TextBlock Text="{Binding MusicName}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding MusicPath}" />
                    <Button Grid.Column="1" Classes="soft" Padding="10,5" Margin="8,0,0,0" Command="{Binding PickMusicCommand}">
                      <TextBlock svc:Tr.Text="Pick a song…" FontSize="12" />
                    </Button>
                    <Button Grid.Column="2" Classes="ghost" Padding="6" Margin="4,0,0,0" IsVisible="{Binding HasMusic}" svc:Tr.Tip="No music"
                            Command="{Binding RemoveMusicCommand}">
                      <PathIcon Data="{StaticResource IcDelete}" Width="13" Height="13" />
                    </Button>
                  </Grid>
                  <StackPanel Spacing="10" IsVisible="{Binding HasMusic}">
                    <StackPanel Spacing="6">
                      <TextBlock svc:Tr.Text="Music volume" FontSize="12" />
                      <ContentControl Content="{Binding MusicVolume}" />
                    </StackPanel>
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="2">
                        <TextBlock svc:Tr.Text="Lower it when the game is loud" FontSize="12" />
                        <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" svc:Tr.Text="Shots, voices and explosions push the music down for a moment, so they still come through." />
                      </StackPanel>
                      <ToggleSwitch Grid.Column="1" Classes="bare" IsChecked="{Binding MusicDuck}" />
                    </Grid>
                  </StackPanel>
                </StackPanel>
              </Border>

              <!-- sound -->
              <StackPanel Spacing="8" IsVisible="{Binding ShowAudioTools}">
                <Border Classes="fxcard">
                  <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="2">
                        <TextBlock svc:Tr.Text="Even out loudness" FontSize="12" />
                        <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" svc:Tr.Text="Brings exports to the same loudness YouTube and Twitch use (−14 LUFS), so quiet clips aren't too quiet." />
                      </StackPanel>
                      <ToggleSwitch Grid.Column="1" Classes="bare" IsChecked="{Binding Normalize}" />
                    </Grid>
                    <StackPanel Spacing="10" IsVisible="{Binding HasVoiceTrackChoice}">
                      <Border Classes="sep" />
                      <StackPanel Spacing="6">
                        <TextBlock svc:Tr.Text="Voice track" FontSize="12" />
                        <ContentControl Content="{Binding VoiceTrack}" />
                      </StackPanel>
                      <StackPanel Spacing="6">
                        <TextBlock svc:Tr.Text="Voice boost" FontSize="12" />
                        <ContentControl Content="{Binding VoiceBoost}" />
                      </StackPanel>
                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="2">
                          <TextBlock svc:Tr.Text="Lower the game while you talk" FontSize="12" />
                          <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" svc:Tr.Text="The other tracks duck under your voice, then come back." />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" Classes="bare" IsChecked="{Binding Duck}" />
                      </Grid>
                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="2">
                          <TextBlock svc:Tr.Text="Clean up my voice" FontSize="12" />
                          <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" svc:Tr.Text="Takes out fan, keyboard and room noise, cuts low rumble and evens out how loud you are. Laughs and shouts stay. Done on this computer while exporting." />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" Classes="bare" IsChecked="{Binding CleanVoice}" />
                      </Grid>
                    </StackPanel>
                    <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" IsVisible="{Binding !HasVoiceTrackChoice}"
                               svc:Tr.Text="Voice boost, cleaning up your voice and lowering the game need the microphone on its own track: Settings, Clipping, two audio devices with Separate tracks." />
                  </StackPanel>
                </Border>
              </StackPanel>


                <Border Classes="fxcard" IsVisible="{Binding HasAudioTracks}">
                  <StackPanel Spacing="8">
                    <TextBlock Classes="label" svc:Tr.Text="AUDIO TRACKS" />
                    <ItemsControl ItemsSource="{Binding AudioTracks}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <ToggleButton Classes="mod" IsChecked="{Binding Enabled}" Content="{Binding Label}" Margin="0,0,6,6"
                                        svc:Tr.Tip="Switched off: this track is left out of exports. Playback uses the first track that is on." />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" svc:Tr.Text="Export keeps the tracks that are on. Share presets mix them into one." />
                  </StackPanel>
                </Border>
              </StackPanel>

              <!-- watermark, intro, outro -->
              <StackPanel Spacing="8" IsVisible="{Binding IsBrandPage}">
                <Border Classes="fxcard">
                  <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="2">
                        <TextBlock svc:Tr.Text="Watermark" FontSize="12" />
                        <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" Text="{Binding WatermarkName}" />
                      </StackPanel>
                      <ToggleSwitch Grid.Column="1" Classes="bare" IsChecked="{Binding UseWatermark}" IsEnabled="{Binding HasWatermark}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="2">
                        <TextBlock svc:Tr.Text="Intro clip" FontSize="12" />
                        <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" Text="{Binding IntroName}" />
                      </StackPanel>
                      <ToggleSwitch Grid.Column="1" Classes="bare" IsChecked="{Binding UseIntro}" IsEnabled="{Binding HasIntro}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="2">
                        <TextBlock svc:Tr.Text="Outro clip" FontSize="12" />
                        <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" Text="{Binding OutroName}" />
                      </StackPanel>
                      <ToggleSwitch Grid.Column="1" Classes="bare" IsChecked="{Binding UseOutro}" IsEnabled="{Binding HasOutro}" />
                    </Grid>
                    <Button Classes="soft" HorizontalAlignment="Left" Padding="10,5" FontSize="12" svc:Tr.Content="Set up in Settings…"
                            Command="{Binding #Root.((vm:MainViewModel)DataContext).OpenEditingSettingsCommand}" />
                  </StackPanel>
                </Border>
              </StackPanel>


              <!-- export and share -->
              <StackPanel Spacing="12" IsVisible="{Binding IsSharePage}">
                <Border Classes="fxcard">
                  <StackPanel Spacing="10">
                    <TextBlock Classes="label" svc:Tr.Text="EXPORT CLIP" />
                    <RadioButton GroupName="exportmode" IsChecked="{Binding !PreciseExport}">
                      <StackPanel Spacing="2">
                        <TextBlock svc:Tr.Text="Lossless" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" svc:Tr.Text="Instant, no quality loss. The start snaps to the keyframe before your In point." />
                      </StackPanel>
                    </RadioButton>
                    <RadioButton GroupName="exportmode" IsChecked="{Binding PreciseExport}">
                      <StackPanel Spacing="2">
                        <TextBlock svc:Tr.Text="Precise" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" svc:Tr.Text="Frame-accurate. Re-encodes to H.264, so it takes a little while. Effects always export this way." />
                      </StackPanel>
                    </RadioButton>
                  </StackPanel>
                </Border>
                <Border Classes="fxcard">
                  <StackPanel Spacing="8">
                    <TextBlock Classes="label" svc:Tr.Text="SHARE" />
                    <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" svc:Tr.Text="Converts the selection (or the whole video) and saves it next to the original." />
                    <Button Classes="preset" Command="{Binding ShareCommand}" CommandParameter="Discord10">
                      <StackPanel Spacing="1">
                        <TextBlock svc:Tr.Text="Discord" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock Classes="dim" FontSize="11" svc:Tr.Text="Fits in 10 MB" />
                      </StackPanel>
                    </Button>
                    <Button Classes="preset" Command="{Binding ShareCommand}" CommandParameter="Discord50">
                      <StackPanel Spacing="1">
                        <TextBlock svc:Tr.Text="Discord Nitro Basic" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock Classes="dim" FontSize="11" svc:Tr.Text="Fits in 50 MB" />
                      </StackPanel>
                    </Button>
                    <Button Classes="preset" Command="{Binding ShareCommand}" CommandParameter="Vertical">
                      <StackPanel Spacing="1">
                        <TextBlock svc:Tr.Text="Vertical 9:16" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock Classes="dim" FontSize="11" svc:Tr.Text="Shorts, Reels and TikTok" />
                      </StackPanel>
                    </Button>
                    <Button Classes="preset" Command="{Binding ShareCommand}" CommandParameter="Gif">
                      <StackPanel Spacing="1">
                        <TextBlock svc:Tr.Text="GIF" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock Classes="dim" FontSize="11" svc:Tr.Text="Up to 20 seconds" />
                      </StackPanel>
                    </Button>
                  </StackPanel>
                </Border>
              </StackPanel>

              <Button Classes="ghost" HorizontalAlignment="Center" FontSize="12" svc:Tr.Content="Remove captions, speed changes, blur and zoom"
                      Command="{Binding ClearEffectsCommand}" IsVisible="{Binding ShowClearEffects}" />
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>
      </Grid>

      <!-- Controls -->
      <Border Grid.Row="2" Background="{DynamicResource Bg1}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0"
              Padding="18,4,18,10" x:Name="ControlsPanel">
        <StackPanel Spacing="6">
          <c:TrimTimeline Duration="{Binding Duration}" Position="{Binding Position}"
                          InPoint="{Binding InPoint}" OutPoint="{Binding OutPoint}"
                          SeekCommand="{Binding SeekCommand}" Accent="{DynamicResource Accent}" RangeBrush="{DynamicResource Highlight}"
                          Segments="{Binding SegmentRanges}" Markers="{Binding Markers}" Effects="{Binding EffectRanges}" />

          <!-- Transport row -->
          <Grid ColumnDefinitions="*,Auto,*">
            <Button Classes="ghost" Padding="4,2" Margin="-4,0,0,0" VerticalAlignment="Center" Command="{Binding ToggleClockCommand}"
                    svc:Tr.Tip="Click to switch between tenths of a second and frames">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Classes="mono" Text="{Binding PositionText}" FontSize="13" />
                <TextBlock Classes="dim mono" Text="/" FontSize="13" Margin="4,0" />
                <TextBlock Classes="dim mono" Text="{Binding DurationText}" FontSize="13" />
              </StackPanel>
            </Button>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
              <Button Classes="ghost" Command="{Binding StepFrameBackCommand}" svc:Tr.Tip="Previous frame (,)" VerticalAlignment="Center">
                <PathIcon Data="{StaticResource IcFramePrev}" />
              </Button>
              <Button Classes="ghost" Command="{Binding SkipBackCommand}" svc:Tr.Tip="Back 5 s (Shift+←)" VerticalAlignment="Center">
                <PathIcon Data="{StaticResource IcRewind}" />
              </Button>
              <Button x:Name="PlayButton" Classes="play" Command="{Binding TogglePlayCommand}" svc:Tr.Tip="Play / pause (Space)" Margin="6,0">
                <Panel>
                  <PathIcon Data="{StaticResource IcPlay}" Width="20" Height="20" Margin="3,0,0,0" Foreground="{DynamicResource Bg0}" IsVisible="{Binding !IsPlaying}" />
                  <PathIcon Data="{StaticResource IcPause}" Width="20" Height="20" Foreground="{DynamicResource Bg0}" IsVisible="{Binding IsPlaying}" />
                </Panel>
              </Button>
              <Button Classes="ghost" Command="{Binding SkipForwardCommand}" svc:Tr.Tip="Forward 5 s (Shift+→)" VerticalAlignment="Center">
                <PathIcon Data="{StaticResource IcForward}" />
              </Button>
              <Button Classes="ghost" Command="{Binding StepFrameCommand}" svc:Tr.Tip="Next frame (.)" VerticalAlignment="Center">
                <PathIcon Data="{StaticResource IcFrameNext}" />
              </Button>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right" VerticalAlignment="Center">
              <Button Classes="ghost" Classes.on="{Binding LoopRange}" Command="{Binding AbLoopCommand}" ToolTip.Tip="{Binding AbTip}" MinWidth="54">
                <StackPanel Orientation="Horizontal" Spacing="5">
                  <PathIcon Data="{StaticResource IcLoop}" Width="13" Height="13" />
                  <TextBlock Text="{Binding AbText}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Classes="ghost" Classes.on="{Binding IsRateChanged}" svc:Tr.Tip="Playback speed (Shift+, slower, Shift+. faster)" MinWidth="52">
                <TextBlock Text="{Binding RateText}" FontSize="13" FontWeight="SemiBold" />
                <Button.Flyout>
                  <Flyout Placement="TopEdgeAlignedRight">
                    <StackPanel Spacing="2" MinWidth="150">
                      <TextBlock Classes="label" svc:Tr.Text="SPEED" Margin="8,0,0,6" />
                      <ItemsControl ItemsSource="{Binding RateOptions}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:RateOption">
                            <Button Classes="menurow" Classes.on="{Binding IsCurrent}" Content="{Binding Label}" Click="OnFlyoutRowClick"
                                    Command="{Binding #Root.((vm:MainViewModel)DataContext).Player.SetRateCommand}" CommandParameter="{Binding}" />
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Flyout>
                </Button.Flyout>
              </Button>
              <Button Classes="ghost" Classes.on="{Binding ShowSpoken}" Command="{Binding ToggleSpokenCommand}" svc:Tr.Tip="Captions: show what's said (V)"
                      IsVisible="{Binding #Root.((vm:MainViewModel)DataContext).ShowSpeech}">
                <PathIcon Data="{StaticResource IcCaptions}" />
              </Button>
              <Button Classes="ghost" Command="{Binding ToggleMuteCommand}" svc:Tr.Tip="Mute (M)">
                <Panel>
                  <PathIcon Data="{StaticResource IcVolume}" IsVisible="{Binding !IsMuted}" />
                  <PathIcon Data="{StaticResource IcMute}" IsVisible="{Binding IsMuted}" />
                </Panel>
              </Button>
              <Slider Width="110" Minimum="0" Maximum="125" Value="{Binding Volume}" VerticalAlignment="Center" Margin="0,-6,8,-6" />
              <Button Classes="ghost" Click="OnFullscreenClick" svc:Tr.Tip="Fullscreen (F)">
                <PathIcon Data="{StaticResource IcFullscreen}" />
              </Button>
            </StackPanel>
          </Grid>


          <!-- Tool bar: the everyday tools as buttons -->
          <Grid Margin="0,2,0,0">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Button Classes="tool" Command="{Binding SetInCommand}" svc:Tr.Tip="Start the selection at the playhead (I)">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock svc:Tr.Text="In" FontWeight="SemiBold" VerticalAlignment="Center" />
                  <TextBlock Classes="mono" Text="{Binding InText}" Foreground="{DynamicResource Highlight}" FontSize="12" VerticalAlignment="Center" />
                  <TextBlock Classes="hint" Text="I" />
                </StackPanel>
              </Button>
              <Button Classes="tool" Command="{Binding SetOutCommand}" svc:Tr.Tip="End the selection at the playhead (O)">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock svc:Tr.Text="Out" FontWeight="SemiBold" VerticalAlignment="Center" />
                  <TextBlock Classes="mono" Text="{Binding OutText}" Foreground="{DynamicResource Highlight}" FontSize="12" VerticalAlignment="Center" />
                  <TextBlock Classes="hint" Text="O" />
                </StackPanel>
              </Button>
              <Button Classes="tool" Command="{Binding PreviewRangeCommand}" svc:Tr.Tip="Play the selection (P)" IsEnabled="{Binding HasRange}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Data="{StaticResource IcPlay}" />
                  <TextBlock svc:Tr.Text="Play" VerticalAlignment="Center" />
                  <TextBlock Classes="hint" Text="P" />
                </StackPanel>
              </Button>
              <ToggleButton Classes="tool" IsChecked="{Binding LoopRange}" IsEnabled="{Binding HasRange}" svc:Tr.Tip="Loop the selection (L)">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Data="{StaticResource IcLoop}" />
                  <TextBlock svc:Tr.Text="Loop" VerticalAlignment="Center" />
                  <TextBlock Classes="hint" Text="L" />
                </StackPanel>
              </ToggleButton>
              <Button Classes="tool" Command="{Binding ClearRangeCommand}" svc:Tr.Tip="Clear In and Out (X)">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Data="{StaticResource IcClose}" />
                  <TextBlock svc:Tr.Text="Clear" VerticalAlignment="Center" />
                  <TextBlock Classes="hint" Text="X" />
                </StackPanel>
              </Button>
              <Button Classes="tool" Command="{Binding AddSegmentCommand}" svc:Tr.Tip="Keep this selection as one part and mark another; Export joins all parts (A)" IsEnabled="{Binding HasRange}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Data="{StaticResource IcAdd}" />
                  <TextBlock svc:Tr.Text="Add part" VerticalAlignment="Center" />
                  <TextBlock Classes="hint" Text="A" />
                </StackPanel>
              </Button>
              <Border Classes="toolsep" />
              <Button Classes="tool" Command="{Binding NextMarkerCommand}" svc:Tr.Tip="Jump to the next loud moment or bookmark (N; Shift+N goes back)" IsEnabled="{Binding HasMarkers}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Data="{StaticResource IcMarker}" />
                  <TextBlock svc:Tr.Text="Next marker" VerticalAlignment="Center" />
                  <TextBlock Classes="hint" Text="N" />
                </StackPanel>
              </Button>
              <Border Classes="toolsep" />
              <Button Classes="tool" Command="{Binding AddCaptionCommand}" svc:Tr.Tip="Add a caption at the playhead (C)" IsVisible="{Binding ShowCaptionsTool}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Data="{StaticResource IcText}" />
                  <TextBlock svc:Tr.Text="Caption" VerticalAlignment="Center" />
                  <TextBlock Classes="hint" Text="C" />
                </StackPanel>
              </Button>
              <Button Classes="tool" Command="{Binding AddSpeedSectionCommand}" svc:Tr.Tip="Slow down or speed up part of the clip, starting at the playhead" IsVisible="{Binding ShowSpeedTool}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Data="{StaticResource IcSpeed}" />
                  <TextBlock svc:Tr.Text="Slow-mo" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Classes="tool" Command="{Binding PunchInCommand}" svc:Tr.Tip="Zoom in on the playhead for a moment (Z)" IsVisible="{Binding ShowZoomTool}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Data="{StaticResource IcZoom}" />
                  <TextBlock svc:Tr.Text="Punch in" VerticalAlignment="Center" />
                  <TextBlock Classes="hint" Text="Z" />
                </StackPanel>
              </Button>
              <Button Classes="tool" Command="{Binding AddBlurCommand}" svc:Tr.Tip="Blur a name, the chat or part of the HUD (H)" IsVisible="{Binding ShowBlurTool}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Data="{StaticResource IcBlur}" />
                  <TextBlock svc:Tr.Text="Blur" VerticalAlignment="Center" />
                  <TextBlock Classes="hint" Text="H" />
                </StackPanel>
              </Button>
              <Border Classes="toolsep" />
              <Button Classes="tool" Command="{Binding #Root.((vm:MainViewModel)DataContext).UseFrameAsThumbnailCommand}" svc:Tr.Tip="Use this frame as the video's thumbnail in the library (T)">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Data="{StaticResource IcImage}" />
                  <TextBlock svc:Tr.Text="Thumbnail" VerticalAlignment="Center" />
                  <TextBlock Classes="hint" Text="T" />
                </StackPanel>
              </Button>
              <Button Classes="tool" Command="{Binding #Root.((vm:MainViewModel)DataContext).SaveFrameCommand}" svc:Tr.Tip="Save this frame as a PNG next to the video (G)">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Data="{StaticResource IcCamera}" />
                  <TextBlock svc:Tr.Text="Save frame" VerticalAlignment="Center" />
                  <TextBlock Classes="hint" Text="G" />
                </StackPanel>
              </Button>
            </WrapPanel>

          </Grid>
        </StackPanel>
      </Border>
    </Grid>
  </Panel>
  </DockPanel>
  </LayoutTransformControl>
</Window>
