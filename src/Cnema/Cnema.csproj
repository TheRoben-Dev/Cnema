<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <!-- Run on newer runtimes too (e.g. Homebrew installs only the latest .NET). -->
    <RollForward>Major</RollForward>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- AWSSDK pulls in System.IO.Hashing 11, which warns on net8.0 (its netstandard2.0 build works fine). -->
    <SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AssemblyName>Cnema</AssemblyName>
    <RootNamespace>Cnema</RootNamespace>
    <Version>0.1.0</Version>
    <Product>Savefile</Product>
    <AssemblyTitle>Savefile</AssemblyTitle>
    <Company>Savefile</Company>
    <ApplicationIcon Condition="Exists('Assets/cnema.ico')">Assets/cnema.ico</ApplicationIcon>
  </PropertyGroup>

  <PropertyGroup>
    <AvaloniaVersion>11.3.23</AvaloniaVersion>
    <!-- Which OS are we producing a build for? RID wins, otherwise the build host. -->
    <CnemaTargetsWindows Condition="$(RuntimeIdentifier.StartsWith('win')) Or ('$(RuntimeIdentifier)' == '' And $([MSBuild]::IsOSPlatform('Windows')))">true</CnemaTargetsWindows>
    <CnemaTargetsMac Condition="$(RuntimeIdentifier.StartsWith('osx')) Or ('$(RuntimeIdentifier)' == '' And $([MSBuild]::IsOSPlatform('OSX')))">true</CnemaTargetsMac>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Controls.ItemsRepeater" Version="11.1.5" />
    <PackageReference Include="AWSSDK.S3" Version="4.1.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="LibVLCSharp" Version="3.10.2" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <PackageReference Include="SSH.NET" Version="2026.0.1" />
    <PackageReference Include="Whisper.net" Version="1.9.1" />
    <!-- Managed part only: the native library comes with the optional visual-search download (ModelStore). -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Managed" Version="1.23.2" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" />
  </ItemGroup>

  <!--
    Native libVLC per platform (see Services/VlcBootstrap.cs):
      macOS   -> bundled from NuGet into libvlc/osx-<arch>/ (falls back to an installed VLC.app).
      Windows -> bundled from NuGet into libvlc/win-<arch>/.
      Linux   -> VideoLAN publishes no Linux package, so the system libvlc is used
                 (apt install libvlc5 vlc-plugin-base / dnf install vlc-libs).
  -->
  <ItemGroup Condition="'$(CnemaTargetsMac)' == 'true'">
    <PackageReference Include="VideoLAN.LibVLC.Mac" Version="3.1.3.2" />
  </ItemGroup>
  <ItemGroup Condition="'$(CnemaTargetsWindows)' == 'true'">
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.24" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets/**" Exclude="Assets/Lang/**;Assets/rnnoise/**" />
    <!-- RNNoise model for Clean up my voice: a plain file next to the app, since ffmpeg reads it by path -->
    <None Include="Assets/rnnoise/voice.rnnn" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Link="rnnoise/voice.rnnn" />
    <EmbeddedResource Include="../../CHANGELOG.md" LogicalName="Cnema.CHANGELOG.md" />
    <EmbeddedResource Include="Assets/Lang/*.json" LogicalName="Cnema.Lang.%(Filename).json" />
  </ItemGroup>
</Project>
