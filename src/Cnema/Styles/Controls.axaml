<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
  </Style>
  <Style Selector="TextBlock.dim">
    <Setter Property="Foreground" Value="{DynamicResource TextDim}" />
  </Style>
  <Style Selector="TextBlock.label">
    <Setter Property="Foreground" Value="{DynamicResource TextDim}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="1.2" />
  </Style>
  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="Menlo, Consolas, DejaVu Sans Mono, monospace" />
  </Style>

  <!-- One body size for form controls, so dialogs, Settings and the welcome setup read the same -->
  <Style Selector="CheckBox, RadioButton, ComboBox, TextBox">
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="ComboBox, TextBox">
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>

  <!-- Generic button chrome -->
  <Style Selector="Button">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <!-- Ghost: transparent, subtle hover -->
  <Style Selector="Button.ghost, ToggleButton.ghost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
    <Setter Property="Padding" Value="8" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Bg3}" />
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
  </Style>
  <Style Selector="Button.ghost:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Line}" />
  </Style>
  <Style Selector="ToggleButton.ghost:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
  </Style>
  <Style Selector="Button.ghost PathIcon, ToggleButton.ghost PathIcon">
    <Setter Property="Width" Value="18" />
    <Setter Property="Height" Value="18" />
  </Style>
  <Style Selector="Button.ghost:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <!-- Soft: filled secondary button -->
  <Style Selector="Button.soft">
    <Setter Property="Background" Value="{DynamicResource Bg3}" />
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
    <Setter Property="Padding" Value="12,7" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="Button.soft:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Line}" />
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
  </Style>

  <!-- Accent: primary action -->
  <Style Selector="Button.accent">
    <Setter Property="Background" Value="{DynamicResource BrandButton}" />
    <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Padding" Value="14,7" />
  </Style>
  <Style Selector="Button.accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BrandButtonHover}" />
    <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
  </Style>
  <Style Selector="Button.accent:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Bg3}" />
    <Setter Property="Foreground" Value="{DynamicResource TextDim}" />
  </Style>

  <!-- Big round play button -->
  <Style Selector="Button.play">
    <Setter Property="Width" Value="46" />
    <Setter Property="Height" Value="46" />
    <Setter Property="CornerRadius" Value="23" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource Text}" />
    <Setter Property="Foreground" Value="{DynamicResource Bg0}" />
  </Style>
  <Style Selector="Button.play:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Highlight}" />
    <Setter Property="Foreground" Value="{DynamicResource Bg0}" />
  </Style>

  <!-- Segmented toggle (Lossless / Precise) -->
  <Style Selector="RadioButton.seg">
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="bd" Background="Transparent" CornerRadius="6" Padding="10,5">
          <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Setter Property="Foreground" Value="{DynamicResource TextDim}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="RadioButton.seg:checked /template/ Border#bd">
    <Setter Property="Background" Value="{DynamicResource Bg3}" />
  </Style>
  <Style Selector="RadioButton.seg:checked">
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
  </Style>

  <!-- Search box -->
  <Style Selector="TextBox.search">
    <Setter Property="Background" Value="{DynamicResource Bg2}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="34,8,10,8" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="TextBox.search:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource Bg2}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
  </Style>
  <Style Selector="TextBox.search:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource Bg2}" />
  </Style>

  <!-- Sidebar navigation list -->
  <Style Selector="ListBox.nav">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem">
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Bg2}" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:selected PathIcon.navicon">
    <Setter Property="Foreground" Value="{DynamicResource Highlight}" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem Button.remove">
    <Setter Property="Opacity" Value="0" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:pointerover Button.remove">
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:pointerover Panel.removable TextBlock.count">
    <Setter Property="Opacity" Value="0" />
  </Style>

  <!-- Video cards -->
  <Style Selector="Button.card">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Top" />
    <Setter Property="CornerRadius" Value="12" />
  </Style>
  <Style Selector="Button.card:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Bg2}" />
  </Style>
  <Style Selector="Button.card:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Bg3}" />
  </Style>
  <Style Selector="Button.card Border.thumb">
    <Setter Property="RenderTransform" Value="scale(1)" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.card:pointerover Border.thumb">
    <Setter Property="RenderTransform" Value="scale(1.02)" />
  </Style>
  <Style Selector="Button.card Border.glow">
    <Setter Property="Opacity" Value="0" />
    <Setter Property="RenderTransform" Value="scale(1)" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.28" Easing="CubicEaseOut" />
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.card:pointerover Border.glow, Window.pad Button.card:focus Border.glow">
    <Setter Property="Opacity" Value="1" />
    <Setter Property="RenderTransform" Value="scale(1.02)" />
  </Style>
  <Style Selector="Button.card Border.ring">
    <Setter Property="Opacity" Value="0" />
    <Setter Property="Transitions">
      <Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.15" /></Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.card:pointerover Border.ring">
    <Setter Property="Opacity" Value="1" />
  </Style>

  <Style Selector="Button.card Border.playhint">
    <Setter Property="Opacity" Value="0" />
    <Setter Property="Transitions">
      <Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.15" /></Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.card:pointerover Border.playhint">
    <Setter Property="Opacity" Value="1" />
  </Style>

  <!-- Badges -->
  <Style Selector="Border.badge">
    <Setter Property="Background" Value="{DynamicResource Overlay}" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Padding" Value="6,2" />
  </Style>
  <Style Selector="Border.badge TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource OnOverlay}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- 4K badge: must come after the base badge style to win -->
  <Style Selector="Border.badge.hi">
    <Setter Property="Background" Value="{DynamicResource Brand}" />
  </Style>
  <Style Selector="Border.badge.hi TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>

  <!-- Tag chips -->
  <Style Selector="Border.tag">
    <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Padding" Value="6,2" />
    <Setter Property="Margin" Value="0,0,4,4" />
  </Style>
  <Style Selector="Border.tag TextBlock">
    <Setter Property="FontSize" Value="10.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TagText}" />
  </Style>
  <Style Selector="Border.tag.big">
    <Setter Property="Padding" Value="9,4,5,4" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Margin" Value="0,0,6,6" />
  </Style>
  <Style Selector="Border.tag.big TextBlock">
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="Button.suggest">
    <Setter Property="Background" Value="{DynamicResource Bg2}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Padding" Value="8,3" />
    <Setter Property="Margin" Value="0,0,6,6" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource TextDim}" />
  </Style>

  <!-- Small round buttons that appear over a thumbnail on hover -->
  <Style Selector="Button.mini">
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="28" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Background" Value="{DynamicResource Overlay}" />
    <Setter Property="Foreground" Value="{DynamicResource OnOverlay}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.mini:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Accent}" />
    <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
  </Style>
  <Style Selector="Button.mini.del:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Danger}" />
    <Setter Property="Foreground" Value="#FFFFFF" />
  </Style>
  <Style Selector="Button.card StackPanel.actions">
    <Setter Property="Opacity" Value="0" />
    <Setter Property="Transitions">
      <Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.12" /></Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.card:pointerover StackPanel.actions">
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="Button.card:pointerover Border.fav">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:selected TextBlock.navicon">
    <Setter Property="Foreground" Value="{DynamicResource Highlight}" />
  </Style>

  <!-- Keycap hint -->
  <Style Selector="Border.key">
    <Setter Property="Background" Value="{DynamicResource Bg0}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
    <Setter Property="BorderThickness" Value="1,1,1,2" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="5,0" />
    <Setter Property="MinWidth" Value="18" />
  </Style>
  <Style Selector="Border.key TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>

  <Style Selector="Slider.thin">
    <Setter Property="MinWidth" Value="80" />
  </Style>

  <Style Selector="ProgressBar">
    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
    <Setter Property="Background" Value="{DynamicResource Bg3}" />
  </Style>
  <!-- Clipping status card (sidebar) -->
  <Style Selector="Border.clipbar">
    <Setter Property="Background" Value="{DynamicResource Bg2}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="10" />
  </Style>
  <Style Selector="Border.clipbar Ellipse.clipdot">
    <Setter Property="Fill" Value="{DynamicResource TextDim}" />
  </Style>
  <Style Selector="Border.clipbar.on Ellipse.clipdot">
    <Setter Property="Fill" Value="{DynamicResource Danger}" />
  </Style>
  <Style Selector="Border.clipbar.err">
    <Setter Property="BorderBrush" Value="{DynamicResource Danger}" />
  </Style>

  <!-- Settings sheet -->
  <Style Selector="Border.group">
    <Setter Property="Background" Value="{DynamicResource Bg2}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
  </Style>
  <Style Selector="Grid.row">
    <Setter Property="Margin" Value="14,10" />
    <Setter Property="MinHeight" Value="32" />
  </Style>
  <Style Selector="Grid.row > TextBlock">
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="Grid.row > StackPanel">
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Grid.row > StackPanel > TextBlock">
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="Border.sep">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{DynamicResource Line}" />
    <Setter Property="Margin" Value="14,0,0,0" />
  </Style>
  <Style Selector="ComboBox.field">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="ToggleSwitch.bare">
    <Setter Property="OnContent" Value="" />
    <Setter Property="OffContent" Value="" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="12,-4,-6,-4" />
  </Style>
  <Style Selector="ToggleButton.mod">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="9,6" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Background" Value="{DynamicResource Bg3}" />
    <Setter Property="Foreground" Value="{DynamicResource TextDim}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="ToggleButton.mod:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
  </Style>
  <!-- Controller mode: button legend -->
  <Style Selector="Border.padkey">
    <Setter Property="Background" Value="{DynamicResource Bg3}" />
    <Setter Property="CornerRadius" Value="11" />
    <Setter Property="MinWidth" Value="22" />
    <Setter Property="Height" Value="22" />
    <Setter Property="Padding" Value="7,0" />
  </Style>
  <Style Selector="Border.padkey TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.padkey.a"><Setter Property="Background" Value="#2E9E5B" /></Style>
  <Style Selector="Border.padkey.b"><Setter Property="Background" Value="#D2453F" /></Style>
  <Style Selector="Border.padkey.x"><Setter Property="Background" Value="#2F7FD8" /></Style>
  <Style Selector="Border.padkey.y"><Setter Property="Background" Value="#C99A1E" /></Style>

  <!-- Controller mode: the focused card looks like the hovered one, so the cursor is obvious from the sofa -->
  <Style Selector="Window.pad Button.card:focus Border.ring">
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="Window.pad Button.card:focus Border.playhint">
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="Window.pad Button.card:focus /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Bg2}" />
  </Style>
  <!--
    Keyboard and controller focus: a rounded ring in the colour scheme's accent with a soft glow, the same
    language as a hovered card, in place of Fluent's sharp white-and-black rectangle. Cards draw their own
    (the hover look), so they opt out of the adorner.
  -->
  <Style Selector=":is(Control)">
    <Setter Property="FocusAdorner">
      <FocusAdornerTemplate>
        <Border Margin="-3" CornerRadius="10" BorderThickness="2" BorderBrush="{DynamicResource FocusRing}"
                BoxShadow="{DynamicResource FocusGlow}" IsHitTestVisible="False" AdornerLayer.IsClipEnabled="False" />
      </FocusAdornerTemplate>
    </Setter>
  </Style>
  <Style Selector="Button.card">
    <Setter Property="FocusAdorner" Value="{x:Null}" />
  </Style>
  <Style Selector="Button.card:focus-visible Border.ring, Button.card:focus-visible Border.playhint">
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="Button.card:focus-visible Border.glow">
    <Setter Property="Opacity" Value="1" />
    <Setter Property="RenderTransform" Value="scale(1.02)" />
  </Style>
  <Style Selector="Button.card:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Bg2}" />
  </Style>
  <Style Selector="Window.pad ListBox.nav ListBoxItem:focus /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
  </Style>
  <Style Selector="Button.updatebar">
    <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="10" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
  </Style>
  <Style Selector="Button.danger">
    <Setter Property="Background" Value="{DynamicResource Danger}" />
    <Setter Property="Foreground" Value="#FFFFFF" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Padding" Value="14,7" />
  </Style>
  <Style Selector="Button.danger:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Bg3}" />
    <Setter Property="Foreground" Value="{DynamicResource TextDim}" />
  </Style>
  <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource DangerHover}" />
    <Setter Property="Foreground" Value="#FFFFFF" />
  </Style>
  <Style Selector="Border.part">
    <Setter Property="Background" Value="{DynamicResource PartFill}" />
    <Setter Property="BorderBrush" Value="{DynamicResource PartLine}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="7" />
  </Style>

  <!-- Settings page tabs -->
  <Style Selector="ListBox.tabs">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4" /></ItemsPanelTemplate>
    </Setter>
  </Style>
  <Style Selector="ListBox.tabs ListBoxItem">
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource TextDim}" />
  </Style>
  <Style Selector="ListBox.tabs ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Bg2}" />
  </Style>
  <Style Selector="ListBox.tabs ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
  </Style>

  <!-- First-run colour swatches -->
  <Style Selector="ListBox.swatches">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.swatches ListBoxItem">
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="Margin" Value="0,0,6,6" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
  </Style>
  <Style Selector="ListBox.swatches ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
  </Style>

  <!-- Key chips in the shortcut sheet -->
  <Style Selector="Button.keychip">
    <Setter Property="Background" Value="{DynamicResource Bg0}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
    <Setter Property="BorderThickness" Value="1,1,1,2" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="9,3" />
    <Setter Property="MinWidth" Value="40" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
  </Style>
  <Style Selector="Button.keychip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    <Setter Property="Background" Value="{DynamicResource Bg2}" />
  </Style>
  <Style Selector="Button.keychip:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Bg0}" />
    <Setter Property="Foreground" Value="{DynamicResource TextDim}" />
  </Style>
  <Style Selector="Button.keychip.custom">
    <Setter Property="Foreground" Value="{DynamicResource Highlight}" />
  </Style>
  <Style Selector="Button.keychip.capturing /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
  </Style>

  <!-- Features: hover glow off -->
  <Style Selector="Window.noglow Border.glow">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <!-- Accessibility: reduce motion. No zoom, no glow, no fades. -->
  <Style Selector="Window.reduced Border.glow">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="Window.reduced Button.card Border.thumb, Window.reduced Button.card:pointerover Border.thumb">
    <Setter Property="RenderTransform" Value="scale(1)" />
    <Setter Property="Transitions" Value="{x:Null}" />
  </Style>
  <Style Selector="Window.reduced Button.card Border.ring, Window.reduced Button.card Border.playhint, Window.reduced Button.card StackPanel.actions">
    <Setter Property="Transitions" Value="{x:Null}" />
  </Style>

  <!-- ======================= Library tools (v0.12) ======================= -->
  <!-- A sidebar row that runs a command instead of selecting a view -->
  <Style Selector="Button.navbutton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.navbutton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Bg2}" />
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
  </Style>
  <Style Selector="Window.pad Button.navbutton:focus /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
  </Style>

  <!-- A moment card in Year in clips: thumbnail and a line, the whole card plays it -->
  <Style Selector="Button.recapmoment">
    <Setter Property="Background" Value="{DynamicResource Bg2}" />
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="8" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.recapmoment:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Bg3}" />
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
  </Style>

  <!-- "Playing with" in the clipping box: a quiet line that turns violet once friends are set -->
  <Style Selector="Button.squad">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextDim}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Padding" Value="6,5" />
    <Setter Property="Margin" Value="-6,-2" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.squad:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Bg2}" />
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
  </Style>
  <Style Selector="Button.squad.on">
    <Setter Property="Foreground" Value="{DynamicResource Highlight}" />
  </Style>

  <!-- A soft button that is "on" (e.g. filters active) -->
  <Style Selector="Button.soft.on">
    <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
    <Setter Property="Foreground" Value="{DynamicResource Highlight}" />
  </Style>

  <!-- Select mode: tick box on cards, ring stays on for picked cards -->
  <Style Selector="Border.selbox">
    <Setter Property="Width" Value="22" />
    <Setter Property="Height" Value="22" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="BorderBrush" Value="#E6FFFFFF" />
    <Setter Property="Background" Value="#66000000" />
  </Style>
  <Style Selector="Border.selbox.checked">
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    <Setter Property="Background" Value="{DynamicResource Accent}" />
  </Style>
  <Style Selector="Border.selbox PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
  </Style>
  <!-- While selecting, a click picks the card, so the play hint would be misleading -->
  <Style Selector="Window.selecting Button.card:pointerover Border.playhint, Window.selecting.pad Button.card:focus Border.playhint">
    <Setter Property="Opacity" Value="0" />
  </Style>
  <Style Selector="Button.card Border.ring.selected">
    <Setter Property="Opacity" Value="1" />
  </Style>

  <!-- The toast moves up while the bulk bar is showing -->
  <Style Selector="Border.toast">
    <Setter Property="Margin" Value="0,0,0,26" />
  </Style>
  <Style Selector="Border.toast.lifted">
    <Setter Property="Margin" Value="0,0,0,86" />
  </Style>
  <!-- Floating bar of bulk actions -->
  <Style Selector="Border.bulkbar">
    <Setter Property="Background" Value="{DynamicResource Bg3}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="BoxShadow" Value="0 8 28 0 #66000000" />
  </Style>

  <!-- Clean-up rows and stat tiles -->
  <Style Selector="Border.cleanrow">
    <Setter Property="Background" Value="{DynamicResource Bg2}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="Margin" Value="0,2" />
  </Style>
  <Style Selector="Border.cleanrow.kept">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Border.tile">
    <Setter Property="Background" Value="{DynamicResource Bg2}" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="14,12" />
    <Setter Property="Margin" Value="0,0,8,8" />
  </Style>

  <!-- Menus and flyouts follow the colour scheme -->
  <Style Selector="FlyoutPresenter">
    <Setter Property="Background" Value="{DynamicResource Bg2}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="12" />
  </Style>
  <Style Selector="MenuFlyoutPresenter, ContextMenu">
    <Setter Property="Background" Value="{DynamicResource Bg2}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
  </Style>

  <!-- ======================= Player (v0.13) ======================= -->
  <Style Selector="Button.ghost.on">
    <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
    <Setter Property="Foreground" Value="{DynamicResource Highlight}" />
  </Style>
  <Style Selector="Button.ghost.on PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource Highlight}" />
  </Style>
  <!-- A row in a flyout list (speed, chapters) -->
  <Style Selector="Button.menurow">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="Button.menurow:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Bg3}" />
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
  </Style>
  <Style Selector="Button.menurow.on">
    <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
    <Setter Property="Foreground" Value="{DynamicResource Highlight}" />
  </Style>
  <!-- The mini player card -->
  <Style Selector="Border.miniplayer">
    <Setter Property="Background" Value="{DynamicResource Bg1}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="BoxShadow" Value="0 16 48 0 #99000000" />
  </Style>
  <!-- Effects panel: cards, segmented chip rows -->
  <Style Selector="Border.fxcard">
    <Setter Property="Background" Value="{DynamicResource Bg2}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="10" />
  </Style>
  <Style Selector="Border.fxcard.picked">
    <Setter Property="BorderBrush" Value="{DynamicResource Brand}" />
  </Style>
  <Style Selector="Border.chipbar">
    <Setter Property="Background" Value="{DynamicResource Bg1}" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Padding" Value="2" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>
  <Style Selector="Button.chip">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextDim}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="MinWidth" Value="30" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.chip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Bg2}" />
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
  </Style>
  <Style Selector="Button.chip.on">
    <Setter Property="Background" Value="{DynamicResource Bg3}" />
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
  </Style>
  <Style Selector="Button.chip.on:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Bg3}" />
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
  </Style>
  <Style Selector="TextBox.fx">
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Padding" Value="9,7" />
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="Background" Value="{DynamicResource Bg1}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
  </Style>
  <Style Selector="TextBlock.err">
    <Setter Property="Foreground" Value="{DynamicResource Danger}" />
  </Style>
  <Style Selector="Border.speedbadge">
    <Setter Property="Background" Value="{DynamicResource ToastBg}" />
    <Setter Property="BorderBrush" Value="#FF9F43" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="10,5" />
  </Style>
  <!-- Editor: the rail of tools beside the video (icon over a label), the page it opens, and the tool bar -->
  <Style Selector="Button.rail">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextDim}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="4,8,4,7" />
    <Setter Property="Width" Value="64" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.rail TextBlock">
    <Setter Property="FontSize" Value="10.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="TextAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.rail PathIcon">
    <Setter Property="Width" Value="18" />
    <Setter Property="Height" Value="18" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.rail:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Bg3}" />
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
  </Style>
  <Style Selector="Button.rail.on /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
  </Style>
  <Style Selector="Button.rail.on:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
  </Style>

  <Style Selector="Button.tool, ToggleButton.tool">
    <Setter Property="Background" Value="{DynamicResource Bg2}" />
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="9,6" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Margin" Value="0,0,4,4" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.tool PathIcon, ToggleButton.tool PathIcon">
    <Setter Property="Width" Value="14" />
    <Setter Property="Height" Value="14" />
  </Style>
  <Style Selector="Button.tool:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.tool:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Bg3}" />
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
  </Style>
  <Style Selector="ToggleButton.tool:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
  </Style>
  <Style Selector="Button.tool:disabled /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.tool:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Bg2}" />
    <Setter Property="Opacity" Value="0.4" />
  </Style>
  <Style Selector="TextBlock.hint">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontFamily" Value="Menlo, Consolas, DejaVu Sans Mono, monospace" />
    <Setter Property="Foreground" Value="{DynamicResource TextDim}" />
    <Setter Property="Opacity" Value="0.8" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.toolsep">
    <Setter Property="Width" Value="1" />
    <Setter Property="Height" Value="22" />
    <Setter Property="Background" Value="{DynamicResource Line}" />
    <Setter Property="Margin" Value="6,0,10,4" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.preset">
    <Setter Property="Background" Value="{DynamicResource Bg2}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="12,9" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.preset:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Bg3}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
  </Style>
</Styles>
